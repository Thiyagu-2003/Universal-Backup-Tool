<UserControl x:Class="UniBackup.UI.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:UniBackup.UI.Controls"
             xmlns:conv="clr-namespace:UniBackup.UI.Converters"
             xmlns:vm="clr-namespace:UniBackup.UI.ViewModels"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,20">
        <StackPanel MaxWidth="1320" HorizontalAlignment="Stretch">

            <!-- ===================================================================
                 1. HEADER SECTION (§2.A)
                 Overview title, description, host badge, last refreshed, refresh action, and date filter
                 =================================================================== -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Title and Subtitle -->
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Overview"
                               FontWeight="SemiBold"
                               FontSize="{StaticResource FontSizePageTitle}"
                               Foreground="{DynamicResource BrushInk}"/>
                    <TextBlock Text="Backup operations and system protection at a glance."
                               FontSize="{StaticResource FontSizeBody}"
                               Foreground="{DynamicResource BrushInkMuted}"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Right: Server Host Pill, Last Refreshed, Date Preset Filter, and Refresh Action -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Current System / Server Name Pill -->
                    <Border Background="{DynamicResource BrushSunken}"
                            BorderBrush="{DynamicResource BrushLine}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusPill}"
                            Padding="12,5"
                            Margin="0,0,14,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconServer}"
                                  Fill="{DynamicResource BrushInkMuted}"
                                  Width="13" Height="13"
                                  Stretch="Uniform"
                                  Margin="0,0,6,0"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding HostDisplay}"
                                       FontFamily="{StaticResource FontFamilyMono}"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       Foreground="{DynamicResource BrushInk}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Last Refreshed Timestamp -->
                    <TextBlock Text="{Binding OverviewLastRefreshedDisplay, StringFormat='Updated: {0}'}"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource BrushInkFaint}"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0"/>

                    <!-- Date Range Presets Segmented Pill (Last 7d, 30d, 90d) -->
                    <Border Style="{StaticResource SegmentedContainer}"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Last 7 days"
                                         Style="{StaticResource SegmentedItem}"
                                         IsChecked="{Binding IsOverviewPreset7Days, Mode=OneWay}"
                                         Click="DatePreset_Click"
                                         Tag="Last7Days"/>
                            <RadioButton Content="Last 30 days"
                                         Style="{StaticResource SegmentedItem}"
                                         IsChecked="{Binding IsOverviewPreset30Days, Mode=OneWay}"
                                         Click="DatePreset_Click"
                                         Tag="Last30Days"/>
                            <RadioButton Content="Last 90 days"
                                         Style="{StaticResource SegmentedItem}"
                                         IsChecked="{Binding IsOverviewPreset90Days, Mode=OneWay}"
                                         Click="DatePreset_Click"
                                         Tag="Last90Days"/>
                        </StackPanel>
                    </Border>

                    <!-- Refresh Dashboard Action Button -->
                    <Button Command="{Binding RefreshOverviewCommand}"
                            Style="{StaticResource BtnQuiet}"
                            Height="32" Padding="12,0"
                            VerticalAlignment="Center"
                            ToolTip="Reload all backup metrics, activity charts, and system diagnostics">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconRefresh}"
                                  Fill="{DynamicResource BrushInkMuted}"
                                  Width="13" Height="13"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Margin="0,0,6,0"/>
                            <TextBlock Text="Refresh"
                                       FontWeight="SemiBold"
                                       FontSize="{StaticResource FontSizeBadge}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ===================================================================
                 2. ATTENTION ALERT BANNER
                 Only visible when HasAttentionJobs is true
                 =================================================================== -->
            <Border x:Name="AttentionBannerCard"
                    Visibility="{Binding HasAttentionJobs, Converter={StaticResource BoolToVis}}"
                    Background="{DynamicResource BrushCoralSoft}"
                    BorderBrush="{DynamicResource BrushCoral}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusCard}"
                    Padding="18,14"
                    Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 36 px Coral Icon Tile -->
                    <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource BrushCoral}"
                            VerticalAlignment="Center" Margin="0,0,14,0">
                        <Path Data="{StaticResource IconWarningCircle}" Fill="#FFFFFF" Width="20" Height="20" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AttentionBannerSummary}"
                                   FontWeight="SemiBold"
                                   FontSize="{StaticResource FontSizeCardHeader}"
                                   Foreground="{DynamicResource BrushCoral}"/>
                        <TextBlock Text="{Binding AttentionBannerExplanation}"
                                   FontSize="{StaticResource FontSizeSecondary}"
                                   Foreground="{DynamicResource BrushInkMuted}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- View Affected Jobs Action Button -->
                    <Button Grid.Column="2"
                            Content="View affected jobs"
                            Command="{Binding ViewAffectedJobsCommand}"
                            Style="{StaticResource BtnDanger}"
                            Height="34" Padding="16,0"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ===================================================================
                 3. FOUR COMPACT, VISUALLY DISTINCTIVE KPI CARDS (§2.B)
                 1. Total Backup Jobs · 2. Backup Success Rate · 3. Needs Attention · 4. Cloud Storage
                 =================================================================== -->
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- KPI 1: Total Backup Jobs -->
                <Border Grid.Column="0"
                        Style="{StaticResource Card}"
                        Padding="18,16"
                        Cursor="Hand">
                    <Border.InputBindings>
                        <MouseBinding Gesture="LeftClick" Command="{Binding NavigateToJobsCommand}"/>
                    </Border.InputBindings>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Top: Icon Tile and Active Pill -->
                        <Grid Grid.Row="0">
                            <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource BrushCobaltSoft}" HorizontalAlignment="Left">
                                <Path Data="{StaticResource IconBackups}" Fill="{DynamicResource BrushCobalt}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource BadgePill}" Background="{DynamicResource BrushCobaltSoft}" Padding="8,3">
                                <TextBlock Text="{Binding EnabledJobsCount, StringFormat='{}{0} active'}"
                                           FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushCobalt}"/>
                            </Border>
                        </Grid>

                        <!-- Middle: Title and Primary Metric -->
                        <StackPanel Grid.Row="1" Margin="0,12,0,4">
                            <TextBlock Text="Total Backup Jobs" FontWeight="Medium" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}"/>
                            <TextBlock Text="{Binding TotalJobsCount}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeKpi}" Foreground="{DynamicResource BrushInk}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Bottom: Supporting Breakdown -->
                        <TextBlock Grid.Row="2"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{DynamicResource BrushInkFaint}">
                            <Run Text="{Binding EnabledJobsCount, Mode=OneWay}"/>
                            <Run Text="active · "/>
                            <Run Text="{Binding DisabledJobsCount, Mode=OneWay}"/>
                            <Run Text="disabled"/>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- KPI 2: Backup Success Rate -->
                <Border Grid.Column="2"
                        Style="{StaticResource Card}"
                        Padding="18,16"
                        Cursor="Hand">
                    <Border.InputBindings>
                        <MouseBinding Gesture="LeftClick" Command="{Binding NavigateToAnalyticsCommand}"/>
                    </Border.InputBindings>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Top: Icon Tile and Delta Pill -->
                        <Grid Grid.Row="0">
                            <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource BrushJadeSoft}" HorizontalAlignment="Left">
                                <Path Data="{StaticResource IconCheckCircle}" Fill="{DynamicResource BrushJade}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource BadgePill}" Background="{DynamicResource BrushJadeSoft}" Padding="8,3">
                                <TextBlock Text="{Binding SuccessRateDeltaDisplay}"
                                           FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushJade}"/>
                            </Border>
                        </Grid>

                        <!-- Middle: Title and Primary Metric -->
                        <StackPanel Grid.Row="1" Margin="0,12,0,4">
                            <TextBlock Text="Backup Success Rate" FontWeight="Medium" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}"/>
                            <TextBlock Text="{Binding SuccessPercentageDisplay}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeKpi}" Foreground="{DynamicResource BrushJade}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Bottom: Supporting Info -->
                        <TextBlock Grid.Row="2"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{DynamicResource BrushInkFaint}">
                            <Run Text="{Binding SuccessfulRunsCount, Mode=OneWay}"/>
                            <Run Text="successful executions"/>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- KPI 3: Needs Attention -->
                <Border Grid.Column="4"
                        Style="{StaticResource Card}"
                        Padding="18,16"
                        Cursor="Hand">
                    <Border.InputBindings>
                        <MouseBinding Gesture="LeftClick" Command="{Binding NavigateToAttentionJobsCommand}"/>
                    </Border.InputBindings>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Top: Icon Tile and Status Pill -->
                        <Grid Grid.Row="0">
                            <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource BrushCoralSoft}" HorizontalAlignment="Left">
                                <Path Data="{StaticResource IconWarningCircle}" Fill="{DynamicResource BrushCoral}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource BadgePill}" Background="{DynamicResource BrushCoralSoft}" Padding="8,3">
                                <TextBlock Text="{Binding AttentionBadgeText}"
                                           FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushCoral}"/>
                            </Border>
                        </Grid>

                        <!-- Middle: Title and Primary Metric -->
                        <StackPanel Grid.Row="1" Margin="0,12,0,4">
                            <TextBlock Text="Needs Attention" FontWeight="Medium" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}"/>
                            <TextBlock Text="{Binding AttentionJobsCount}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeKpi}" Foreground="{DynamicResource BrushCoral}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Bottom: Supporting Breakdown -->
                        <TextBlock Grid.Row="2"
                                   Text="{Binding AttentionSummaryBreakdown}"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{DynamicResource BrushInkFaint}"/>
                    </Grid>
                </Border>

                <!-- KPI 4: Cloud Storage -->
                <Border Grid.Column="6"
                        Style="{StaticResource Card}"
                        Padding="18,16"
                        Cursor="Hand">
                    <Border.InputBindings>
                        <MouseBinding Gesture="LeftClick" Command="{Binding NavigateToCloudRecoveryCommand}"/>
                    </Border.InputBindings>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Top: Icon Tile and Cloud Status Pill -->
                        <Grid Grid.Row="0">
                            <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource BrushOrchidSoft}" HorizontalAlignment="Left">
                                <Path Data="{StaticResource IconCloudArrowUp}" Fill="{DynamicResource BrushOrchid}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource BadgePill}" Background="{DynamicResource BrushOrchidSoft}" Padding="8,3">
                                <TextBlock Text="{Binding CloudDestinationStatus}"
                                           FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushOrchid}"/>
                            </Border>
                        </Grid>

                        <!-- Middle: Title and Primary Metric -->
                        <StackPanel Grid.Row="1" Margin="0,12,0,4">
                            <TextBlock Text="Cloud Storage" FontWeight="Medium" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}"/>
                            <TextBlock Text="{Binding TotalUploadedDisplay}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeKpi}" Foreground="{DynamicResource BrushOrchid}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Bottom: Supporting Info -->
                        <TextBlock Grid.Row="2"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{DynamicResource BrushInkFaint}">
                            <Run Text="{Binding SuccessfulUploadsCount, Mode=OneWay}"/>
                            <Run Text="successful uploads to cloud"/>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===================================================================
                 4. ANALYTICS ROW (§2.C & §2.D)
                 Left: Large Modern Interactive Chart (Activity Trends)
                 Right: Backup Distribution by Type (Donut Visualization)
                 =================================================================== -->
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.7*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Card: Backup Activity Analytics Chart -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20">
                    <StackPanel>
                        <!-- Header with Legend -->
                        <Grid Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Backup Activity Trends"
                                           FontWeight="SemiBold"
                                           FontSize="{StaticResource FontSizeCardHeader}"
                                           Foreground="{DynamicResource BrushInk}"/>
                                <TextBlock Text="Execution volume and outcome telemetry across reporting window"
                                           FontSize="{StaticResource FontSizeSecondary}"
                                           Foreground="{DynamicResource BrushInkMuted}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Chart Legend -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource BrushJade}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Succeeded" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,0,14,0"/>

                                <Ellipse Width="8" Height="8" Fill="{DynamicResource BrushCoral}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Failed" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,0,14,0"/>

                                <Ellipse Width="8" Height="8" Fill="{DynamicResource BrushSaffron}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Partial" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkMuted}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Interactive LiveCharts2 Cartesian Chart -->
                        <Grid Height="210">
                            <!-- Chart Content -->
                            <lvc:CartesianChart Series="{Binding OverviewActivitySeries}"
                                                XAxes="{Binding OverviewActivityXAxes}"
                                                YAxes="{Binding OverviewActivityYAxes}"
                                                Height="210"
                                                MinHeight="190"
                                                Visibility="{Binding HasOverviewActivityHistory, Converter={StaticResource BoolToVis}}"/>

                            <!-- Empty State when no history exists -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding HasOverviewActivityHistory, Converter={StaticResource InverseBoolToVis}}">
                                <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource BrushSunken}" HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <Path Data="{StaticResource IconClock}" Fill="{DynamicResource BrushInkFaint}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="No backup activity recorded" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Executions during this time period will appear here." FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkFaint}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Right Card: Backup Distribution Donut Visualization -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Backup Distribution"
                                   FontWeight="SemiBold"
                                   FontSize="{StaticResource FontSizeCardHeader}"
                                   Foreground="{DynamicResource BrushInk}"/>
                        <TextBlock Text="Volume distribution by backup type"
                                   FontSize="{StaticResource FontSizeSecondary}"
                                   Foreground="{DynamicResource BrushInkMuted}"
                                   Margin="0,2,0,12"/>

                        <!-- Donut Graphic Container -->
                        <Grid Height="140" HorizontalAlignment="Center" Margin="0,0,0,10">
                            <lvc:PieChart Series="{Binding OverviewTypeSeries}"
                                          Height="140"
                                          Width="160"
                                          InitialRotation="-90"
                                          MaxAngle="360"
                                          Visibility="{Binding HasOverviewTypeDistribution, Converter={StaticResource BoolToVis}}"/>

                            <!-- Center Label -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                        Visibility="{Binding HasOverviewTypeDistribution, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding OverviewTotalTypeCount}"
                                           FontWeight="SemiBold"
                                           FontSize="{StaticResource FontSizeSectionHeader}"
                                           Foreground="{DynamicResource BrushInk}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="total runs"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{DynamicResource BrushInkMuted}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Empty State for Distribution -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding HasOverviewTypeDistribution, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="No backup types logged" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkFaint}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Slices Legend List -->
                        <Border BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                            <ItemsControl ItemsSource="{Binding OverviewTypeSlices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="48"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="8" Height="8" Fill="{Binding ColorBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInk}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Count}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Border Grid.Column="3" Style="{StaticResource BadgePill}" Background="{DynamicResource BrushSunken}" HorizontalAlignment="Right" Padding="5,2">
                                                <TextBlock Text="{Binding PercentageDisplay}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushInk}"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===================================================================
                 5. OPERATIONAL ROW (§2.F & §2.G)
                 Left: Compact System Health Panel
                 Right: Upcoming Backup Activity Queue
                 =================================================================== -->
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Card: System Health Panel -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="System &amp; Engine Health"
                                           FontWeight="SemiBold"
                                           FontSize="{StaticResource FontSizeCardHeader}"
                                           Foreground="{DynamicResource BrushInk}"/>
                                <TextBlock Text="Background daemon, cloud targets and staging space"
                                           FontSize="{StaticResource FontSizeSecondary}"
                                           Foreground="{DynamicResource BrushInkMuted}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>

                            <Button HorizontalAlignment="Right"
                                    Content="View diagnostics →"
                                    Command="{Binding NavigateToSettingsDiagnosticsCommand}"
                                    Style="{StaticResource BtnQuiet}"
                                    Height="28" Padding="10,0"
                                    VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Health Indicators Grid -->
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Metric 1: Backup Engine Status -->
                            <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource BrushSunken}" CornerRadius="{StaticResource RadiusControl}" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="BACKUP ENGINE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushInkFaint}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Fill="{Binding OverviewEngineStatusBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding OverviewEngineStatus}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInk}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Metric 2: Background Service Status -->
                            <Border Grid.Row="0" Grid.Column="2" Background="{DynamicResource BrushSunken}" CornerRadius="{StaticResource RadiusControl}" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="SCHEDULER SERVICE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushInkFaint}"/>
                                    <TextBlock Text="{Binding OverviewServiceStatus}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInk}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>

                            <!-- Metric 3: Cloud Destinations -->
                            <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource BrushSunken}" CornerRadius="{StaticResource RadiusControl}" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="CLOUD CONNECTIVITY" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushInkFaint}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <Ellipse Width="7" Height="7" Fill="{Binding OverviewCloudStatusBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding OverviewCloudStatus}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInk}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Metric 4: Temporary Staging Disk -->
                            <Border Grid.Row="1" Grid.Column="2" Background="{DynamicResource BrushSunken}" CornerRadius="{StaticResource RadiusControl}" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="TEMPORARY DISK" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushInkFaint}"/>
                                    <TextBlock Text="{Binding OverviewTempDiskDisplay}" FontFamily="{StaticResource FontFamilyMono}" FontWeight="Medium" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInk}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>

                            <!-- Metric 5: Last Successful Backup -->
                            <Border Grid.Row="2" Grid.Column="0" Background="{DynamicResource BrushSunken}" CornerRadius="{StaticResource RadiusControl}" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="LAST SUCCESSFUL RUN" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushInkFaint}"/>
                                    <TextBlock Text="{Binding OverviewLastSuccessfulBackup}" FontFamily="{StaticResource FontFamilyMono}" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInk}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>

                            <!-- Metric 6: Overall System Health -->
                            <Border Grid.Row="2" Grid.Column="2" Background="{DynamicResource BrushSunken}" CornerRadius="{StaticResource RadiusControl}" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="HEALTH ASSESSMENT" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushInkFaint}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <Ellipse Width="7" Height="7" Fill="{Binding OverviewOverallHealthBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding OverviewOverallHealth}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSecondary}" Foreground="{Binding OverviewOverallHealthBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Right Card: Upcoming Backup Activity Queue (§2.G) -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Upcoming Backup Activity"
                                           FontWeight="SemiBold"
                                           FontSize="{StaticResource FontSizeCardHeader}"
                                           Foreground="{DynamicResource BrushInk}"/>
                                <TextBlock Text="Scheduled routine queue and execution timeline"
                                           FontSize="{StaticResource FontSizeSecondary}"
                                           Foreground="{DynamicResource BrushInkMuted}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- View All Jobs Action Button -->
                            <Button HorizontalAlignment="Right"
                                    Content="View all jobs →"
                                    Command="{Binding NavigateTabCommand}"
                                    CommandParameter="Backups"
                                    Style="{StaticResource BtnQuiet}"
                                    Height="28" Padding="10,0"
                                    VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Structured Upcoming List (Visible when HasUpcomingJobs is true) -->
                        <Grid Grid.Row="1" Visibility="{Binding HasUpcomingJobs, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Column Headers -->
                            <Border Grid.Row="0" BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,0,0,1" Padding="6,0,6,6" Margin="0,0,0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="110"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="75"/>
                                        <ColumnDefinition Width="52"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="JOB" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkFaint}"/>
                                    <TextBlock Grid.Column="1" Text="SCHEDULE" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkFaint}"/>
                                    <TextBlock Grid.Column="2" Text="NEXT RUN" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkFaint}"/>
                                    <TextBlock Grid.Column="3" Text="STATUS" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkFaint}"/>
                                    <TextBlock Grid.Column="4" Text="RUN" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkFaint}" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <!-- Rows -->
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding UpcomingJobs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:JobCardViewModel}">
                                        <Border BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,0,0,1" Padding="6,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="110"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="95"/>
                                                    <ColumnDefinition Width="75"/>
                                                    <ColumnDefinition Width="52"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Job Name & Kind Chip -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding Name, Mode=OneWay}"
                                                               FontWeight="SemiBold"
                                                               FontSize="{StaticResource FontSizeSecondary}"
                                                               Foreground="{DynamicResource BrushInk}"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="115"/>
                                                    <Border Style="{StaticResource BadgePill}"
                                                            Background="{Binding KindSoftBrush}"
                                                            Margin="5,0,0,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding KindChipName}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="9"
                                                                   Foreground="{Binding KindBrush}"/>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Schedule -->
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding ScheduleDisplay}"
                                                           FontSize="{StaticResource FontSizeCaption}"
                                                           Foreground="{DynamicResource BrushInk}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0"/>

                                                <!-- Next Run -->
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding NextRunDisplay}"
                                                           FontSize="{StaticResource FontSizeCaption}"
                                                           Foreground="{DynamicResource BrushInk}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0"/>

                                                <!-- Status Badge -->
                                                <Border Grid.Column="3" Style="{StaticResource BadgePill}"
                                                        Background="{Binding StatusBadgeSoftBrush}"
                                                        Padding="6,2"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="5" Height="5" Fill="{Binding StatusBadgeBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding StatusBadgeText}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="10"
                                                                   Foreground="{Binding StatusBadgeBrush}"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Quick Run Action Button -->
                                                <Button Grid.Column="4"
                                                        Command="{Binding DataContext.RunJobCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource BtnQuiet}"
                                                        Width="48" Height="24" Padding="0"
                                                        HorizontalAlignment="Right"
                                                        ToolTip="Run this backup job now">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconPlay}" Fill="{DynamicResource BrushInkMuted}" Width="8" Height="8" Stretch="Uniform" Margin="0,0,2,0"/>
                                                        <TextBlock Text="Run" FontSize="10" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <!-- Empty State when no upcoming jobs exist -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,24"
                                    Visibility="{Binding HasUpcomingJobs, Converter={StaticResource InverseBoolToVis}}">
                            <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource BrushCobaltSoft}" HorizontalAlignment="Center" Margin="0,0,0,10">
                                <Path Data="{StaticResource IconClock}" Fill="{DynamicResource BrushCobalt}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="No upcoming scheduled runs" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInk}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Configure a schedule on any backup job to automate routines." FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkMuted}" HorizontalAlignment="Center" Margin="0,3,0,12"/>
                            <Button Content="Create backup job" Command="{Binding OpenNewJobCommand}" Style="{StaticResource BtnPrimary}" Height="30" Padding="14,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===================================================================
                 6. RECENT BACKUP ACTIVITY TABLE (§2.E)
                 Columns: Job · Type · Date & Time · Status · Size · Duration · Destination · Action
                 Search · Multi-column sorting · Status filters · Pagination · View details
                 =================================================================== -->
            <Border Style="{StaticResource Card}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Table Header & Toolbar -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Title & Subtitle -->
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Recent Backup Activity"
                                       FontWeight="SemiBold"
                                       FontSize="{StaticResource FontSizeCardHeader}"
                                       Foreground="{DynamicResource BrushInk}"/>
                            <TextBlock Text="Execution metrics, sizes, run duration, and destination status"
                                       FontSize="{StaticResource FontSizeSecondary}"
                                       Foreground="{DynamicResource BrushInkMuted}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Right: Search Box + Status Filter Segmented Container + Complete History link -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Quick Filter Search Box -->
                            <Border Width="200" Height="30" CornerRadius="{StaticResource RadiusControl}" Background="{DynamicResource BrushSunken}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" Margin="0,0,10,0">
                                <Grid>
                                    <Path Data="{StaticResource IconSearch}" Fill="{DynamicResource BrushInkFaint}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Left" Margin="8,0,0,0" IsHitTestVisible="False"/>
                                    <TextBox Text="{Binding OverviewSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent" BorderThickness="0"
                                             FontSize="{StaticResource FontSizeCaption}"
                                             Padding="26,0,8,0"
                                             VerticalContentAlignment="Center"
                                             Tag="Search jobs or type..."
                                             Style="{StaticResource FieldInput}"/>
                                </Grid>
                            </Border>

                            <!-- Status Filter Buttons -->
                            <Border Style="{StaticResource SegmentedContainer}" Margin="0,0,12,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="All"
                                            Command="{Binding SetOverviewStatusFilterCommand}" CommandParameter="ALL"
                                            Style="{StaticResource BtnGhost}" Height="24" Padding="8,0" FontSize="11"/>
                                    <Button Content="Success"
                                            Command="{Binding SetOverviewStatusFilterCommand}" CommandParameter="SUCCESS"
                                            Style="{StaticResource BtnGhost}" Height="24" Padding="8,0" FontSize="11"/>
                                    <Button Content="Failed"
                                            Command="{Binding SetOverviewStatusFilterCommand}" CommandParameter="FAILED"
                                            Style="{StaticResource BtnGhost}" Height="24" Padding="8,0" FontSize="11"/>
                                    <Button Content="Partial"
                                            Command="{Binding SetOverviewStatusFilterCommand}" CommandParameter="PARTIAL"
                                            Style="{StaticResource BtnGhost}" Height="24" Padding="8,0" FontSize="11"/>
                                </StackPanel>
                            </Border>

                            <!-- Navigate to Complete Backup History Action Button -->
                            <Button Content="Complete history →"
                                    Command="{Binding NavigateToFullHistoryCommand}"
                                    Style="{StaticResource BtnQuiet}"
                                    Height="30" Padding="12,0"
                                    VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Table Container -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Column Headers with Sort Actions -->
                        <Border Grid.Row="0" BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,0,0,1" Padding="8,0,8,8" Margin="0,0,0,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.2*" MinWidth="140"/> <!-- Job -->
                                    <ColumnDefinition Width="1.1*"/>                <!-- Type -->
                                    <ColumnDefinition Width="1.5*"/>                <!-- Date & Time -->
                                    <ColumnDefinition Width="1.1*"/>                <!-- Status -->
                                    <ColumnDefinition Width="1.0*"/>                <!-- Size -->
                                    <ColumnDefinition Width="1.0*"/>                <!-- Duration -->
                                    <ColumnDefinition Width="1.4*"/>                <!-- Destination -->
                                    <ColumnDefinition Width="65"/>                  <!-- Action -->
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Command="{Binding SortOverviewByCommand}" CommandParameter="Job" Style="{StaticResource BtnGhost}" Height="22" Padding="0" HorizontalAlignment="Left">
                                    <TextBlock Text="JOB" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkFaint}"/>
                                </Button>
                                <Button Grid.Column="1" Command="{Binding SortOverviewByCommand}" CommandParameter="Type" Style="{StaticResource BtnGhost}" Height="22" Padding="0" HorizontalAlignment="Left">
                                    <TextBlock Text="TYPE" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkFaint}"/>
                                </Button>
                                <Button Grid.Column="2" Command="{Binding SortOverviewByCommand}" CommandParameter="Date" Style="{StaticResource BtnGhost}" Height="22" Padding="0" HorizontalAlignment="Left">
                                    <TextBlock Text="DATE &amp; TIME" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkFaint}"/>
                                </Button>
                                <Button Grid.Column="3" Command="{Binding SortOverviewByCommand}" CommandParameter="Status" Style="{StaticResource BtnGhost}" Height="22" Padding="0" HorizontalAlignment="Left">
                                    <TextBlock Text="STATUS" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkFaint}"/>
                                </Button>
                                <Button Grid.Column="4" Command="{Binding SortOverviewByCommand}" CommandParameter="Size" Style="{StaticResource BtnGhost}" Height="22" Padding="0" HorizontalAlignment="Left">
                                    <TextBlock Text="SIZE" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkFaint}"/>
                                </Button>
                                <Button Grid.Column="5" Command="{Binding SortOverviewByCommand}" CommandParameter="Duration" Style="{StaticResource BtnGhost}" Height="22" Padding="0" HorizontalAlignment="Left">
                                    <TextBlock Text="DURATION" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkFaint}"/>
                                </Button>
                                <TextBlock Grid.Column="6" Text="DESTINATION" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkFaint}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="7" Text="ACTION" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkFaint}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Paged Rows -->
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding OverviewPagedRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ActivityRowVm}">
                                    <Border BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,0,0,1" Padding="8,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.2*" MinWidth="140"/>
                                                <ColumnDefinition Width="1.1*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="1.1*"/>
                                                <ColumnDefinition Width="1.0*"/>
                                                <ColumnDefinition Width="1.0*"/>
                                                <ColumnDefinition Width="1.4*"/>
                                                <ColumnDefinition Width="65"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Job Name -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding JobName}"
                                                           FontWeight="SemiBold"
                                                           FontSize="{StaticResource FontSizeBody}"
                                                           Foreground="{DynamicResource BrushInk}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <!-- Type Badge -->
                                            <Border Grid.Column="1" Style="{StaticResource BadgePill}" Background="{DynamicResource BrushSunken}" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="6,2">
                                                <TextBlock Text="{Binding BackupTypeDisplay}" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource BrushInk}"/>
                                            </Border>

                                            <!-- Date & Time + TimeAgo -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding TimestampDisplay}" FontFamily="{StaticResource FontFamilyMono}" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInk}"/>
                                                <TextBlock Text="{Binding TimeAgoDisplay}" FontSize="10" Foreground="{DynamicResource BrushInkFaint}"/>
                                            </StackPanel>

                                            <!-- Status Badge -->
                                            <Border Grid.Column="3" Style="{StaticResource BadgePill}" Background="{Binding StatusSoftBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="6,2">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="5" Height="5" Fill="{Binding StatusBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding StatusDisplay}" FontWeight="SemiBold" FontSize="10" Foreground="{Binding StatusBrush}"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Size -->
                                            <TextBlock Grid.Column="4" Text="{Binding SizeDisplay}" FontFamily="{StaticResource FontFamilyMono}" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInk}" VerticalAlignment="Center"/>

                                            <!-- Duration -->
                                            <TextBlock Grid.Column="5" Text="{Binding DurationDisplay}" FontFamily="{StaticResource FontFamilyMono}" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkMuted}" VerticalAlignment="Center"/>

                                            <!-- Destination -->
                                            <TextBlock Grid.Column="6" Text="{Binding DestinationsSummary}" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkMuted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,6,0"/>

                                            <!-- View Details Button -->
                                            <Button Grid.Column="7"
                                                    Command="{Binding DataContext.ViewOverviewDetailsCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource BtnQuiet}"
                                                    Height="26" Padding="8,0"
                                                    HorizontalAlignment="Right"
                                                    ToolTip="View execution details and destinations">
                                                <TextBlock Text="View" FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- Table Pagination Footer -->
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Summary text -->
                        <TextBlock Text="{Binding OverviewPaginationSummary}"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{DynamicResource BrushInkMuted}"
                                   VerticalAlignment="Center"/>

                        <!-- Page Navigation Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="«" Command="{Binding OverviewFirstPageCommand}" IsEnabled="{Binding CanOverviewPrevPage}" Style="{StaticResource BtnQuiet}" Width="28" Height="28" Padding="0" Margin="0,0,4,0"/>
                            <Button Content="‹" Command="{Binding OverviewPrevPageCommand}" IsEnabled="{Binding CanOverviewPrevPage}" Style="{StaticResource BtnQuiet}" Width="28" Height="28" Padding="0" Margin="0,0,8,0"/>

                            <TextBlock Text="{Binding OverviewCurrentPage, StringFormat='Page {0}'}"
                                       FontWeight="Medium" FontSize="{StaticResource FontSizeCaption}"
                                       Foreground="{DynamicResource BrushInk}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>

                            <Button Content="›" Command="{Binding OverviewNextPageCommand}" IsEnabled="{Binding CanOverviewNextPage}" Style="{StaticResource BtnQuiet}" Width="28" Height="28" Padding="0" Margin="0,0,4,0"/>
                            <Button Content="»" Command="{Binding OverviewLastPageCommand}" IsEnabled="{Binding CanOverviewNextPage}" Style="{StaticResource BtnQuiet}" Width="28" Height="28" Padding="0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Execution Details Modal / Flyout Overlay (Shown when IsOverviewDetailsOpen is true) -->
                    <Border Grid.Row="0" Grid.RowSpan="3"
                            Visibility="{Binding IsOverviewDetailsOpen, Converter={StaticResource BoolToVis}}"
                            Background="#880B1420"
                            CornerRadius="{StaticResource RadiusCard}"
                            Margin="-20">
                        <Border Style="{StaticResource Card}"
                                MaxWidth="620"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Effect="{StaticResource Sh3}"
                                Padding="24">
                            <StackPanel DataContext="{Binding OverviewSelectedRow}">
                                <!-- Header: Job Name and Close Button -->
                                <Grid Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="{Binding JobName}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSectionHeader}" Foreground="{DynamicResource BrushInk}"/>
                                        <TextBlock Text="{Binding TimestampDisplay, StringFormat='Execution timestamp: {0}'}" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Command="{Binding DataContext.CloseOverviewDetailsCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            Style="{StaticResource IconBtn}" Width="28" Height="28">
                                        <Path Data="{StaticResource IconClose}" Fill="{DynamicResource BrushInkMuted}" Width="10" Height="10" Stretch="Uniform"/>
                                    </Button>
                                </Grid>

                                <!-- Details Grid -->
                                <Border Background="{DynamicResource BrushSunken}" CornerRadius="{StaticResource RadiusControl}" Padding="16" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Run Status:" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkFaint}" Margin="0,3"/>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                                            <Border Style="{StaticResource BadgePill}" Background="{Binding StatusSoftBrush}" Padding="6,2">
                                                <TextBlock Text="{Binding StatusDisplay}" FontWeight="SemiBold" FontSize="10" Foreground="{Binding StatusBrush}"/>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Backup Type:" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkFaint}" Margin="0,3"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BackupTypeDisplay}" FontWeight="Medium" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInk}" Margin="0,3"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Backup Size / Time:" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkFaint}" Margin="0,3"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SizeDisplay, StringFormat='{}{0} in '}" FontWeight="Medium" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInk}" Margin="0,3">
                                            <Run Text="{Binding DurationDisplay, Mode=OneWay}"/>
                                        </TextBlock>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Destinations:" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkFaint}" Margin="0,3"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DestinationsSummary}" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInk}" Margin="0,3"/>
                                    </Grid>
                                </Border>

                                <!-- Per-destination upload summary -->
                                <ItemsControl ItemsSource="{Binding Destinations}" Margin="0,0,0,14">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" Padding="10,6" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Destination}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInk}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding TargetLocation}" FontFamily="{StaticResource FontFamilyMono}" FontSize="10" Foreground="{DynamicResource BrushInkMuted}" Margin="10,0" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Status}" FontWeight="SemiBold" FontSize="10" Foreground="{DynamicResource BrushJade}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Error Box (Visible only if ErrorMessage exists) -->
                                <Border Background="{DynamicResource BrushCoralSoft}" BorderBrush="{DynamicResource BrushCoral}" BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" Padding="12" Margin="0,0,0,16"
                                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringEqualsToBool}, ConverterParameter=''}">
                                    <StackPanel>
                                        <TextBlock Text="Error Details" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushCoral}"/>
                                        <TextBlock Text="{Binding ErrorMessage}" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInk}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Close Button -->
                                <Button Content="Close"
                                        Command="{Binding DataContext.CloseOverviewDetailsCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        Style="{StaticResource BtnQuiet}"
                                        Height="32" Padding="20,0"
                                        HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>
            </Border>

