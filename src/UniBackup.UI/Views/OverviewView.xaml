<UserControl x:Class="UniBackup.UI.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:UniBackup.UI.Controls"
             xmlns:vm="clr-namespace:UniBackup.UI.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20">
        <StackPanel MaxWidth="1280" HorizontalAlignment="Stretch">

            <!-- 1. Header: Page Title and System Status Subtitle -->
            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="Overview"
                           FontWeight="SemiBold"
                           FontSize="{StaticResource FontSizePageTitle}"
                           Foreground="{DynamicResource BrushInk}"/>
                <TextBlock Text="{Binding OverviewSubtitle}"
                           FontSize="{StaticResource FontSizeBody}"
                           Foreground="{DynamicResource BrushInkMuted}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- 2. Attention Banner (Compact alert banner, only visible when AttentionJobsCount > 0) -->
            <Border x:Name="AttentionBannerCard"
                    Visibility="{Binding HasAttentionJobs, Converter={StaticResource BoolToVis}}"
                    Background="{DynamicResource BrushCoralSoft}"
                    BorderBrush="{DynamicResource BrushCoral}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusCard}"
                    Padding="18,14"
                    Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 36 px Coral Icon Tile -->
                    <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource BrushCoral}"
                            VerticalAlignment="Center" Margin="0,0,14,0">
                        <Path Data="{StaticResource IconWarningCircle}" Fill="#FFFFFF" Width="20" Height="20" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AttentionBannerSummary}"
                                   FontWeight="SemiBold"
                                   FontSize="{StaticResource FontSizeCardHeader}"
                                   Foreground="{DynamicResource BrushCoral}"/>
                        <TextBlock Text="{Binding AttentionBannerExplanation}"
                                   FontSize="{StaticResource FontSizeSecondary}"
                                   Foreground="{DynamicResource BrushInkMuted}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- View Affected Jobs Action Button -->
                    <Button Grid.Column="2"
                            Content="View affected jobs"
                            Command="{Binding ViewAffectedJobsCommand}"
                            Style="{StaticResource BtnDanger}"
                            Height="34" Padding="14,0"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 3. Four KPI Summary Cards Grid -->
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- KPI 1: Runs Today -->
                <controls:KpiCard Grid.Column="0"
                                  Title="Runs today"
                                  Value="{Binding RunsTodayCount, StringFormat={}{0}}"
                                  NumericValue="{Binding RunsTodayCount}"
                                  SubText="{Binding RunsTodaySubText}"
                                  Icon="{StaticResource IconClock}"
                                  TileBrush="{DynamicResource BrushCobalt}"/>

                <!-- KPI 2: Succeeded -->
                <controls:KpiCard Grid.Column="2"
                                  Title="Succeeded"
                                  Value="{Binding SuccessPercentageDisplay}"
                                  NumericValue="{Binding SuccessfulRunsCount}"
                                  SubText="{Binding SuccessRateDisplay}"
                                  Icon="{StaticResource IconCheckCircle}"
                                  TileBrush="{DynamicResource BrushJade}"/>

                <!-- KPI 3: Needs Attention -->
                <controls:KpiCard Grid.Column="4"
                                  Title="Needs attention"
                                  Value="{Binding AttentionJobsCount, StringFormat={}{0}}"
                                  NumericValue="{Binding AttentionJobsCount}"
                                  SubText="Failed, partial or stale"
                                  Icon="{StaticResource IconWarningCircle}"
                                  TileBrush="{DynamicResource BrushCoral}"/>

                <!-- KPI 4: Uploaded -->
                <controls:KpiCard Grid.Column="6"
                                  Title="Uploaded"
                                  Value="{Binding TotalUploadedDisplay}"
                                  SubText="Data protected to cloud"
                                  Icon="{StaticResource IconCloudArrowUp}"
                                  TileBrush="{DynamicResource BrushOrchid}"/>
            </Grid>

            <!-- 4. Middle Section: Result Mix Donut + Upcoming Backup Activity -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Result Mix Card -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="Backup result mix"
                                   FontWeight="SemiBold"
                                   FontSize="{StaticResource FontSizeCardHeader}"
                                   Foreground="{DynamicResource BrushInk}"/>
                        <TextBlock Text="Run outcome telemetry across all history"
                                   FontSize="{StaticResource FontSizeSecondary}"
                                   Foreground="{DynamicResource BrushInkMuted}"
                                   Margin="0,2,0,16"/>

                        <!-- Donut Graphic Container (160 px) -->
                        <Grid Width="160" Height="160" HorizontalAlignment="Center" Margin="0,4,0,10">
                            <controls:DonutChart SucceededCount="{Binding SuccessfulRunsCount}"
                                                 PartialCount="{Binding PartialRunsCount}"
                                                 FailedCount="{Binding FailedRunsCount}"
                                                 StrokeThickness="14"/>

                            <!-- Center KPI Percentage & Label -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SuccessPercentageDisplay}"
                                           FontWeight="SemiBold"
                                           FontSize="{StaticResource FontSizePageTitle}"
                                           Foreground="{DynamicResource BrushInk}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="success"
                                           FontSize="{StaticResource FontSizeSecondary}"
                                           Foreground="{DynamicResource BrushInkMuted}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Legend & Counts -->
                        <Border BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Succeeded -->
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource BrushJade}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Succeeded" FontWeight="Medium" FontSize="{StaticResource FontSizeStatus}" Foreground="{DynamicResource BrushInkMuted}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SuccessfulRunsCount, StringFormat={}{0}}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushInk}" Margin="13,3,0,0"/>
                                </StackPanel>

                                <!-- Partial -->
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource BrushSaffron}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Partial" FontWeight="Medium" FontSize="{StaticResource FontSizeStatus}" Foreground="{DynamicResource BrushInkMuted}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding PartialRunsCount, StringFormat={}{0}}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushInk}" Margin="13,3,0,0"/>
                                </StackPanel>

                                <!-- Failed -->
                                <StackPanel Grid.Column="2">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource BrushCoral}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Failed" FontWeight="Medium" FontSize="{StaticResource FontSizeStatus}" Foreground="{DynamicResource BrushInkMuted}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding FailedRunsCount, StringFormat={}{0}}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushInk}" Margin="13,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Upcoming Backup Activity Card -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Card Header: Title, Subtitle, and View All Jobs Action Button -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Upcoming backup activity"
                                           FontWeight="SemiBold"
                                           FontSize="{StaticResource FontSizeCardHeader}"
                                           Foreground="{DynamicResource BrushInk}"/>
                                <TextBlock Text="Scheduled routines queue and next execution timeline"
                                           FontSize="{StaticResource FontSizeSecondary}"
                                           Foreground="{DynamicResource BrushInkMuted}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- View All Jobs Action Button -->
                            <Button HorizontalAlignment="Right"
                                    Content="View all jobs →"
                                    Command="{Binding NavigateTabCommand}"
                                    CommandParameter="Backups"
                                    Style="{StaticResource BtnQuiet}"
                                    Height="30" Padding="10,0"/>
                        </Grid>

                        <!-- Structured Custom List / Table (Shown when upcoming jobs exist) -->
                        <Grid Grid.Row="1" Visibility="{Binding HasUpcomingJobs, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Column Headers -->
                            <Border Grid.Row="0" BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,0,0,1" Padding="6,0,6,8" Margin="0,0,0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="110"/> <!-- Job -->
                                        <ColumnDefinition Width="100"/>             <!-- Source -->
                                        <ColumnDefinition Width="90"/>              <!-- Schedule -->
                                        <ColumnDefinition Width="100"/>             <!-- Next Run -->
                                        <ColumnDefinition Width="80"/>              <!-- Status -->
                                        <ColumnDefinition Width="58"/>              <!-- Action -->
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="JOB" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkFaint}"/>
                                    <TextBlock Grid.Column="1" Text="SOURCE" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkFaint}"/>
                                    <TextBlock Grid.Column="2" Text="SCHEDULE" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkFaint}"/>
                                    <TextBlock Grid.Column="3" Text="NEXT RUN" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkFaint}"/>
                                    <TextBlock Grid.Column="4" Text="STATUS" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkFaint}"/>
                                    <TextBlock Grid.Column="5" Text="ACTION" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkFaint}" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <!-- Rows -->
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding UpcomingJobs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:JobCardViewModel}">
                                        <Border BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,0,0,1" Padding="6,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="110"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="58"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Job Name & Kind Chip -->
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name, Mode=OneWay}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="{StaticResource FontSizeBody}"
                                                                   Foreground="{DynamicResource BrushInk}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxWidth="105"/>
                                                        <Border Style="{StaticResource BadgePill}"
                                                                Background="{Binding KindSoftBrush}"
                                                                Margin="5,0,0,0"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding KindChipName}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="10"
                                                                       Foreground="{Binding KindBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Source Path in Mono -->
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding EffectiveSourcePath}"
                                                           FontFamily="{StaticResource FontFamilyMono}"
                                                           FontSize="{StaticResource FontSizeMono}"
                                                           Foreground="{DynamicResource BrushInkMuted}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0"/>

                                                <!-- Schedule -->
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding ScheduleDisplay}"
                                                           FontWeight="Medium"
                                                           FontSize="{StaticResource FontSizeBody}"
                                                           Foreground="{DynamicResource BrushInk}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0"/>

                                                <!-- Next Run -->
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding NextRunDisplay}"
                                                           FontWeight="Medium"
                                                           FontSize="{StaticResource FontSizeBody}"
                                                           Foreground="{DynamicResource BrushInk}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0"/>

                                                <!-- Status Badge -->
                                                <Border Grid.Column="4" Style="{StaticResource BadgePill}"
                                                        Background="{Binding StatusBadgeSoftBrush}"
                                                        Padding="6,3"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="6" Height="6" Fill="{Binding StatusBadgeBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding StatusBadgeText}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="{StaticResource FontSizeBadge}"
                                                                   Foreground="{Binding StatusBadgeBrush}"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Quick Run Action Button -->
                                                <Button Grid.Column="5"
                                                        Command="{Binding DataContext.RunJobCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource BtnQuiet}"
                                                        Width="52" Height="26" Padding="4,0"
                                                        HorizontalAlignment="Right"
                                                        ToolTip="Run this backup job now">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconPlay}" Fill="{DynamicResource BrushInkMuted}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,3,0"/>
                                                        <TextBlock Text="Run" FontSize="{StaticResource FontSizeBadge}" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <!-- Empty State when no upcoming executions exist -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,32,0,24"
                                    Visibility="{Binding HasUpcomingJobs, Converter={StaticResource InverseBoolToVis}}">
                            <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource BrushCobaltSoft}" HorizontalAlignment="Center" Margin="0,0,0,12">
                                <Path Data="{StaticResource IconClock}" Fill="{DynamicResource BrushCobalt}" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="No upcoming scheduled runs" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCardHeader}" Foreground="{DynamicResource BrushInk}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Configure a daily, weekly, or monthly schedule on any backup job to automate execution." FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}" HorizontalAlignment="Center" Margin="0,4,0,16"/>
                            <Button Content="Create backup job" Command="{Binding OpenNewJobCommand}" Style="{StaticResource BtnPrimary}" Height="34" Padding="18,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
