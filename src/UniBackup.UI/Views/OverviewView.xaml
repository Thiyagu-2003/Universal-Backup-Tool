<UserControl x:Class="UniBackup.UI.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:UniBackup.UI.Controls"
             xmlns:vm="clr-namespace:UniBackup.UI.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,24">
        <StackPanel MaxWidth="1280" HorizontalAlignment="Stretch">

            <!-- 1. Failure Banner (Only when a job has failed) -->
            <Border x:Name="FailureBannerCard"
                    Visibility="{Binding HasStaleJobs, Converter={StaticResource BoolToVis}}"
                    Background="{DynamicResource BrushCoralSoft}"
                    BorderBrush="{DynamicResource BrushCoral}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusCard}"
                    Padding="20"
                    Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 36 px Coral Icon Tile -->
                    <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource BrushCoral}"
                            VerticalAlignment="Center" Margin="0,0,16,0">
                        <Path Data="{StaticResource IconWarningCircle}" Fill="#FFFFFF" Width="18" Height="18" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="One or more backup jobs require immediate attention"
                                   FontWeight="SemiBold"
                                   FontSize="{StaticResource FontSizeRowTitle}"
                                   Foreground="{DynamicResource BrushCoral}"/>
                        <TextBlock Text="The last execution encountered an error. The next scheduled run will take a full backup automatically."
                                   FontSize="{StaticResource FontSizeHelp}"
                                   Foreground="{DynamicResource BrushInkMuted}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Open Job Button -->
                    <Button Grid.Column="2"
                            Content="Open jobs"
                            Command="{Binding NavigateTabCommand}"
                            CommandParameter="Backups"
                            Style="{StaticResource BtnDanger}"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 2. Four KPI Cards Grid -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- KPI 1: Runs Today -->
                <controls:KpiCard Grid.Column="0"
                                  Title="Runs today"
                                  Value="{Binding TotalRunsCount, StringFormat={}{0}}"
                                  NumericValue="{Binding TotalRunsCount}"
                                  SubText="Automated &amp; manual"
                                  Icon="{StaticResource IconClock}"
                                  TileBrush="{DynamicResource BrushCobalt}"/>

                <!-- KPI 2: Succeeded (%) -->
                <controls:KpiCard Grid.Column="2"
                                  Title="Succeeded"
                                  Value="{Binding SuccessRateDisplay}"
                                  NumericValue="{Binding SuccessfulRunsCount}"
                                  SubText="Healthy backups verified"
                                  Icon="{StaticResource IconCheck}"
                                  TileBrush="{DynamicResource BrushJade}"/>

                <!-- KPI 3: Needs Attention -->
                <controls:KpiCard Grid.Column="4"
                                  Title="Needs attention"
                                  Value="{Binding NeedsAttentionCount, StringFormat={}{0}}"
                                  NumericValue="{Binding NeedsAttentionCount}"
                                  SubText="Failed or partial runs"
                                  Icon="{StaticResource IconWarningCircle}"
                                  TileBrush="{DynamicResource BrushCoral}"/>

                <!-- KPI 4: Uploaded -->
                <controls:KpiCard Grid.Column="6"
                                  Title="Uploaded"
                                  Value="{Binding TotalUploadedDisplay}"
                                  SubText="Data protected to cloud"
                                  Icon="{StaticResource IconCloudArrowUp}"
                                  TileBrush="{DynamicResource BrushOrchid}"/>
            </Grid>

            <!-- 3. Middle Section: Result Mix Donut + Next Scheduled Runs -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Result Mix Card -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="24">
                    <StackPanel>
                        <TextBlock Text="Result mix"
                                   FontWeight="SemiBold"
                                   FontSize="{StaticResource FontSizeH2}"
                                   Foreground="{DynamicResource BrushInk}"/>
                        <TextBlock Text="Overall run outcome distribution across all jobs"
                                   FontSize="{StaticResource FontSizeHelp}"
                                   Foreground="{DynamicResource BrushInkMuted}"
                                   Margin="0,2,0,20"/>

                        <Grid HorizontalAlignment="Center" Margin="0,10">
                            <!-- Donut graphic (150 px) -->
                            <Ellipse Width="150" Height="150"
                                     Stroke="{DynamicResource BrushSunken}"
                                     StrokeThickness="13"/>
                            <Ellipse Width="150" Height="150"
                                     Stroke="{DynamicResource BrushJade}"
                                     StrokeThickness="13"
                                     StrokeDashArray="36 12"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="-90"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>

                            <!-- Center KPI Percentage -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SuccessPercentageDisplay}"
                                           FontWeight="SemiBold"
                                           FontSize="{StaticResource FontSizeKpi}"
                                           Foreground="{DynamicResource BrushInk}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="success"
                                           FontSize="{StaticResource FontSizeBadge}"
                                           Foreground="{DynamicResource BrushInkMuted}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Legend & Data Protected Total -->
                        <Border BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,16,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Stretch="Uniform" Fill="{DynamicResource BrushJade}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Succeeded" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SuccessfulRunsCount, StringFormat={}{0}}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeRowTitle}" Foreground="{DynamicResource BrushInk}" Margin="14,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Stretch="Uniform" Fill="{DynamicResource BrushSaffron}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Partial" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding PartialRunsCount, StringFormat={}{0}}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeRowTitle}" Foreground="{DynamicResource BrushInk}" Margin="14,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Stretch="Uniform" Fill="{DynamicResource BrushCoral}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Failed" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding FailedRunsCount, StringFormat={}{0}}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeRowTitle}" Foreground="{DynamicResource BrushInk}" Margin="14,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Next Scheduled Runs Card -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Next scheduled runs"
                                           FontWeight="SemiBold"
                                           FontSize="{StaticResource FontSizeH2}"
                                           Foreground="{DynamicResource BrushInk}"/>
                                <TextBlock Text="Upcoming executions from the background service clock"
                                           FontSize="{StaticResource FontSizeHelp}"
                                           Foreground="{DynamicResource BrushInkMuted}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>

                            <Button HorizontalAlignment="Right"
                                    Content="+ Create backup"
                                    Command="{Binding OpenNewJobCommand}"
                                    Style="{StaticResource BtnQuiet}"
                                    Height="32" Padding="12,0"/>
                        </Grid>

                        <!-- Scheduled Rows (Shown when jobs exist) -->
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Jobs}"
                                      Visibility="{Binding HasJobs, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:JobCardViewModel}">
                                    <Border BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,0,0,1" Padding="0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>  <!-- Time -->
                                                <ColumnDefinition Width="*"/>   <!-- Name -->
                                                <ColumnDefinition Width="Auto"/><!-- Kind Chip -->
                                                <ColumnDefinition Width="Auto"/><!-- Run Now -->
                                            </Grid.ColumnDefinitions>

                                            <!-- Scheduled Time in Mono -->
                                            <TextBlock Text="{Binding ScheduleDisplay}"
                                                       FontFamily="{StaticResource FontMono}"
                                                       FontSize="{StaticResource FontSizeMono}"
                                                       Foreground="{DynamicResource BrushInkMuted}"
                                                       VerticalAlignment="Center"/>

                                            <!-- Job Name -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       FontSize="{StaticResource FontSizeRowTitle}"
                                                       Foreground="{DynamicResource BrushInk}"
                                                       VerticalAlignment="Center"
                                                       Margin="12,0"/>

                                            <!-- Kind Chip -->
                                            <Border Grid.Column="2"
                                                    Style="{StaticResource BadgePill}"
                                                    Background="{Binding KindSoftBrush}"
                                                    Margin="0,0,12,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{Binding KindIconGeometry}"
                                                          Fill="{Binding KindBrush}"
                                                          Width="12" Height="12"
                                                          Stretch="Uniform"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding KindChipName}"
                                                               FontWeight="SemiBold"
                                                               FontSize="{StaticResource FontSizeBadge}"
                                                               Foreground="{Binding KindBrush}"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Quick Run Button -->
                                            <Button Grid.Column="3"
                                                    Command="{Binding DataContext.RunJobCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource BtnQuiet}"
                                                    Height="28" Padding="10,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconPlay}" Fill="{DynamicResource BrushInkMuted}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0"/>
                                                    <TextBlock Text="Run" FontSize="{StaticResource FontSizeBadge}"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty State when no jobs are configured -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,32,0,24"
                                    Visibility="{Binding HasNoJobs, Converter={StaticResource BoolToVis}}">
                            <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource BrushCobaltSoft}" HorizontalAlignment="Center" Margin="0,0,0,12">
                                <Path Data="{StaticResource IconClock}" Fill="{DynamicResource BrushCobalt}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="No scheduled backups configured" FontWeight="SemiBold" FontSize="{StaticResource FontSizeRowTitle}" Foreground="{DynamicResource BrushInk}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Automated backup schedules run silently via the Windows background service." FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" HorizontalAlignment="Center" Margin="0,4,0,16"/>
                            <Button Content="Create backup job" Command="{Binding OpenNewJobCommand}" Style="{StaticResource BtnPrimary}" Height="34" Padding="18,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
