<UserControl x:Class="UniBackup.UI.Views.JobWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:UniBackup.UI.Controls"
             xmlns:vm="clr-namespace:UniBackup.UI.ViewModels">
    <Grid Background="{DynamicResource BrushCanvas}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Action Bar -->
            <RowDefinition Height="Auto"/> <!-- 4-cell Step Bar -->
            <RowDefinition Height="*"/>    <!-- Wizard Body -->
            <RowDefinition Height="Auto"/> <!-- Sticky Footer -->
        </Grid.RowDefinitions>

        <!-- 1. Top Action Bar Card -->
        <Border Grid.Row="0" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,0,0,1" Padding="28,16">
            <Grid MaxWidth="1280">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Back button -->
                    <ColumnDefinition Width="Auto"/> <!-- Icon Tile -->
                    <ColumnDefinition Width="*"/>    <!-- Title and Subline -->
                    <ColumnDefinition Width="Auto"/> <!-- Cancel & Save -->
                </Grid.ColumnDefinitions>

                <!-- Back to Jobs quiet button -->
                <Button Command="{Binding CancelCommand}" Style="{StaticResource BtnQuiet}" Height="36" Padding="12,0" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconArrowLeft}" Fill="{DynamicResource BrushInkMuted}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                        <TextBlock Text="Backup jobs" FontSize="{StaticResource FontSizeBadge}"/>
                    </StackPanel>
                </Button>

                <!-- 40 px Cobalt Icon Tile -->
                <Border Grid.Column="1" Width="40" Height="40" CornerRadius="10" Background="{DynamicResource BrushCobaltSoft}" Margin="0,0,16,0">
                    <Path Data="{StaticResource IconCreateJob}" Fill="{DynamicResource BrushCobalt}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Title & Subtitle -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding WizardPageTitle, FallbackValue='Create backup job'}" FontWeight="SemiBold" FontSize="{StaticResource FontSizePageTitle}" Foreground="{DynamicResource BrushInk}"/>
                    <TextBlock Text="Source, schedule, destinations, then retention and encryption" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Cancel & Save Actions -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource BtnQuiet}" Margin="0,0,10,0"/>
                    <Button Content="{Binding SaveButtonText, FallbackValue='Save job'}" Command="{Binding SaveJobCommand}" Style="{StaticResource BtnPrimary}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Step Bar Card (4 equal cells divided by hairlines) -->
        <Border Grid.Row="1" Background="{DynamicResource BrushRaised}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,0,0,1" Padding="28,14">
            <Grid MaxWidth="1280">
                <controls:StepBar CurrentStep="{Binding CurrentStep}" StepSelectedCommand="{Binding SetStepCommand}"/>
            </Grid>
        </Border>

        <!-- 3. Wizard Body (Steps 1, 2, 3, 4) -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,24">
            <StackPanel MaxWidth="1280" HorizontalAlignment="Stretch">

                <!-- Inline Validation Error Banner (§4.3, §12) -->
                <Border Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource BrushCoralSoft}" BorderBrush="{DynamicResource BrushCoral}" BorderThickness="1"
                        CornerRadius="8" Padding="16,12" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Data="{StaticResource IconWarningCircle}" Fill="{DynamicResource BrushCoral}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding ValidationError}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushCoral}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- ================= STEP 1: SOURCE ================= -->
                <StackPanel Visibility="{Binding IsStep1, Converter={StaticResource BoolToVis}}">
                    <!-- Source Selection Card (3 Radio Cards) -->
                    <Border Style="{StaticResource Card}" Padding="24" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Select source type" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSectionHeader}" Foreground="{DynamicResource BrushInk}"/>
                            <TextBlock Text="Choose what this backup job protects" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,16"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Radio Card 1: Folder or file share (Cobalt) -->
                                <RadioButton Grid.Column="0" IsChecked="{Binding IsFolder, Mode=TwoWay}" GroupName="SourceTypeGroup" Cursor="Hand">
                                    <RadioButton.Template>
                                        <ControlTemplate TargetType="{x:Type RadioButton}">
                                            <Border x:Name="bd" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="12" Padding="18,16">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="42" Height="42" CornerRadius="11" Background="{DynamicResource BrushCobaltSoft}" Margin="0,0,14,0" VerticalAlignment="Top">
                                                        <Path Data="{StaticResource IconFolder}" Fill="{DynamicResource BrushCobalt}" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="Folder or file share" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCardHeader}" Foreground="{DynamicResource BrushInk}"/>
                                                        <TextBlock Text="Local directories or UNC network shares with VSS" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BrushCobalt}"/>
                                                    <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushCobaltSoft}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </RadioButton.Template>
                                </RadioButton>

                                <!-- Radio Card 2: IIS Websites (Teal) -->
                                <RadioButton Grid.Column="2" IsChecked="{Binding IsIisSite, Mode=TwoWay}" GroupName="SourceTypeGroup" Cursor="Hand">
                                    <RadioButton.Template>
                                        <ControlTemplate TargetType="{x:Type RadioButton}">
                                            <Border x:Name="bd" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="12" Padding="18,16">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="42" Height="42" CornerRadius="11" Background="{DynamicResource BrushTealSoft}" Margin="0,0,14,0" VerticalAlignment="Top">
                                                        <Path Data="{StaticResource IconIisSites}" Fill="{DynamicResource BrushTeal}" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="IIS websites" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCardHeader}" Foreground="{DynamicResource BrushInk}"/>
                                                        <TextBlock Text="Live websites with bindings, app pools and config export" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BrushTeal}"/>
                                                    <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushTealSoft}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </RadioButton.Template>
                                </RadioButton>

                                <!-- Radio Card 3: SQL Server Databases (Orchid) -->
                                <RadioButton Grid.Column="4" IsChecked="{Binding IsSqlServer, Mode=TwoWay}" GroupName="SourceTypeGroup" Cursor="Hand">
                                    <RadioButton.Template>
                                        <ControlTemplate TargetType="{x:Type RadioButton}">
                                            <Border x:Name="bd" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="12" Padding="18,16">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="42" Height="42" CornerRadius="11" Background="{DynamicResource BrushOrchidSoft}" Margin="0,0,14,0" VerticalAlignment="Top">
                                                        <Path Data="{StaticResource IconSqlServer}" Fill="{DynamicResource BrushOrchid}" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="SQL Server databases" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCardHeader}" Foreground="{DynamicResource BrushInk}"/>
                                                        <TextBlock Text="Full, differential and log backups with restore chains" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BrushOrchid}"/>
                                                    <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushOrchidSoft}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </RadioButton.Template>
                                </RadioButton>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Job Name Card -->
                    <Border Style="{StaticResource Card}" Padding="24" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Job name" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                            <TextBox Text="{Binding JobName, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="e.g. Daily Accounting Backup, Web Assets, Documents"
                                     Style="{StaticResource FieldInput}"
                                     Width="560"
                                     HorizontalAlignment="Left"
                                     Margin="0,6,0,0"/>
                            <TextBlock Text="Used in archive file names, alerts and the history list." FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkFaint}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Source Type Specific Details -->
                    <!-- 1. Folder Settings -->
                    <Border Visibility="{Binding IsFolder, Converter={StaticResource BoolToVis}}" Style="{StaticResource Card}" Padding="24">
                        <StackPanel>
                            <TextBlock Text="Source folder path" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                            <Grid Margin="0,6,0,0" Width="680" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding SourceFolder, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="e.g. C:\inetpub\wwwroot or \\server\share"
                                         Style="{StaticResource FieldInputMono}"/>
                                <Button Grid.Column="2" Content="Browse..." Command="{Binding BrowseFolderCommand}"
                                        Style="{StaticResource BtnQuiet}" Height="38" Padding="18,0"/>
                            </Grid>

                            <TextBlock Text="Subfolder filter (optional)" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,16,0,0"/>
                            <TextBox Text="{Binding Subfolder, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="e.g. App_Data\Uploads, logs\*, *.bak"
                                     Style="{StaticResource FieldInput}"
                                     Width="480"
                                     HorizontalAlignment="Left"
                                     Margin="0,6,0,0"/>

                            <CheckBox Content="Use Volume Shadow Copy (VSS) for open files" IsChecked="{Binding UseVss}" Style="{StaticResource Switch}" Margin="0,20,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 2. IIS Websites Settings (§5) -->
                    <Border Visibility="{Binding IsIisSite, Converter={StaticResource BoolToVis}}" Style="{StaticResource Card}" Padding="24">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Chosen IIS websites" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCardHeader}" Foreground="{DynamicResource BrushInk}"/>
                                    <TextBlock Text="Select live sites to package and protect" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button HorizontalAlignment="Right" Content="Select from IIS" Command="{Binding OpenIisPickerCommand}" Style="{StaticResource BtnPrimary}"/>
                            </Grid>

                            <!-- Chosen Sites List -->
                            <ItemsControl ItemsSource="{Binding SelectedIisSites}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:IisSiteVm}">
                                        <Border BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,8" Background="{DynamicResource BrushRaised}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="30" Height="30" CornerRadius="6" Background="{DynamicResource BrushTealSoft}" Margin="0,0,12,0">
                                                    <Path Data="{StaticResource IconIisSites}" Fill="{DynamicResource BrushTeal}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushInk}"/>
                                                    <TextBlock Text="{Binding Path}" FontFamily="{StaticResource FontFamilyMono}" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushInk}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                                <Button Grid.Column="3" Command="{Binding DataContext.RemoveIisSiteCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding}" Style="{StaticResource IconBtn}" Width="28" Height="28">
                                                    <Path Data="{StaticResource IconClose}" Fill="{DynamicResource BrushInkMuted}" Width="10" Height="10" Stretch="Uniform"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Summary bar -->
                            <Border BorderBrush="{DynamicResource BrushLineStrong}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,10,0,0"
                                    Visibility="{Binding SelectedIisSites.Count, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <TextBlock Text="{Binding IisSummaryDisplay}" FontWeight="Medium" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushInk}" VerticalAlignment="Center"/>
                                    <Border HorizontalAlignment="Right" Style="{StaticResource BadgePill}" Background="{DynamicResource BrushTealSoft}">
                                        <TextBlock Text="One archive per site" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBadge}" Foreground="{DynamicResource BrushTeal}"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 3. SQL Server Settings -->
                    <Border Visibility="{Binding IsSqlServer, Converter={StaticResource BoolToVis}}" Style="{StaticResource Card}" Padding="24">
                        <StackPanel>
                            <TextBlock Text="SQL Server instance" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                            <Grid Margin="0,6,0,0" Width="600" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding SqlServer, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="e.g. localhost, .\SQL2022, 192.168.1.50"
                                         Style="{StaticResource FieldInputMono}"/>
                                <Button Grid.Column="2" Content="Test connection" Command="{Binding TestSqlConnectionCommand}"
                                        Style="{StaticResource BtnQuiet}" Height="38" Padding="16,0"/>
                            </Grid>
                            <TextBlock Text="{Binding SqlConnectionStatus}" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,4,0,16"/>

                            <TextBlock Text="Authentication" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,16">
                                <RadioButton Content="Windows Authentication" IsChecked="{Binding SqlUseWindowsAuth, Mode=TwoWay}" Style="{StaticResource SegmentedItem}" Margin="0,0,12,0"/>
                                <RadioButton Content="SQL Server Authentication" IsChecked="{Binding SqlUseSqlAuth, Mode=TwoWay}" Style="{StaticResource SegmentedItem}"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding SqlUseSqlAuth, Converter={StaticResource BoolToVis}}" Margin="0,0,0,16" Width="420" HorizontalAlignment="Left">
                                <TextBlock Text="Login username" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                <TextBox Text="{Binding SqlUsername, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="e.g. sa"
                                         Style="{StaticResource FieldInput}"
                                         Margin="0,4,0,10"/>
                                <TextBlock Text="Login password" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                <TextBox Text="{Binding SqlPassword, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="Database password"
                                         Style="{StaticResource FieldInput}"
                                         Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Simple Recovery Info Note -->
                            <Border Background="{DynamicResource BrushSunken}" CornerRadius="8" Padding="14,10" Margin="0,8,0,0">
                                <TextBlock Text="Databases in Simple recovery model automatically skip transaction log backups." FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ================= STEP 2: SCHEDULE ================= -->
                <StackPanel Visibility="{Binding IsStep2, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource Card}" Padding="24" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Schedule execution" FontWeight="SemiBold" FontSize="{StaticResource FontSizeH2}" Foreground="{DynamicResource BrushInk}"/>
                            <TextBlock Text="Set automated backup frequencies and start times" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,16"/>

                            <Grid Width="560" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Frequency" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                    <ComboBox SelectedValue="{Binding SelectedFrequency}" SelectedValuePath="Tag" Style="{StaticResource FieldComboBox}" Margin="0,6,0,0">
                                        <ComboBoxItem Content="Daily (every day)" Tag="daily" IsSelected="True"/>
                                        <ComboBoxItem Content="On selected days" Tag="selected_days"/>
                                        <ComboBoxItem Content="Manual execution only" Tag="manual"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Start time" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                    <TextBox Text="{Binding ScheduledTime, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="e.g. 02:00"
                                             Style="{StaticResource FieldInputMono}"
                                             Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Live human-readable schedule summary bar -->
                            <Border BorderBrush="{DynamicResource BrushLineStrong}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,24,0,0" Background="{DynamicResource BrushRaised}">
                                <TextBlock Text="{Binding LiveScheduleSummary}" FontWeight="Medium" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushInk}"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ================= STEP 3: DESTINATIONS ================= -->
                <StackPanel Visibility="{Binding IsStep3, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource Card}" Padding="24" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Storage destinations" FontWeight="SemiBold" FontSize="{StaticResource FontSizeH2}" Foreground="{DynamicResource BrushInk}"/>
                            <TextBlock Text="Select target cloud providers and storage endpoints" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,16"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Column 1 -->
                                <StackPanel Grid.Column="0">
                                    <CheckBox IsChecked="{Binding EnableS3}" Style="{StaticResource Switch}" Margin="0,0,0,14">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="{StaticResource BrandDrawingAwsS3}" Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Amazon S3 &amp; S3-compatible" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <CheckBox IsChecked="{Binding EnableGDrive}" Style="{StaticResource Switch}" Margin="0,0,0,14">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="{StaticResource BrandDrawingGoogleDrive}" Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Google Drive" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <CheckBox Content="Azure Blob Storage" IsChecked="{Binding EnableAzure}" Style="{StaticResource Switch}" Margin="0,0,0,14"/>
                                    <CheckBox Content="OneDrive" IsChecked="{Binding EnableOneDrive}" Style="{StaticResource Switch}" Margin="0,0,0,14"/>
                                    <CheckBox Content="Dropbox" IsChecked="{Binding EnableDropbox}" Style="{StaticResource Switch}"/>
                                </StackPanel>

                                <!-- Column 2 -->
                                <StackPanel Grid.Column="2">
                                    <CheckBox IsChecked="{Binding EnableLocal}" Style="{StaticResource Switch}" Margin="0,0,0,14">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconServer}" Fill="{DynamicResource BrushJade}" Width="20" Height="20" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Local or UNC Network Share" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <CheckBox Content="SFTP (SSH File Transfer)" IsChecked="{Binding EnableSftp}" Style="{StaticResource Switch}" Margin="0,0,0,14"/>
                                    <CheckBox Content="FTP / FTPS" IsChecked="{Binding EnableFtp}" Style="{StaticResource Switch}" Margin="0,0,0,14"/>
                                    <CheckBox Content="WebDAV" IsChecked="{Binding EnableWebDav}" Style="{StaticResource Switch}" Margin="0,0,0,14"/>
                                    <CheckBox Content="Box" IsChecked="{Binding EnableBox}" Style="{StaticResource Switch}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ================= STEP 4: OPTIONS ================= -->
                <StackPanel Visibility="{Binding IsStep4, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource Card}" Padding="24" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Retention &amp; archiving" FontWeight="SemiBold" FontSize="{StaticResource FontSizeH2}" Foreground="{DynamicResource BrushInk}"/>
                            <TextBlock Text="Configure age-based cleanup and long-term GFS policies" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,16"/>

                            <StackPanel Width="260" HorizontalAlignment="Left">
                                <TextBlock Text="Retention days" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                <TextBox Text="{Binding RetentionDays, UpdateSourceTrigger=PropertyChanged, TargetNullValue=0, FallbackValue=30}"
                                         Tag="e.g. 30"
                                         Style="{StaticResource FieldInputMono}"
                                         Margin="0,6,0,16"/>
                            </StackPanel>

                            <CheckBox Content="Enable Grandfather-Father-Son (GFS) long-term archiving" IsChecked="{Binding GfsEnabled}" Style="{StaticResource Switch}"/>
                        </StackPanel>
                    </Border>

                    <!-- Encryption Card -->
                    <Border Style="{StaticResource Card}" Padding="24">
                        <StackPanel>
                            <TextBlock Text="End-to-end encryption" FontWeight="SemiBold" FontSize="{StaticResource FontSizeH2}" Foreground="{DynamicResource BrushInk}"/>
                            <TextBlock Text="AES-256-GCM zero-knowledge encryption before upload" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,16"/>

                            <CheckBox Content="Enable AES-256-GCM encryption" IsChecked="{Binding EncryptionEnabled}" Style="{StaticResource Switch}" Margin="0,0,0,14"/>

                            <StackPanel Visibility="{Binding EncryptionEnabled, Converter={StaticResource BoolToVis}}" Width="440" HorizontalAlignment="Left">
                                <TextBlock Text="Passphrase" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                <TextBox Text="{Binding EncryptionPassphrase, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="Enter secret passphrase"
                                         Style="{StaticResource FieldInput}"
                                         Margin="0,6,0,10"/>

                                <TextBlock Text="Confirm passphrase" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                <TextBox Text="{Binding EncryptionPassphraseConfirm, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="Re-enter passphrase"
                                         Style="{StaticResource FieldInput}"
                                         Margin="0,6,0,6"/>

                                <TextBlock Text="Without the passphrase nobody can restore them, including you." FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushCoral}" FontWeight="Medium"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- 4. Sticky Footer Bar -->
        <Border Grid.Row="3" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,1,0,0" Padding="28,16">
            <Grid MaxWidth="1280">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Cancel Button -->
                <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource BtnQuiet}"/>

                <!-- Navigation Controls: Back & Next / Create -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Back" Command="{Binding PreviousStepCommand}" IsEnabled="{Binding CanGoPrevious}" Style="{StaticResource BtnQuiet}" Margin="0,0,10,0"/>
                    <Button Content="Next" Command="{Binding NextStepCommand}" Style="{StaticResource BtnPrimary}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
