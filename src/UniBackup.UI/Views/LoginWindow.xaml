<Window x:Class="UniBackup.UI.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:UniBackup.UI.ViewModels"
        mc:Ignorable="d"
        Title="UniBackup — Sign In" 
        Width="920" Height="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        FontFamily="{StaticResource MainFont}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <!-- Borderless TextBox for inside composite input containers -->
        <Style x:Key="BorderlessTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="14,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" 
                                      HorizontalScrollBarVisibility="Hidden" 
                                      VerticalScrollBarVisibility="Hidden" 
                                      VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Borderless PasswordBox for inside composite input containers -->
        <Style x:Key="BorderlessPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="14,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" 
                                      HorizontalScrollBarVisibility="Hidden" 
                                      VerticalScrollBarVisibility="Hidden" 
                                      VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border CornerRadius="16" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            Margin="16" MouseLeftButtonDown="DragWindow">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="8" Opacity="0.32" Color="#0B132B" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="1.0*"/>
            </Grid.ColumnDefinitions>

            <!-- ============================================== -->
            <!-- LEFT BRAND PANEL (Obsidian / Indigo Depth)     -->
            <!-- ============================================== -->
            <Border Grid.Column="0" Background="{StaticResource SidebarGradient}" CornerRadius="15,0,0,15" Padding="40">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Brand Header -->
                    <StackPanel Grid.Row="0">
                        <Border Width="50" Height="50" CornerRadius="12" Background="#162244" HorizontalAlignment="Left" Margin="0,0,0,16">
                            <Image Source="pack://application:,,,/UniBackup;component/UniBackup.png" Width="42" Height="42" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <TextBlock Text="UniBackup" FontSize="26" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Enterprise Cloud Backup &amp; Recovery v2.0" FontSize="12.5" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,4,0,10"/>
                        <TextBlock Text="Automated SQL Server and folder backups, compressed with high-throughput streams and uploaded to Amazon S3 &amp; Google Drive."
                                   FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" LineHeight="18"/>
                    </StackPanel>

                    <!-- Feature Chips -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,16,0,16">
                        <!-- Feature 1 -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8" Background="#1E3A8A" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconBackups}" Fill="#60A5FA" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Every folder and database on schedule" FontSize="12.5" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="Automated VSS snapshots for open/locked files" FontSize="11" Foreground="#94A3B8"/>
                            </StackPanel>
                        </Grid>

                        <!-- Feature 2 -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8" Background="#064E3B" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconShield}" Fill="#34D399" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="AES-256-GCM encrypted credentials" FontSize="12.5" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="Never stored in plaintext; protected with DPAPI" FontSize="11" Foreground="#94A3B8"/>
                            </StackPanel>
                        </Grid>

                        <!-- Feature 3 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8" Background="#4A044E" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconLogs}" Fill="#F472B6" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Multi-channel alerts &amp; logs" FontSize="12.5" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="Instant email reports and webhook audit logs" FontSize="11" Foreground="#94A3B8"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Footer Tag -->
                    <TextBlock Grid.Row="2" Text="UNIPRO TECH SOLUTIONS · ENTERPRISE" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                </Grid>
            </Border>

            <!-- ============================================== -->
            <!-- RIGHT SIGN-IN FORM PANEL                       -->
            <!-- ============================================== -->
            <Border Grid.Column="1" Background="#F8FAFC" CornerRadius="0,15,15,0" Padding="32">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Bar: Status Pill & Close Button -->
                    <Grid Grid.Row="0">
                        <Border Background="{StaticResource BrandTintTealSoft}" CornerRadius="10" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,6,0" VerticalAlignment="Center"
                                         Style="{StaticResource PulsingIndicator}"/>
                                <TextBlock Text="Engine Ready" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrandTintTealDeep}"/>
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource SecondaryButton}" Width="28" Height="28" Padding="0" 
                                HorizontalAlignment="Right" VerticalAlignment="Center" Click="CloseWindow" ToolTip="Exit Application">
                            <Path Data="{StaticResource IconClose}" Fill="{StaticResource TextSecondaryBrush}" Width="13" Height="13" Stretch="Uniform"/>
                        </Button>
                    </Grid>

                    <!-- Centered Sign-In Card -->
                    <Border Grid.Row="1" Style="{StaticResource ModernCard}" VerticalAlignment="Center" Padding="28">
                        <StackPanel>
                            <TextBlock Text="Sign in" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Enter the administrator access password to continue." FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,20"/>

                            <TextBlock Text="Access Password" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <Border x:Name="PasswordInputContainer" Height="44" Background="White" 
                                    BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="8"
                                    SnapsToDevicePixels="True" MouseLeftButtonDown="PasswordInputContainer_MouseLeftButtonDown">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFocused, ElementName=PasswordInput}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsFocused, ElementName=PasswordVisibleInput}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Masked PasswordBox -->
                                    <PasswordBox x:Name="PasswordInput" Grid.Column="0"
                                                 Style="{StaticResource BorderlessPasswordBox}"
                                                 PasswordChar="●" KeyDown="PasswordKeyDown" PasswordChanged="PasswordInput_PasswordChanged"
                                                 Visibility="Visible"/>

                                    <!-- Plaintext Visible TextBox -->
                                    <TextBox x:Name="PasswordVisibleInput" Grid.Column="0"
                                             Style="{StaticResource BorderlessTextBox}"
                                             KeyDown="PasswordKeyDown" TextChanged="PasswordVisibleInput_TextChanged"
                                             Visibility="Collapsed"/>

                                    <!-- Eye Toggle Button -->
                                    <Button x:Name="ToggleEyeBtn" Grid.Column="1" Width="36" Height="36" 
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Margin="0,0,4,0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Focusable="False"
                                            Click="ToggleEye_Click" ToolTip="Show/Hide Password">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="EyeBd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="6">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="EyeBd" Property="Background" Value="#F1F5F9"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="EyeBd" Property="Background" Value="#E2E8F0"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Path x:Name="EyeIconPath" Data="{StaticResource IconEye}" Fill="{StaticResource TextSecondaryBrush}"
                                              Width="22" Height="22" Stretch="Uniform"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Error Message Display -->
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"/>

                            <!-- Sign In Button -->
                            <Button Style="{StaticResource PrimaryButton}" Height="42" Margin="0,16,0,0" Click="SignIn_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="Sign In" FontWeight="Bold" FontSize="14" Margin="0,0,8,0"/>
                                    <Path Data="{StaticResource IconChevronRight}" Fill="White" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Footer Info -->
                    <TextBlock Grid.Row="2" HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource TextMutedBrush}">
                        <Run Text="UniBackup"/>
                        <Run Text=" · "/>
                        <Run Text="Uniprotech"/>
                        <Run Text=" · "/>
                        <Run Text="v2.0"/>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
