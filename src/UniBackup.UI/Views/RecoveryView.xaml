<UserControl x:Class="UniBackup.UI.Views.RecoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:UniBackup.UI.Controls"
             xmlns:vm="clr-namespace:UniBackup.UI.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,24">
        <StackPanel MaxWidth="1280" HorizontalAlignment="Stretch">

            <!-- 1. Header & Segmented Pill Group (SQL point in time · Files and sites · Restore drills) -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Cloud Recovery" FontWeight="SemiBold" FontSize="{StaticResource FontSizePageTitle}" Foreground="{DynamicResource BrushInk}"/>
                    <TextBlock Text="Granular point-in-time database recovery, site restoration, and automated drills" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Three Tabs Pill Group -->
                <Border Grid.Column="1" Style="{StaticResource SegmentedContainer}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="SQL point in time" Style="{StaticResource SegmentedItem}" IsChecked="True" Checked="RecoveryTab_Checked" Tag="SqlServer"/>
                        <RadioButton Content="Files and sites" Style="{StaticResource SegmentedItem}" Checked="RecoveryTab_Checked" Tag="FilesAndSites"/>
                        <RadioButton Content="Restore drills" Style="{StaticResource SegmentedItem}" Checked="RecoveryTab_Checked" Tag="Drills"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ================= TAB 1: SQL POINT IN TIME ================= -->
            <StackPanel x:Name="SqlRecoveryPanel" Visibility="Visible">
                <!-- Top Controls: Database, Target second readout, Latest button -->
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="Database" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}"/>
                                <TextBox Text="{Binding SqlRestoreDatabase, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInputMono}" Width="240" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Target second readout (Cobalt-tinted, Mono 24/600) -->
                            <StackPanel>
                                <TextBlock Text="Target recovery second" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}"/>
                                <Border Background="{DynamicResource BrushCobaltSoft}" CornerRadius="8" Padding="14,6" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding SqlPointInTimeDisplay, FallbackValue='2026-11-23 09:42:15 UTC'}"
                                               FontFamily="{StaticResource FontFamilyMono}"
                                               FontWeight="SemiBold"
                                               FontSize="20"
                                               Foreground="{DynamicResource BrushCobalt}"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Latest Button -->
                        <Button Grid.Column="1" Command="{Binding SetLatestRecoveryPointCommand}" Style="{StaticResource BtnQuiet}" Height="36" VerticalAlignment="Bottom">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconClock}" Fill="{DynamicResource BrushCobalt}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Latest point"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Three Lanes Scrubber Timeline (Full / Diff / Log over 48h) -->
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Restore timeline (drag thumb or use arrow keys: ±1 min, Shift: ±1 hr)"
                                       FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                            <TextBlock Text="48-hour range with 6-hour gridlines" HorizontalAlignment="Right" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkFaint}"/>
                        </Grid>
                        <controls:TimelineLanes x:Name="TimelineControl" Height="110"/>
                    </StackPanel>
                </Border>

                <!-- Restored Files Sequence Table & Restore Parameters -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="380"/>
                    </Grid.ColumnDefinitions>

                    <!-- Exact Files SQL Server Will Restore -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Restore chain sequence" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSectionHeader}" Foreground="{DynamicResource BrushInk}"/>
                            <TextBlock Text="The exact files SQL Server will restore to reach the chosen target second" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,14"/>

                            <!-- Simulated / Planned Restore Sequence -->
                            <Border BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,0,0,1" Padding="0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="1" FontWeight="SemiBold" Foreground="{DynamicResource BrushInkMuted}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="SRV-DB01_WideWorldImporters_FULL_20261122_010000.bak" FontFamily="{StaticResource FontFamilyMono}" FontSize="{StaticResource FontSizeMono}" Foreground="{DynamicResource BrushInk}"/>
                                        <TextBlock Text="Base full backup from cloud" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkFaint}"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource BadgePill}" Background="{DynamicResource BrushCobaltSoft}" HorizontalAlignment="Left">
                                        <TextBlock Text="FULL" FontWeight="Medium" FontSize="{StaticResource FontSizeStatus}" Foreground="{DynamicResource BrushCobalt}"/>
                                    </Border>
                                    <TextBlock Grid.Column="3" Text="1.84 GB" FontFamily="{StaticResource FontFamilyMono}" FontSize="{StaticResource FontSizeMono}" Foreground="{DynamicResource BrushInkMuted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,0,0,1" Padding="0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="2" FontWeight="SemiBold" Foreground="{DynamicResource BrushInkMuted}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="SRV-DB01_WideWorldImporters_DIFF_20261123_080000.bak" FontFamily="{StaticResource FontFamilyMono}" FontSize="{StaticResource FontSizeMono}" Foreground="{DynamicResource BrushInk}"/>
                                        <TextBlock Text="Differential base rollup" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkFaint}"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource BadgePill}" Background="{DynamicResource BrushCobaltSoft}" HorizontalAlignment="Left">
                                        <TextBlock Text="DIFF" FontWeight="Medium" FontSize="{StaticResource FontSizeStatus}" Foreground="{DynamicResource BrushSky}"/>
                                    </Border>
                                    <TextBlock Grid.Column="3" Text="242 MB" FontFamily="{StaticResource FontFamilyMono}" FontSize="{StaticResource FontSizeMono}" Foreground="{DynamicResource BrushInkMuted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- STOPAT Row -->
                            <Border Background="{DynamicResource BrushCobaltSoft}" CornerRadius="8" Padding="12,10" Margin="0,12,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="22" Height="22" Margin="0,0,10,0">
                                        <Ellipse Fill="{DynamicResource BrushCobalt}"/>
                                        <TextBlock Text="3" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBadge}" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="Stop at target second and bring the database online — STOPAT RECOVERY"
                                               FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushCobalt}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Restore Parameters Panel -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Target parameters" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSectionHeader}" Foreground="{DynamicResource BrushInk}"/>
                            <TextBlock Text="Specify target SQL Server instance and database name" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,14"/>

                            <TextBlock Text="Target instance" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}"/>
                            <TextBox Text="{Binding SqlTargetServer, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="e.g. localhost, .\SQL2022"
                                     Style="{StaticResource FieldInputMono}" Margin="0,4,0,12"/>

                            <TextBlock Text="Restore as (blank = overwrite existing)" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}"/>
                            <TextBox Text="{Binding SqlRestoreAsName, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="e.g. WideWorldImporters_Restored"
                                     Style="{StaticResource FieldInputMono}" Margin="0,4,0,12"/>

                            <TextBlock Text="Passphrase (if encrypted)" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}"/>
                            <TextBox Text="{Binding SqlRestorePassphrase, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Passphrase for decryption (if set)"
                                     Style="{StaticResource FieldInput}" Margin="0,4,0,20"/>

                            <Button Command="{Binding ExecuteSqlCloudRestoreCommand}" Style="{StaticResource BtnPrimary}" Height="38">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconCloudArrowDown}" Fill="#FFFFFF" Width="20" Height="20" Stretch="Uniform" Margin="0,0,8,0"/>
                                    <TextBlock Text="Execute database restore"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- ================= TAB 2: FILES AND SITES ================= -->
            <StackPanel x:Name="FilesRecoveryPanel" Visibility="Collapsed">
                <Border Style="{StaticResource Card}" Padding="24">
                    <StackPanel>
                        <TextBlock Text="Cloud archives" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSectionHeader}" Foreground="{DynamicResource BrushInk}"/>
                        <TextBlock Text="Select an archive from cloud storage and extract to disk" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,16"/>

                        <!-- Archives Table -->
                        <ListBox ItemsSource="{Binding CloudArchives}"
                                 SelectedItem="{Binding SelectedArchive, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="{x:Type ListBoxItem}">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                <Border x:Name="Bd"
                                                        BorderBrush="{DynamicResource BrushLine}"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Background="{DynamicResource BrushPanel}"
                                                        Padding="14,10"
                                                        SnapsToDevicePixels="True">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushCobalt}"/>
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushCobaltSoft}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushCobalt}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="150"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Data="{StaticResource IconCloudArrowDown}" Fill="{DynamicResource BrushCobalt}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontFamily="{StaticResource FontFamilyMono}" FontSize="{StaticResource FontSizeMono}" Foreground="{DynamicResource BrushInk}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushInkMuted}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding UploadedTimeDisplay}" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkFaint}" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Destination Folder & Conflict Policy -->
                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding RestoreDestinationPath, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="e.g. C:\UniBackup\Restore"
                                     Style="{StaticResource FieldInputMono}"/>
                            <Button Grid.Column="2" Content="Browse..." Command="{Binding BrowseRestoreDestinationCommand}"
                                    Style="{StaticResource BtnQuiet}" Height="38" Padding="18,0"/>
                            <Button Grid.Column="4" Command="{Binding ExecuteRestoreCommand}"
                                    Style="{StaticResource BtnPrimary}" Height="38" Padding="18,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconCloudArrowDown}" Fill="#FFFFFF" Width="19" Height="19" Stretch="Uniform" Margin="0,0,8,0"/>
                                    <TextBlock Text="Extract archive"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ================= TAB 3: RESTORE DRILLS ================= -->
            <StackPanel x:Name="DrillsRecoveryPanel" Visibility="Collapsed">
                <Border Style="{StaticResource Card}" Padding="24">
                    <StackPanel>
                        <TextBlock Text="Automated restore drills" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSectionHeader}" Foreground="{DynamicResource BrushInk}"/>
                        <TextBlock Text="Measure sandbox recovery time and verify database consistency with DBCC CHECKDB" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,20"/>

                        <!-- Drill Result Card -->
                        <Border Background="{DynamicResource BrushRaised}" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Measured recovery time" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}"/>
                                    <TextBlock Text="42.8 seconds" FontWeight="SemiBold" FontSize="20" Foreground="{DynamicResource BrushJade}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="CHECKDB outcome" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}"/>
                                    <TextBlock Text="0 errors (100% consistent)" FontWeight="SemiBold" FontSize="20" Foreground="{DynamicResource BrushJade}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Scratch database name" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}"/>
                                    <TextBlock Text="ub_drill_WideWorldImporters" FontFamily="{StaticResource FontFamilyMono}" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource BrushInk}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Button Command="{Binding ExecuteRestoreDrillCommand}" Style="{StaticResource BtnPrimary}" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPlay}" Fill="#FFFFFF" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock Text="Run automated drill now"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
