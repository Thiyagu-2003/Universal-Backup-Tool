<UserControl x:Class="UniBackup.UI.Views.RecoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:UniBackup.UI.Controls"
             xmlns:conv="clr-namespace:UniBackup.UI.Converters"
             xmlns:vm="clr-namespace:UniBackup.UI.ViewModels">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
        <conv:StringEqualsToBoolConverter x:Key="StringEqualsToBool"/>
        <conv:InvertedZeroToVisibilityConverter x:Key="InvertedZeroToVis"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,24">
        <StackPanel MaxWidth="1280" HorizontalAlignment="Stretch">

            <!-- ===================================================================
                 1. HEADER & NAVIGATION SEGMENTED PILLS (§1, §2)
                 =================================================================== -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Cloud Recovery" FontWeight="SemiBold" FontSize="{StaticResource FontSizePageTitle}" Foreground="{DynamicResource BrushInk}"/>
                    <TextBlock Text="Discover, browse, verify and restore backup data from configured cloud storage destinations" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Five Tabs Pill Group -->
                <Border Grid.Column="1" Style="{StaticResource SegmentedContainer}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Dashboard" Style="{StaticResource SegmentedItem}" IsChecked="{Binding IsDashboardTab, Mode=OneWay}" Click="Tab_Click" Tag="Dashboard"/>
                        <RadioButton Content="SQL point in time" Style="{StaticResource SegmentedItem}" IsChecked="{Binding IsSqlServerTab, Mode=OneWay}" Click="Tab_Click" Tag="SqlServer"/>
                        <RadioButton Content="Files and sites" Style="{StaticResource SegmentedItem}" IsChecked="{Binding IsFilesTab, Mode=OneWay}" Click="Tab_Click" Tag="FilesAndSites"/>
                        <RadioButton Content="Restore drills" Style="{StaticResource SegmentedItem}" IsChecked="{Binding IsDrillsTab, Mode=OneWay}" Click="Tab_Click" Tag="Drills"/>
                        <RadioButton Content="History" Style="{StaticResource SegmentedItem}" IsChecked="{Binding IsHistoryTab, Mode=OneWay}" Click="Tab_Click" Tag="History"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===================================================================
                 TAB 1: MAIN CLOUD RECOVERY DASHBOARD (§1)
                 =================================================================== -->
            <StackPanel Visibility="{Binding IsDashboardTab, Converter={StaticResource BoolToVis}}">
                <!-- Top 4 Recovery Summary KPI Cards -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- KPI 1: Configured Cloud Sources -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="Configured Sources" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}"/>
                            <TextBlock Text="{Binding ConfiguredSources.Count}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeKpi}" Foreground="{DynamicResource BrushInk}" Margin="0,4,0,2"/>
                            <TextBlock Text="Active storage destinations" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkFaint}"/>
                        </StackPanel>
                    </Border>

                    <!-- KPI 2: Total Recovery Points -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="Available Recovery Points" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}"/>
                            <TextBlock Text="{Binding TotalRecoveryPoints}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeKpi}" Foreground="{DynamicResource BrushCobalt}" Margin="0,4,0,2"/>
                            <TextBlock Text="Discovered in cloud repositories" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkFaint}"/>
                        </StackPanel>
                    </Border>

                    <!-- KPI 3: Total Recoverable Data -->
                    <Border Grid.Column="4" Style="{StaticResource Card}" Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="Total Recoverable Data" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}"/>
                            <TextBlock Text="{Binding TotalRecoverableDataDisplay}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeKpi}" Foreground="{DynamicResource BrushJade}" Margin="0,4,0,2"/>
                            <TextBlock Text="Available for immediate restore" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkFaint}"/>
                        </StackPanel>
                    </Border>

                    <!-- KPI 4: Recovery Health Status -->
                    <Border Grid.Column="6" Style="{StaticResource Card}" Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="Recovery Health" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}"/>
                            <TextBlock Text="{Binding RecoveryHealthStatus}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeKpi}" Foreground="{DynamicResource BrushTeal}" Margin="0,4,0,2"/>
                            <TextBlock Text="{Binding LatestBackupDisplay}" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkFaint}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Cloud Storage Sources List -->
                <Border Style="{StaticResource Card}" Padding="20">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Cloud Storage Destinations" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSectionHeader}" Foreground="{DynamicResource BrushInk}"/>
                                <TextBlock Text="Real configured repositories discovered from your configuration settings" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Command="{Binding RefreshDashboardCommand}" Style="{StaticResource BtnQuiet}" Height="34">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconRefresh}" Fill="{DynamicResource BrushCobalt}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock Text="Refresh sources"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Sources Items -->
                        <ItemsControl ItemsSource="{Binding ConfiguredSources}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="10" Background="{DynamicResource BrushRaised}" Padding="18,14" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/> <!-- Provider Icon Tile -->
                                                <ColumnDefinition Width="*"/>    <!-- Source Name & Bucket -->
                                                <ColumnDefinition Width="140"/>  <!-- Backups & Size -->
                                                <ColumnDefinition Width="150"/>  <!-- Status & Latency -->
                                                <ColumnDefinition Width="Auto"/> <!-- Actions -->
                                            </Grid.ColumnDefinitions>

                                            <!-- Provider Icon Tile -->
                                            <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource BrushCobaltSoft}" VerticalAlignment="Center" Margin="0,0,14,0">
                                                <Path Data="{StaticResource IconCloudArrowDown}" Fill="{DynamicResource BrushCobalt}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Source Details -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeRowTitle}" Foreground="{DynamicResource BrushInk}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="Repository: " FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}"/>
                                                    <TextBlock Text="{Binding BucketOrPath}" FontFamily="{StaticResource FontFamilyMono}" FontSize="{StaticResource FontSizeMono}" Foreground="{DynamicResource BrushInkMuted}"/>
                                                    <TextBlock Text="  •  Region: " FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}"/>
                                                    <TextBlock Text="{Binding RegionOrEndpoint}" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkFaint}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Backups & Size -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TotalDataDisplay}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushInk}"/>
                                                <TextBlock Text="{Binding BackupCount, StringFormat='{}{0} backups stored'}" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}"/>
                                            </StackPanel>

                                            <!-- Status & Latency -->
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                <Border Style="{StaticResource BadgePill}" Background="{Binding StatusSoftBrush}" HorizontalAlignment="Left" Padding="8,2">
                                                    <TextBlock Text="{Binding Status}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}" Foreground="{Binding StatusBrush}"/>
                                                </Border>
                                                <TextBlock Text="{Binding LatencyDisplay, StringFormat='{}Latency: {0}'}" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkFaint}" Margin="0,3,0,0"/>
                                            </StackPanel>

                                            <!-- Actions -->
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Validate" Command="{Binding DataContext.ValidateSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource BtnQuiet}" Height="32" Margin="0,0,8,0"/>
                                                <Button Content="Browse backups" Command="{Binding DataContext.BrowseSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource BtnQuiet}" Height="32"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty State if no sources configured -->
                        <Border Visibility="{Binding ConfiguredSources.Count, Converter={StaticResource InvertedZeroToVis}}" Background="{DynamicResource BrushSunken}" CornerRadius="10" Padding="32" HorizontalAlignment="Stretch">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="No cloud storage destinations currently configured or enabled." FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushInkMuted}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Please configure AWS S3, Azure Blob, Google Drive, or Local Storage in Settings &amp; Engine." FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkFaint}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===================================================================
                 TAB 2: SQL POINT IN TIME RECOVERY (§3)
                 =================================================================== -->
            <StackPanel Visibility="{Binding IsSqlServerTab, Converter={StaticResource BoolToVis}}">
                <!-- Source & Database Discovery Row -->
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Cloud Source Selector -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Cloud Storage Source" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}"/>
                            <ComboBox ItemsSource="{Binding SqlSources}" SelectedItem="{Binding SelectedSqlSource, Mode=TwoWay}" DisplayMemberPath="DisplayName" Height="36" Margin="0,6,0,0"/>
                        </StackPanel>

                        <!-- Discovered Databases -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Discovered SQL Databases" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}"/>
                            <ListBox ItemsSource="{Binding DiscoveredDatabases}" SelectedItem="{Binding SelectedDatabase, Mode=TwoWay}" Height="78" Background="Transparent" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" Margin="0,6,0,0" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource BrushPanel}" Padding="14,8" Margin="0,0,8,0" MinWidth="180">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushInk}"/>
                                                <TextBlock Text="{Binding TotalBackups, StringFormat='{}{0} backups in cloud'}" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushCobalt}" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding RangeDisplay}" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkFaint}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Interactive Timeline Control -->
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Target recovery second: " FontWeight="SemiBold" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}"/>
                                <Border Background="{DynamicResource BrushCobaltSoft}" CornerRadius="6" Padding="10,3" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding SqlPointInTimeDisplay}" FontFamily="{StaticResource FontFamilyMono}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushCobalt}"/>
                                </Border>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Command="{Binding SetLatestRecoveryPointCommand}" Style="{StaticResource BtnQuiet}" Height="32">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconClock}" Fill="{DynamicResource BrushCobalt}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock Text="Latest point"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <!-- Interactive 3-Lane Scrubber -->
                        <controls:TimelineLanes x:Name="TimelineControl" Height="110" Backups="{Binding TimelineBackups}" SelectedTime="{Binding SelectedRecoveryTime, Mode=TwoWay}"/>
                    </StackPanel>
                </Border>

                <!-- Restore Chain Sequence & Target Parameters -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="400"/>
                    </Grid.ColumnDefinitions>

                    <!-- Restore Chain Sequence Table -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Restore Chain Sequence" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSectionHeader}" Foreground="{DynamicResource BrushInk}"/>
                            <TextBlock Text="{Binding ChainValidationMessage}" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,14"/>

                            <!-- Sequence Items -->
                            <ItemsControl ItemsSource="{Binding PlannedSequence}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,0,0,1" Padding="0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="85"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding StepNumber}" FontWeight="SemiBold" Foreground="{DynamicResource BrushInkMuted}" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FileName}" FontFamily="{StaticResource FontFamilyMono}" FontSize="{StaticResource FontSizeMono}" Foreground="{DynamicResource BrushInk}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkMuted}"/>
                                                </StackPanel>
                                                <Border Grid.Column="2" Style="{StaticResource BadgePill}" Background="{Binding TypeSoftBrush}" HorizontalAlignment="Left" Padding="6,2">
                                                    <TextBlock Text="{Binding Type}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}" Foreground="{Binding TypeBrush}"/>
                                                </Border>
                                                <TextBlock Grid.Column="3" Text="{Binding SizeDisplay}" FontFamily="{StaticResource FontFamilyMono}" FontSize="{StaticResource FontSizeMono}" Foreground="{DynamicResource BrushInkMuted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Target Database Parameters -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Target Parameters" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSectionHeader}" Foreground="{DynamicResource BrushInk}"/>
                            <TextBlock Text="Configure destination SQL Server instance and database" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,14"/>

                            <TextBlock Text="Target SQL Server instance" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}"/>
                            <TextBox Text="{Binding TargetServer, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInputMono}" Margin="0,4,0,12"/>

                            <TextBlock Text="Target database name" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}"/>
                            <TextBox Text="{Binding TargetDatabaseName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInputMono}" Margin="0,4,0,12"/>

                            <!-- Overwrite Existing CheckBox with Alert -->
                            <CheckBox IsChecked="{Binding IsOverwriteExisting, Mode=TwoWay}" Margin="0,4,0,14">
                                <TextBlock Text="Overwrite existing database (REPLACE)" Foreground="{DynamicResource BrushCoral}" FontWeight="Medium"/>
                            </CheckBox>

                            <TextBlock Text="Decryption Passphrase (if encrypted)" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}"/>
                            <TextBox Text="{Binding SqlPassphrase, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInput}" Margin="0,4,0,20"/>

                            <!-- Execute Restore Button -->
                            <Button Command="{Binding ExecuteSqlRestoreCommand}" IsEnabled="{Binding HasValidChain}" Style="{StaticResource BtnPrimary}" Height="40">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconCloudArrowDown}" Fill="#FFFFFF" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0"/>
                                    <TextBlock Text="Execute database restore" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <!-- Live Progress Box when active -->
                            <Border Visibility="{Binding IsSqlRestoring, Converter={StaticResource BoolToVis}}" Background="{DynamicResource BrushRaised}" CornerRadius="8" Padding="14" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding SqlRestorePhase}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushCobalt}"/>
                                    <ProgressBar Value="{Binding SqlRestoreProgress}" Maximum="100" Height="8" Margin="0,8,0,6"/>
                                    <TextBlock Text="{Binding SqlRestoreMessage}" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkMuted}" TextTrimming="CharacterEllipsis"/>
                                    <Button Content="Cancel" Command="{Binding CancelSqlRestoreCommand}" Style="{StaticResource BtnQuiet}" Height="28" Margin="0,8,0,0" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- ===================================================================
                 TAB 3: FILES AND IIS SITES RECOVERY (§4)
                 =================================================================== -->
            <StackPanel Visibility="{Binding IsFilesTab, Converter={StaticResource BoolToVis}}">
                <!-- Archive Selection & IIS Detection Banner -->
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Cloud Storage Source" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}"/>
                                <ComboBox ItemsSource="{Binding FileSources}" SelectedItem="{Binding SelectedFileSource, Mode=TwoWay}" DisplayMemberPath="DisplayName" Height="36" Margin="0,6,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Select Backup Archive" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}"/>
                                <ComboBox ItemsSource="{Binding AvailableArchives}" SelectedItem="{Binding SelectedArchive, Mode=TwoWay}" DisplayMemberPath="DisplayName" Height="36" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- IIS Site Detected Banner -->
                        <Border Visibility="{Binding IsIisSite, Converter={StaticResource BoolToVis}}" Background="{DynamicResource BrushTealSoft}" BorderBrush="{DynamicResource BrushTeal}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,6,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Data="{StaticResource IconCheckCircle}" Fill="{DynamicResource BrushTeal}" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="IIS Website Backup Detected" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTeal}"/>
                                    <TextBlock Text="{Binding IisDetectedName, StringFormat='{}Site Name: {0}'}" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInk}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- In-Archive File Explorer -->
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <!-- Explorer Toolbar -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Archive Contents Explorer" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSectionHeader}" Foreground="{DynamicResource BrushInk}"/>
                                <TextBlock Text="{Binding ArchiveExplorerNodes.Count, StringFormat='{} ({0} files)'}" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Select all" Command="{Binding SelectAllArchiveFilesCommand}" Style="{StaticResource BtnQuiet}" Height="30" Margin="0,0,6,0"/>
                                <Button Content="Clear selection" Command="{Binding ClearSelectedArchiveFilesCommand}" Style="{StaticResource BtnQuiet}" Height="30"/>
                            </StackPanel>
                        </Grid>

                        <!-- File Explorer Items List -->
                        <DataGrid ItemsSource="{Binding ArchiveExplorerNodes}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" Height="260" Background="Transparent" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" RowHeight="32">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="40"/>
                                <DataGridTextColumn Header="File / Folder Name" Binding="{Binding Name}" Width="280"/>
                                <DataGridTextColumn Header="Relative Path" Binding="{Binding RelativePath}" Width="*"/>
                                <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="100"/>
                                <DataGridTextColumn Header="Date Modified" Binding="{Binding DateDisplay}" Width="140"/>
                                <DataGridTemplateColumn Header="Action" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Preview" Command="{Binding DataContext.PreviewSelectedFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource BtnQuiet}" Height="24" Padding="6,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Destination & Restore Safety Options -->
                <Border Style="{StaticResource Card}" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Destination Directory & Conflict Mode -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Extraction Destination" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSectionHeader}" Foreground="{DynamicResource BrushInk}"/>
                            <Grid Margin="0,8,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding CustomDestinationPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInputMono}"/>
                                <Button Grid.Column="2" Content="Browse..." Command="{Binding BrowseRestoreDestinationCommand}" Style="{StaticResource BtnQuiet}" Height="36" Padding="14,0"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Conflict Policy: " FontWeight="Medium" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}" VerticalAlignment="Center"/>
                                <RadioButton Content="Safe (Restore_timestamp)" IsChecked="{Binding WriteMode, Converter={StaticResource StringEqualsToBool}, ConverterParameter=safe}" Margin="12,0,12,0" VerticalAlignment="Center"/>
                                <RadioButton Content="Overwrite existing" IsChecked="{Binding WriteMode, Converter={StaticResource StringEqualsToBool}, ConverterParameter=overwrite}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <RadioButton Content="Skip existing" IsChecked="{Binding WriteMode, Converter={StaticResource StringEqualsToBool}, ConverterParameter=skip}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Right: Action Button & Progress -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom" MinWidth="220">
                            <Button Command="{Binding ExecuteFileRestoreCommand}" Style="{StaticResource BtnPrimary}" Height="40">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconCloudArrowDown}" Fill="#FFFFFF" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0"/>
                                    <TextBlock Text="Extract selected files" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <!-- Live Progress Box -->
                            <Border Visibility="{Binding IsFileRestoring, Converter={StaticResource BoolToVis}}" Background="{DynamicResource BrushRaised}" CornerRadius="8" Padding="10" Margin="0,10,0,0">
                                <StackPanel>
                                    <ProgressBar Value="{Binding FileRestoreProgress}" Maximum="100" Height="6"/>
                                    <TextBlock Text="{Binding FileRestoreMessage}" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkMuted}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ===================================================================
                 TAB 4: RESTORE DRILLS (§5)
                 =================================================================== -->
            <StackPanel Visibility="{Binding IsDrillsTab, Converter={StaticResource BoolToVis}}">
                <!-- Drill KPI Outcome Row -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Recovery Time (RTO) -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Measured Recovery Time (RTO)" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}"/>
                            <TextBlock Text="{Binding DrillLastRtoDisplay}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeKpi}" Foreground="{DynamicResource BrushJade}" Margin="0,6,0,2"/>
                            <TextBlock Text="Automated download and restore time" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkFaint}"/>
                        </StackPanel>
                    </Border>

                    <!-- Consistency (DBCC CHECKDB) -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Database Consistency" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}"/>
                            <TextBlock Text="{Binding DrillLastOutcomeDisplay}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSectionHeader}" Foreground="{DynamicResource BrushTeal}" Margin="0,6,0,2" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Verified with DBCC CHECKDB in sandbox" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkFaint}"/>
                        </StackPanel>
                    </Border>

                    <!-- Scratch Database -->
                    <Border Grid.Column="4" Style="{StaticResource Card}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Isolated Scratch Database" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}"/>
                            <TextBlock Text="{Binding ScratchDatabaseName}" FontFamily="{StaticResource FontFamilyMono}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeRowTitle}" Foreground="{DynamicResource BrushInk}" Margin="0,8,0,2"/>
                            <TextBlock Text="Safely dropped immediately after drill" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkFaint}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Drill Execution Controls -->
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Run Automated Restore Drill" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSectionHeader}" Foreground="{DynamicResource BrushInk}"/>
                        <TextBlock Text="Restores the latest backup chain into an isolated scratch database to verify backup integrity without impacting production" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,16"/>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Select Source SQL Job" FontWeight="Medium" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}"/>
                                <ComboBox ItemsSource="{Binding AvailableDrillJobs}" SelectedItem="{Binding SelectedDrillJob, Mode=TwoWay}" DisplayMemberPath="Name" Height="36" Margin="0,6,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Source Database" FontWeight="Medium" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}"/>
                                <TextBox Text="{Binding DrillDatabaseName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInputMono}" Height="36" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Button Command="{Binding ExecuteRestoreDrillCommand}" IsEnabled="{Binding IsRunningDrill, Converter={StaticResource InvertedBoolConverter}}" Style="{StaticResource BtnPrimary}" HorizontalAlignment="Left" Height="38" Padding="20,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPlay}" Fill="#FFFFFF" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock Text="Run automated drill now" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Border Visibility="{Binding IsRunningDrill, Converter={StaticResource BoolToVis}}" Background="{DynamicResource BrushRaised}" CornerRadius="8" Padding="14" Margin="0,16,0,0">
                            <TextBlock Text="{Binding DrillProgressMessage}" FontWeight="Medium" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushCobalt}"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Past Drill History -->
                <Border Style="{StaticResource Card}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Previous Drill Results" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSectionHeader}" Foreground="{DynamicResource BrushInk}"/>
                        <DataGrid ItemsSource="{Binding DrillHistory}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" Height="180" Background="Transparent" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" Margin="0,12,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Timestamp" Binding="{Binding TimestampDisplay}" Width="160"/>
                                <DataGridTextColumn Header="Database" Binding="{Binding Database}" Width="180"/>
                                <DataGridTextColumn Header="Scratch Database" Binding="{Binding ScratchDatabaseName}" Width="200"/>
                                <DataGridTextColumn Header="Recovery Time (RTO)" Binding="{Binding RtoDisplay}" Width="140"/>
                                <DataGridCheckBoxColumn Header="CHECKDB Passed" Binding="{Binding CheckDbPassed}" Width="120"/>
                                <DataGridTextColumn Header="Error / Details" Binding="{Binding ErrorMessage}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===================================================================
                 TAB 5: RECOVERY AUDIT HISTORY (§6)
                 =================================================================== -->
            <StackPanel Visibility="{Binding IsHistoryTab, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource Card}" Padding="20">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Recovery Audit Trail" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSectionHeader}" Foreground="{DynamicResource BrushInk}"/>
                                <TextBlock Text="Complete log of all database, file, and drill recovery operations" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Filter Pills & Search -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox Text="{Binding HistorySearchQuery, UpdateSourceTrigger=PropertyChanged}" Tag="Search operations..." Style="{StaticResource FieldInput}" Width="220" Margin="0,0,12,0"/>
                                <Button Content="All" Command="{Binding FilterHistoryCommand}" CommandParameter="All" Style="{StaticResource BtnQuiet}" Height="30" Margin="0,0,4,0"/>
                                <Button Content="SQL" Command="{Binding FilterHistoryCommand}" CommandParameter="SqlPointInTime" Style="{StaticResource BtnQuiet}" Height="30" Margin="0,0,4,0"/>
                                <Button Content="Files" Command="{Binding FilterHistoryCommand}" CommandParameter="Files" Style="{StaticResource BtnQuiet}" Height="30" Margin="0,0,4,0"/>
                                <Button Content="Drills" Command="{Binding FilterHistoryCommand}" CommandParameter="RestoreDrill" Style="{StaticResource BtnQuiet}" Height="30"/>
                            </StackPanel>
                        </Grid>

                        <!-- History DataGrid -->
                        <DataGrid ItemsSource="{Binding FilteredHistoryRecords}" SelectedItem="{Binding SelectedHistoryRecord, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" Height="360" Background="Transparent" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Operation ID" Binding="{Binding OperationId}" Width="150"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding RecoveryType}" Width="130"/>
                                <DataGridTextColumn Header="Source" Binding="{Binding SourceBackup}" Width="200"/>
                                <DataGridTextColumn Header="Target" Binding="{Binding TargetName}" Width="200"/>
                                <DataGridTextColumn Header="Start Time" Binding="{Binding StartTimeDisplay}" Width="160"/>
                                <DataGridTextColumn Header="Duration" Binding="{Binding DurationDisplay}" Width="90"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                                <DataGridTextColumn Header="Error / Summary" Binding="{Binding ErrorMessage}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
