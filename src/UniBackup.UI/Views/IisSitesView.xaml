<UserControl x:Class="UniBackup.UI.Views.IisSitesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:UniBackup.UI.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,24">
        <StackPanel MaxWidth="1280" HorizontalAlignment="Stretch">

            <!-- 1. Header -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="IIS Websites" FontWeight="SemiBold" FontSize="{StaticResource FontSizeH1}" Foreground="{DynamicResource BrushInk}"/>
                    <TextBlock x:Name="HeaderSubline" Text="Inspect live web applications on local server and package for cloud backup" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Back up selected sites Button (Cobalt) -->
                <Button Grid.Column="1"
                        Content="Back up selected sites"
                        Click="BackupSelected_Click"
                        Style="{StaticResource BtnPrimary}"
                        VerticalAlignment="Center"/>
            </Grid>

            <!-- 2. Toolbar (Segmented Filters + Search + Refresh) -->
            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Segmented Filter -->
                    <Border Style="{StaticResource SegmentedContainer}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="All sites" Style="{StaticResource SegmentedItem}" IsChecked="True" Checked="Filter_Checked" Tag="All"/>
                            <RadioButton Content="Running" Style="{StaticResource SegmentedItem}" Checked="Filter_Checked" Tag="Running"/>
                            <RadioButton Content="Stopped" Style="{StaticResource SegmentedItem}" Checked="Filter_Checked" Tag="Stopped"/>
                            <RadioButton Content="Unavailable" Style="{StaticResource SegmentedItem}" Checked="Filter_Checked" Tag="Unavailable"/>
                        </StackPanel>
                    </Border>

                    <!-- Search Box -->
                    <Border Grid.Column="1" Margin="20,0,0,0" Width="320" HorizontalAlignment="Left">
                        <Grid>
                            <TextBox x:Name="SearchBox" Tag="Filter sites by name, port..." Style="{StaticResource FieldInput}" Padding="34,0,12,0" TextChanged="SearchBox_TextChanged"/>
                            <Path Data="{StaticResource IconSearch}" Fill="{DynamicResource BrushInkFaint}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False"/>
                        </Grid>
                    </Border>

                    <!-- Refresh from IIS Button -->
                    <Button Grid.Column="2" Click="Refresh_Click" Style="{StaticResource BtnQuiet}" Height="36" Padding="14,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRefresh}" Fill="{DynamicResource BrushInkMuted}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0"/>
                            <TextBlock Text="Read from IIS"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- 3. Sites List -->
            <ItemsControl x:Name="SitesItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:IisSiteVm}">
                        <Border Margin="0,0,0,9" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="{StaticResource RadiusCard}" Padding="16,14" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/> <!-- Checkbox -->
                                    <ColumnDefinition Width="Auto"/> <!-- Icon Tile -->
                                    <ColumnDefinition Width="*"/>    <!-- Name, Path, Bindings -->
                                    <ColumnDefinition Width="150"/>  <!-- Size -->
                                    <ColumnDefinition Width="120"/>  <!-- State Badge -->
                                </Grid.ColumnDefinitions>

                                <!-- Checkbox -->
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding Available}" VerticalAlignment="Center" Margin="0,0,14,0"/>

                                <!-- 40 px Icon Tile (24 px Icon) -->
                                <Border Grid.Column="1" Width="40" Height="40" CornerRadius="10" Background="{Binding TileSoftBrush}" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <Path Data="{Binding TileIconGeometry}" Fill="{Binding TileBrush}" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Name, Path, Bindings & Pool -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeRowTitle}" Foreground="{DynamicResource BrushInk}"/>
                                    <TextBlock Text="{Binding Path}" FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeMono}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,4"/>
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding Available, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding PrimaryBinding}" FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,0,8,0"/>
                                        <TextBlock Text="·" Foreground="{DynamicResource BrushInkFaint}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Pool}" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Reason}" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushCoral}" Visibility="{Binding Available, Converter={StaticResource InverseBoolToVis}}"/>
                                </StackPanel>

                                <!-- Size Column -->
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding SizeDisplay}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeRowTitle}" Foreground="{DynamicResource BrushInk}" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding FilesDisplay}" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkFaint}" HorizontalAlignment="Right" Margin="0,1,0,4"/>
                                    <Border Width="80" Height="5" CornerRadius="2.5" Background="{DynamicResource BrushSunken}" HorizontalAlignment="Right">
                                        <Border Height="5" CornerRadius="2.5" Background="{DynamicResource BrushTeal}" HorizontalAlignment="Left">
                                            <Border.Width>
                                                <MultiBinding Converter="{StaticResource RatioToWidthConverter}">
                                                    <Binding Path="SizeRatio"/>
                                                    <Binding Source="{StaticResource DoubleOne}"/>
                                                    <Binding Source="80.0"/>
                                                </MultiBinding>
                                            </Border.Width>
                                        </Border>
                                    </Border>
                                </StackPanel>

                                <!-- State Badge -->
                                <Border Grid.Column="4" Style="{StaticResource BadgePill}" Background="{Binding StateBadgeSoftBrush}" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding StateBadgeText}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBadge}" Foreground="{Binding StateBadgeBrush}"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
