<UserControl x:Class="UniBackup.UI.Views.IisSitesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:UniBackup.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance vm:IisSitesViewModel}"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,24">
        <StackPanel MaxWidth="1280" HorizontalAlignment="Stretch">

            <!-- 1. Header (Title & Bulk Operations Toolbar) -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="IIS Websites" FontWeight="SemiBold" FontSize="{StaticResource FontSizePageTitle}" Foreground="{DynamicResource BrushInk}"/>
                    <TextBlock x:Name="HeaderSubline" Text="Inspect live web applications on local server and package for cloud backup" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Bulk Operations Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Run Selected Button -->
                    <Button Command="{Binding RunSelectedCommand}"
                            IsEnabled="{Binding CanRunSelected}"
                            Style="{StaticResource BtnQuiet}"
                            Height="38" Padding="14,0" Margin="0,0,8,0"
                            ToolTip="Start stopped eligible websites in IIS">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlay}" Fill="{DynamicResource BrushJade}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Run Selected" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Edit Selected Button -->
                    <Button Command="{Binding EditSelectedCommand}"
                            IsEnabled="{Binding CanEditSelected}"
                            Style="{StaticResource BtnQuiet}"
                            Height="38" Padding="14,0" Margin="0,0,8,0"
                            ToolTip="Edit configuration for single selected site">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconEdit}" Fill="{DynamicResource BrushInkMuted}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Edit Selected" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Delete Selected Button -->
                    <Button Command="{Binding DeleteSelectedCommand}"
                            IsEnabled="{Binding CanDeleteSelected}"
                            Style="{StaticResource BtnQuiet}"
                            Height="38" Padding="14,0" Margin="0,0,12,0"
                            ToolTip="Delete configured backup jobs for selected sites">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconTrash}" Fill="{DynamicResource BrushCoral}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Delete Selected" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Backup Selected Button (Cobalt/Primary) -->
                    <Button Command="{Binding BackupSelectedCommand}"
                            IsEnabled="{Binding CanBackupSelected}"
                            Style="{StaticResource BtnPrimary}"
                            Height="38" Padding="18,0"
                            VerticalAlignment="Center"
                            ToolTip="Launch bulk backup workflow for selected websites">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconCloudArrowUp}" Fill="White" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Backup Selected" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2. Toolbar Card (Segmented Filters + Search + Selection Controls) -->
            <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,20">
                <StackPanel>
                    <!-- Top row: Status Segmented Filter + Search Box + Read from IIS -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Segmented Status Filter with Live Counts -->
                        <Border Style="{StaticResource SegmentedContainer}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="FilterAllRadio" Style="{StaticResource SegmentedItem}" IsChecked="True" Checked="Filter_Checked" Tag="All">
                                    <TextBlock Text="{Binding AllFilterTitle}"/>
                                </RadioButton>
                                <RadioButton x:Name="FilterRunningRadio" Style="{StaticResource SegmentedItem}" Checked="Filter_Checked" Tag="Running">
                                    <TextBlock Text="{Binding RunningFilterTitle}"/>
                                </RadioButton>
                                <RadioButton x:Name="FilterStoppedRadio" Style="{StaticResource SegmentedItem}" Checked="Filter_Checked" Tag="Stopped">
                                    <TextBlock Text="{Binding StoppedFilterTitle}"/>
                                </RadioButton>
                                <RadioButton x:Name="FilterUnavailableRadio" Style="{StaticResource SegmentedItem}" Checked="Filter_Checked" Tag="Unavailable">
                                    <TextBlock Text="{Binding UnavailableFilterTitle}"/>
                                </RadioButton>
                            </StackPanel>
                        </Border>

                        <!-- Search Box -->
                        <Border Grid.Column="1" Margin="20,0" Width="360" HorizontalAlignment="Left">
                            <Grid>
                                <TextBox x:Name="SearchBox"
                                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="Search name, path, binding, port, pool..."
                                         Style="{StaticResource FieldInput}"
                                         Padding="34,0,12,0"/>
                                <Path Data="{StaticResource IconSearch}" Fill="{DynamicResource BrushInkFaint}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>

                        <!-- Read from IIS Button -->
                        <Button Grid.Column="2" Command="{Binding RefreshFromIisCommand}" Style="{StaticResource BtnQuiet}" Height="36" Padding="14,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconRefresh}" Fill="{DynamicResource BrushInkMuted}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock Text="Read from IIS"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Divider -->
                    <Border Height="1" Background="{DynamicResource BrushLine}" Margin="0,12,0,12"/>

                    <!-- Bottom row: Selection Controls Bar & Selection Summary -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Selection Controls -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Master Checkbox (Tri-state) -->
                            <CheckBox IsChecked="{Binding IsAllFilteredSelected, Mode=OneWay}"
                                      Command="{Binding ToggleSelectAllFilteredCommand}"
                                      VerticalAlignment="Center"
                                      Margin="4,0,12,0"
                                      ToolTip="Toggle selection for all visible eligible websites"/>

                            <TextBlock Text="Select:" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>

                            <Button Content="Select All" Command="{Binding SelectAllCommand}" Style="{StaticResource BtnQuiet}" Height="28" Padding="10,0" Margin="0,0,4,0" ToolTip="Select all available websites in this view"/>
                            <Button Content="Running" Command="{Binding SelectRunningCommand}" Style="{StaticResource BtnQuiet}" Height="28" Padding="10,0" Margin="0,0,4,0" ToolTip="Select running available websites in this view"/>
                            <Button Content="Stopped" Command="{Binding SelectStoppedCommand}" Style="{StaticResource BtnQuiet}" Height="28" Padding="10,0" Margin="0,0,4,0" ToolTip="Select stopped available websites in this view"/>
                            <Button Content="Available" Command="{Binding SelectAvailableCommand}" Style="{StaticResource BtnQuiet}" Height="28" Padding="10,0" Margin="0,0,8,0" ToolTip="Select all validated available websites in this view"/>

                            <!-- Clear Selection -->
                            <Button Content="Clear Selection" Command="{Binding ClearSelectionCommand}"
                                    IsEnabled="{Binding HasSelectedSites}"
                                    Style="{StaticResource BtnQuiet}"
                                    Height="28" Padding="10,0"
                                    Foreground="{DynamicResource BrushCoral}"
                                    ToolTip="Clear selection across all sites"/>
                        </StackPanel>

                        <!-- Selection Indicator Badge (Distinguishing visible vs total) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                            <Border Style="{StaticResource BadgePill}" Background="{DynamicResource BrushTealSoft}"
                                    Visibility="{Binding HasSelectedSites, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding SelectedSummaryText}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushTeal}"/>
                            </Border>
                        </StackPanel>

                        <!-- Visible Websites Count -->
                        <TextBlock Grid.Column="2" Text="{Binding VisibleSummaryText}" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 3. Empty State -->
            <Border Style="{StaticResource Card}" Padding="40" Margin="0,0,0,20" HorizontalAlignment="Stretch"
                    Visibility="{Binding HasNoFilteredSites, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center">
                    <Path Data="{StaticResource IconIisSites}" Fill="{DynamicResource BrushInkFaint}" Width="48" Height="48" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="No websites match your filter or search query" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCardHeader}" Foreground="{DynamicResource BrushInk}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Try clearing your search query or switching to 'All Sites'." FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushInkMuted}" HorizontalAlignment="Center" Margin="0,4,0,16"/>
                    <Button Content="Show All Sites" Command="{Binding SetFilterCommand}" CommandParameter="All" Style="{StaticResource BtnQuiet}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 4. Sites List -->
            <ItemsControl x:Name="SitesItemsControl" ItemsSource="{Binding FilteredSites}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:IisSiteVm}">
                        <Border Margin="0,0,0,9" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="{StaticResource RadiusCard}" Padding="16,14" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/> <!-- Checkbox -->
                                    <ColumnDefinition Width="Auto"/> <!-- Icon Tile -->
                                    <ColumnDefinition Width="*"/>    <!-- Name, Path, Bindings -->
                                    <ColumnDefinition Width="150"/>  <!-- Size -->
                                    <ColumnDefinition Width="120"/>  <!-- State Badge -->
                                </Grid.ColumnDefinitions>

                                <!-- Checkbox -->
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding Available}" VerticalAlignment="Center" Margin="0,0,14,0"/>

                                <!-- 40 px Icon Tile (24 px Icon) -->
                                <Border Grid.Column="1" Width="40" Height="40" CornerRadius="10" Background="{Binding TileSoftBrush}" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <Path Data="{Binding TileIconGeometry}" Fill="{Binding TileBrush}" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Name, Path, Bindings & Pool -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCardHeader}" Foreground="{DynamicResource BrushInk}"/>
                                    <TextBlock Text="{Binding Path}" FontFamily="{StaticResource FontFamilyMono}" FontSize="{StaticResource FontSizeMono}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,4"/>
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding Available, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding PrimaryBinding}" FontFamily="{StaticResource FontFamilyMono}" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,0,8,0"/>
                                        <TextBlock Text="·" Foreground="{DynamicResource BrushInkFaint}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Pool}" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Reason}" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushCoral}" Visibility="{Binding Available, Converter={StaticResource InverseBoolToVis}}"/>
                                </StackPanel>

                                <!-- Size Column -->
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding SizeDisplay}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushInk}" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding FilesDisplay}" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkFaint}" HorizontalAlignment="Right" Margin="0,1,0,4"/>
                                    <Border Width="80" Height="5" CornerRadius="2.5" Background="{DynamicResource BrushSunken}" HorizontalAlignment="Right">
                                        <Border Height="5" CornerRadius="2.5" Background="{DynamicResource BrushTeal}" HorizontalAlignment="Left">
                                            <Border.Width>
                                                <MultiBinding Converter="{StaticResource RatioToWidthConverter}">
                                                    <Binding Path="SizeRatio"/>
                                                    <Binding Source="{StaticResource DoubleOne}"/>
                                                    <Binding Source="80.0"/>
                                                </MultiBinding>
                                            </Border.Width>
                                        </Border>
                                    </Border>
                                </StackPanel>

                                <!-- State Badge -->
                                <Border Grid.Column="4" Style="{StaticResource BadgePill}" Background="{Binding StateBadgeSoftBrush}" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding StateBadgeText}" FontWeight="Medium" FontSize="{StaticResource FontSizeStatus}" Foreground="{Binding StateBadgeBrush}"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
