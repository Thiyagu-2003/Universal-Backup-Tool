<UserControl x:Class="UniBackup.UI.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:UniBackup.UI.ViewModels">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header and Toolbar -->
            <RowDefinition Height="*"/>    <!-- Log List Viewer -->
        </Grid.RowDefinitions>

        <!-- 1. Header and Toolbar -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Level toggle chips -->
                    <ColumnDefinition Width="*"/>    <!-- Search -->
                    <ColumnDefinition Width="Auto"/> <!-- Actions: Copy & Logs folder -->
                </Grid.ColumnDefinitions>

                <!-- Three Counting Toggle Chips (§4.6) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Errors Chip (Coral) -->
                    <ToggleButton IsChecked="{Binding Logs.ShowErrors, Mode=TwoWay}" Cursor="Hand" Margin="0,0,8,0">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                <Border x:Name="bd" Height="28" CornerRadius="14" Padding="12,0"
                                        Background="{DynamicResource BrushCoralSoft}" BorderBrush="{DynamicResource BrushCoral}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Stretch="Uniform" Fill="{DynamicResource BrushCoral}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Logs.ErrorCount, StringFormat={}{0} Errors}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBadge}" Foreground="{DynamicResource BrushCoral}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="False">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushSunken}"/>
                                        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BrushLine}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <!-- Warnings Chip (Saffron) -->
                    <ToggleButton IsChecked="{Binding Logs.ShowWarnings, Mode=TwoWay}" Cursor="Hand" Margin="0,0,8,0">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                <Border x:Name="bd" Height="28" CornerRadius="14" Padding="12,0"
                                        Background="{DynamicResource BrushSaffronSoft}" BorderBrush="{DynamicResource BrushSaffron}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Stretch="Uniform" Fill="{DynamicResource BrushSaffron}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Logs.WarningCount, StringFormat={}{0} Warnings}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBadge}" Foreground="{DynamicResource BrushSaffron}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="False">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushSunken}"/>
                                        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BrushLine}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <!-- Info Chip (Cobalt) -->
                    <ToggleButton IsChecked="{Binding Logs.ShowInfo, Mode=TwoWay}" Cursor="Hand">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                <Border x:Name="bd" Height="28" CornerRadius="14" Padding="12,0"
                                        Background="{DynamicResource BrushCobaltSoft}" BorderBrush="{DynamicResource BrushCobalt}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Stretch="Uniform" Fill="{DynamicResource BrushCobalt}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Logs.InfoCount, StringFormat={}{0} Info}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBadge}" Foreground="{DynamicResource BrushCobalt}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="False">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushSunken}"/>
                                        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BrushLine}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                </StackPanel>

                <!-- Search Box with Watermark -->
                <Border Grid.Column="1" Margin="16,0" Width="260" Height="32" HorizontalAlignment="Left"
                        CornerRadius="{StaticResource RadiusControl}" Background="{DynamicResource BrushCanvas}"
                        BorderBrush="{DynamicResource BrushLineStrong}" BorderThickness="1">
                    <Grid>
                        <Path Data="{StaticResource IconSearch}"
                              Fill="{DynamicResource BrushInkFaint}"
                              Width="17" Height="17"
                              Stretch="Uniform"
                              HorizontalAlignment="Left"
                              Margin="10,0,0,0"
                              IsHitTestVisible="False"/>
                        <TextBlock Text="Filter log events..."
                                   Foreground="{DynamicResource BrushInkFaint}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   VerticalAlignment="Center"
                                   Margin="30,0,10,0"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=LogSearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Text, ElementName=LogSearchBox}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox x:Name="LogSearchBox"
                                 Text="{Binding Logs.SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource BrushInk}"
                                 CaretBrush="{DynamicResource BrushCobalt}"
                                 FontSize="{StaticResource FontSizeBody}"
                                 VerticalContentAlignment="Center"
                                 Padding="30,0,10,0"/>
                    </Grid>
                </Border>

                <!-- Actions: Copy & Logs Folder -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding Logs.CopyFilteredCommand}" Style="{StaticResource BtnQuiet}" Margin="0,0,8,0" Height="34" Padding="12,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconCopy}" Fill="{DynamicResource BrushInkMuted}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Copy" FontSize="{StaticResource FontSizeBadge}"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding Logs.OpenLogsFolderCommand}" Style="{StaticResource BtnQuiet}" Height="34" Padding="12,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconFolder}" Fill="{DynamicResource BrushInkMuted}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Logs folder" FontSize="{StaticResource FontSizeBadge}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Monospace Log Viewer Box (Named LogViewerList for tests and auto-scroll) -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <Grid>
                <ListView x:Name="LogViewerList"
                          ItemsSource="{Binding Logs.VisibleLines}"
                          Background="{DynamicResource BrushPanel}"
                          BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="{x:Type ListViewItem}">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                                        <Border SnapsToDevicePixels="True">
                                            <Border.Style>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                                            <Setter Property="Background" Value="#0FE11D48"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                            <Setter Property="Background" Value="#0FD97706"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource BrushSunken}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <!-- Coloured Left Edge Indicator per Line (§4.6) -->
                                                <Border Width="4" HorizontalAlignment="Left" CornerRadius="2">
                                                    <Border.Style>
                                                        <Style TargetType="{x:Type Border}">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource BrushCoral}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource BrushSaffron}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource BrushJade}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>

                                                <!-- Mono Line Content -->
                                                <TextBlock Text="{Binding Raw}"
                                                           FontFamily="{StaticResource FontMono}"
                                                           FontSize="{StaticResource FontSizeMono}"
                                                           Foreground="{DynamicResource BrushInk}"
                                                           TextWrapping="NoWrap"
                                                           LineHeight="21"
                                                           Padding="16,4,16,4"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <!-- Empty State Message when 0 lines match -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding Logs.HasNoVisibleLines, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="No log events match the current filter"
                               FontWeight="Medium"
                               FontSize="{StaticResource FontSizeBody}"
                               Foreground="{DynamicResource BrushInkMuted}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
