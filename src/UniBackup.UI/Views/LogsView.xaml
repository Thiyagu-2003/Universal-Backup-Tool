<UserControl x:Class="UniBackup.UI.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:UniBackup.UI.ViewModels">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header and Toolbar -->
            <RowDefinition Height="*"/>    <!-- Log List Viewer -->
        </Grid.RowDefinitions>

        <!-- 1. Header and Toolbar -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Level toggle chips -->
                    <ColumnDefinition Width="*"/>    <!-- Search -->
                    <ColumnDefinition Width="Auto"/> <!-- Actions: Copy & Logs folder -->
                </Grid.ColumnDefinitions>

                <!-- Three Counting Toggle Chips (§4.6) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Errors Chip (Coral) -->
                    <ToggleButton IsChecked="{Binding Logs.ShowErrors, Mode=TwoWay}" Cursor="Hand" Margin="0,0,8,0">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                <Border x:Name="bd" CornerRadius="{StaticResource RadiusPill}" Padding="12,6"
                                        Background="{DynamicResource BrushCoralSoft}" BorderBrush="{DynamicResource BrushCoral}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource BrushCoral}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Logs.ErrorCount, StringFormat={}{0} Errors}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBadge}" Foreground="{DynamicResource BrushCoral}"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="False">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushSunken}"/>
                                        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BrushLine}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <!-- Warnings Chip (Saffron) -->
                    <ToggleButton IsChecked="{Binding Logs.ShowWarnings, Mode=TwoWay}" Cursor="Hand" Margin="0,0,8,0">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                <Border x:Name="bd" CornerRadius="{StaticResource RadiusPill}" Padding="12,6"
                                        Background="{DynamicResource BrushSaffronSoft}" BorderBrush="{DynamicResource BrushSaffron}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource BrushSaffron}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Logs.WarningCount, StringFormat={}{0} Warnings}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBadge}" Foreground="{DynamicResource BrushSaffron}"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="False">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushSunken}"/>
                                        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BrushLine}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <!-- Info Chip (Cobalt) -->
                    <ToggleButton IsChecked="{Binding Logs.ShowInfo, Mode=TwoWay}" Cursor="Hand">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                <Border x:Name="bd" CornerRadius="{StaticResource RadiusPill}" Padding="12,6"
                                        Background="{DynamicResource BrushCobaltSoft}" BorderBrush="{DynamicResource BrushCobalt}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource BrushCobalt}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Logs.InfoCount, StringFormat={}{0} Info}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBadge}" Foreground="{DynamicResource BrushCobalt}"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="False">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushSunken}"/>
                                        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BrushLine}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                </StackPanel>

                <!-- Search Box -->
                <Border Grid.Column="1" Margin="20,0" MaxWidth="320" HorizontalAlignment="Left">
                    <Grid>
                        <TextBox Text="{Binding Logs.SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FieldInput}"
                                 Padding="34,0,12,0"/>
                        <Path Data="{StaticResource IconSearch}"
                              Fill="{DynamicResource BrushInkFaint}"
                              Width="14" Height="14"
                              Stretch="Uniform"
                              HorizontalAlignment="Left"
                              Margin="12,0,0,0"
                              IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <!-- Actions: Copy & Logs Folder -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding Logs.CopyFilteredCommand}" Style="{StaticResource BtnQuiet}" Margin="0,0,8,0" Height="34" Padding="12,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconCopy}" Fill="{DynamicResource BrushInkMuted}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Copy" FontSize="{StaticResource FontSizeBadge}"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding Logs.OpenLogsFolderCommand}" Style="{StaticResource BtnQuiet}" Height="34" Padding="12,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconFolder}" Fill="{DynamicResource BrushInkMuted}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Logs folder" FontSize="{StaticResource FontSizeBadge}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Monospace Log Viewer Box (Named LogViewerList for tests and auto-scroll) -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <Grid>
                <ListView x:Name="LogViewerList"
                          ItemsSource="{Binding Logs.VisibleLines}"
                          Background="{DynamicResource BrushPanel}"
                          BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="{x:Type ListViewItem}">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                                        <Border SnapsToDevicePixels="True">
                                            <Border.Style>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource BrushCoralSoft}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource BrushSaffronSoft}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <!-- Coloured Left Edge per Line (§4.6) -->
                                                <Border Width="4" HorizontalAlignment="Left">
                                                    <Border.Style>
                                                        <Style TargetType="{x:Type Border}">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource BrushCoral}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource BrushSaffron}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource BrushJade}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>

                                                <!-- Mono Line Content -->
                                                <TextBlock Text="{Binding Raw}"
                                                           FontFamily="{StaticResource FontMono}"
                                                           FontSize="{StaticResource FontSizeMono}"
                                                           Foreground="{DynamicResource BrushInk}"
                                                           TextWrapping="NoWrap"
                                                           LineHeight="21"
                                                           Padding="16,3,16,3"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <!-- Empty State Message when 0 lines match -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding Logs.VisibleLines.Count, Converter={StaticResource InverseBoolToVis}}">
                    <TextBlock Text="No log events match the current filter"
                               FontWeight="Medium"
                               FontSize="{StaticResource FontSizeBody}"
                               Foreground="{DynamicResource BrushInkMuted}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
