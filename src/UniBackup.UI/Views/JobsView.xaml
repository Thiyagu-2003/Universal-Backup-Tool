<UserControl x:Class="UniBackup.UI.Views.JobsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:UniBackup.UI.Controls"
             xmlns:vm="clr-namespace:UniBackup.UI.ViewModels"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,20">
            <StackPanel MaxWidth="1320" HorizontalAlignment="Stretch">

                <!-- ===================================================================
                     1. PAGE HEADER (§2)
                     Title, description, All/Enabled/Disabled filter, date preset, refresh
                     =================================================================== -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Title & Description -->
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Backup Jobs"
                                   FontWeight="SemiBold"
                                   FontSize="{StaticResource FontSizePageTitle}"
                                   Foreground="{DynamicResource BrushInk}"/>
                        <TextBlock Text="Manage and monitor your backup jobs."
                                   FontSize="{StaticResource FontSizeBody}"
                                   Foreground="{DynamicResource BrushInkMuted}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- Right: Quick All/Enabled/Disabled Filter, Date Range Selector, Refresh -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Quick Header Status Segmented Pill -->
                        <Border Style="{StaticResource SegmentedContainer}" VerticalAlignment="Center" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="All jobs"
                                             Style="{StaticResource SegmentedItem}"
                                             IsChecked="{Binding IsJobsFilterAll, Mode=OneWay}"
                                             Click="StatusFilter_Click"
                                             Tag="All"/>
                                <RadioButton Content="Enabled"
                                             Style="{StaticResource SegmentedItem}"
                                             IsChecked="{Binding IsJobsFilterEnabled, Mode=OneWay}"
                                             Click="StatusFilter_Click"
                                             Tag="Enabled"/>
                                <RadioButton Content="Disabled"
                                             Style="{StaticResource SegmentedItem}"
                                             IsChecked="{Binding IsJobsFilterDisabled, Mode=OneWay}"
                                             Click="StatusFilter_Click"
                                             Tag="Disabled"/>
                            </StackPanel>
                        </Border>

                        <!-- Date Range Filter for Activity Chart -->
                        <Border Style="{StaticResource SegmentedContainer}" VerticalAlignment="Center" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="7d"
                                             Style="{StaticResource SegmentedItem}"
                                             IsChecked="{Binding IsJobsPreset7Days, Mode=OneWay}"
                                             Click="DatePreset_Click"
                                             Tag="Last7Days"/>
                                <RadioButton Content="30d"
                                             Style="{StaticResource SegmentedItem}"
                                             IsChecked="{Binding IsJobsPreset30Days, Mode=OneWay}"
                                             Click="DatePreset_Click"
                                             Tag="Last30Days"/>
                                <RadioButton Content="90d"
                                             Style="{StaticResource SegmentedItem}"
                                             IsChecked="{Binding IsJobsPreset90Days, Mode=OneWay}"
                                             Click="DatePreset_Click"
                                             Tag="Last90Days"/>
                            </StackPanel>
                        </Border>

                        <!-- Refresh Action -->
                        <Button Command="{Binding RefreshJobsPageCommand}"
                                Style="{StaticResource BtnQuiet}"
                                Height="32" Padding="12,0"
                                VerticalAlignment="Center"
                                ToolTip="Reload backup jobs, schedules, and execution charts">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconRefresh}"
                                      Fill="{DynamicResource BrushInkMuted}"
                                      Width="13" Height="13"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Margin="0,0,6,0"/>
                                <TextBlock Text="Refresh"
                                           FontWeight="SemiBold"
                                           FontSize="{StaticResource FontSizeBadge}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ===================================================================
                     2. FOUR KPI SUMMARY CARDS (§3)
                     Clickable cards that apply the corresponding table filter
                     =================================================================== -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- KPI 1: Total Jobs -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18,16" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding SetJobsStatusFilterCommand}" CommandParameter="All"/>
                        </Border.InputBindings>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource BrushCobaltSoft}" HorizontalAlignment="Left">
                                    <Path Data="{StaticResource IconBackups}" Fill="{DynamicResource BrushCobalt}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource BadgePill}" Background="{DynamicResource BrushCobaltSoft}" Padding="8,3">
                                    <TextBlock Text="Configured" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushCobalt}"/>
                                </Border>
                            </Grid>
                            <StackPanel Grid.Row="1" Margin="0,12,0,4">
                                <TextBlock Text="Total Jobs" FontWeight="Medium" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}"/>
                                <TextBlock Text="{Binding TotalJobsCount}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeKpi}" Foreground="{DynamicResource BrushInk}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Row="2" Text="{Binding JobsTotalSubText}" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkFaint}" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>

                    <!-- KPI 2: Enabled Jobs -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,16" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding SetJobsStatusFilterCommand}" CommandParameter="Enabled"/>
                        </Border.InputBindings>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource BrushJadeSoft}" HorizontalAlignment="Left">
                                    <Path Data="{StaticResource IconCheckCircle}" Fill="{DynamicResource BrushJade}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource BadgePill}" Background="{DynamicResource BrushJadeSoft}" Padding="8,3">
                                    <TextBlock Text="Active" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushJade}"/>
                                </Border>
                            </Grid>
                            <StackPanel Grid.Row="1" Margin="0,12,0,4">
                                <TextBlock Text="Enabled Jobs" FontWeight="Medium" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}"/>
                                <TextBlock Text="{Binding EnabledJobsCount}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeKpi}" Foreground="{DynamicResource BrushJade}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Row="2" Text="{Binding JobsEnabledSubText}" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkFaint}" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>

                    <!-- KPI 3: Scheduled Jobs -->
                    <Border Grid.Column="4" Style="{StaticResource Card}" Padding="18,16" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding SetJobsStatusFilterCommand}" CommandParameter="Scheduled"/>
                        </Border.InputBindings>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource BrushOrchidSoft}" HorizontalAlignment="Left">
                                    <Path Data="{StaticResource IconClock}" Fill="{DynamicResource BrushOrchid}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource BadgePill}" Background="{DynamicResource BrushOrchidSoft}" Padding="8,3">
                                    <TextBlock Text="Automated" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushOrchid}"/>
                                </Border>
                            </Grid>
                            <StackPanel Grid.Row="1" Margin="0,12,0,4">
                                <TextBlock Text="Scheduled Jobs" FontWeight="Medium" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}"/>
                                <TextBlock Text="{Binding ScheduledJobsCount}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeKpi}" Foreground="{DynamicResource BrushOrchid}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Row="2" Text="{Binding JobsNextScheduledSubText}" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkFaint}" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>

                    <!-- KPI 4: Needs Attention -->
                    <Border Grid.Column="6" Style="{StaticResource Card}" Padding="18,16" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding SetJobsStatusFilterCommand}" CommandParameter="NeedsAttention"/>
                        </Border.InputBindings>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource BrushCoralSoft}" HorizontalAlignment="Left">
                                    <Path Data="{StaticResource IconWarningCircle}" Fill="{DynamicResource BrushCoral}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource BadgePill}" Background="{DynamicResource BrushCoralSoft}" Padding="8,3">
                                    <TextBlock Text="Review" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushCoral}"/>
                                </Border>
                            </Grid>
                            <StackPanel Grid.Row="1" Margin="0,12,0,4">
                                <TextBlock Text="Needs Attention" FontWeight="Medium" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}"/>
                                <TextBlock Text="{Binding NeedsAttentionJobsCount}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeKpi}" Foreground="{DynamicResource BrushCoral}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Row="2" Text="{Binding JobsAttentionSubText}" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkFaint}" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ===================================================================
                     3. ANALYTICS ROW (§4 & §5)
                     Left: Backup Activity Chart | Right: Backup Job Distribution Donut
                     =================================================================== -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.7*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Card: Backup Activity Chart -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Backup Execution Trends"
                                               FontWeight="SemiBold"
                                               FontSize="{StaticResource FontSizeCardHeader}"
                                               Foreground="{DynamicResource BrushInk}"/>
                                    <TextBlock Text="{Binding JobsDateRangeDisplay}"
                                               FontSize="{StaticResource FontSizeSecondary}"
                                               Foreground="{DynamicResource BrushInkMuted}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Legend -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource BrushJade}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Succeeded" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,0,14,0"/>

                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource BrushCoral}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Failed" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,0,14,0"/>

                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource BrushSaffron}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Partial" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkMuted}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Height="195">
                                <lvc:CartesianChart Series="{Binding JobsActivitySeries}"
                                                    XAxes="{Binding JobsActivityXAxes}"
                                                    YAxes="{Binding JobsActivityYAxes}"
                                                    Height="195"
                                                    Visibility="{Binding HasJobsActivityHistory, Converter={StaticResource BoolToVis}}"/>

                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Visibility="{Binding HasJobsActivityHistory, Converter={StaticResource InverseBoolToVis}}">
                                    <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource BrushSunken}" HorizontalAlignment="Center" Margin="0,0,0,8">
                                        <Path Data="{StaticResource IconClock}" Fill="{DynamicResource BrushInkFaint}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="No executions in selected window" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Run a backup job or expand the date range to view trends." FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkFaint}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Right Card: Backup Job Distribution Donut -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Job Distribution"
                                       FontWeight="SemiBold"
                                       FontSize="{StaticResource FontSizeCardHeader}"
                                       Foreground="{DynamicResource BrushInk}"/>
                            <TextBlock Text="Configured jobs by backup type"
                                       FontSize="{StaticResource FontSizeSecondary}"
                                       Foreground="{DynamicResource BrushInkMuted}"
                                       Margin="0,2,0,10"/>

                            <Grid Height="130" HorizontalAlignment="Center" Margin="0,0,0,10">
                                <lvc:PieChart Series="{Binding JobsDistributionSeries}"
                                              Height="130" Width="150"
                                              InitialRotation="-90" MaxAngle="360"
                                              Visibility="{Binding HasJobsDistribution, Converter={StaticResource BoolToVis}}"/>

                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                            Visibility="{Binding HasJobsDistribution, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding JobsDistributionTotalCount}"
                                               FontWeight="SemiBold" FontSize="{StaticResource FontSizeSectionHeader}"
                                               Foreground="{DynamicResource BrushInk}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="total jobs" FontSize="{StaticResource FontSizeCaption}"
                                               Foreground="{DynamicResource BrushInkMuted}" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Visibility="{Binding HasJobsDistribution, Converter={StaticResource InverseBoolToVis}}">
                                    <TextBlock Text="No configured jobs" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkFaint}"/>
                                </StackPanel>
                            </Grid>

                            <Border BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                <ItemsControl ItemsSource="{Binding JobsDistributionSlices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="48"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="8" Height="8" Fill="{Binding ColorBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInk}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Count}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <Border Grid.Column="3" Style="{StaticResource BadgePill}" Background="{DynamicResource BrushSunken}" HorizontalAlignment="Right" Padding="5,2">
                                                    <TextBlock Text="{Binding PercentageDisplay}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushInk}"/>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ===================================================================
                     4. EMPTY STATE (When 0 jobs are configured §8)
                     =================================================================== -->
                <controls:EmptyState Visibility="{Binding HasNoJobs, Converter={StaticResource BoolToVis}}"
                                     Title="No backup jobs yet"
                                     Description="Protect folders, IIS websites, or SQL Server databases with automated schedules and cloud storage retention."
                                     ButtonText="Create backup job"
                                     ActionCommand="{Binding OpenNewJobCommand}"
                                     Icon="{StaticResource IconBackups}"
                                     Margin="0,16,0,24"/>

                <!-- ===================================================================
                     5. BACKUP JOBS TABLE CARD (§6)
                     Filters, Search, Bulk Action Bar, Sortable Columns, Pagination
                     =================================================================== -->
                <Border Style="{StaticResource Card}"
                        Padding="0"
                        Visibility="{Binding HasNoJobs, Converter={StaticResource InverseBoolToVis}}">
                    <StackPanel>

                        <!-- Table Filter & Search Toolbar -->
                        <Border BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,0,0,1" Padding="18,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Status Filter Pills -->
                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Style="{StaticResource SegmentedContainer}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Content="All" Style="{StaticResource SegmentedItem}" IsChecked="{Binding IsJobsFilterAll, Mode=OneWay}" Click="StatusFilter_Click" Tag="All"/>
                                            <RadioButton Content="Enabled" Style="{StaticResource SegmentedItem}" IsChecked="{Binding IsJobsFilterEnabled, Mode=OneWay}" Click="StatusFilter_Click" Tag="Enabled"/>
                                            <RadioButton Content="Disabled" Style="{StaticResource SegmentedItem}" IsChecked="{Binding IsJobsFilterDisabled, Mode=OneWay}" Click="StatusFilter_Click" Tag="Disabled"/>
                                            <RadioButton Content="Running" Style="{StaticResource SegmentedItem}" IsChecked="{Binding IsJobsFilterRunning, Mode=OneWay}" Click="StatusFilter_Click" Tag="Running"/>
                                            <RadioButton Content="Failed" Style="{StaticResource SegmentedItem}" IsChecked="{Binding IsJobsFilterFailed, Mode=OneWay}" Click="StatusFilter_Click" Tag="Failed"/>
                                            <RadioButton Content="Needs attention" Style="{StaticResource SegmentedItem}" IsChecked="{Binding IsJobsFilterNeedsAttention, Mode=OneWay}" Click="StatusFilter_Click" Tag="NeedsAttention"/>
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>

                                <!-- Search Box -->
                                <Border Grid.Column="1" Width="290" HorizontalAlignment="Right">
                                    <Grid>
                                        <TextBox x:Name="SearchBox"
                                                 Text="{Binding JobsSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="Search by name, source, type..."
                                                 Style="{StaticResource FieldInput}"
                                                 Padding="34,0,12,0"/>
                                        <Path Data="{StaticResource IconSearch}"
                                              Fill="{DynamicResource BrushInkFaint}"
                                              Width="16" Height="16"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Left"
                                              Margin="12,0,0,0"
                                              IsHitTestVisible="False"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Bulk Actions Bar (Visible when 1+ jobs selected) -->
                        <Border Visibility="{Binding HasSelectedJobs, Converter={StaticResource BoolToVis}}"
                                Background="{DynamicResource BrushCobaltSoft}"
                                BorderBrush="{DynamicResource BrushLine}"
                                BorderThickness="0,0,0,1"
                                Padding="18,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource BrushCobalt}" CornerRadius="6" Padding="8,3" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding SelectedJobsCount}" FontWeight="Bold" FontSize="{StaticResource FontSizeCaption}" Foreground="#FFFFFF"/>
                                    </Border>
                                    <TextBlock Text="jobs selected" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushCobalt}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Run selected" Command="{Binding BulkRunSelectedJobsCommand}" Style="{StaticResource BtnPrimary}" Height="30" Padding="12,0" FontSize="{StaticResource FontSizeCaption}" Margin="0,0,8,0"/>
                                    <Button Content="Enable" Command="{Binding BulkEnableJobsCommand}" Style="{StaticResource BtnQuiet}" Height="30" Padding="12,0" FontSize="{StaticResource FontSizeCaption}" Margin="0,0,8,0"/>
                                    <Button Content="Disable" Command="{Binding BulkDisableJobsCommand}" Style="{StaticResource BtnQuiet}" Height="30" Padding="12,0" FontSize="{StaticResource FontSizeCaption}" Margin="0,0,8,0"/>
                                    <Button Content="Clear" Command="{Binding ClearJobSelectionCommand}" Style="{StaticResource BtnQuiet}" Height="30" Padding="10,0" FontSize="{StaticResource FontSizeCaption}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Table Column Headers (Sortable) -->
                        <Border Background="{DynamicResource BrushRaised}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,0,0,1" Padding="18,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>              <!-- Checkbox -->
                                    <ColumnDefinition Width="1.4*" MinWidth="170"/> <!-- Job Name -->
                                    <ColumnDefinition Width="105"/>             <!-- Type -->
                                    <ColumnDefinition Width="1.2*" MinWidth="140"/> <!-- Source -->
                                    <ColumnDefinition Width="125"/>             <!-- Schedule -->
                                    <ColumnDefinition Width="120"/>             <!-- Last Run -->
                                    <ColumnDefinition Width="105"/>             <!-- Status -->
                                    <ColumnDefinition Width="120"/>             <!-- Next Run -->
                                    <ColumnDefinition Width="105"/>             <!-- Actions -->
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding IsAllCurrentPageSelected}"
                                          VerticalAlignment="Center"
                                          ToolTip="Select all jobs on this page"/>

                                <Button Grid.Column="1" Command="{Binding SortJobsByCommand}" CommandParameter="Name"
                                        Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Left" Cursor="Hand">
                                    <TextBlock Text="JOB NAME ↕" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkFaint}"/>
                                </Button>

                                <Button Grid.Column="2" Command="{Binding SortJobsByCommand}" CommandParameter="Type"
                                        Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Left" Cursor="Hand">
                                    <TextBlock Text="TYPE ↕" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkFaint}"/>
                                </Button>

                                <TextBlock Grid.Column="3" Text="SOURCE" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkFaint}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="SCHEDULE" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkFaint}" VerticalAlignment="Center"/>

                                <Button Grid.Column="5" Command="{Binding SortJobsByCommand}" CommandParameter="LastRun"
                                        Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Left" Cursor="Hand">
                                    <TextBlock Text="LAST RUN ↕" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkFaint}"/>
                                </Button>

                                <Button Grid.Column="6" Command="{Binding SortJobsByCommand}" CommandParameter="Status"
                                        Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Left" Cursor="Hand">
                                    <TextBlock Text="STATUS ↕" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkFaint}"/>
                                </Button>

                                <Button Grid.Column="7" Command="{Binding SortJobsByCommand}" CommandParameter="NextRun"
                                        Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Left" Cursor="Hand">
                                    <TextBlock Text="NEXT RUN ↕" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkFaint}"/>
                                </Button>

                                <TextBlock Grid.Column="8" Text="ACTIONS" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkFaint}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Filtered Empty State -->
                        <StackPanel Visibility="{Binding HasNoFilteredJobs, Converter={StaticResource BoolToVis}}"
                                    Margin="32,40" HorizontalAlignment="Center">
                            <TextBlock Text="No matching backup jobs" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCardHeader}" Foreground="{DynamicResource BrushInk}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Try adjusting your search query or active status filter." FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}" HorizontalAlignment="Center" Margin="0,4,0,14"/>
                            <Button Content="Clear filters" Command="{Binding ResetJobsFiltersCommand}" Style="{StaticResource BtnQuiet}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Table Rows (Paginated) -->
                        <ItemsControl ItemsSource="{Binding JobsPagedRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:JobCardViewModel}">
                                    <Border BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- 3px Left Status Accent -->
                                            <Border Grid.Row="0" Grid.RowSpan="3" Width="3" HorizontalAlignment="Left" Background="{Binding StatusBrush}"/>

                                            <!-- Main Table Row -->
                                            <Border Grid.Row="0" Padding="18,13" Cursor="Hand" MouseLeftButtonUp="JobRow_Click">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource BrushRaised}"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34"/>
                                                        <ColumnDefinition Width="1.4*" MinWidth="170"/>
                                                        <ColumnDefinition Width="105"/>
                                                        <ColumnDefinition Width="1.2*" MinWidth="140"/>
                                                        <ColumnDefinition Width="125"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="105"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="105"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Checkbox -->
                                                    <CheckBox Grid.Column="0"
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              VerticalAlignment="Center"/>

                                                    <!-- Job Name -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding Name, Mode=OneWay}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="{StaticResource FontSizeBody}"
                                                                   Foreground="{DynamicResource BrushInk}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding DestinationsDisplay}"
                                                                   FontSize="{StaticResource FontSizeCaption}"
                                                                   Foreground="{DynamicResource BrushInkFaint}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,2,0,0"/>
                                                    </StackPanel>

                                                    <!-- Type Chip -->
                                                    <Border Grid.Column="2" Style="{StaticResource BadgePill}" Background="{Binding KindSoftBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="8,4">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{Binding KindIconGeometry}" Fill="{Binding KindBrush}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                            <TextBlock Text="{Binding KindChipName}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}" Foreground="{Binding KindBrush}"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Source -->
                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding EffectiveSourcePath}"
                                                               FontFamily="{StaticResource FontFamilyMono}"
                                                               FontSize="{StaticResource FontSizeMono}"
                                                               Foreground="{DynamicResource BrushInkMuted}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,10,0"
                                                               ToolTip="{Binding EffectiveSourcePath}"/>

                                                    <!-- Schedule -->
                                                    <TextBlock Grid.Column="4"
                                                               Text="{Binding ScheduleDisplay}"
                                                               FontSize="{StaticResource FontSizeSecondary}"
                                                               Foreground="{DynamicResource BrushInk}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,10,0"/>

                                                    <!-- Last Run -->
                                                    <StackPanel Grid.Column="5" VerticalAlignment="Center" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding LastRunDisplay}" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInk}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding ArchiveSizeDisplay}" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkFaint}" Margin="0,1,0,0"/>
                                                    </StackPanel>

                                                    <!-- Status Pill -->
                                                    <Border Grid.Column="6" Style="{StaticResource BadgePill}" Background="{Binding StatusBadgeSoftBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="8,4">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="7" Height="7" Fill="{Binding StatusBadgeBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding StatusBadgeText}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}" Foreground="{Binding StatusBadgeBrush}"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Next Run -->
                                                    <TextBlock Grid.Column="7"
                                                               Text="{Binding NextRunDisplay}"
                                                               FontSize="{StaticResource FontSizeSecondary}"
                                                               Foreground="{DynamicResource BrushInkMuted}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0"/>

                                                    <!-- Actions -->
                                                    <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                        <Button Command="{Binding DataContext.RunJobCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource BtnQuiet}"
                                                                Height="30" Padding="9,0" Margin="0,0,5,0"
                                                                ToolTip="Run this backup job now">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Path Data="{StaticResource IconPlay}" Fill="{DynamicResource BrushInkMuted}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,4,0"/>
                                                                <TextBlock Text="Run" FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold"/>
                                                            </StackPanel>
                                                        </Button>

                                                        <Button Style="{StaticResource IconBtn}" Click="MenuButton_Click" ToolTip="More job actions" Width="30" Height="30">
                                                            <Path Data="{StaticResource IconDotsHorizontal}" Fill="{DynamicResource BrushInkMuted}" Width="16" Height="16" Stretch="Uniform"/>
                                                            <Button.ContextMenu>
                                                                <ContextMenu>
                                                                    <MenuItem Header="View details" Click="ViewDetails_Click"/>
                                                                    <MenuItem Header="Run now" Click="RunFull_Click"/>
                                                                    <MenuItem Header="Run differential backup" Click="RunDiff_Click" Visibility="{Binding IsSqlServer, Converter={StaticResource BoolToVis}}"/>
                                                                    <MenuItem Header="Run log backup" Click="RunLog_Click" Visibility="{Binding IsSqlServer, Converter={StaticResource BoolToVis}}"/>
                                                                    <Separator/>
                                                                    <MenuItem Header="Edit job" Click="EditJob_Click"/>
                                                                    <MenuItem Header="Duplicate job" Click="DuplicateJob_Click"/>
                                                                    <MenuItem Header="{Binding ToggleActionText}" Click="TogglePause_Click"/>
                                                                    <MenuItem Header="View execution history" Click="ViewHistory_Click"/>
                                                                    <Separator/>
                                                                    <MenuItem Header="Delete job" Click="DeleteJob_Click" Foreground="{DynamicResource BrushCoral}"/>
                                                                </ContextMenu>
                                                            </Button.ContextMenu>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Inline Running Progress -->
                                            <Border Grid.Row="1" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" Background="{DynamicResource BrushRaised}" Padding="18,8">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                        <TextBlock Text="{Binding CurrentPhase}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushCobalt}"/>
                                                        <TextBlock Text=" — backup in progress" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}"/>
                                                    </StackPanel>
                                                    <ProgressBar Height="6" Value="{Binding CurrentPercent}" Maximum="100" Foreground="{DynamicResource BrushCobalt}" Background="{DynamicResource BrushSunken}"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Inline Delete Confirmation -->
                                            <Border Grid.Row="2" Visibility="{Binding IsDeletingInline, Converter={StaticResource BoolToVis}}"
                                                    Background="{DynamicResource BrushCoralSoft}" BorderBrush="{DynamicResource BrushCoral}" BorderThickness="0,1,0,0" Padding="18,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushCoral}">
                                                        Delete <Bold><Run Text="{Binding Name, Mode=OneWay}"/></Bold>? Cloud archives remain untouched.
                                                    </TextBlock>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <Button Content="Cancel" Command="{Binding CancelInlineDeleteCommand}" Style="{StaticResource BtnQuiet}" Height="30" Margin="0,0,8,0"/>
                                                        <Button Content="Delete job" Command="{Binding DataContext.DeleteJobConfirmedCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" Style="{StaticResource BtnDanger}" Height="30"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Pagination & Page Size Footer -->
                        <Border Padding="18,12" Background="{DynamicResource BrushRaised}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding JobsPaginationSummary}"
                                               FontSize="{StaticResource FontSizeSecondary}"
                                               Foreground="{DynamicResource BrushInkMuted}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,16,0"/>
                                    <TextBlock Text="Rows per page:"
                                               FontSize="{StaticResource FontSizeCaption}"
                                               Foreground="{DynamicResource BrushInkFaint}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>
                                    <ComboBox ItemsSource="{Binding AvailableJobsPageSizes}"
                                              SelectedItem="{Binding JobsPageSize}"
                                              Width="62" Height="28"
                                              FontSize="{StaticResource FontSizeCaption}"
                                              VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="«" Command="{Binding JobsFirstPageCommand}" IsEnabled="{Binding CanJobsPrevPage}" Style="{StaticResource BtnQuiet}" Height="28" Width="30" Padding="0" Margin="0,0,4,0"/>
                                    <Button Content="‹ Prev" Command="{Binding JobsPrevPageCommand}" IsEnabled="{Binding CanJobsPrevPage}" Style="{StaticResource BtnQuiet}" Height="28" Padding="10,0" FontSize="{StaticResource FontSizeCaption}" Margin="0,0,8,0"/>
                                    <TextBlock VerticalAlignment="Center" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInk}" Margin="0,0,8,0">
                                        <Run Text="Page"/>
                                        <Run Text="{Binding JobsCurrentPage, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text="of"/>
                                        <Run Text="{Binding JobsTotalPages, Mode=OneWay}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                    <Button Content="Next ›" Command="{Binding JobsNextPageCommand}" IsEnabled="{Binding CanJobsNextPage}" Style="{StaticResource BtnQuiet}" Height="28" Padding="10,0" FontSize="{StaticResource FontSizeCaption}" Margin="0,0,4,0"/>
                                    <Button Content="»" Command="{Binding JobsLastPageCommand}" IsEnabled="{Binding CanJobsNextPage}" Style="{StaticResource BtnQuiet}" Height="28" Width="30" Padding="0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ===================================================================
             6. JOB DETAILS FLYOUT / MODAL OVERLAY (§7)
             =================================================================== -->
        <Grid Visibility="{Binding IsJobDetailsOpen, Converter={StaticResource BoolToVis}}"
              Background="#660B1420">
            <Border MaxWidth="680" MaxHeight="660"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Style="{StaticResource Card}" Padding="24"
                    Effect="{StaticResource Sh2}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Flyout Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedJobDetails.Name}"
                                           FontWeight="SemiBold" FontSize="{StaticResource FontSizeSectionHeader}"
                                           Foreground="{DynamicResource BrushInk}"/>
                                <Border Style="{StaticResource BadgePill}" Background="{Binding SelectedJobDetails.KindSoftBrush}" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedJobDetails.KindChipName}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}" Foreground="{Binding SelectedJobDetails.KindBrush}"/>
                                </Border>
                                <Border Style="{StaticResource BadgePill}" Background="{Binding SelectedJobDetails.StatusBadgeSoftBrush}" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedJobDetails.StatusBadgeText}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}" Foreground="{Binding SelectedJobDetails.StatusBadgeBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedJobDetails.EffectiveSourcePath}"
                                       FontFamily="{StaticResource FontFamilyMono}" FontSize="{StaticResource FontSizeMono}"
                                       Foreground="{DynamicResource BrushInkMuted}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1" Command="{Binding CloseJobDetailsCommand}" Style="{StaticResource IconBtn}" Width="32" Height="32" VerticalAlignment="Top">
                            <Path Data="{StaticResource IconClose}" Fill="{DynamicResource BrushInkMuted}" Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                    </Grid>

                    <!-- Flyout Body -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                        <StackPanel>
                            <!-- Configuration Summary Grid -->
                            <Border Background="{DynamicResource BrushRaised}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="BACKUP DESTINATION" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushInkFaint}"/>
                                        <TextBlock Text="{Binding SelectedJobDetails.DestinationsDisplay}" FontWeight="Medium" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInk}" Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="1">
                                        <TextBlock Text="SCHEDULE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushInkFaint}"/>
                                        <TextBlock Text="{Binding SelectedJobDetails.ScheduleDisplay}" FontWeight="Medium" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInk}" Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="RETENTION" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushInkFaint}"/>
                                        <TextBlock Text="{Binding SelectedJobDetails.RetentionDisplay}" FontWeight="Medium" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInk}" Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="1">
                                        <TextBlock Text="ENCRYPTION" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushInkFaint}"/>
                                        <TextBlock Text="{Binding SelectedJobDetails.EncryptionDisplay}" FontWeight="Medium" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInk}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Last Execution Telemetry -->
                            <Border Background="{DynamicResource BrushRaised}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="LAST RESULT" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushInkFaint}"/>
                                        <TextBlock Text="{Binding SelectedJobDetails.StatusText}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSecondary}" Foreground="{Binding SelectedJobDetails.StatusBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="DURATION" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushInkFaint}"/>
                                        <TextBlock Text="{Binding SelectedJobDetails.DurationDisplay}" FontWeight="Medium" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInk}" Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="BACKUP SIZE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushInkFaint}"/>
                                        <TextBlock Text="{Binding SelectedJobDetails.ArchiveSizeDisplay}" FontWeight="Medium" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInk}" Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="NEXT RUN" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushInkFaint}"/>
                                        <TextBlock Text="{Binding SelectedJobDetails.NextRunDisplay}" FontWeight="Medium" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInk}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Recent Execution History -->
                            <TextBlock Text="Recent Execution History" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInk}" Margin="0,0,0,8"/>

                            <Border Background="{DynamicResource BrushSunken}" CornerRadius="8" Padding="14,12"
                                    Visibility="{Binding HasSelectedJobHistory, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="No execution records logged for this job yet." FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkFaint}" HorizontalAlignment="Center"/>
                            </Border>

                            <ItemsControl ItemsSource="{Binding SelectedJobRecentHistory}" Visibility="{Binding HasSelectedJobHistory, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,0,0,1" Padding="4,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="90"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" FontFamily="{StaticResource FontFamilyMono}" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkMuted}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Status}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInk}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Trigger}" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkFaint}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding DurationSeconds, StringFormat='{}{0:F0}s'}" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkMuted}" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Flyout Footer Actions -->
                    <Border Grid.Row="2" BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                        <Grid>
                            <Button Content="View logs" Command="{Binding ViewSelectedJobLogsCommand}" Style="{StaticResource BtnQuiet}" HorizontalAlignment="Left"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Edit configuration" Command="{Binding EditSelectedJobDetailsCommand}" Style="{StaticResource BtnQuiet}" Margin="0,0,8,0"/>
                                <Button Content="Run now" Command="{Binding RunSelectedJobDetailsCommand}" Style="{StaticResource BtnPrimary}" Margin="0,0,8,0"/>
                                <Button Content="Close" Command="{Binding CloseJobDetailsCommand}" Style="{StaticResource BtnQuiet}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
