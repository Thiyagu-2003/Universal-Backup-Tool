<UserControl x:Class="UniBackup.UI.Views.AnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:UniBackup.UI.Controls"
             xmlns:vm="clr-namespace:UniBackup.UI.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,24">
        <StackPanel MaxWidth="1280" HorizontalAlignment="Stretch">

            <!-- 1. Header & Actions -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Analytics &amp; History" FontWeight="SemiBold" FontSize="{StaticResource FontSizeH1}" Foreground="{DynamicResource BrushInk}"/>
                    <TextBlock Text="30-day operational telemetry, failure rates, and execution log records" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,3,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Content="Export CSV" Command="{Binding ExportHistoryCsvCommand}" Style="{StaticResource BtnQuiet}" Height="36" Padding="14,0"/>
            </Grid>

            <!-- 2. Four KPI Cards (30 Days) -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <controls:KpiCard Grid.Column="0" Title="Runs (30 days)" Value="{Binding TotalRunsCount, StringFormat={}{0}}" SubText="Total executions"
                                  Icon="{StaticResource IconClock}" TileBrush="{DynamicResource BrushCobalt}"/>

                <controls:KpiCard Grid.Column="2" Title="Succeeded" Value="{Binding SuccessRateDisplay}" SubText="Clean completions"
                                  Icon="{StaticResource IconCheck}" TileBrush="{DynamicResource BrushJade}"/>

                <controls:KpiCard Grid.Column="4" Title="Failed or partial" Value="{Binding NeedsAttentionCount, StringFormat={}{0}}" SubText="Required attention"
                                  Icon="{StaticResource IconWarningCircle}" TileBrush="{DynamicResource BrushCoral}"/>

                <controls:KpiCard Grid.Column="6" Title="Uploaded" Value="{Binding TotalUploadedDisplay}" SubText="Stored in cloud"
                                  Icon="{StaticResource IconCloud}" TileBrush="{DynamicResource BrushOrchid}"/>
            </Grid>

            <!-- 3. Problems-Per-Day Chart -->
            <Border Style="{StaticResource Card}" Padding="24" Margin="0,0,0,24">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Problems per day" FontWeight="SemiBold" FontSize="{StaticResource FontSizeH2}" Foreground="{DynamicResource BrushInk}"/>
                            <TextBlock Text="Partial and failed executions over the last 30 days (healthy days show clean baseline)"
                                       FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Legend -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Stretch="Uniform" Fill="{DynamicResource BrushSaffron}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Partial" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,0,14,0"/>
                            <Ellipse Width="8" Height="8" Stretch="Uniform" Fill="{DynamicResource BrushCoral}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Failed" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Baseline Chart Canvas -->
                    <Border Height="70" Background="{DynamicResource BrushRaised}" CornerRadius="8" Padding="14,10">
                        <Grid>
                            <!-- Baseline (3 px grey) -->
                            <Border Height="3" Background="{DynamicResource BrushLineStrong}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>

                            <!-- Sample problem bars stack -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10,0,0,4">
                                <!-- Day 1-8: Clean -->
                                <Border Width="16" Height="3" Margin="0,0,12,0"/>
                                <Border Width="16" Height="3" Margin="0,0,12,0"/>
                                <Border Width="16" Height="3" Margin="0,0,12,0"/>
                                <Border Width="16" Height="3" Margin="0,0,12,0"/>
                                <!-- Day 9: Saffron Partial -->
                                <Border Width="16" Height="22" Background="{DynamicResource BrushSaffron}" CornerRadius="3,3,0,0" Margin="0,0,12,0"/>
                                <!-- Day 10-18: Clean -->
                                <Border Width="16" Height="3" Margin="0,0,12,0"/>
                                <Border Width="16" Height="3" Margin="0,0,12,0"/>
                                <Border Width="16" Height="3" Margin="0,0,12,0"/>
                                <Border Width="16" Height="3" Margin="0,0,12,0"/>
                                <!-- Day 19: Coral Failed -->
                                <Border Width="16" Height="38" Background="{DynamicResource BrushCoral}" CornerRadius="3,3,0,0" Margin="0,0,12,0"/>
                                <!-- Day 20-29: Clean -->
                                <Border Width="16" Height="3" Margin="0,0,12,0"/>
                                <Border Width="16" Height="3" Margin="0,0,12,0"/>
                                <Border Width="16" Height="3" Margin="0,0,12,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 4. Run History Table -->
            <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                <StackPanel>
                    <!-- Table Header -->
                    <Border Background="{DynamicResource BrushRaised}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,0,0,1" Padding="20,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/> <!-- Started -->
                                <ColumnDefinition Width="200"/> <!-- Job -->
                                <ColumnDefinition Width="90"/>  <!-- Type -->
                                <ColumnDefinition Width="110"/> <!-- Result -->
                                <ColumnDefinition Width="100"/> <!-- Size -->
                                <ColumnDefinition Width="100"/> <!-- Duration -->
                                <ColumnDefinition Width="*"/>   <!-- Output / Detail -->
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Started" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                            <TextBlock Grid.Column="1" Text="Job" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                            <TextBlock Grid.Column="2" Text="Type" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                            <TextBlock Grid.Column="3" Text="Result" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                            <TextBlock Grid.Column="4" Text="Size" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                            <TextBlock Grid.Column="5" Text="Duration" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                            <TextBlock Grid.Column="6" Text="Output" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                        </Grid>
                    </Border>

                    <!-- Table Rows -->
                    <ItemsControl ItemsSource="{Binding HistoryRecords}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,0,0,1" Padding="20,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeMono}" Foreground="{DynamicResource BrushInkMuted}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding JobName}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushInk}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding BackupType}" FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeMono}" Foreground="{DynamicResource BrushInkMuted}" VerticalAlignment="Center"/>

                                        <Border Grid.Column="3" Style="{StaticResource BadgePill}" Background="{Binding Status, Converter={StaticResource StatusToBrushConverter}, ConverterParameter=soft}" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Status}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBadge}" Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"/>
                                        </Border>

                                        <TextBlock Grid.Column="4" Text="{Binding SizeBytes, Converter={StaticResource BytesToStringConverter}}" FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeMono}" Foreground="{DynamicResource BrushInk}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="{Binding DurationSeconds, Converter={StaticResource DurationConverter}}" FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeMono}" Foreground="{DynamicResource BrushInkMuted}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="6" Text="{Binding OutputSummary}" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkFaint}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
