<UserControl x:Class="UniBackup.UI.Views.AnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:UniBackup.UI.Controls"
             xmlns:conv="clr-namespace:UniBackup.UI.Converters"
             xmlns:vm="clr-namespace:UniBackup.UI.ViewModels"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
        <conv:StringEqualsToBoolConverter x:Key="StringEqualsToBool"/>
        <conv:InvertedZeroToVisibilityConverter x:Key="InvertedZeroToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,24">
        <StackPanel MaxWidth="1280" HorizontalAlignment="Stretch">

            <!-- ===================================================================
                 1. HEADER & DATE-RANGE TOOLBAR (§2)
                 =================================================================== -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Page Titles -->
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Analytics &amp; History" FontWeight="SemiBold" FontSize="{StaticResource FontSizePageTitle}" Foreground="{DynamicResource BrushInk}"/>
                    <TextBlock Text="Track your backup activity, monitor operational health, and inspect detailed history" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Action Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Export Report Split Button / Dropdown -->
                    <Button Command="{Binding ExportSummaryReportCommand}" Style="{StaticResource BtnQuiet}" Height="36" Padding="14,0" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconDocument}" Fill="{DynamicResource BrushCobalt}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Summary report"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ExportCsvCommand}" Style="{StaticResource BtnQuiet}" Height="36" Padding="14,0" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconCloudArrowDown}" Fill="{DynamicResource BrushCobalt}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Export CSV"/>
                        </StackPanel>
                    </Button>

                    <!-- Refresh Button -->
                    <Button Command="{Binding RefreshCommand}" Style="{StaticResource BtnQuiet}" Width="36" Height="36" Padding="0">
                        <Path Data="{StaticResource IconRefresh}" Fill="{DynamicResource BrushInkMuted}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Date Range Selector Bar -->
            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Presets Pill Container -->
                    <Border Style="{StaticResource SegmentedContainer}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Today" Style="{StaticResource SegmentedItem}" IsChecked="{Binding IsPresetToday, Mode=OneWay}" Click="DatePreset_Click" Tag="Today"/>
                            <RadioButton Content="Last 7 days" Style="{StaticResource SegmentedItem}" IsChecked="{Binding IsPreset7Days, Mode=OneWay}" Click="DatePreset_Click" Tag="Last7Days"/>
                            <RadioButton Content="Last 30 days" Style="{StaticResource SegmentedItem}" IsChecked="{Binding IsPreset30Days, Mode=OneWay}" Click="DatePreset_Click" Tag="Last30Days"/>
                            <RadioButton Content="Last 90 days" Style="{StaticResource SegmentedItem}" IsChecked="{Binding IsPreset90Days, Mode=OneWay}" Click="DatePreset_Click" Tag="Last90Days"/>
                            <RadioButton Content="Custom range" Style="{StaticResource SegmentedItem}" IsChecked="{Binding IsPresetCustom, Mode=OneWay}" Click="DatePreset_Click" Tag="Custom"/>
                        </StackPanel>
                    </Border>

                    <!-- Date Span Label -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Path Data="{StaticResource IconClock}" Fill="{DynamicResource BrushInkFaint}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DateRangeDisplay}" FontWeight="Medium" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Custom Range Date Pickers (visible only when Custom is chosen) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsCustomDateRange, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="From:" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker SelectedDate="{Binding StartDate, Mode=TwoWay}" Height="30" Width="110" Margin="0,0,10,0"/>
                        <TextBlock Text="To:" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker SelectedDate="{Binding EndDate, Mode=TwoWay}" Height="30" Width="110" Margin="0,0,10,0"/>
                        <Button Content="Apply" Command="{Binding ApplyCustomDateRangeCommand}" Style="{StaticResource BtnPrimary}" Height="30" Padding="12,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===================================================================
                 2. FOUR MODERN KPI STATISTIC CARDS (§2)
                 =================================================================== -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- KPI 1: Total Backups -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="Total Backups" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}"/>
                            <Border HorizontalAlignment="Right" Style="{StaticResource BadgePill}" Background="{DynamicResource BrushCobaltSoft}" Padding="6,2">
                                <TextBlock Text="{Binding TotalBackupsDeltaDisplay}" FontSize="{StaticResource FontSizeCaption}" FontWeight="Medium" Foreground="{DynamicResource BrushCobalt}"/>
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding TotalBackupsCount}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeKpi}" Foreground="{DynamicResource BrushInk}" Margin="0,6,0,2"/>
                        <TextBlock Grid.Row="2" Text="Total executions in period" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkFaint}"/>
                    </Grid>
                </Border>

                <!-- KPI 2: Successful -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="Successful" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}"/>
                            <!-- Circular / Donut Indicator -->
                            <Border HorizontalAlignment="Right" Style="{StaticResource BadgePill}" Background="{DynamicResource BrushJadeSoft}" Padding="6,2">
                                <TextBlock Text="{Binding SuccessRateDisplay}" FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource BrushJade}"/>
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding SuccessfulCount}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeKpi}" Foreground="{DynamicResource BrushJade}" Margin="0,6,0,2"/>
                        <TextBlock Grid.Row="2" Text="Clean error-free backups" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkFaint}"/>
                    </Grid>
                </Border>

                <!-- KPI 3: Failed / Attention -->
                <Border Grid.Column="4" Style="{StaticResource Card}" Padding="20,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="Failed &amp; Partial" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}"/>
                            <Border HorizontalAlignment="Right" Style="{StaticResource BadgePill}" Background="{DynamicResource BrushCoralSoft}" Padding="6,2">
                                <TextBlock Text="{Binding FailureRateDisplay}" FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource BrushCoral}"/>
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding FailedCount}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeKpi}" Foreground="{DynamicResource BrushCoral}" Margin="0,6,0,2"/>
                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <TextBlock Text="{Binding PartialCount, StringFormat='{}{0} partial'}" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushSaffron}"/>
                            <TextBlock Text=" · requires review" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkFaint}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- KPI 4: Total Data Backed Up -->
                <Border Grid.Column="6" Style="{StaticResource Card}" Padding="20,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="Total Data" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}"/>
                            <Border HorizontalAlignment="Right" Style="{StaticResource BadgePill}" Background="{DynamicResource BrushCobaltSoft}" Padding="6,2">
                                <TextBlock Text="{Binding AvgRunSizeDisplay}" FontSize="{StaticResource FontSizeCaption}" FontWeight="Medium" Foreground="{DynamicResource BrushCobalt}"/>
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding TotalDataDisplay}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeKpi}" Foreground="{DynamicResource BrushCobalt}" Margin="0,6,0,2"/>
                        <TextBlock Grid.Row="2" Text="Stored across all destinations" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkFaint}"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===================================================================
                 3. INTERACTIVE CHARTS ROW (LiveCharts2) (§2)
                 =================================================================== -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Chart 1: Backup Activity Over Time (Line / Area) -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Daily Backup Activity" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSectionHeader}" Foreground="{DynamicResource BrushInk}"/>
                                <TextBlock Text="Execution volume and failure trends across the selected reporting window" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Legend -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource BrushJade}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Successful" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,0,14,0"/>
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource BrushCoral}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Failed / Attention" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkMuted}"/>
                            </StackPanel>
                        </Grid>

                        <!-- LiveCharts2 Cartesian Chart -->
                        <lvc:CartesianChart Series="{Binding ActivitySeries}"
                                            XAxes="{Binding ActivityXAxes}"
                                            YAxes="{Binding ActivityYAxes}"
                                            Height="210"
                                            MinHeight="200"/>
                    </StackPanel>
                </Border>

                <!-- Chart 2: Backup by Type (Doughnut Chart) -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Backup by Type" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSectionHeader}" Foreground="{DynamicResource BrushInk}"/>
                        <TextBlock Text="Distribution across backup categories" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,10"/>

                        <!-- LiveCharts2 Doughnut Chart -->
                        <lvc:PieChart Series="{Binding BackupTypeSeries}"
                                      Height="140"
                                      InitialRotation="-90"
                                      MaxAngle="360"/>

                        <!-- Type Legend Items -->
                        <ItemsControl ItemsSource="{Binding BackupTypeSlices}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="8" Height="8" Fill="{Binding ColorBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkMuted}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Count, StringFormat='{}{0} runs'}" FontSize="{StaticResource FontSizeCaption}" FontWeight="Medium" Foreground="{DynamicResource BrushInk}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="3" Text="{Binding PercentageDisplay}" FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource BrushInkFaint}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===================================================================
                 4. BACKUP SYSTEM HEALTH PANEL (§2)
                 =================================================================== -->
            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Engine Status -->
                    <StackPanel Grid.Column="0" Margin="10,0">
                        <TextBlock Text="BACKUP ENGINE" FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource BrushInkFaint}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Ellipse Width="8" Height="8" Fill="{Binding SystemHealth.EngineStatusBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SystemHealth.EngineStatus}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushInk}"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" Background="{DynamicResource BrushLine}"/>

                    <!-- Task Scheduler -->
                    <StackPanel Grid.Column="2" Margin="16,0,10,0">
                        <TextBlock Text="SCHEDULER STATUS" FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource BrushInkFaint}"/>
                        <TextBlock Text="{Binding SystemHealth.SchedulerStatus}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushInk}" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding SystemHealth.SchedulerNextRun}" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkMuted}"/>
                    </StackPanel>

                    <Border Grid.Column="3" Background="{DynamicResource BrushLine}"/>

                    <!-- Cloud Storage Connectivity -->
                    <StackPanel Grid.Column="4" Margin="16,0,10,0">
                        <TextBlock Text="CLOUD STORAGE" FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource BrushInkFaint}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Ellipse Width="8" Height="8" Fill="{Binding SystemHealth.StorageStatusBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SystemHealth.StorageConnectivity}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushInk}"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="5" Background="{DynamicResource BrushLine}"/>

                    <!-- Last Successful Run -->
                    <StackPanel Grid.Column="6" Margin="16,0,10,0">
                        <TextBlock Text="LAST SUCCESSFUL BACKUP" FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource BrushInkFaint}"/>
                        <TextBlock Text="{Binding SystemHealth.LastSuccessfulBackup}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushInk}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding SystemHealth.HealthHeadline}" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkMuted}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===================================================================
                 5. RECENT ACTIVITY TABLE & PAGINATION (§2)
                 =================================================================== -->
            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <!-- Table Toolbar -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="260"/>
                        </Grid.ColumnDefinitions>

                        <!-- Status Filter Pills -->
                        <Border Style="{StaticResource SegmentedContainer}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="All" GroupName="ActivityStatusFilter" Click="FilterStatus_Click" Tag="All" Style="{StaticResource SegmentedItem}" IsChecked="{Binding StatusFilter, Converter={StaticResource StringEqualsToBool}, ConverterParameter=All, Mode=OneWay}"/>
                                <RadioButton Content="Success" GroupName="ActivityStatusFilter" Click="FilterStatus_Click" Tag="SUCCESS" Style="{StaticResource SegmentedItem}" IsChecked="{Binding StatusFilter, Converter={StaticResource StringEqualsToBool}, ConverterParameter=SUCCESS, Mode=OneWay}"/>
                                <RadioButton Content="Failed" GroupName="ActivityStatusFilter" Click="FilterStatus_Click" Tag="FAILED" Style="{StaticResource SegmentedItem}" IsChecked="{Binding StatusFilter, Converter={StaticResource StringEqualsToBool}, ConverterParameter=FAILED, Mode=OneWay}"/>
                                <RadioButton Content="Partial" GroupName="ActivityStatusFilter" Click="FilterStatus_Click" Tag="PARTIAL" Style="{StaticResource SegmentedItem}" IsChecked="{Binding StatusFilter, Converter={StaticResource StringEqualsToBool}, ConverterParameter=PARTIAL, Mode=OneWay}"/>
                            </StackPanel>
                        </Border>

                        <!-- Search Box -->
                        <TextBox Grid.Column="2"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Search backups by job, type, status..."
                                 Style="{StaticResource FieldInput}"
                                 Height="34"/>
                    </Grid>

                    <!-- Activity DataGrid -->
                    <DataGrid ItemsSource="{Binding PagedActivityRows}"
                              SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              Background="Transparent"
                              BorderBrush="{DynamicResource BrushLine}"
                              BorderThickness="1"
                              RowHeight="36"
                              MouseDoubleClick="DataGrid_MouseDoubleClick"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <!-- Date & Time -->
                            <DataGridTextColumn Header="Date &amp; Time" Binding="{Binding TimestampDisplay}" Width="160"/>

                            <!-- Job Name -->
                            <DataGridTextColumn Header="Job Name" Binding="{Binding JobName}" Width="220">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Backup Type -->
                            <DataGridTextColumn Header="Backup Type" Binding="{Binding BackupTypeDisplay}" Width="120"/>

                            <!-- Status Badge -->
                            <DataGridTemplateColumn Header="Status" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource BadgePill}" Background="{Binding StatusSoftBrush}" HorizontalAlignment="Left" Padding="8,2">
                                            <TextBlock Text="{Binding StatusDisplay}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}" Foreground="{Binding StatusBrush}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Size -->
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="100"/>

                            <!-- Duration -->
                            <DataGridTextColumn Header="Duration" Binding="{Binding DurationDisplay}" Width="90"/>

                            <!-- Destinations Summary -->
                            <DataGridTextColumn Header="Destinations" Binding="{Binding DestinationsSummary}" Width="*"/>

                            <!-- Action Column: View Details -->
                            <DataGridTemplateColumn Header="Action" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Details" Click="ViewDetailsButton_Click" Style="{StaticResource BtnQuiet}" Height="24" Padding="8,0" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty State (if no records match) -->
                    <Border Visibility="{Binding FilteredActivityRows.Count, Converter={StaticResource InvertedZeroToVis}}"
                            Background="{DynamicResource BrushSunken}" CornerRadius="8" Padding="28" Margin="0,8,0,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="No backup activity records found for the selected filter or date range." FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushInkMuted}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Try adjusting your date range preset or clearing your search query." FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkFaint}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Pagination Toolbar -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding PaginationSummary}" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="«" Command="{Binding FirstPageCommand}" IsEnabled="{Binding CanGoPrev}" Style="{StaticResource BtnQuiet}" Width="32" Height="30" Margin="0,0,4,0"/>
                            <Button Content="‹ Prev" Command="{Binding PrevPageCommand}" IsEnabled="{Binding CanGoPrev}" Style="{StaticResource BtnQuiet}" Height="30" Padding="10,0" Margin="0,0,6,0"/>
                            <Border Background="{DynamicResource BrushRaised}" CornerRadius="6" Padding="10,4" Margin="0,0,6,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentPage, StringFormat='{}Page {0}'}" FontWeight="Medium" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInk}"/>
                            </Border>
                            <Button Content="Next ›" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}" Style="{StaticResource BtnQuiet}" Height="30" Padding="10,0" Margin="0,0,4,0"/>
                            <Button Content="»" Command="{Binding LastPageCommand}" IsEnabled="{Binding CanGoNext}" Style="{StaticResource BtnQuiet}" Width="32" Height="30"/>
                        </StackPanel>
                    </Grid>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
