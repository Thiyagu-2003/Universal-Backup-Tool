<UserControl x:Class="UniBackup.UI.Views.NotificationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:UniBackup.UI.ViewModels">

    <UserControl.Resources>
        <Style x:Key="StatusToggleSwitchBase" TargetType="{x:Type CheckBox}">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Border x:Name="Track"
                                Width="42" Height="22"
                                CornerRadius="11"
                                Background="{DynamicResource BrushSunken}"
                                BorderBrush="{DynamicResource BrushLineStrong}"
                                BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <Border x:Name="Thumb"
                                    Width="16" Height="16"
                                    CornerRadius="8"
                                    Background="#FFFFFF"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="2,0,0,0"
                                    Effect="{StaticResource Sh1}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GreenToggleSwitch" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource StatusToggleSwitchBase}">
            <Setter Property="Foreground" Value="{DynamicResource BrushJade}"/>
        </Style>

        <Style x:Key="OrangeToggleSwitch" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource StatusToggleSwitchBase}">
            <Setter Property="Foreground" Value="{DynamicResource BrushSaffron}"/>
        </Style>

        <Style x:Key="RedToggleSwitch" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource StatusToggleSwitchBase}">
            <Setter Property="Foreground" Value="{DynamicResource BrushCoral}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,20">
            <StackPanel MaxWidth="1320" HorizontalAlignment="Stretch">

                <!-- ===================================================================
                     1. HEADER & COMPACT SUMMARY CARDS (§2)
                     =================================================================== -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Notifications"
                               FontWeight="SemiBold"
                               FontSize="{StaticResource FontSizePageTitle}"
                               Foreground="{DynamicResource BrushInk}"/>
                    <TextBlock Text="Configure notification channels and choose when UniBackup Pro should send backup alerts."
                               FontSize="{StaticResource FontSizeBody}"
                               Foreground="{DynamicResource BrushInkMuted}"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <!-- 4 Compact Summary Cards -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource BrushCobaltSoft}" Margin="0,0,12,0">
                                <Path Data="{StaticResource IconNotifications}" Fill="{DynamicResource BrushCobalt}" Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Configured channels" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkMuted}"/>
                                <TextBlock Text="{Binding ConfiguredChannelsCount}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSectionHeader}" Foreground="{DynamicResource BrushInk}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource BrushJadeSoft}" Margin="0,0,12,0">
                                <Path Data="{StaticResource IconCheckCircle}" Fill="{DynamicResource BrushJade}" Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Active channels" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkMuted}"/>
                                <TextBlock Text="{Binding ActiveChannelsCount}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSectionHeader}" Foreground="{DynamicResource BrushJade}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource Card}" Padding="14,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource BrushCoralSoft}" Margin="0,0,12,0">
                                <Path Data="{StaticResource IconWarningCircle}" Fill="{DynamicResource BrushCoral}" Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Failed notifications" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkMuted}"/>
                                <TextBlock Text="{Binding FailedTestNotificationsCount}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSectionHeader}" Foreground="{DynamicResource BrushCoral}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="6" Style="{StaticResource Card}" Padding="14,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource BrushSunken}" Margin="0,0,12,0">
                                <Path Data="{StaticResource IconClock}" Fill="{DynamicResource BrushInkMuted}" Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Last activity" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkMuted}"/>
                                <TextBlock Text="{Binding LastNotificationActivityDisplay}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInk}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ===================================================================
                     2. FLOATING PROVIDER SUBMENU + CONFIGURATION PANEL (§3 & §4)
                     =================================================================== -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="264"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Floating Provider Navigation Submenu -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10" VerticalAlignment="Top" Effect="{StaticResource Sh1}">
                        <StackPanel>
                            <TextBlock Text="PROVIDERS" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource BrushInkFaint}" Margin="8,4,0,8"/>

                            <!-- 1. Email -->
                            <RadioButton GroupName="ProviderNav" Style="{StaticResource ChannelListItem}" IsChecked="{Binding IsProviderEmail, Mode=OneWay}"
                                         Command="{Binding SelectNotificationProviderCommand}" CommandParameter="Email" Margin="0,0,0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource BrushCobaltSoft}">
                                        <Path Data="{StaticResource IconEmail}" Fill="{DynamicResource BrushCobalt}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="Email (SMTP)" FontWeight="Medium" FontSize="{StaticResource FontSizeNavLabel}" VerticalAlignment="Center"/>
                                    <Ellipse Grid.Column="3" Width="7" Height="7" VerticalAlignment="Center"
                                             Fill="{DynamicResource BrushJade}"
                                             Visibility="{Binding IsEmailConfigured, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </RadioButton>

                            <!-- 2. Slack -->
                            <RadioButton GroupName="ProviderNav" Style="{StaticResource ChannelListItem}" IsChecked="{Binding IsProviderSlack, Mode=OneWay}"
                                         Command="{Binding SelectNotificationProviderCommand}" CommandParameter="Slack" Margin="0,0,0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="8" Background="#15E01E5A">
                                        <Image Source="{StaticResource BrandDrawingSlack}" Width="20" Height="20" Stretch="Uniform"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="Slack" FontWeight="Medium" FontSize="{StaticResource FontSizeNavLabel}" VerticalAlignment="Center"/>
                                    <Ellipse Grid.Column="3" Width="7" Height="7" Fill="{DynamicResource BrushJade}" VerticalAlignment="Center" Visibility="{Binding IsSlackConfigured, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </RadioButton>

                            <!-- 3. Microsoft Teams -->
                            <RadioButton GroupName="ProviderNav" Style="{StaticResource ChannelListItem}" IsChecked="{Binding IsProviderTeams, Mode=OneWay}"
                                         Command="{Binding SelectNotificationProviderCommand}" CommandParameter="Teams" Margin="0,0,0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="8" Background="#155059C9">
                                        <Image Source="{StaticResource BrandDrawingTeams}" Width="20" Height="20" Stretch="Uniform"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="Microsoft Teams" FontWeight="Medium" FontSize="{StaticResource FontSizeNavLabel}" VerticalAlignment="Center"/>
                                    <Ellipse Grid.Column="3" Width="7" Height="7" Fill="{DynamicResource BrushJade}" VerticalAlignment="Center" Visibility="{Binding IsTeamsConfigured, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </RadioButton>

                            <!-- 4. Discord -->
                            <RadioButton GroupName="ProviderNav" Style="{StaticResource ChannelListItem}" IsChecked="{Binding IsProviderDiscord, Mode=OneWay}"
                                         Command="{Binding SelectNotificationProviderCommand}" CommandParameter="Discord" Margin="0,0,0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="8" Background="#155865F2">
                                        <Image Source="{StaticResource BrandDrawingDiscord}" Width="20" Height="20" Stretch="Uniform"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="Discord" FontWeight="Medium" FontSize="{StaticResource FontSizeNavLabel}" VerticalAlignment="Center"/>
                                    <Ellipse Grid.Column="3" Width="7" Height="7" Fill="{DynamicResource BrushJade}" VerticalAlignment="Center" Visibility="{Binding IsDiscordConfigured, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </RadioButton>

                            <!-- 5. Telegram -->
                            <RadioButton GroupName="ProviderNav" Style="{StaticResource ChannelListItem}" IsChecked="{Binding IsProviderTelegram, Mode=OneWay}"
                                         Command="{Binding SelectNotificationProviderCommand}" CommandParameter="Telegram" Margin="0,0,0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="8" Background="#1524A1DE">
                                        <Image Source="{StaticResource BrandDrawingTelegram}" Width="20" Height="20" Stretch="Uniform"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="Telegram" FontWeight="Medium" FontSize="{StaticResource FontSizeNavLabel}" VerticalAlignment="Center"/>
                                    <Ellipse Grid.Column="3" Width="7" Height="7" Fill="{DynamicResource BrushJade}" VerticalAlignment="Center" Visibility="{Binding IsTelegramConfigured, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </RadioButton>

                            <!-- 6. Pushover -->
                            <RadioButton GroupName="ProviderNav" Style="{StaticResource ChannelListItem}" IsChecked="{Binding IsProviderPushover, Mode=OneWay}"
                                         Command="{Binding SelectNotificationProviderCommand}" CommandParameter="Pushover" Margin="0,0,0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="8" Background="#15249DF1">
                                        <Image Source="{StaticResource BrandDrawingPushover}" Width="20" Height="20" Stretch="Uniform"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="Pushover" FontWeight="Medium" FontSize="{StaticResource FontSizeNavLabel}" VerticalAlignment="Center"/>
                                    <Ellipse Grid.Column="3" Width="7" Height="7" Fill="{DynamicResource BrushJade}" VerticalAlignment="Center" Visibility="{Binding IsPushoverConfigured, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </RadioButton>

                            <!-- 7. ntfy -->
                            <RadioButton GroupName="ProviderNav" Style="{StaticResource ChannelListItem}" IsChecked="{Binding IsProviderNtfy, Mode=OneWay}"
                                         Command="{Binding SelectNotificationProviderCommand}" CommandParameter="Ntfy" Margin="0,0,0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="8" Background="#15317F6F">
                                        <Image Source="{StaticResource BrandDrawingNtfy}" Width="20" Height="20" Stretch="Uniform"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="ntfy" FontWeight="Medium" FontSize="{StaticResource FontSizeNavLabel}" VerticalAlignment="Center"/>
                                    <Ellipse Grid.Column="3" Width="7" Height="7" Fill="{DynamicResource BrushJade}" VerticalAlignment="Center" Visibility="{Binding IsNtfyConfigured, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </RadioButton>

                            <!-- 8. PagerDuty -->
                            <RadioButton GroupName="ProviderNav" Style="{StaticResource ChannelListItem}" IsChecked="{Binding IsProviderPagerDuty, Mode=OneWay}"
                                         Command="{Binding SelectNotificationProviderCommand}" CommandParameter="PagerDuty" Margin="0,0,0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="8" Background="#1506AC38">
                                        <Image Source="{StaticResource BrandDrawingPagerDuty}" Width="20" Height="20" Stretch="Uniform"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="PagerDuty" FontWeight="Medium" FontSize="{StaticResource FontSizeNavLabel}" VerticalAlignment="Center"/>
                                    <Ellipse Grid.Column="3" Width="7" Height="7" Fill="{DynamicResource BrushJade}" VerticalAlignment="Center" Visibility="{Binding IsPagerDutyConfigured, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </RadioButton>

                            <!-- 9. Custom Webhook -->
                            <RadioButton GroupName="ProviderNav" Style="{StaticResource ChannelListItem}" IsChecked="{Binding IsProviderCustomWebhook, Mode=OneWay}"
                                         Command="{Binding SelectNotificationProviderCommand}" CommandParameter="CustomWebhook" Margin="0,0,0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource BrushSunken}">
                                        <Path Data="{StaticResource IconCustomWebhook}" Fill="{DynamicResource BrushInkMuted}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="Custom webhook" FontWeight="Medium" FontSize="{StaticResource FontSizeNavLabel}" VerticalAlignment="Center"/>
                                    <Ellipse Grid.Column="3" Width="7" Height="7" Fill="{DynamicResource BrushJade}" VerticalAlignment="Center" Visibility="{Binding IsCustomWebhookConfigured, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </RadioButton>

                            <!-- 10. Heartbeat Monitor -->
                            <RadioButton GroupName="ProviderNav" Style="{StaticResource ChannelListItem}" IsChecked="{Binding IsProviderHeartbeat, Mode=OneWay}"
                                         Command="{Binding SelectNotificationProviderCommand}" CommandParameter="Heartbeat">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource BrushJadeSoft}">
                                        <Path Data="{StaticResource IconHeartbeat}" Fill="{DynamicResource BrushJade}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="Heartbeat monitor" FontWeight="Medium" FontSize="{StaticResource FontSizeNavLabel}" VerticalAlignment="Center"/>
                                    <Ellipse Grid.Column="3" Width="7" Height="7" Fill="{DynamicResource BrushJade}" VerticalAlignment="Center" Visibility="{Binding IsHeartbeatConfigured, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <!-- Right: Selected Provider Configuration Card -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="24">
                        <Grid>
                            <!-- 1. Email Settings -->
                            <StackPanel Visibility="{Binding IsProviderEmail, Converter={StaticResource BoolToVis}}">
                                <Grid Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock Text="Email (SMTP) settings" FontWeight="SemiBold" FontSize="{StaticResource FontSizeH2}" Foreground="{DynamicResource BrushInk}"/>
                                        <TextBlock Text="Configure SMTP server, TLS encryption, sender identity, and recipients" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox Content="Enable Email" IsChecked="{Binding Config.Email.Enabled, Mode=TwoWay}" Click="Input_Dirty" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </Grid>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="SMTP server" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <TextBox Text="{Binding Config.Email.SmtpHost, UpdateSourceTrigger=PropertyChanged}" TextChanged="TextBox_Dirty" Tag="smtp.example.com" Style="{StaticResource FieldInputMono}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="SMTP port" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <TextBox Text="{Binding Config.Email.SmtpPort, UpdateSourceTrigger=PropertyChanged}" TextChanged="TextBox_Dirty" Tag="587" Style="{StaticResource FieldInputMono}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="4" Content="Use SSL / TLS" IsChecked="{Binding Config.Email.UseTls, Mode=TwoWay}" Click="Input_Dirty" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                                </Grid>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Username" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <TextBox Text="{Binding Config.Email.Username, UpdateSourceTrigger=PropertyChanged}" TextChanged="TextBox_Dirty" Tag="user@example.com" Style="{StaticResource FieldInput}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Password" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <TextBox Text="{Binding Config.Email.Password, UpdateSourceTrigger=PropertyChanged}" TextChanged="TextBox_Dirty" Tag="SMTP password" Style="{StaticResource FieldInput}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="1.4*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Sender email" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <TextBox Text="{Binding Config.Email.FromAddress, UpdateSourceTrigger=PropertyChanged}" TextChanged="TextBox_Dirty" Tag="alerts@example.com" Style="{StaticResource FieldInput}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Recipients (comma-separated)" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <TextBox Text="{Binding EmailRecipientsText, UpdateSourceTrigger=PropertyChanged}" TextChanged="TextBox_Dirty" Tag="admin@example.com, ops@example.com" Style="{StaticResource FieldInput}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Send test email" Command="{Binding TestEmailCommand}" Style="{StaticResource BtnQuiet}" Height="34" Padding="14,0" Margin="0,0,10,0"/>
                                    <Button Content="Save email settings" Command="{Binding SaveNotificationsPageCommand}" Style="{StaticResource BtnPrimary}" Height="34" Padding="16,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- 2. Slack -->
                            <StackPanel Visibility="{Binding IsProviderSlack, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Slack settings" FontWeight="SemiBold" FontSize="{StaticResource FontSizeH2}" Foreground="{DynamicResource BrushInk}"/>
                                <TextBlock Text="Dispatch backup status alerts directly to a designated Slack channel" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,18"/>

                                <TextBlock Text="Slack incoming webhook URL" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                <TextBox Text="{Binding Config.Webhooks.SlackWebhookUrl, UpdateSourceTrigger=PropertyChanged}" TextChanged="TextBox_Dirty" Tag="https://hooks.slack.com/services/..." Style="{StaticResource FieldInputMono}" Margin="0,4,0,6"/>
                                <TextBlock Text="Create an Incoming Webhook in your Slack Workspace App configuration portal." FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkFaint}" Margin="0,0,0,18"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Send test Slack message" Command="{Binding TestSlackCommand}" Style="{StaticResource BtnQuiet}" Height="34" Padding="14,0" Margin="0,0,10,0"/>
                                    <Button Content="Save settings" Command="{Binding SaveNotificationsPageCommand}" Style="{StaticResource BtnPrimary}" Height="34" Padding="16,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- 3. Microsoft Teams -->
                            <StackPanel Visibility="{Binding IsProviderTeams, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Microsoft Teams settings" FontWeight="SemiBold" FontSize="{StaticResource FontSizeH2}" Foreground="{DynamicResource BrushInk}"/>
                                <TextBlock Text="Deliver structured adaptive cards to your Microsoft Teams channel" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,18"/>

                                <TextBlock Text="Teams webhook URL" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                <TextBox Text="{Binding Config.Webhooks.TeamsWebhookUrl, UpdateSourceTrigger=PropertyChanged}" TextChanged="TextBox_Dirty" Tag="https://outlook.office.com/webhook/..." Style="{StaticResource FieldInputMono}" Margin="0,4,0,6"/>
                                <TextBlock Text="Incoming webhook URL created via Microsoft Teams Workflows or connectors." FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkFaint}" Margin="0,0,0,18"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Send test Teams message" Command="{Binding TestTeamsCommand}" Style="{StaticResource BtnQuiet}" Height="34" Padding="14,0" Margin="0,0,10,0"/>
                                    <Button Content="Save settings" Command="{Binding SaveNotificationsPageCommand}" Style="{StaticResource BtnPrimary}" Height="34" Padding="16,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- 4. Discord -->
                            <StackPanel Visibility="{Binding IsProviderDiscord, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Discord settings" FontWeight="SemiBold" FontSize="{StaticResource FontSizeH2}" Foreground="{DynamicResource BrushInk}"/>
                                <TextBlock Text="Send rich embedded alert cards to a Discord server channel" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,18"/>

                                <TextBlock Text="Discord webhook URL" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                <TextBox Text="{Binding Config.Webhooks.DiscordWebhookUrl, UpdateSourceTrigger=PropertyChanged}" TextChanged="TextBox_Dirty" Tag="https://discord.com/api/webhooks/..." Style="{StaticResource FieldInputMono}" Margin="0,4,0,6"/>
                                <TextBlock Text="Created in Discord under Channel Settings > Integrations > Webhooks." FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkFaint}" Margin="0,0,0,18"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Send test Discord message" Command="{Binding TestDiscordCommand}" Style="{StaticResource BtnQuiet}" Height="34" Padding="14,0" Margin="0,0,10,0"/>
                                    <Button Content="Save settings" Command="{Binding SaveNotificationsPageCommand}" Style="{StaticResource BtnPrimary}" Height="34" Padding="16,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- 5. Telegram -->
                            <StackPanel Visibility="{Binding IsProviderTelegram, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Telegram settings" FontWeight="SemiBold" FontSize="{StaticResource FontSizeH2}" Foreground="{DynamicResource BrushInk}"/>
                                <TextBlock Text="Send notifications through a Telegram Bot to your chat or channel" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,18"/>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Bot token" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <TextBox Text="{Binding Config.Webhooks.TelegramBotToken, UpdateSourceTrigger=PropertyChanged}" TextChanged="TextBox_Dirty" Tag="123456789:ABCdefGhI..." Style="{StaticResource FieldInputMono}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Chat ID" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <TextBox Text="{Binding Config.Webhooks.TelegramChatId, UpdateSourceTrigger=PropertyChanged}" TextChanged="TextBox_Dirty" Tag="@mychannel or -100123456789" Style="{StaticResource FieldInputMono}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Create a bot via @BotFather to receive your bot token and chat ID." FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkFaint}" Margin="0,0,0,18"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Send test Telegram message" Command="{Binding TestTelegramCommand}" Style="{StaticResource BtnQuiet}" Height="34" Padding="14,0" Margin="0,0,10,0"/>
                                    <Button Content="Save settings" Command="{Binding SaveNotificationsPageCommand}" Style="{StaticResource BtnPrimary}" Height="34" Padding="16,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- 6. Pushover -->
                            <StackPanel Visibility="{Binding IsProviderPushover, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Pushover settings" FontWeight="SemiBold" FontSize="{StaticResource FontSizeH2}" Foreground="{DynamicResource BrushInk}"/>
                                <TextBlock Text="Deliver real-time mobile push notifications to iOS and Android" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,18"/>

                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="User key" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <TextBox Text="{Binding Config.Webhooks.PushoverUserKey, UpdateSourceTrigger=PropertyChanged}" TextChanged="TextBox_Dirty" Tag="30-character user key" Style="{StaticResource FieldInputMono}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Application API token" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <TextBox Text="{Binding Config.Webhooks.PushoverApiToken, UpdateSourceTrigger=PropertyChanged}" TextChanged="TextBox_Dirty" Tag="30-character app token" Style="{StaticResource FieldInputMono}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Send test Pushover notification" Command="{Binding TestPushoverCommand}" Style="{StaticResource BtnQuiet}" Height="34" Padding="14,0" Margin="0,0,10,0"/>
                                    <Button Content="Save settings" Command="{Binding SaveNotificationsPageCommand}" Style="{StaticResource BtnPrimary}" Height="34" Padding="16,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- 7. ntfy -->
                            <StackPanel Visibility="{Binding IsProviderNtfy, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="ntfy settings" FontWeight="SemiBold" FontSize="{StaticResource FontSizeH2}" Foreground="{DynamicResource BrushInk}"/>
                                <TextBlock Text="HTTP-based pub-sub push notifications to phones and desktop subscribers" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,18"/>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="ntfy server URL" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <TextBox Text="{Binding Config.Webhooks.NtfyServerUrl, UpdateSourceTrigger=PropertyChanged}" TextChanged="TextBox_Dirty" Tag="https://ntfy.sh" Style="{StaticResource FieldInputMono}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Topic name" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <TextBox Text="{Binding Config.Webhooks.NtfyTopic, UpdateSourceTrigger=PropertyChanged}" TextChanged="TextBox_Dirty" Tag="backup-alerts" Style="{StaticResource FieldInput}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Authentication token (optional)" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                <TextBox Text="{Binding Config.Webhooks.NtfyToken, UpdateSourceTrigger=PropertyChanged}" TextChanged="TextBox_Dirty" Tag="tk_..." Style="{StaticResource FieldInputMono}" Margin="0,4,0,18"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Send test ntfy notification" Command="{Binding TestNtfyCommand}" Style="{StaticResource BtnQuiet}" Height="34" Padding="14,0" Margin="0,0,10,0"/>
                                    <Button Content="Save settings" Command="{Binding SaveNotificationsPageCommand}" Style="{StaticResource BtnPrimary}" Height="34" Padding="16,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- 8. PagerDuty -->
                            <StackPanel Visibility="{Binding IsProviderPagerDuty, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="PagerDuty settings" FontWeight="SemiBold" FontSize="{StaticResource FontSizeH2}" Foreground="{DynamicResource BrushInk}"/>
                                <TextBlock Text="Trigger and auto-resolve incident tickets through PagerDuty Events API v2" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,18"/>

                                <TextBlock Text="Integration / routing key" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                <TextBox Text="{Binding Config.Webhooks.PagerDutyRoutingKey, UpdateSourceTrigger=PropertyChanged}" TextChanged="TextBox_Dirty" Tag="32-character PagerDuty routing key" Style="{StaticResource FieldInputMono}" Margin="0,4,0,6"/>
                                <TextBlock Text="Find your 32-character routing key in PagerDuty under Service > Integrations." FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkFaint}" Margin="0,0,0,18"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Send test PagerDuty incident" Command="{Binding TestPagerDutyCommand}" Style="{StaticResource BtnQuiet}" Height="34" Padding="14,0" Margin="0,0,10,0"/>
                                    <Button Content="Save settings" Command="{Binding SaveNotificationsPageCommand}" Style="{StaticResource BtnPrimary}" Height="34" Padding="16,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- 9. Custom Webhook -->
                            <StackPanel Visibility="{Binding IsProviderCustomWebhook, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Custom webhook settings" FontWeight="SemiBold" FontSize="{StaticResource FontSizeH2}" Foreground="{DynamicResource BrushInk}"/>
                                <TextBlock Text="Post structured JSON payloads to any HTTP endpoint (n8n, Zapier, Make, Home Assistant)" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,18"/>

                                <TextBlock Text="Webhook URL" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                <TextBox Text="{Binding Config.Webhooks.CustomWebhookUrl, UpdateSourceTrigger=PropertyChanged}" TextChanged="TextBox_Dirty" Tag="https://api.example.com/webhook/backup" Style="{StaticResource FieldInputMono}" Margin="0,4,0,14"/>

                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Custom header name (optional)" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <TextBox Text="{Binding Config.Webhooks.CustomWebhookHeaderName, UpdateSourceTrigger=PropertyChanged}" TextChanged="TextBox_Dirty" Tag="X-Auth-Token" Style="{StaticResource FieldInput}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Custom header value (optional)" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <TextBox Text="{Binding Config.Webhooks.CustomWebhookHeaderValue, UpdateSourceTrigger=PropertyChanged}" TextChanged="TextBox_Dirty" Tag="secret-key" Style="{StaticResource FieldInput}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Send test webhook" Command="{Binding TestCustomWebhookCommand}" Style="{StaticResource BtnQuiet}" Height="34" Padding="14,0" Margin="0,0,10,0"/>
                                    <Button Content="Save settings" Command="{Binding SaveNotificationsPageCommand}" Style="{StaticResource BtnPrimary}" Height="34" Padding="16,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- 10. Heartbeat Monitor -->
                            <StackPanel Visibility="{Binding IsProviderHeartbeat, Converter={StaticResource BoolToVis}}">
                                <Grid Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock Text="Heartbeat monitor settings" FontWeight="SemiBold" FontSize="{StaticResource FontSizeH2}" Foreground="{DynamicResource BrushInk}"/>
                                        <TextBlock Text="Ping external healthcheck services (BetterUptime, Healthchecks.io, Cronitor)" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox Content="Enable Monitoring" IsChecked="{Binding Config.Heartbeat.Enabled, Mode=TwoWay}" Click="Input_Dirty" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </Grid>

                                <TextBlock Text="Healthcheck ping URL" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                <TextBox Text="{Binding Config.Heartbeat.Url, UpdateSourceTrigger=PropertyChanged}" TextChanged="TextBox_Dirty" Tag="https://hc-ping.com/your-uuid" Style="{StaticResource FieldInputMono}" Margin="0,4,0,14"/>

                                <TextBlock Text="Failure ping URL (optional)" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                <TextBox Text="{Binding Config.Heartbeat.FailUrl, UpdateSourceTrigger=PropertyChanged}" TextChanged="TextBox_Dirty" Tag="Leave blank to append /fail automatically" Style="{StaticResource FieldInputMono}" Margin="0,4,0,10"/>

                                <CheckBox Content="Append /fail path on backup failure when Failure URL is blank"
                                          IsChecked="{Binding Config.Heartbeat.AppendFailPath, Mode=TwoWay}" Click="Input_Dirty" Margin="0,0,0,18"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Test connection" Command="{Binding TestHeartbeatCommand}" Style="{StaticResource BtnQuiet}" Height="34" Padding="14,0" Margin="0,0,10,0"/>
                                    <Button Content="Save settings" Command="{Binding SaveNotificationsPageCommand}" Style="{StaticResource BtnPrimary}" Height="34" Padding="16,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ===================================================================
                     3. NOTIFICATION RULES – WHEN TO NOTIFY (§5)
                     Modern card with colored toggle switches & Select All / Deselect All / Reset
                     =================================================================== -->
                <Border Style="{StaticResource Card}" Padding="22" Margin="0,0,0,20" Effect="{StaticResource Sh1}">
                    <StackPanel>
                        <!-- Section Header & Bulk Controls -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="When to notify" FontWeight="SemiBold" FontSize="{StaticResource FontSizeH2}" Foreground="{DynamicResource BrushInk}"/>
                                    <Border Style="{StaticResource BadgePill}" Background="{DynamicResource BrushCobaltSoft}" Margin="10,0,0,0" VerticalAlignment="Center" Padding="9,3">
                                        <TextBlock FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource BrushCobalt}">
                                            <Run Text="{Binding ActiveNotificationRulesCount, Mode=OneWay}"/>
                                            <Run Text="of 9 rules active"/>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Choose which backup execution outcomes trigger alerts across your configured channels."
                                           FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,3,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Select All" Command="{Binding SelectAllNotificationRulesCommand}" Style="{StaticResource BtnQuiet}" Height="30" Padding="12,0" FontSize="{StaticResource FontSizeCaption}" Margin="0,0,6,0"/>
                                <Button Content="Deselect All" Command="{Binding DeselectAllNotificationRulesCommand}" Style="{StaticResource BtnQuiet}" Height="30" Padding="12,0" FontSize="{StaticResource FontSizeCaption}" Margin="0,0,6,0"/>
                                <Button Content="Reset" Command="{Binding ResetNotificationRulesCommand}" Style="{StaticResource BtnQuiet}" Height="30" Padding="12,0" FontSize="{StaticResource FontSizeCaption}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Matrix Table Container -->
                        <Border Background="{DynamicResource BrushRaised}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="12" Padding="0">
                            <StackPanel>
                                <!-- Matrix Column Headers -->
                                <Border BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,0,0,1" Padding="18,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="BACKUP TYPE" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource BrushInkFaint}" VerticalAlignment="Center"/>

                                        <Button Grid.Column="1" Command="{Binding ToggleAllSuccessNotificationsCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Toggle all Succeeded rules">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Ellipse Width="8" Height="8" Fill="{DynamicResource BrushJade}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Succeeded" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushJade}"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Column="2" Command="{Binding ToggleAllWarningNotificationsCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Toggle all Partial rules">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Ellipse Width="8" Height="8" Fill="{DynamicResource BrushSaffron}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Partial" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushSaffron}"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Column="3" Command="{Binding ToggleAllFailureNotificationsCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Toggle all Failed rules">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Ellipse Width="8" Height="8" Fill="{DynamicResource BrushCoral}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Failed" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushCoral}"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Row 1: Full Backup -->
                                <Border BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,0,0,1" Padding="18,13">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Full Backup" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushInk}"/>
                                            <TextBlock Text="Complete database or folder snapshot" FontSize="11" Foreground="{DynamicResource BrushInkFaint}" Margin="0,1,0,0"/>
                                        </StackPanel>

                                        <CheckBox Grid.Column="1" Style="{StaticResource GreenToggleSwitch}" IsChecked="{Binding Config.NotificationMatrix.FullSuccess, Mode=TwoWay}" Click="Input_Dirty" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <CheckBox Grid.Column="2" Style="{StaticResource OrangeToggleSwitch}" IsChecked="{Binding Config.NotificationMatrix.FullWarning, Mode=TwoWay}" Click="Input_Dirty" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <CheckBox Grid.Column="3" Style="{StaticResource RedToggleSwitch}" IsChecked="{Binding Config.NotificationMatrix.FullFailure, Mode=TwoWay}" Click="Input_Dirty" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Row 2: Differential Backup -->
                                <Border BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,0,0,1" Padding="18,13">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Differential Backup" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushInk}"/>
                                            <TextBlock Text="Changed data since last full backup" FontSize="11" Foreground="{DynamicResource BrushInkFaint}" Margin="0,1,0,0"/>
                                        </StackPanel>

                                        <CheckBox Grid.Column="1" Style="{StaticResource GreenToggleSwitch}" IsChecked="{Binding Config.NotificationMatrix.DiffSuccess, Mode=TwoWay}" Click="Input_Dirty" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <CheckBox Grid.Column="2" Style="{StaticResource OrangeToggleSwitch}" IsChecked="{Binding Config.NotificationMatrix.DiffWarning, Mode=TwoWay}" Click="Input_Dirty" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <CheckBox Grid.Column="3" Style="{StaticResource RedToggleSwitch}" IsChecked="{Binding Config.NotificationMatrix.DiffFailure, Mode=TwoWay}" Click="Input_Dirty" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Row 3: Transaction Log -->
                                <Border Padding="18,13">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Transaction Log" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushInk}"/>
                                            <TextBlock Text="Incremental SQL Server log backups" FontSize="11" Foreground="{DynamicResource BrushInkFaint}" Margin="0,1,0,0"/>
                                        </StackPanel>

                                        <CheckBox Grid.Column="1" Style="{StaticResource GreenToggleSwitch}" IsChecked="{Binding Config.NotificationMatrix.LogSuccess, Mode=TwoWay}" Click="Input_Dirty" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <CheckBox Grid.Column="2" Style="{StaticResource OrangeToggleSwitch}" IsChecked="{Binding Config.NotificationMatrix.LogWarning, Mode=TwoWay}" Click="Input_Dirty" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <CheckBox Grid.Column="3" Style="{StaticResource RedToggleSwitch}" IsChecked="{Binding Config.NotificationMatrix.LogFailure, Mode=TwoWay}" Click="Input_Dirty" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ===================================================================
                     4. RECENT NOTIFICATION ACTIVITY (§7)
                     =================================================================== -->
                <Border Style="{StaticResource Card}" Padding="0">
                    <StackPanel>
                        <Border BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,0,0,1" Padding="20,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Notification activity" FontWeight="SemiBold" FontSize="{StaticResource FontSizeH2}" Foreground="{DynamicResource BrushInk}"/>
                                    <TextBlock Text="Recent test dispatches and backup alert deliveries" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Text="{Binding NotificationSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="Search provider, job..." Style="{StaticResource FieldInput}" Width="180" Height="30" Margin="0,0,8,0"/>
                                    <ComboBox ItemsSource="{Binding NotificationProviderFilterOptions}" SelectedItem="{Binding NotificationProviderFilter}" Width="125" Height="30" Margin="0,0,8,0"/>
                                    <ComboBox ItemsSource="{Binding NotificationStatusFilterOptions}" SelectedItem="{Binding NotificationStatusFilter}" Width="110" Height="30" Margin="0,0,8,0"/>
                                    <ComboBox ItemsSource="{Binding NotificationDateFilterOptions}" SelectedItem="{Binding NotificationDateFilter}" Width="110" Height="30" Margin="0,0,8,0"/>
                                    <Button Content="Refresh" Command="{Binding RefreshNotificationActivityCommand}" Style="{StaticResource BtnQuiet}" Height="30" Padding="12,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Column Header -->
                        <Border Background="{DynamicResource BrushRaised}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,0,0,1" Padding="20,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="145"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="DATE &amp; TIME" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource BrushInkFaint}"/>
                                <TextBlock Grid.Column="1" Text="PROVIDER" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource BrushInkFaint}"/>
                                <TextBlock Grid.Column="2" Text="BACKUP JOB" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource BrushInkFaint}"/>
                                <TextBlock Grid.Column="3" Text="EVENT" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource BrushInkFaint}"/>
                                <TextBlock Grid.Column="4" Text="RESULT" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource BrushInkFaint}"/>
                                <TextBlock Grid.Column="5" Text="ERROR DETAILS" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource BrushInkFaint}"/>
                                <TextBlock Grid.Column="6" Text="ACTION" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource BrushInkFaint}" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <!-- Empty State -->
                        <StackPanel Visibility="{Binding HasNotificationActivity, Converter={StaticResource InverseBoolToVis}}" Margin="24,28" HorizontalAlignment="Center">
                            <TextBlock Text="No notification activity recorded" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Test a channel or run a backup job to see delivery logs here." FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkFaint}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Activity Rows -->
                        <ItemsControl ItemsSource="{Binding NotificationActivityPaged}" Visibility="{Binding HasNotificationActivity, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,0,0,1" Padding="20,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="145"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="70"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding TimestampDisplay}" FontFamily="{StaticResource FontFamilyMono}" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkMuted}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Provider}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInk}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding RelatedJob}" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkMuted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding EventType}" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInk}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="4" Style="{StaticResource BadgePill}" Background="{DynamicResource BrushSunken}" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="8,2">
                                                <TextBlock Text="{Binding Result}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource BrushInk}"/>
                                            </Border>
                                            <TextBlock Grid.Column="5" Text="{Binding ErrorDetails}" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushCoral}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Button Grid.Column="6" Content="View"
                                                    Command="{Binding DataContext.ViewNotificationActivityDetailsCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource BtnQuiet}" Height="26" Padding="10,0" FontSize="11" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Pagination Footer -->
                        <Border Padding="20,10" Background="{DynamicResource BrushRaised}">
                            <Grid>
                                <TextBlock Text="{Binding NotificationActivitySummary}" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkMuted}" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="‹ Prev" Command="{Binding NotificationPrevPageCommand}" IsEnabled="{Binding CanNotificationPrevPage}" Style="{StaticResource BtnQuiet}" Height="26" Padding="10,0" FontSize="11" Margin="0,0,6,0"/>
                                    <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource BrushInk}" Margin="0,0,6,0">
                                        <Run Text="Page"/>
                                        <Run Text="{Binding NotificationActivityCurrentPage, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text="of"/>
                                        <Run Text="{Binding NotificationActivityTotalPages, Mode=OneWay}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                    <Button Content="Next ›" Command="{Binding NotificationNextPageCommand}" IsEnabled="{Binding CanNotificationNextPage}" Style="{StaticResource BtnQuiet}" Height="26" Padding="10,0" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ===================================================================
             5. STICKY BOTTOM ACTION BAR (§8)
             =================================================================== -->
        <Border Grid.Row="1"
                Background="{DynamicResource BrushPanel}"
                BorderBrush="{DynamicResource BrushLine}"
                BorderThickness="0,1,0,0"
                Padding="28,12">
            <Grid MaxWidth="1320">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Visibility="{Binding HasUnsavedNotificationChanges, Converter={StaticResource BoolToVis}}"
                            Background="{DynamicResource BrushSaffronSoft}"
                            CornerRadius="{StaticResource RadiusPill}"
                            Padding="10,4" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource BrushSaffron}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Unsaved changes" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushSaffron}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Visibility="{Binding HasUnsavedNotificationChanges, Converter={StaticResource InverseBoolToVis}}"
                               Text="All notification settings are saved"
                               FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkFaint}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Reset changes" Command="{Binding ResetNotificationsCommand}" Style="{StaticResource BtnQuiet}" Height="34" Padding="14,0" Margin="0,0,8,0"/>
                    <Button Content="Validate configuration" Command="{Binding ValidateNotificationsConfigCommand}" Style="{StaticResource BtnQuiet}" Height="34" Padding="14,0" Margin="0,0,8,0"/>
                    <Button Content="Test selected provider" Command="{Binding TestSelectedNotificationProviderCommand}" Style="{StaticResource BtnQuiet}" Height="34" Padding="14,0" Margin="0,0,8,0"/>
                    <Button Content="Save changes" Command="{Binding SaveNotificationsPageCommand}" Style="{StaticResource BtnPrimary}" Height="34" Padding="18,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================================================================
             6. ACTIVITY DETAILS FLYOUT OVERLAY
             =================================================================== -->
        <Grid Grid.Row="0" Grid.RowSpan="2"
              Visibility="{Binding IsNotificationActivityDetailsOpen, Converter={StaticResource BoolToVis}}"
              Background="#660B1420">
            <Border MaxWidth="540" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Style="{StaticResource Card}" Padding="24" Effect="{StaticResource Sh2}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Notification Delivery Details" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSectionHeader}" Foreground="{DynamicResource BrushInk}"/>
                        <Button Command="{Binding CloseNotificationActivityDetailsCommand}" Style="{StaticResource IconBtn}" Width="30" Height="30" HorizontalAlignment="Right">
                            <Path Data="{StaticResource IconClose}" Fill="{DynamicResource BrushInkMuted}" Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding SelectedNotificationActivity.TimestampDisplay, StringFormat='Timestamp: {0}'}" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding SelectedNotificationActivity.Provider, StringFormat='Provider: {0}'}" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInk}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding SelectedNotificationActivity.RelatedJob, StringFormat='Backup Job: {0}'}" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInk}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding SelectedNotificationActivity.Result, StringFormat='Result: {0}'}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInk}" Margin="0,0,0,12"/>
                    <Border Background="{DynamicResource BrushSunken}" CornerRadius="8" Padding="12" Visibility="{Binding SelectedNotificationActivity.HasError, Converter={StaticResource BoolToVis}}" Margin="0,0,0,14">
                        <TextBlock Text="{Binding SelectedNotificationActivity.ErrorDetails}" FontFamily="{StaticResource FontFamilyMono}" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushCoral}" TextWrapping="Wrap"/>
                    </Border>
                    <Button Content="Close" Command="{Binding CloseNotificationActivityDetailsCommand}" Style="{StaticResource BtnPrimary}" HorizontalAlignment="Right" Height="32" Padding="16,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
