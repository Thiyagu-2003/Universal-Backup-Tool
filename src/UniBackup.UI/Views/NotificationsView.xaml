<UserControl x:Class="UniBackup.UI.Views.NotificationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:UniBackup.UI.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,24">
        <StackPanel MaxWidth="1280" HorizontalAlignment="Stretch">

            <!-- 1. Header -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Notifications" FontWeight="SemiBold" FontSize="{StaticResource FontSizeH1}" Foreground="{DynamicResource BrushInk}"/>
                <TextBlock Text="Alert dispatch channels, secret tokens, and notification trigger matrix" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,3,0,0"/>
            </StackPanel>

            <!-- 2. Master-Detail Channel Config -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="272"/> <!-- Master Channel List -->
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>   <!-- Detail Credentials Form -->
                </Grid.ColumnDefinitions>

                <!-- Master Channel List (272 px) -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8">
                    <StackPanel>
                        <!-- Email -->
                        <RadioButton IsChecked="True" GroupName="ChannelGroup" Style="{StaticResource ChannelListItem}" Checked="ChannelRadio_Checked" Tag="Email" Margin="0,0,0,4">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="24" Height="24" CornerRadius="6" Background="{DynamicResource BrushCobaltSoft}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconNotifications}" Fill="{DynamicResource BrushCobalt}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="2" Text="Email (SMTP)" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center"/>
                            </Grid>
                        </RadioButton>

                        <!-- Slack -->
                        <RadioButton GroupName="ChannelGroup" Style="{StaticResource ChannelListItem}" Checked="ChannelRadio_Checked" Tag="Slack" Margin="0,0,0,4">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="24" Height="24" CornerRadius="6" Background="{DynamicResource BrushTealSoft}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconCloud}" Fill="{DynamicResource BrushTeal}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="2" Text="Slack" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center"/>
                            </Grid>
                        </RadioButton>

                        <!-- Microsoft Teams -->
                        <RadioButton GroupName="ChannelGroup" Style="{StaticResource ChannelListItem}" Checked="ChannelRadio_Checked" Tag="Teams" Margin="0,0,0,4">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="24" Height="24" CornerRadius="6" Background="{DynamicResource BrushOrchidSoft}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconCloud}" Fill="{DynamicResource BrushOrchid}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="2" Text="Microsoft Teams" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center"/>
                            </Grid>
                        </RadioButton>

                        <!-- Discord -->
                        <RadioButton GroupName="ChannelGroup" Style="{StaticResource ChannelListItem}" Checked="ChannelRadio_Checked" Tag="Discord" Margin="0,0,0,4">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="24" Height="24" CornerRadius="6" Background="{DynamicResource BrushCobaltSoft}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconCloud}" Fill="{DynamicResource BrushCobalt}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="2" Text="Discord" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center"/>
                            </Grid>
                        </RadioButton>

                        <!-- Telegram -->
                        <RadioButton GroupName="ChannelGroup" Style="{StaticResource ChannelListItem}" Checked="ChannelRadio_Checked" Tag="Telegram" Margin="0,0,0,4">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="24" Height="24" CornerRadius="6" Background="{DynamicResource BrushSky}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconCloud}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="2" Text="Telegram" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center"/>
                            </Grid>
                        </RadioButton>

                        <!-- Pushover -->
                        <RadioButton GroupName="ChannelGroup" Style="{StaticResource ChannelListItem}" Checked="ChannelRadio_Checked" Tag="Pushover" Margin="0,0,0,4">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="24" Height="24" CornerRadius="6" Background="{DynamicResource BrushJadeSoft}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconNotifications}" Fill="{DynamicResource BrushJade}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="2" Text="Pushover" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center"/>
                            </Grid>
                        </RadioButton>

                        <!-- ntfy -->
                        <RadioButton GroupName="ChannelGroup" Style="{StaticResource ChannelListItem}" Checked="ChannelRadio_Checked" Tag="Ntfy" Margin="0,0,0,4">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="24" Height="24" CornerRadius="6" Background="{DynamicResource BrushCobaltSoft}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconNotifications}" Fill="{DynamicResource BrushCobalt}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="2" Text="ntfy" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center"/>
                            </Grid>
                        </RadioButton>

                        <!-- PagerDuty -->
                        <RadioButton GroupName="ChannelGroup" Style="{StaticResource ChannelListItem}" Checked="ChannelRadio_Checked" Tag="PagerDuty" Margin="0,0,0,4">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="24" Height="24" CornerRadius="6" Background="{DynamicResource BrushJadeSoft}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconWarningCircle}" Fill="{DynamicResource BrushJade}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="2" Text="PagerDuty" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center"/>
                            </Grid>
                        </RadioButton>

                        <!-- Custom Webhook -->
                        <RadioButton GroupName="ChannelGroup" Style="{StaticResource ChannelListItem}" Checked="ChannelRadio_Checked" Tag="CustomWebhook" Margin="0,0,0,4">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="24" Height="24" CornerRadius="6" Background="{DynamicResource BrushSunken}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconSettings}" Fill="{DynamicResource BrushInkMuted}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="2" Text="Custom webhook" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center"/>
                            </Grid>
                        </RadioButton>

                        <!-- Heartbeat Monitor -->
                        <RadioButton GroupName="ChannelGroup" Style="{StaticResource ChannelListItem}" Checked="ChannelRadio_Checked" Tag="Heartbeat">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="24" Height="24" CornerRadius="6" Background="{DynamicResource BrushJadeSoft}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconCheck}" Fill="{DynamicResource BrushJade}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="2" Text="Heartbeat monitor" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center"/>
                            </Grid>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <!-- Detail Credentials Form Container -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="24">
                    <Grid>
                        <!-- 1. Email Channel Form -->
                        <StackPanel x:Name="EmailChannelPanel" Visibility="Visible">
                            <TextBlock Text="Email settings" FontWeight="SemiBold" FontSize="{StaticResource FontSizeH2}" Foreground="{DynamicResource BrushInk}"/>
                            <TextBlock Text="Configure SMTP host, authentication, and alert recipients" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,20"/>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="SMTP host" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                    <TextBox Text="{Binding Config.Email.SmtpHost, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInputMono}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Port" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                    <TextBox Text="{Binding Config.Email.SmtpPort, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInputMono}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Username" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                    <TextBox Text="{Binding Config.Email.Username, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInput}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Password" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                    <TextBox Text="{Binding Config.Email.Password, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInput}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Recipients (comma separated)" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                            <TextBox Text="{Binding EmailRecipientsText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInput}" Margin="0,4,0,20"/>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Send test message" Command="{Binding TestEmailCommand}" Style="{StaticResource BtnQuiet}" Height="36" Padding="16,0" Margin="0,0,12,0"/>
                                <Button Content="Save email settings" Command="{Binding SaveSettingsCommand}" Style="{StaticResource BtnPrimary}" Height="36" Padding="18,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- 2. Slack Channel Form -->
                        <StackPanel x:Name="SlackChannelPanel" Visibility="Collapsed">
                            <TextBlock Text="Slack settings" FontWeight="SemiBold" FontSize="{StaticResource FontSizeH2}" Foreground="{DynamicResource BrushInk}"/>
                            <TextBlock Text="Dispatch backup status alerts directly to a designated Slack channel" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,20"/>

                            <TextBlock Text="Slack incoming webhook URL" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                            <TextBox Text="{Binding Config.Webhooks.SlackWebhookUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInputMono}" Margin="0,4,0,6"/>
                            <TextBlock Text="Create an Incoming Webhook in your Slack Workspace App configuration portal." FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkFaint}" Margin="0,0,0,20"/>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Send test Slack message" Command="{Binding TestSlackCommand}" Style="{StaticResource BtnQuiet}" Height="36" Padding="16,0" Margin="0,0,12,0"/>
                                <Button Content="Save settings" Command="{Binding SaveSettingsCommand}" Style="{StaticResource BtnPrimary}" Height="36" Padding="18,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- 3. Microsoft Teams Channel Form -->
                        <StackPanel x:Name="TeamsChannelPanel" Visibility="Collapsed">
                            <TextBlock Text="Microsoft Teams settings" FontWeight="SemiBold" FontSize="{StaticResource FontSizeH2}" Foreground="{DynamicResource BrushInk}"/>
                            <TextBlock Text="Deliver structured adaptive cards to your Microsoft Teams channel" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,20"/>

                            <TextBlock Text="Teams webhook URL" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                            <TextBox Text="{Binding Config.Webhooks.TeamsWebhookUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInputMono}" Margin="0,4,0,6"/>
                            <TextBlock Text="Incoming webhook URL created via Microsoft Teams Workflows or connectors." FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkFaint}" Margin="0,0,0,20"/>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Send test Teams message" Command="{Binding TestTeamsCommand}" Style="{StaticResource BtnQuiet}" Height="36" Padding="16,0" Margin="0,0,12,0"/>
                                <Button Content="Save settings" Command="{Binding SaveSettingsCommand}" Style="{StaticResource BtnPrimary}" Height="36" Padding="18,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- 4. Discord Channel Form -->
                        <StackPanel x:Name="DiscordChannelPanel" Visibility="Collapsed">
                            <TextBlock Text="Discord settings" FontWeight="SemiBold" FontSize="{StaticResource FontSizeH2}" Foreground="{DynamicResource BrushInk}"/>
                            <TextBlock Text="Send rich embedded alert cards to a Discord server channel" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,20"/>

                            <TextBlock Text="Discord webhook URL" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                            <TextBox Text="{Binding Config.Webhooks.DiscordWebhookUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInputMono}" Margin="0,4,0,6"/>
                            <TextBlock Text="Created in Discord under Channel Settings > Integrations > Webhooks." FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkFaint}" Margin="0,0,0,20"/>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Send test Discord message" Command="{Binding TestDiscordCommand}" Style="{StaticResource BtnQuiet}" Height="36" Padding="16,0" Margin="0,0,12,0"/>
                                <Button Content="Save settings" Command="{Binding SaveSettingsCommand}" Style="{StaticResource BtnPrimary}" Height="36" Padding="18,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- 5. Telegram Channel Form -->
                        <StackPanel x:Name="TelegramChannelPanel" Visibility="Collapsed">
                            <TextBlock Text="Telegram settings" FontWeight="SemiBold" FontSize="{StaticResource FontSizeH2}" Foreground="{DynamicResource BrushInk}"/>
                            <TextBlock Text="Send notifications through a Telegram Bot to your chat or channel" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,20"/>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Bot token" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                    <TextBox Text="{Binding Config.Webhooks.TelegramBotToken, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInputMono}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Chat ID" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                    <TextBox Text="{Binding Config.Webhooks.TelegramChatId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInputMono}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Create a bot via @BotFather to receive your bot token and chat ID." FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkFaint}" Margin="0,0,0,20"/>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Send test Telegram message" Command="{Binding TestTelegramCommand}" Style="{StaticResource BtnQuiet}" Height="36" Padding="16,0" Margin="0,0,12,0"/>
                                <Button Content="Save settings" Command="{Binding SaveSettingsCommand}" Style="{StaticResource BtnPrimary}" Height="36" Padding="18,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- 6. Pushover Channel Form -->
                        <StackPanel x:Name="PushoverChannelPanel" Visibility="Collapsed">
                            <TextBlock Text="Pushover settings" FontWeight="SemiBold" FontSize="{StaticResource FontSizeH2}" Foreground="{DynamicResource BrushInk}"/>
                            <TextBlock Text="Deliver real-time mobile push notifications to iOS and Android" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,20"/>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="User key" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                    <TextBox Text="{Binding Config.Webhooks.PushoverUserKey, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInputMono}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Application API token" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                    <TextBox Text="{Binding Config.Webhooks.PushoverApiToken, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInputMono}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Send test Pushover notification" Command="{Binding TestPushoverCommand}" Style="{StaticResource BtnQuiet}" Height="36" Padding="16,0" Margin="0,0,12,0"/>
                                <Button Content="Save settings" Command="{Binding SaveSettingsCommand}" Style="{StaticResource BtnPrimary}" Height="36" Padding="18,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- 7. ntfy Channel Form -->
                        <StackPanel x:Name="NtfyChannelPanel" Visibility="Collapsed">
                            <TextBlock Text="ntfy settings" FontWeight="SemiBold" FontSize="{StaticResource FontSizeH2}" Foreground="{DynamicResource BrushInk}"/>
                            <TextBlock Text="HTTP-based pub-sub push notifications to phones and desktop subscribers" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,20"/>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="ntfy server URL" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                    <TextBox Text="{Binding Config.Webhooks.NtfyServerUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInputMono}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Topic name" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                    <TextBox Text="{Binding Config.Webhooks.NtfyTopic, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInput}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Authentication token (optional for protected topics)" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                            <TextBox Text="{Binding Config.Webhooks.NtfyToken, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInputMono}" Margin="0,4,0,20"/>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Send test ntfy notification" Command="{Binding TestNtfyCommand}" Style="{StaticResource BtnQuiet}" Height="36" Padding="16,0" Margin="0,0,12,0"/>
                                <Button Content="Save settings" Command="{Binding SaveSettingsCommand}" Style="{StaticResource BtnPrimary}" Height="36" Padding="18,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- 8. PagerDuty Channel Form -->
                        <StackPanel x:Name="PagerDutyChannelPanel" Visibility="Collapsed">
                            <TextBlock Text="PagerDuty settings" FontWeight="SemiBold" FontSize="{StaticResource FontSizeH2}" Foreground="{DynamicResource BrushInk}"/>
                            <TextBlock Text="Trigger and auto-resolve incident tickets through PagerDuty Events API v2" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,20"/>

                            <TextBlock Text="Integration / routing key" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                            <TextBox Text="{Binding Config.Webhooks.PagerDutyRoutingKey, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInputMono}" Margin="0,4,0,6"/>
                            <TextBlock Text="Find your 32-character routing key in PagerDuty under Service > Integrations." FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkFaint}" Margin="0,0,0,20"/>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Send test PagerDuty incident" Command="{Binding TestPagerDutyCommand}" Style="{StaticResource BtnQuiet}" Height="36" Padding="16,0" Margin="0,0,12,0"/>
                                <Button Content="Save settings" Command="{Binding SaveSettingsCommand}" Style="{StaticResource BtnPrimary}" Height="36" Padding="18,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- 9. Custom Webhook Channel Form -->
                        <StackPanel x:Name="CustomWebhookChannelPanel" Visibility="Collapsed">
                            <TextBlock Text="Custom webhook settings" FontWeight="SemiBold" FontSize="{StaticResource FontSizeH2}" Foreground="{DynamicResource BrushInk}"/>
                            <TextBlock Text="Post structured JSON payloads to any HTTP endpoint (n8n, Zapier, Make, Home Assistant)" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,20"/>

                            <TextBlock Text="Webhook URL" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                            <TextBox Text="{Binding Config.Webhooks.CustomWebhookUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInputMono}" Margin="0,4,0,16"/>

                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Custom header name (optional)" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                    <TextBox Text="{Binding Config.Webhooks.CustomWebhookHeaderName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInput}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Custom header value (optional)" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                    <TextBox Text="{Binding Config.Webhooks.CustomWebhookHeaderValue, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInput}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Send test webhook" Command="{Binding TestCustomWebhookCommand}" Style="{StaticResource BtnQuiet}" Height="36" Padding="16,0" Margin="0,0,12,0"/>
                                <Button Content="Save settings" Command="{Binding SaveSettingsCommand}" Style="{StaticResource BtnPrimary}" Height="36" Padding="18,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- 10. Heartbeat Monitor Form -->
                        <StackPanel x:Name="HeartbeatChannelPanel" Visibility="Collapsed">
                            <TextBlock Text="Heartbeat monitor settings" FontWeight="SemiBold" FontSize="{StaticResource FontSizeH2}" Foreground="{DynamicResource BrushInk}"/>
                            <TextBlock Text="Ping external healthcheck services (BetterUptime, Healthchecks.io, Cronitor) on successful backup" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,20"/>

                            <TextBlock Text="Healthcheck ping URL" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                            <TextBox Text="{Binding Config.Heartbeat.Url, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInputMono}" Margin="0,4,0,6"/>
                            <TextBlock Text="An HTTP GET request will be dispatched to this endpoint every time a backup succeeds." FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkFaint}" Margin="0,0,0,20"/>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Send test heartbeat ping" Command="{Binding TestHeartbeatCommand}" Style="{StaticResource BtnQuiet}" Height="36" Padding="16,0" Margin="0,0,12,0"/>
                                <Button Content="Save settings" Command="{Binding SaveSettingsCommand}" Style="{StaticResource BtnPrimary}" Height="36" Padding="18,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- 3. When To Notify Matrix (§4.7) -->
            <Border Style="{StaticResource Card}" Padding="24">
                <StackPanel>
                    <TextBlock Text="When to notify" FontWeight="SemiBold" FontSize="{StaticResource FontSizeH2}" Foreground="{DynamicResource BrushInk}"/>
                    <TextBlock Text="Select which backup execution events trigger alert dispatch" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,16"/>

                    <!-- Matrix Table: Rows (Full, Diff, Log), Columns (Succeeded, Partial, Failed) -->
                    <Border Background="{DynamicResource BrushRaised}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Header -->
                                <RowDefinition Height="Auto"/> <!-- Full Row -->
                                <RowDefinition Height="Auto"/> <!-- Diff Row -->
                                <RowDefinition Height="Auto"/> <!-- Log Row -->
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/> <!-- Type -->
                                <ColumnDefinition Width="*"/>   <!-- Succeeded -->
                                <ColumnDefinition Width="*"/>   <!-- Partial -->
                                <ColumnDefinition Width="*"/>   <!-- Failed -->
                            </Grid.ColumnDefinitions>

                            <!-- Column Headers -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Backup type" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Succeeded" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushJade}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Partial" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushSaffron}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="Failed" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushCoral}" HorizontalAlignment="Center"/>

                            <!-- Row 1: Full -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Full backup" FontWeight="Medium" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushInk}" VerticalAlignment="Center" Margin="0,12,0,0"/>
                            <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding Config.Email.NotifyOnSuccess}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                            <CheckBox Grid.Row="1" Grid.Column="2" IsChecked="True" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                            <CheckBox Grid.Row="1" Grid.Column="3" IsChecked="{Binding Config.Email.NotifyOnFailure}" HorizontalAlignment="Center" Margin="0,12,0,0"/>

                            <!-- Row 2: Differential -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Differential backup" FontWeight="Medium" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushInk}" VerticalAlignment="Center" Margin="0,12,0,0"/>
                            <CheckBox Grid.Row="2" Grid.Column="1" IsChecked="False" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                            <CheckBox Grid.Row="2" Grid.Column="2" IsChecked="True" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                            <CheckBox Grid.Row="2" Grid.Column="3" IsChecked="True" HorizontalAlignment="Center" Margin="0,12,0,0"/>

                            <!-- Row 3: Transaction Log -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Transaction log" FontWeight="Medium" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushInk}" VerticalAlignment="Center" Margin="0,12,0,0"/>
                            <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="False" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                            <CheckBox Grid.Row="3" Grid.Column="2" IsChecked="True" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                            <CheckBox Grid.Row="3" Grid.Column="3" IsChecked="True" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>