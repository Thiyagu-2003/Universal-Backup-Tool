<UserControl x:Class="UniBackup.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:UniBackup.UI.Controls"
             xmlns:vm="clr-namespace:UniBackup.UI.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,24">
        <StackPanel MaxWidth="1280" HorizontalAlignment="Stretch">

            <!-- 1. Header -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Settings &amp; Engine" FontWeight="SemiBold" FontSize="{StaticResource FontSizePageTitle}" Foreground="{DynamicResource BrushInk}"/>
                <TextBlock Text="System configuration, appearance, background service, cloud credentials, and diagnostics" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,3,0,0"/>
            </StackPanel>

            <!-- 2. Appearance Section -->
            <Border Style="{StaticResource Card}" Padding="24" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Appearance" FontWeight="SemiBold" FontSize="{StaticResource FontSizeH2}" Foreground="{DynamicResource BrushInk}"/>
                    <TextBlock Text="Personalize interface theme and window styling" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,16"/>

                    <Border Style="{StaticResource SegmentedContainer}" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Match Windows" Style="{StaticResource SegmentedItem}" Checked="Theme_Checked" Tag="System"/>
                            <RadioButton Content="Light" Style="{StaticResource SegmentedItem}" IsChecked="True" Checked="Theme_Checked" Tag="Light"/>
                            <RadioButton Content="Dark" Style="{StaticResource SegmentedItem}" Checked="Theme_Checked" Tag="Dark"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 3. Security & Access Control Section -->
            <Border Style="{StaticResource Card}" Padding="24" Margin="0,0,0,20">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="9" Background="#1A2D5BFF" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconShield}" Fill="{DynamicResource BrushCobalt}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Security &amp; access control" FontWeight="SemiBold" FontSize="{StaticResource FontSizeH2}" Foreground="{DynamicResource BrushInk}"/>
                            <TextBlock Text="Configure password protection on startup and custom date-based daily passwords" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Status Badge Pill -->
                        <Border Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource BadgePill}" Background="{DynamicResource BrushSunken}">
                            <TextBlock Text="{Binding SecurityStatusBadgeText}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBadge}" Foreground="{DynamicResource BrushInk}"/>
                        </Border>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource BrushLine}" Margin="0,16,0,16"/>

                    <!-- Toggle Row: Require Password on Startup -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Require password on startup" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushInk}"/>
                            <TextBlock Text="When disabled, UniBackup opens directly without asking for any password" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding SecurityRequireLogin, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Expanded Configuration Area (Visible when RequireLogin is enabled) -->
                    <Border Background="{DynamicResource BrushSunken}" CornerRadius="{StaticResource RadiusControl}" Padding="18,16" Margin="0,0,0,8"
                            Visibility="{Binding SecurityRequireLogin, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <!-- Mode Selector: Static vs Date-Based -->
                            <TextBlock Text="Authentication mode" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,0,0,8"/>
                            <Border Style="{StaticResource SegmentedContainer}" HorizontalAlignment="Left" Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="Standard static password" Style="{StaticResource SegmentedItem}" Tag="Static" Checked="SecurityMode_Checked" IsChecked="{Binding IsStaticAuthMode, Mode=OneWay}"/>
                                    <RadioButton Content="Dynamic date-based password" Style="{StaticResource SegmentedItem}" Tag="DateBased" Checked="SecurityMode_Checked" IsChecked="{Binding IsDateBasedAuthMode, Mode=OneWay}"/>
                                </StackPanel>
                            </Border>

                            <!-- 1. STATIC PASSWORD PANEL -->
                            <StackPanel Visibility="{Binding IsStaticAuthMode, Converter={StaticResource BoolToVis}}">
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Set New Password -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="New master password" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <Grid Margin="0,4,0,0">
                                            <PasswordBox x:Name="SecNewPasswordBox" PasswordChanged="SecNewPassword_Changed" Style="{StaticResource FieldPassword}"
                                                         Tag="Enter new master password"
                                                         Visibility="{Binding IsSecurityPasswordVisible, Converter={StaticResource InverseBoolToVis}}"/>
                                            <TextBox Text="{Binding SecurityNewPassword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInput}"
                                                     Tag="Enter new master password"
                                                     Visibility="{Binding IsSecurityPasswordVisible, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Confirm Password -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Confirm master password" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <Grid Margin="0,4,0,0">
                                            <PasswordBox x:Name="SecConfirmPasswordBox" PasswordChanged="SecConfirmPassword_Changed" Style="{StaticResource FieldPassword}"
                                                         Tag="Re-enter password"
                                                         Visibility="{Binding IsSecurityPasswordVisible, Converter={StaticResource InverseBoolToVis}}"/>
                                            <TextBox Text="{Binding SecurityConfirmPassword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInput}"
                                                     Tag="Re-enter password"
                                                     Visibility="{Binding IsSecurityPasswordVisible, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <!-- Show password toggle button -->
                                <Button Command="{Binding ToggleSecurityPasswordVisibilityCommand}" Style="{StaticResource IconBtn}" HorizontalAlignment="Left" Margin="0,0,0,12" ToolTip="Toggle password visibility">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconEye}" Fill="{DynamicResource BrushInkMuted}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Show password in plaintext" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- 2. DATE-BASED PASSWORD PANEL -->
                            <StackPanel Visibility="{Binding IsDateBasedAuthMode, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Configure your dynamic daily formula. UniBackup automatically evaluates this format every day."
                                           FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="0.8*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Prefix -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Prefix (e.g. admin(, ups)" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <TextBox Text="{Binding SecurityDatePrefix, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="e.g. admin("
                                                 Style="{StaticResource FieldInputMono}" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <!-- Date Format -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Date format" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <ComboBox ItemsSource="{Binding AvailableDateFormats}" Text="{Binding SecurityDateFormat, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEditable="True" Style="{StaticResource FieldComboBox}" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <!-- Suffix -->
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Suffix (e.g. ), !)" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <TextBox Text="{Binding SecurityDateSuffix, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="e.g. )"
                                                 Style="{StaticResource FieldInputMono}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Live Calculated Password Preview Box -->
                                <Border Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" Padding="16,12" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Today's active password preview:" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}"/>
                                            <TextBlock Text="{Binding LiveTodayPasswordPreview}" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource BrushCobalt}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="Tomorrow's password:" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkFaint}" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding LiveTomorrowPasswordPreview}" FontFamily="{StaticResource FontMono}" FontSize="13" Foreground="{DynamicResource BrushInkMuted}" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Validation Feedback Message -->
                            <TextBlock Text="{Binding SecurityMessage}" Visibility="{Binding HasSecurityMessage, Converter={StaticResource BoolToVis}}"
                                       FontWeight="SemiBold" FontSize="{StaticResource FontSizeHelp}" Margin="0,0,0,12"
                                       Foreground="{DynamicResource BrushJade}"/>

                            <!-- Buttons -->
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Save security settings" Style="{StaticResource BtnPrimary}" Height="34" Padding="18,0" Command="{Binding SaveSecuritySettingsCommand}" Margin="0,0,12,0"/>
                                <Button Content="Remove password protection" Style="{StaticResource BtnQuiet}" Height="34" Padding="14,0" Command="{Binding DisableSecurityPasswordCommand}"
                                        Visibility="{Binding HasConfiguredPassword, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 3. How Backups Run (Two Radio Cards: Windows service or Task Scheduler) -->
            <Border Style="{StaticResource Card}" Padding="24" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Execution engine" FontWeight="SemiBold" FontSize="{StaticResource FontSizeH2}" Foreground="{DynamicResource BrushInk}"/>
                    <TextBlock Text="Select how scheduled background backups are managed and fired" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,16"/>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Radio Card 1: Windows Service (Recommended) -->
                        <RadioButton Grid.Column="0" IsChecked="{Binding RunByService, Mode=TwoWay}" GroupName="RunEngineGroup" Cursor="Hand">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="{x:Type RadioButton}">
                                    <Border x:Name="bd" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="12" Padding="18,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource BrushJadeSoft}" Margin="0,0,14,0" VerticalAlignment="Top">
                                                <Path Data="{StaticResource IconServer}" Fill="{DynamicResource BrushJade}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Windows Service" FontWeight="SemiBold" FontSize="{StaticResource FontSizeRowTitle}" Foreground="{DynamicResource BrushInk}"/>
                                                <TextBlock Text="Runs continuously in session 0; survives user logouts" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <!-- Recommended Chip -->
                                            <Border Grid.Column="2" Style="{StaticResource BadgePill}" Background="{DynamicResource BrushJadeSoft}" VerticalAlignment="Top">
                                                <TextBlock Text="Recommended" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBadge}" Foreground="{DynamicResource BrushJade}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BrushJade}"/>
                                            <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushJadeSoft}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- Radio Card 2: Windows Task Scheduler -->
                        <RadioButton Grid.Column="2" IsChecked="{Binding RunByTask, Mode=TwoWay}" GroupName="RunEngineGroup" Cursor="Hand">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="{x:Type RadioButton}">
                                    <Border x:Name="bd" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="12" Padding="18,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource BrushCobaltSoft}" Margin="0,0,14,0" VerticalAlignment="Top">
                                                <Path Data="{StaticResource IconClock}" Fill="{DynamicResource BrushCobalt}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Task Scheduler" FontWeight="SemiBold" FontSize="{StaticResource FontSizeRowTitle}" Foreground="{DynamicResource BrushInk}"/>
                                                <TextBlock Text="Invokes UniBackup CLI via standard Windows Task Scheduler tasks" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BrushCobalt}"/>
                                            <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushCobaltSoft}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>
                    </Grid>

                    <!-- Live Service Card -->
                    <Border Background="{DynamicResource BrushRaised}" CornerRadius="10" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <controls:StatusDot VerticalAlignment="Center" Margin="0,0,12,0"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding WindowsServiceStatus, StringFormat={}UniBackup Service: {0}}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushInk}"/>
                                <TextBlock Text="Service binary: UniBackup.exe --service-worker" FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Start service" Command="{Binding StartWindowsServiceCommand}" Style="{StaticResource BtnQuiet}" Margin="0,0,8,0" Height="32"/>
                                <Button Content="Stop service" Command="{Binding StopWindowsServiceCommand}" Style="{StaticResource BtnQuiet}" Height="32"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 4. Storage Destinations Accordion -->
            <Border Style="{StaticResource Card}" Padding="24" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Storage destinations" FontWeight="SemiBold" FontSize="{StaticResource FontSizeH2}" Foreground="{DynamicResource BrushInk}"/>
                    <TextBlock Text="Cloud providers, credentials, and connectivity verification" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,16"/>

                    <!-- Provider 1: AWS S3 -->
                    <Border BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,10" Background="{DynamicResource BrushRaised}">
                        <Expander IsExpanded="True">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="{StaticResource BrandDrawingAwsS3}" Width="24" Height="24" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Amazon S3 / S3-compatible" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCardHeader}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Margin="16,0,16,16">
                                <Grid Margin="0,10,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Bucket name" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <TextBox Text="{Binding Config.Aws.BucketName, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="e.g. my-backup-bucket"
                                                 Style="{StaticResource FieldInputMono}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Region" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <TextBox Text="{Binding Config.Aws.Region, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="e.g. us-east-1"
                                                 Style="{StaticResource FieldInputMono}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="AWS Access Key ID" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <TextBox Text="{Binding Config.Aws.AccessKeyId, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="e.g. AKIAIOSFODNN7EXAMPLE"
                                                 Style="{StaticResource FieldInputMono}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="AWS Secret Access Key" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <TextBox Text="{Binding Config.Aws.SecretAccessKey, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="Secret access key"
                                                 Style="{StaticResource FieldInputMono}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Custom Endpoint / Service URL (optional for MinIO, Wasabi, Cloudflare R2, Backblaze B2)" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                <TextBox Text="{Binding Config.Aws.ServiceUrl, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="e.g. https://s3.wasabisys.com or https://minio.company.local:9000"
                                         Style="{StaticResource FieldInputMono}" Margin="0,4,0,14"/>

                                <Button Content="Test S3 connection" Command="{Binding TestS3ConnectionCommand}" Style="{StaticResource BtnQuiet}" Height="38" Padding="16,0" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Expander>
                    </Border>

                    <!-- Provider 2: Google Drive -->
                    <Border BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,10" Background="{DynamicResource BrushRaised}">
                        <Expander>
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="{StaticResource BrandDrawingGoogleDrive}" Width="24" Height="24" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Google Drive (OAuth2)" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCardHeader}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Margin="16,0,16,16">
                                <Grid Margin="0,10,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Target Drive folder / path" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <TextBox Text="{Binding Config.GDrive.TargetFolder, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="e.g. /Backups"
                                                 Style="{StaticResource FieldInputMono}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Account label" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <TextBox Text="{Binding Config.GDrive.AccountLabel, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="e.g. Corporate Google Drive"
                                                 Style="{StaticResource FieldInput}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <Button Content="Test Google Drive connection" Command="{Binding TestGoogleDriveCommand}" Style="{StaticResource BtnQuiet}" Height="38" Padding="16,0" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Expander>
                    </Border>

                    <!-- Provider 3: Microsoft Azure Blob Storage -->
                    <Border BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,10" Background="{DynamicResource BrushRaised}">
                        <Expander>
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconCloudArrowDown}" Fill="{DynamicResource BrushCobalt}" Width="22" Height="22" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Microsoft Azure Blob Storage" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCardHeader}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Margin="16,0,16,16">
                                <TextBlock Text="Azure connection string / SAS URL" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,10,0,0"/>
                                <TextBox Text="{Binding Config.Azure.ConnectionString, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net"
                                         Style="{StaticResource FieldInputMono}" Margin="0,4,0,12"/>

                                <TextBlock Text="Container name" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                <TextBox Text="{Binding Config.Azure.ContainerName, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="e.g. unibackup-archives"
                                         Style="{StaticResource FieldInputMono}" Margin="0,4,0,14"/>

                                <Button Content="Test Azure connection" Command="{Binding TestAzureCommand}" Style="{StaticResource BtnQuiet}" Height="38" Padding="16,0" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Expander>
                    </Border>

                    <!-- Provider 4: Local Storage / UNC -->
                    <Border BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,10" Background="{DynamicResource BrushRaised}">
                        <Expander>
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconServer}" Fill="{DynamicResource BrushJade}" Width="22" Height="22" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Local Storage / UNC Network Shares" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCardHeader}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Margin="16,0,16,16">
                                <TextBlock Text="Base folder path" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,10,0,0"/>
                                <Grid Margin="0,4,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Config.Local.TargetPath, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="e.g. D:\Backups or \\nas\backups"
                                             Style="{StaticResource FieldInputMono}"/>
                                    <Button Grid.Column="2" Content="Browse..." Command="{Binding BrowseLocalStorageFolderCommand}" Style="{StaticResource BtnQuiet}" Height="38" Padding="16,0"/>
                                    <Button Grid.Column="4" Content="Test folder access" Command="{Binding TestLocalStorageCommand}" Style="{StaticResource BtnQuiet}" Height="38" Padding="14,0"/>
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </Border>

                    <!-- Provider 5: SFTP (SSH File Transfer) -->
                    <Border BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,10" Background="{DynamicResource BrushRaised}">
                        <Expander>
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconServer}" Fill="{DynamicResource BrushTeal}" Width="22" Height="22" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="SFTP (SSH File Transfer)" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCardHeader}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Margin="16,0,16,16">
                                <Grid Margin="0,10,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Host" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <TextBox Text="{Binding Config.Sftp.Host, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="sftp.company.com" Style="{StaticResource FieldInputMono}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Port" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <TextBox Text="{Binding Config.Sftp.Port, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="22" Style="{StaticResource FieldInputMono}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Username" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <TextBox Text="{Binding Config.Sftp.Username, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="backup-user" Style="{StaticResource FieldInput}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Password" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <TextBox Text="{Binding Config.Sftp.Password, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="SFTP password" Style="{StaticResource FieldInput}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Remote directory" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                <TextBox Text="{Binding Config.Sftp.RemoteFolder, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="/backups" Style="{StaticResource FieldInputMono}" Margin="0,4,0,14"/>

                                <Button Content="Test SFTP connection" Command="{Binding TestSftpCommand}" Style="{StaticResource BtnQuiet}" Height="38" Padding="16,0" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Expander>
                    </Border>

                    <!-- Provider 6: FTP / FTPS -->
                    <Border BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,10" Background="{DynamicResource BrushRaised}">
                        <Expander>
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconServer}" Fill="{DynamicResource BrushAmber}" Width="22" Height="22" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="FTP / FTPS" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCardHeader}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Margin="16,0,16,16">
                                <Grid Margin="0,10,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Host" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <TextBox Text="{Binding Config.Ftp.Host, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="ftp.company.com" Style="{StaticResource FieldInputMono}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Port" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <TextBox Text="{Binding Config.Ftp.Port, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="21" Style="{StaticResource FieldInputMono}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Username" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <TextBox Text="{Binding Config.Ftp.Username, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="ftp-user" Style="{StaticResource FieldInput}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Password" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <TextBox Text="{Binding Config.Ftp.Password, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="FTP password" Style="{StaticResource FieldInput}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Remote directory" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                <TextBox Text="{Binding Config.Ftp.RemoteFolder, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="/backups" Style="{StaticResource FieldInputMono}" Margin="0,4,0,14"/>

                                <Button Content="Test FTP connection" Command="{Binding TestFtpCommand}" Style="{StaticResource BtnQuiet}" Height="38" Padding="16,0" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Expander>
                    </Border>

                    <!-- Provider 7: WebDAV & Cloud Storage Tokens (Dropbox, OneDrive, Box) -->
                    <Border BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,16" Background="{DynamicResource BrushRaised}">
                        <Expander>
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconCloudArrowDown}" Fill="{DynamicResource BrushOrchid}" Width="22" Height="22" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="WebDAV &amp; Cloud Storage APIs (Dropbox, OneDrive, Box)" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCardHeader}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Margin="16,0,16,16">
                                <TextBlock Text="WebDAV Server URL" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,10,0,0"/>
                                <TextBox Text="{Binding Config.WebDav.ServerUrl, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="https://webdav.nextcloud.company.com/remote.php/webdav" Style="{StaticResource FieldInputMono}" Margin="0,4,0,12"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="WebDAV Username" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <TextBox Text="{Binding Config.WebDav.Username, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="webdav-user" Style="{StaticResource FieldInput}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="WebDAV Password" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <TextBox Text="{Binding Config.WebDav.Password, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="WebDAV password" Style="{StaticResource FieldInput}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Dropbox Access Token" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                <TextBox Text="{Binding Config.Dropbox.AccessToken, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="sl.u.AF..." Style="{StaticResource FieldInputMono}" Margin="0,4,0,12"/>

                                <TextBlock Text="Microsoft OneDrive Access Token" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                <TextBox Text="{Binding Config.OneDrive.AccessToken, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="EwB..." Style="{StaticResource FieldInputMono}" Margin="0,4,0,12"/>

                                <TextBlock Text="Box Cloud Access Token" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                <TextBox Text="{Binding Config.Box.AccessToken, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="Box developer or OAuth token" Style="{StaticResource FieldInputMono}" Margin="0,4,0,14"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Test WebDAV" Command="{Binding TestWebDavCommand}" Style="{StaticResource BtnQuiet}" Height="36" Padding="14,0" Margin="0,0,8,0"/>
                                    <Button Content="Test Dropbox" Command="{Binding TestDropboxCommand}" Style="{StaticResource BtnQuiet}" Height="36" Padding="14,0" Margin="0,0,8,0"/>
                                    <Button Content="Test OneDrive" Command="{Binding TestOneDriveCommand}" Style="{StaticResource BtnQuiet}" Height="36" Padding="14,0" Margin="0,0,8,0"/>
                                    <Button Content="Test Box" Command="{Binding TestBoxCommand}" Style="{StaticResource BtnQuiet}" Height="36" Padding="14,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </Border>

                    <!-- Save Storage Destinations Button -->
                    <Button Content="Save storage destinations" Command="{Binding SaveSettingsCommand}" Style="{StaticResource BtnPrimary}" Height="38" Padding="20,0" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- 5. Working Folders -->
            <Border Style="{StaticResource Card}" Padding="24" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Working folders" FontWeight="SemiBold" FontSize="{StaticResource FontSizeH2}" Foreground="{DynamicResource BrushInk}"/>
                    <TextBlock Text="Temporary staging partition for compression and cloud chunks" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,16"/>

                    <TextBlock Text="Temporary directory" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Config.Backup.TempFolder, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="e.g. C:\UniBackup\temp"
                                 Style="{StaticResource FieldInputMono}"/>
                        <Button Grid.Column="2" Content="Browse..." Command="{Binding BrowseTempFolderCommand}" Style="{StaticResource BtnQuiet}" Height="38" Padding="18,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 6. Health Check (§4.8) -->
            <Border x:Name="HealthCheckSection" Style="{StaticResource Card}" Padding="24">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="System health check" FontWeight="SemiBold" FontSize="{StaticResource FontSizeH2}" Foreground="{DynamicResource BrushInk}"/>
                            <TextBlock Text="Validate service, SQL instances, IIS metabase, temp disk, and cloud connections"
                                       FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Content="Run health check" Command="{Binding RunValidateServerCommand}" Style="{StaticResource BtnPrimary}"/>
                    </Grid>

                    <!-- Diagnostic Rows -->
                    <ItemsControl ItemsSource="{Binding DiagnosticItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Status Tile (24 px) -->
                                        <Border Width="24" Height="24" CornerRadius="6"
                                                Background="{Binding IsSuccess, Converter={StaticResource StatusToBrushConverter}, ConverterParameter=soft}"
                                                Margin="0,0,12,0" VerticalAlignment="Center">
                                            <Path Data="{Binding IsSuccess, Converter={StaticResource StatusToGlyphConverter}}"
                                                  Fill="{Binding IsSuccess, Converter={StaticResource StatusToBrushConverter}}"
                                                  Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <TextBlock Grid.Column="1" Text="{Binding Category}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushInk}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
