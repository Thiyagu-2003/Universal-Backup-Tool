<UserControl x:Class="UniBackup.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:UniBackup.UI.Controls"
             xmlns:vm="clr-namespace:UniBackup.UI.ViewModels"
             xmlns:conv="clr-namespace:UniBackup.UI.Converters">
    <UserControl.Resources>
        <Style x:Key="SubmenuNavTab" TargetType="{x:Type RadioButton}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="GroupName" Value="SubmenuNavRadioGroup"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="TabBorder" CornerRadius="10" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path x:Name="IconPath" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                      Fill="{DynamicResource BrushInkMuted}" Width="15" Height="15" Stretch="Uniform"
                                      VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="LabelText" Text="{TemplateBinding Content}"
                                           FontSize="{StaticResource FontSizeBody}" FontWeight="Medium"
                                           Foreground="{DynamicResource BrushInkMuted}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource BrushSunken}"/>
                                <Setter TargetName="LabelText" Property="Foreground" Value="{DynamicResource BrushInk}"/>
                                <Setter TargetName="IconPath" Property="Fill" Value="{DynamicResource BrushInk}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource BrushCobalt}"/>
                                <Setter TargetName="LabelText" Property="Foreground" Value="White"/>
                                <Setter TargetName="LabelText" Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="IconPath" Property="Fill" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Background="{DynamicResource BrushSunken}">
        <Grid.RowDefinitions>
            <!-- 1. Header & Floating Submenu Area -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Dynamic Settings Workspace -->
            <RowDefinition Height="*"/>
            <!-- 3. Bottom Action Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================================================================
             1. HEADER & FLOATING HORIZONTAL SUBMENU
             =================================================================== -->
        <Border Grid.Row="0" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,0,0,1" Padding="28,20,28,16">
            <StackPanel MaxWidth="1340" HorizontalAlignment="Stretch">
                <!-- Page Title & Subtitle -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Settings &amp; Engine" FontWeight="Bold" FontSize="{StaticResource FontSizePageTitle}" Foreground="{DynamicResource BrushInk}"/>
                        <TextBlock Text="Configure execution engine, appearance, cloud credentials, security, storage and advanced options"
                                   FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- Quick Engine Health Status in Header -->
                    <Border Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource BadgePill}" Background="{DynamicResource BrushSunken}" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{Binding WindowsServiceStatusColor}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding WindowsServiceStatus, StringFormat={}Engine: {0}}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBadge}" Foreground="{DynamicResource BrushInk}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Floating Horizontal Submenu Container (Clean, Fixed, No Slider) -->
                <Border Background="{DynamicResource BrushSunken}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1"
                        CornerRadius="14" Padding="4" HorizontalAlignment="Left">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" Direction="270" RenderingBias="Performance" ShadowDepth="2" Opacity="0.06" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <!-- 1. Overview Tab -->
                        <RadioButton Style="{StaticResource SubmenuNavTab}" Tag="{StaticResource IconOverview}" Content="Overview"
                                     IsChecked="{Binding SelectedSection, Converter={StaticResource StringEqualsToBool}, ConverterParameter=Overview}"
                                     Command="{Binding SelectSectionCommand}" CommandParameter="Overview"/>

                        <!-- 2. Appearance Tab -->
                        <RadioButton Style="{StaticResource SubmenuNavTab}" Tag="{StaticResource IconPalette}" Content="Appearance"
                                     IsChecked="{Binding SelectedSection, Converter={StaticResource StringEqualsToBool}, ConverterParameter=Appearance}"
                                     Command="{Binding SelectSectionCommand}" CommandParameter="Appearance"/>

                        <!-- 3. Security Tab -->
                        <RadioButton Style="{StaticResource SubmenuNavTab}" Tag="{StaticResource IconShield}" Content="Security"
                                     IsChecked="{Binding SelectedSection, Converter={StaticResource StringEqualsToBool}, ConverterParameter=Security}"
                                     Command="{Binding SelectSectionCommand}" CommandParameter="Security"/>

                        <!-- 4. Execution Engine Tab -->
                        <RadioButton Style="{StaticResource SubmenuNavTab}" Tag="{StaticResource IconServer}" Content="Execution Engine"
                                     IsChecked="{Binding SelectedSection, Converter={StaticResource StringEqualsToBool}, ConverterParameter=Engine}"
                                     Command="{Binding SelectSectionCommand}" CommandParameter="Engine"/>

                        <!-- 5. Cloud Credentials Tab -->
                        <RadioButton Style="{StaticResource SubmenuNavTab}" Tag="{StaticResource IconCloud}" Content="Cloud Credentials"
                                     IsChecked="{Binding SelectedSection, Converter={StaticResource StringEqualsToBool}, ConverterParameter=Credentials}"
                                     Command="{Binding SelectSectionCommand}" CommandParameter="Credentials"/>

                        <!-- 6. Storage & Cache Tab -->
                        <RadioButton Style="{StaticResource SubmenuNavTab}" Tag="{StaticResource IconHardDrive}" Content="Storage &amp; Cache"
                                     IsChecked="{Binding SelectedSection, Converter={StaticResource StringEqualsToBool}, ConverterParameter=Storage}"
                                     Command="{Binding SelectSectionCommand}" CommandParameter="Storage"/>

                        <!-- 7. Advanced Tab -->
                        <RadioButton Style="{StaticResource SubmenuNavTab}" Tag="{StaticResource IconSliders}" Content="Advanced"
                                     IsChecked="{Binding SelectedSection, Converter={StaticResource StringEqualsToBool}, ConverterParameter=Advanced}"
                                     Command="{Binding SelectSectionCommand}" CommandParameter="Advanced"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ===================================================================
             2. DYNAMIC SETTINGS WORKSPACE
             =================================================================== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,24">
            <StackPanel MaxWidth="1340" HorizontalAlignment="Stretch">

                <!-- ===============================================================
                     SECTION 1: OVERVIEW LANDING
                     =============================================================== -->
                <StackPanel Visibility="{Binding IsOverviewSection, Converter={StaticResource BoolToVis}}">
                    <!-- Section Banner -->
                    <Border Style="{StaticResource Card}" Padding="24" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Settings &amp; Engine Overview" FontWeight="Bold" FontSize="{StaticResource FontSizeH2}" Foreground="{DynamicResource BrushInk}"/>
                                <TextBlock Text="Comprehensive real-time status across execution engine, security, storage and cloud integrations. Jump directly to any section to adjust configurations."
                                           FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Save settings" Command="{Binding SaveSettingsCommand}" Style="{StaticResource BtnPrimary}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Overview Cards Grid (3 Columns x 2 Rows = 6 Cards) -->
                    <UniformGrid Columns="3" Margin="0,0,-16,0">
                        <!-- 1. Appearance Card -->
                        <Border Style="{StaticResource Card}" Padding="22" Margin="0,0,16,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Width="42" Height="42" CornerRadius="10" Background="{DynamicResource BrushCobaltSoft}" HorizontalAlignment="Left">
                                    <Path Data="{StaticResource IconPalette}" Fill="{DynamicResource BrushCobalt}" Width="19" Height="19" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Row="1" Text="Appearance" FontWeight="Bold" FontSize="{StaticResource FontSizeRowTitle}" Foreground="{DynamicResource BrushInk}" Margin="0,14,0,4"/>
                                <StackPanel Grid.Row="2">
                                    <TextBlock Text="{Binding OverviewAppearanceStatus}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushCobalt}"/>
                                    <TextBlock Text="Personalize interface theme and window styling" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" TextWrapping="Wrap" Margin="0,4,0,14"/>
                                </StackPanel>
                                <Button Grid.Row="3" Content="Configure theme" Command="{Binding SelectSectionCommand}" CommandParameter="Appearance" Style="{StaticResource BtnQuiet}" HorizontalAlignment="Left" Height="34"/>
                            </Grid>
                        </Border>

                        <!-- 2. Security Card -->
                        <Border Style="{StaticResource Card}" Padding="22" Margin="0,0,16,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Width="42" Height="42" CornerRadius="10" Background="{DynamicResource BrushJadeSoft}" HorizontalAlignment="Left">
                                    <Path Data="{StaticResource IconShield}" Fill="{DynamicResource BrushJade}" Width="19" Height="19" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Row="1" Text="Security" FontWeight="Bold" FontSize="{StaticResource FontSizeRowTitle}" Foreground="{DynamicResource BrushInk}" Margin="0,14,0,4"/>
                                <StackPanel Grid.Row="2">
                                    <TextBlock Text="{Binding OverviewSecurityStatus}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushInk}"/>
                                    <TextBlock Text="Master password protection &amp; date-based formula" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" TextWrapping="Wrap" Margin="0,4,0,14"/>
                                </StackPanel>
                                <Button Grid.Row="3" Content="Manage security" Command="{Binding SelectSectionCommand}" CommandParameter="Security" Style="{StaticResource BtnQuiet}" HorizontalAlignment="Left" Height="34"/>
                            </Grid>
                        </Border>

                        <!-- 3. Engine Card -->
                        <Border Style="{StaticResource Card}" Padding="22" Margin="0,0,16,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Width="42" Height="42" CornerRadius="10" Background="{DynamicResource BrushJadeSoft}" HorizontalAlignment="Left">
                                    <Path Data="{StaticResource IconServer}" Fill="{DynamicResource BrushJade}" Width="19" Height="19" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Row="1" Text="Execution Engine" FontWeight="Bold" FontSize="{StaticResource FontSizeRowTitle}" Foreground="{DynamicResource BrushInk}" Margin="0,14,0,4"/>
                                <StackPanel Grid.Row="2">
                                    <TextBlock Text="{Binding OverviewEngineStatus}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushInk}"/>
                                    <TextBlock Text="Background service worker and task scheduler" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" TextWrapping="Wrap" Margin="0,4,0,14"/>
                                </StackPanel>
                                <Button Grid.Row="3" Content="Configure engine" Command="{Binding SelectSectionCommand}" CommandParameter="Engine" Style="{StaticResource BtnQuiet}" HorizontalAlignment="Left" Height="34"/>
                            </Grid>
                        </Border>

                        <!-- 4. Cloud Credentials Card -->
                        <Border Style="{StaticResource Card}" Padding="22" Margin="0,0,16,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Width="42" Height="42" CornerRadius="10" Background="{DynamicResource BrushCobaltSoft}" HorizontalAlignment="Left">
                                    <Path Data="{StaticResource IconCloud}" Fill="{DynamicResource BrushCobalt}" Width="19" Height="19" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Row="1" Text="Cloud Credentials" FontWeight="Bold" FontSize="{StaticResource FontSizeRowTitle}" Foreground="{DynamicResource BrushInk}" Margin="0,14,0,4"/>
                                <StackPanel Grid.Row="2">
                                    <TextBlock Text="{Binding OverviewCloudStatus}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushInk}"/>
                                    <TextBlock Text="AWS S3, Azure, Google Drive, and cloud tokens" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" TextWrapping="Wrap" Margin="0,4,0,14"/>
                                </StackPanel>
                                <Button Grid.Row="3" Content="Manage credentials" Command="{Binding SelectSectionCommand}" CommandParameter="Credentials" Style="{StaticResource BtnQuiet}" HorizontalAlignment="Left" Height="34"/>
                            </Grid>
                        </Border>

                        <!-- 5. Storage & Cache Card -->
                        <Border Style="{StaticResource Card}" Padding="22" Margin="0,0,16,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Width="42" Height="42" CornerRadius="10" Background="{DynamicResource BrushTealSoft}" HorizontalAlignment="Left">
                                    <Path Data="{StaticResource IconHardDrive}" Fill="{DynamicResource BrushTeal}" Width="19" Height="19" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Row="1" Text="Storage &amp; Cache" FontWeight="Bold" FontSize="{StaticResource FontSizeRowTitle}" Foreground="{DynamicResource BrushInk}" Margin="0,14,0,4"/>
                                <StackPanel Grid.Row="2">
                                    <TextBlock Text="{Binding OverviewStorageStatus}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushInk}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="Staging partition, retention policy and cache clean" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" TextWrapping="Wrap" Margin="0,4,0,14"/>
                                </StackPanel>
                                <Button Grid.Row="3" Content="Storage settings" Command="{Binding SelectSectionCommand}" CommandParameter="Storage" Style="{StaticResource BtnQuiet}" HorizontalAlignment="Left" Height="34"/>
                            </Grid>
                        </Border>

                        <!-- 6. Advanced Card -->
                        <Border Style="{StaticResource Card}" Padding="22" Margin="0,0,16,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Width="42" Height="42" CornerRadius="10" Background="{DynamicResource BrushRaised}" HorizontalAlignment="Left">
                                    <Path Data="{StaticResource IconSliders}" Fill="{DynamicResource BrushInk}" Width="19" Height="19" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Row="1" Text="Advanced" FontWeight="Bold" FontSize="{StaticResource FontSizeRowTitle}" Foreground="{DynamicResource BrushInk}" Margin="0,14,0,4"/>
                                <StackPanel Grid.Row="2">
                                    <TextBlock Text="{Binding OverviewAdvancedStatus}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushInk}"/>
                                    <TextBlock Text="Concurrency streams, VSS and config export" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" TextWrapping="Wrap" Margin="0,4,0,14"/>
                                </StackPanel>
                                <Button Grid.Row="3" Content="Advanced options" Command="{Binding SelectSectionCommand}" CommandParameter="Advanced" Style="{StaticResource BtnQuiet}" HorizontalAlignment="Left" Height="34"/>
                            </Grid>
                        </Border>
                    </UniformGrid>
                </StackPanel>

                <!-- ===============================================================
                     SECTION 2: APPEARANCE
                     =============================================================== -->
                <StackPanel Visibility="{Binding IsAppearanceSection, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource Card}" Padding="28" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Appearance &amp; Theme" FontWeight="Bold" FontSize="{StaticResource FontSizeH2}" Foreground="{DynamicResource BrushInk}"/>
                            <TextBlock Text="Personalize the visual styling of UniBackup Pro. Changes apply immediately across the entire workspace."
                                       FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,3,0,24"/>

                            <!-- 3 Theme Cards Grid -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Card 1: Match Windows (System) -->
                                <Border Grid.Column="0" CornerRadius="12" BorderThickness="2" Cursor="Hand" Padding="20"
                                        Background="{DynamicResource BrushPanel}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{DynamicResource BrushLine}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSystemTheme}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BrushCobalt}"/>
                                                    <Setter Property="Background" Value="{DynamicResource BrushCobaltSoft}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding SetThemeCommand}" CommandParameter="System"/>
                                    </Border.InputBindings>
                                    <StackPanel>
                                        <!-- Swatch Preview: Half Light, Half Dark -->
                                        <Border Height="80" CornerRadius="8" Margin="0,0,0,16" ClipToBounds="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#F8FAFC">
                                                    <Border Margin="12" Background="#FFFFFF" CornerRadius="4" BorderBrush="#E2E8F0" BorderThickness="1"/>
                                                </Border>
                                                <Border Grid.Column="1" Background="#0F172A">
                                                    <Border Margin="12" Background="#1E293B" CornerRadius="4" BorderBrush="#334155" BorderThickness="1"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <Grid>
                                            <TextBlock Text="Match Windows" FontWeight="Bold" FontSize="{StaticResource FontSizeCardHeader}" Foreground="{DynamicResource BrushInk}"/>
                                            <Path HorizontalAlignment="Right" Data="{StaticResource IconCheck}" Fill="{DynamicResource BrushCobalt}" Width="16" Height="16" Stretch="Uniform"
                                                  Visibility="{Binding IsSystemTheme, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                        <TextBlock Text="Follow system personalization setting" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card 2: Light Mode -->
                                <Border Grid.Column="2" CornerRadius="12" BorderThickness="2" Cursor="Hand" Padding="20"
                                        Background="{DynamicResource BrushPanel}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{DynamicResource BrushLine}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLightTheme}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BrushCobalt}"/>
                                                    <Setter Property="Background" Value="{DynamicResource BrushCobaltSoft}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding SetThemeCommand}" CommandParameter="Light"/>
                                    </Border.InputBindings>
                                    <StackPanel>
                                        <!-- Swatch Preview: Light -->
                                        <Border Height="80" CornerRadius="8" Background="#F1F5F9" Margin="0,0,0,16" Padding="12">
                                            <Border Background="#FFFFFF" CornerRadius="4" BorderBrush="#CBD5E1" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal" Margin="8,0">
                                                    <Border Width="12" Height="12" CornerRadius="6" Background="#2563EB" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <Border Width="40" Height="6" CornerRadius="3" Background="#94A3B8" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Border>
                                        <Grid>
                                            <TextBlock Text="Light Theme" FontWeight="Bold" FontSize="{StaticResource FontSizeCardHeader}" Foreground="{DynamicResource BrushInk}"/>
                                            <Path HorizontalAlignment="Right" Data="{StaticResource IconCheck}" Fill="{DynamicResource BrushCobalt}" Width="16" Height="16" Stretch="Uniform"
                                                  Visibility="{Binding IsLightTheme, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                        <TextBlock Text="Crisp white cards, slate borders and clear contrast" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card 3: Dark Mode -->
                                <Border Grid.Column="4" CornerRadius="12" BorderThickness="2" Cursor="Hand" Padding="20"
                                        Background="{DynamicResource BrushPanel}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{DynamicResource BrushLine}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BrushCobalt}"/>
                                                    <Setter Property="Background" Value="{DynamicResource BrushCobaltSoft}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding SetThemeCommand}" CommandParameter="Dark"/>
                                    </Border.InputBindings>
                                    <StackPanel>
                                        <!-- Swatch Preview: Dark -->
                                        <Border Height="80" CornerRadius="8" Background="#0F172A" Margin="0,0,0,16" Padding="12">
                                            <Border Background="#1E293B" CornerRadius="4" BorderBrush="#334155" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal" Margin="8,0">
                                                    <Border Width="12" Height="12" CornerRadius="6" Background="#38BDF8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <Border Width="40" Height="6" CornerRadius="3" Background="#64748B" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Border>
                                        <Grid>
                                            <TextBlock Text="Dark Theme" FontWeight="Bold" FontSize="{StaticResource FontSizeCardHeader}" Foreground="{DynamicResource BrushInk}"/>
                                            <Path HorizontalAlignment="Right" Data="{StaticResource IconCheck}" Fill="{DynamicResource BrushCobalt}" Width="16" Height="16" Stretch="Uniform"
                                                  Visibility="{Binding IsDarkTheme, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                        <TextBlock Text="Deep navy and slate for comfortable low-light work" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===============================================================
                     SECTION 3: SECURITY & ACCESS CONTROL
                     =============================================================== -->
                <StackPanel Visibility="{Binding IsSecuritySection, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource Card}" Padding="28" Margin="0,0,0,20">
                        <StackPanel>
                            <!-- Header with Badge -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="42" Height="42" CornerRadius="10" Background="{DynamicResource BrushJadeSoft}" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconShield}" Fill="{DynamicResource BrushJade}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Security &amp; Access Control" FontWeight="Bold" FontSize="{StaticResource FontSizeH2}" Foreground="{DynamicResource BrushInk}"/>
                                    <TextBlock Text="Protect UniBackup Pro startup with a static master password or a dynamic date-based daily formula"
                                               FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource BadgePill}" Background="{DynamicResource BrushSunken}" Padding="14,6">
                                    <TextBlock Text="{Binding SecurityStatusBadgeText}" FontWeight="Bold" FontSize="{StaticResource FontSizeBadge}" Foreground="{DynamicResource BrushInk}"/>
                                </Border>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource BrushLine}" Margin="0,0,0,20"/>

                            <!-- Startup Password Toggle Row -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Require password on startup" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushInk}"/>
                                    <TextBlock Text="When disabled, UniBackup opens directly into the console without authentication" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding SecurityRequireLogin, Mode=TwoWay}" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Password Setup Panel (Visible when RequireLogin is True) -->
                            <Border Background="{DynamicResource BrushSunken}" CornerRadius="12" Padding="20"
                                    Visibility="{Binding SecurityRequireLogin, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Authentication Mode" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,0,0,10"/>
                                    <Border Style="{StaticResource SegmentedContainer}" HorizontalAlignment="Left" Margin="0,0,0,20">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Content="Standard Static Password" Style="{StaticResource SegmentedItem}" Tag="Static"
                                                         IsChecked="{Binding SecurityAuthMode, Converter={StaticResource StringEqualsToBool}, ConverterParameter=Static}"/>
                                            <RadioButton Content="Dynamic Date-Based Password" Style="{StaticResource SegmentedItem}" Tag="DateBased"
                                                         IsChecked="{Binding SecurityAuthMode, Converter={StaticResource StringEqualsToBool}, ConverterParameter=DateBased}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Panel A: Static Master Password -->
                                    <StackPanel Visibility="{Binding IsStaticAuthMode, Converter={StaticResource BoolToVis}}">
                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- New Password Field -->
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="New master password" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                                <Grid Margin="0,4,0,0">
                                                    <PasswordBox x:Name="SecNewPasswordBox" PasswordChanged="SecNewPassword_Changed" Style="{StaticResource FieldPassword}"
                                                                 Tag="Enter new master password"
                                                                 Visibility="{Binding IsSecurityPasswordVisible, Converter={StaticResource InverseBoolToVis}}"/>
                                                    <TextBox Text="{Binding SecurityNewPassword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInput}"
                                                             Tag="Enter new master password"
                                                             Visibility="{Binding IsSecurityPasswordVisible, Converter={StaticResource BoolToVis}}"/>
                                                </Grid>
                                            </StackPanel>

                                            <!-- Confirm Password Field -->
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Confirm master password" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                                <Grid Margin="0,4,0,0">
                                                    <PasswordBox x:Name="SecConfirmPasswordBox" PasswordChanged="SecConfirmPassword_Changed" Style="{StaticResource FieldPassword}"
                                                                 Tag="Re-enter password"
                                                                 Visibility="{Binding IsSecurityPasswordVisible, Converter={StaticResource InverseBoolToVis}}"/>
                                                    <TextBox Text="{Binding SecurityConfirmPassword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInput}"
                                                             Tag="Re-enter password"
                                                             Visibility="{Binding IsSecurityPasswordVisible, Converter={StaticResource BoolToVis}}"/>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Show/Hide Plaintext Toggle -->
                                        <Button Command="{Binding ToggleSecurityPasswordVisibilityCommand}" Style="{StaticResource IconBtn}" HorizontalAlignment="Left" Margin="0,0,0,16">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconEye}" Fill="{DynamicResource BrushInkMuted}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="Show password in plaintext" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <!-- Panel B: Dynamic Date-Based Password -->
                                    <StackPanel Visibility="{Binding IsDateBasedAuthMode, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Define your formula format. UniBackup Pro dynamically evaluates this formula every midnight based on the local server date."
                                                   FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,0,0,14"/>

                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="14"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="14"/>
                                                <ColumnDefinition Width="0.8*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Prefix -->
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Prefix (e.g. admin(, ups)" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                                <TextBox Text="{Binding SecurityDatePrefix, UpdateSourceTrigger=PropertyChanged}"
                                                         Tag="e.g. admin(" Style="{StaticResource FieldInputMono}" Margin="0,4,0,0"/>
                                            </StackPanel>

                                            <!-- Date Format -->
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Date Format Pattern" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                                <ComboBox ItemsSource="{Binding AvailableDateFormats}" Text="{Binding SecurityDateFormat, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEditable="True" Style="{StaticResource FieldComboBox}" Margin="0,4,0,0"/>
                                            </StackPanel>

                                            <!-- Suffix -->
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="Suffix (e.g. ), !)" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                                <TextBox Text="{Binding SecurityDateSuffix, UpdateSourceTrigger=PropertyChanged}"
                                                         Tag="e.g. )" Style="{StaticResource FieldInputMono}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Live Calculated Password Preview Box -->
                                        <Border Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1"
                                                CornerRadius="10" Padding="18,14" Margin="0,0,0,16">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Today's active password preview:" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}"/>
                                                    <TextBlock Text="{Binding LiveTodayPasswordPreview}" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="17" Foreground="{DynamicResource BrushCobalt}" Margin="0,4,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="Tomorrow's password:" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding LiveTomorrowPasswordPreview}" FontFamily="{StaticResource FontMono}" FontSize="13" Foreground="{DynamicResource BrushInkMuted}" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <!-- Security Feedback Banner -->
                                    <TextBlock Text="{Binding SecurityMessage}" Visibility="{Binding HasSecurityMessage, Converter={StaticResource BoolToVis}}"
                                               FontWeight="SemiBold" FontSize="{StaticResource FontSizeHelp}" Margin="0,0,0,14"
                                               Foreground="{Binding SecurityMessageIsSuccess, Converter={StaticResource StatusToBrushConverter}}"/>

                                    <!-- Action Buttons -->
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Save security settings" Command="{Binding SaveSecuritySettingsCommand}" Style="{StaticResource BtnPrimary}" Height="36" Padding="20,0" Margin="0,0,12,0"/>
                                        <Button Content="Remove password protection" Command="{Binding DisableSecurityPasswordCommand}" Style="{StaticResource BtnQuiet}" Height="36" Padding="16,0"
                                                Visibility="{Binding HasConfiguredPassword, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===============================================================
                     SECTION 4: EXECUTION ENGINE
                     =============================================================== -->
                <StackPanel Visibility="{Binding IsEngineSection, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource Card}" Padding="28" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Execution Engine &amp; Dispatcher" FontWeight="Bold" FontSize="{StaticResource FontSizeH2}" Foreground="{DynamicResource BrushInk}"/>
                            <TextBlock Text="Choose how scheduled background backups are managed and fired across user sessions"
                                       FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,3,0,20"/>

                            <!-- Two Engine Cards (Service vs Task Scheduler) -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Radio Card 1: Windows Service -->
                                <RadioButton Grid.Column="0" IsChecked="{Binding RunByService, Mode=TwoWay}" GroupName="RunEngineRadioGroup" Cursor="Hand">
                                    <RadioButton.Template>
                                        <ControlTemplate TargetType="{x:Type RadioButton}">
                                            <Border x:Name="bd" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="12" Padding="20">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource BrushJadeSoft}" Margin="0,0,14,0" VerticalAlignment="Top">
                                                        <Path Data="{StaticResource IconServer}" Fill="{DynamicResource BrushJade}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="Windows Service" FontWeight="Bold" FontSize="{StaticResource FontSizeRowTitle}" Foreground="{DynamicResource BrushInk}"/>
                                                        <TextBlock Text="Runs continuously in Session 0 as LocalSystem; survives user logouts and reboots" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Style="{StaticResource BadgePill}" Background="{DynamicResource BrushJadeSoft}" VerticalAlignment="Top">
                                                        <TextBlock Text="Recommended" FontWeight="Bold" FontSize="{StaticResource FontSizeBadge}" Foreground="{DynamicResource BrushJade}"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BrushJade}"/>
                                                    <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushJadeSoft}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </RadioButton.Template>
                                </RadioButton>

                                <!-- Radio Card 2: Task Scheduler -->
                                <RadioButton Grid.Column="2" IsChecked="{Binding RunByTask, Mode=TwoWay}" GroupName="RunEngineRadioGroup" Cursor="Hand">
                                    <RadioButton.Template>
                                        <ControlTemplate TargetType="{x:Type RadioButton}">
                                            <Border x:Name="bd" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="12" Padding="20">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource BrushCobaltSoft}" Margin="0,0,14,0" VerticalAlignment="Top">
                                                        <Path Data="{StaticResource IconClock}" Fill="{DynamicResource BrushCobalt}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="Windows Task Scheduler" FontWeight="Bold" FontSize="{StaticResource FontSizeRowTitle}" Foreground="{DynamicResource BrushInk}"/>
                                                        <TextBlock Text="Invokes UniBackup CLI executable via standard Windows Scheduled Tasks" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BrushCobalt}"/>
                                                    <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushCobaltSoft}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </RadioButton.Template>
                                </RadioButton>
                            </Grid>

                            <!-- Live Windows Service Management Card -->
                            <Border Background="{DynamicResource BrushRaised}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Status Dot -->
                                    <Ellipse Grid.Column="0" Width="14" Height="14" Fill="{Binding WindowsServiceStatusColor}" Margin="0,0,16,0" VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding WindowsServiceStatus, StringFormat={}UniBackup Background Service: {0}}" FontWeight="Bold" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushInk}"/>
                                        <TextBlock Text="{Binding WindowsServiceDetail}" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Controls -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Start service" Command="{Binding StartWindowsServiceCommand}" Style="{StaticResource BtnQuiet}" Height="34" Margin="0,0,8,0"/>
                                        <Button Content="Stop service" Command="{Binding StopWindowsServiceCommand}" Style="{StaticResource BtnQuiet}" Height="34" Margin="0,0,8,0"/>
                                        <Button Content="Sync Scheduler" Command="{Binding InstallTaskSchedulerCommand}" Style="{StaticResource BtnQuiet}" Height="34"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Nightly Schedule Parameters -->
                            <Border Background="{DynamicResource BrushSunken}" CornerRadius="10" Padding="18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Daily backup run time (24h)" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <TextBox Text="{Binding Config.Schedule.Time, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInputMono}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Execution window mode" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <TextBox Text="{Binding Config.Schedule.WindowMode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInputMono}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===============================================================
                     SECTION 5: CLOUD CREDENTIALS
                     =============================================================== -->
                <StackPanel Visibility="{Binding IsCredentialsSection, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource Card}" Padding="28" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Cloud Storage &amp; Repository Credentials" FontWeight="Bold" FontSize="{StaticResource FontSizeH2}" Foreground="{DynamicResource BrushInk}"/>
                            <TextBlock Text="Configure authentication keys, secure endpoints, and access tokens for all supported cloud destinations"
                                       FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,3,0,20"/>

                            <!-- Provider Selector Tabs -->
                            <Border Style="{StaticResource SegmentedContainer}" HorizontalAlignment="Left" Margin="0,0,0,24">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="Amazon S3" Style="{StaticResource SegmentedItem}" Command="{Binding SelectCloudProviderCommand}" CommandParameter="Aws"
                                                 IsChecked="{Binding SelectedCloudProvider, Converter={StaticResource StringEqualsToBool}, ConverterParameter=Aws}"/>
                                    <RadioButton Content="Google Drive" Style="{StaticResource SegmentedItem}" Command="{Binding SelectCloudProviderCommand}" CommandParameter="GDrive"
                                                 IsChecked="{Binding SelectedCloudProvider, Converter={StaticResource StringEqualsToBool}, ConverterParameter=GDrive}"/>
                                    <RadioButton Content="Azure Blob" Style="{StaticResource SegmentedItem}" Command="{Binding SelectCloudProviderCommand}" CommandParameter="Azure"
                                                 IsChecked="{Binding SelectedCloudProvider, Converter={StaticResource StringEqualsToBool}, ConverterParameter=Azure}"/>
                                    <RadioButton Content="Local / UNC" Style="{StaticResource SegmentedItem}" Command="{Binding SelectCloudProviderCommand}" CommandParameter="Local"
                                                 IsChecked="{Binding SelectedCloudProvider, Converter={StaticResource StringEqualsToBool}, ConverterParameter=Local}"/>
                                    <RadioButton Content="SFTP (SSH)" Style="{StaticResource SegmentedItem}" Command="{Binding SelectCloudProviderCommand}" CommandParameter="Sftp"
                                                 IsChecked="{Binding SelectedCloudProvider, Converter={StaticResource StringEqualsToBool}, ConverterParameter=Sftp}"/>
                                    <RadioButton Content="FTP / FTPS" Style="{StaticResource SegmentedItem}" Command="{Binding SelectCloudProviderCommand}" CommandParameter="Ftp"
                                                 IsChecked="{Binding SelectedCloudProvider, Converter={StaticResource StringEqualsToBool}, ConverterParameter=Ftp}"/>
                                    <RadioButton Content="WebDAV" Style="{StaticResource SegmentedItem}" Command="{Binding SelectCloudProviderCommand}" CommandParameter="WebDav"
                                                 IsChecked="{Binding SelectedCloudProvider, Converter={StaticResource StringEqualsToBool}, ConverterParameter=WebDav}"/>
                                    <RadioButton Content="Tokens (Dropbox / OneDrive)" Style="{StaticResource SegmentedItem}" Command="{Binding SelectCloudProviderCommand}" CommandParameter="Tokens"
                                                 IsChecked="{Binding SelectedCloudProvider, Converter={StaticResource StringEqualsToBool}, ConverterParameter=Tokens}"/>
                                </StackPanel>
                            </Border>

                            <!-- PROVIDER 1: AMAZON S3 -->
                            <StackPanel Visibility="{Binding IsAwsProviderSelected, Converter={StaticResource BoolToVis}}">
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Bucket Name" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <TextBox Text="{Binding Config.Aws.BucketName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInputMono}" Tag="e.g. enterprise-unibackup" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Region" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <TextBox Text="{Binding Config.Aws.Region, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInputMono}" Tag="e.g. us-east-1" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="AWS Access Key ID" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <TextBox Text="{Binding Config.Aws.AccessKeyId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInputMono}" Tag="AKIA..." Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="AWS Secret Access Key" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <TextBox Text="{Binding Config.Aws.SecretAccessKey, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInputMono}" Tag="Secret access key" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Custom Service URL (Optional for MinIO, Wasabi, Cloudflare R2, Backblaze B2)" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                <TextBox Text="{Binding Config.Aws.ServiceUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInputMono}" Tag="e.g. https://s3.wasabisys.com" Margin="0,4,0,18"/>

                                <Button Content="Test S3 connection" Command="{Binding TestCloudConnectionCommand}" CommandParameter="Aws" Style="{StaticResource BtnQuiet}" Height="36" Padding="18,0" HorizontalAlignment="Left"/>
                            </StackPanel>

                            <!-- PROVIDER 2: GOOGLE DRIVE -->
                            <StackPanel Visibility="{Binding IsGDriveProviderSelected, Converter={StaticResource BoolToVis}}">
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Target Drive Folder Path" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <TextBox Text="{Binding Config.GDrive.TargetFolder, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInputMono}" Tag="e.g. /Backups" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Account Label" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <TextBox Text="{Binding Config.GDrive.AccountLabel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInput}" Tag="e.g. Corporate Google Drive" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <Button Content="Test Google Drive connection" Command="{Binding TestCloudConnectionCommand}" CommandParameter="GDrive" Style="{StaticResource BtnQuiet}" Height="36" Padding="18,0" HorizontalAlignment="Left"/>
                            </StackPanel>

                            <!-- PROVIDER 3: AZURE BLOB -->
                            <StackPanel Visibility="{Binding IsAzureProviderSelected, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Azure Connection String / SAS URL" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                <TextBox Text="{Binding Config.Azure.ConnectionString, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInputMono}" Tag="DefaultEndpointsProtocol=https;..." Margin="0,4,0,14"/>

                                <TextBlock Text="Container Name" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                <TextBox Text="{Binding Config.Azure.ContainerName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInputMono}" Tag="e.g. unibackup-archives" Margin="0,4,0,18"/>

                                <Button Content="Test Azure connection" Command="{Binding TestCloudConnectionCommand}" CommandParameter="Azure" Style="{StaticResource BtnQuiet}" Height="36" Padding="18,0" HorizontalAlignment="Left"/>
                            </StackPanel>

                            <!-- PROVIDER 4: LOCAL / UNC -->
                            <StackPanel Visibility="{Binding IsLocalProviderSelected, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Local or Network UNC Base Directory" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                <Grid Margin="0,4,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Config.Local.TargetPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInputMono}" Tag="e.g. D:\Backups or \\nas\backups"/>
                                    <Button Grid.Column="2" Content="Browse..." Command="{Binding BrowseLocalStorageFolderCommand}" Style="{StaticResource BtnQuiet}" Height="36" Padding="16,0"/>
                                    <Button Grid.Column="4" Content="Test folder access" Command="{Binding TestLocalStorageFolderCommand}" Style="{StaticResource BtnQuiet}" Height="36" Padding="14,0"/>
                                </Grid>
                            </StackPanel>

                            <!-- PROVIDER 5: SFTP -->
                            <StackPanel Visibility="{Binding IsSftpProviderSelected, Converter={StaticResource BoolToVis}}">
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="SFTP Host" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <TextBox Text="{Binding Config.Sftp.Host, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInputMono}" Tag="sftp.company.com" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Port" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <TextBox Text="{Binding Config.Sftp.Port, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInputMono}" Tag="22" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Username" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <TextBox Text="{Binding Config.Sftp.Username, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInput}" Tag="backup-user" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Password" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <TextBox Text="{Binding Config.Sftp.Password, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInput}" Tag="SFTP password" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Remote Directory" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                <TextBox Text="{Binding Config.Sftp.RemoteFolder, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInputMono}" Tag="/backups" Margin="0,4,0,18"/>

                                <Button Content="Test SFTP connection" Command="{Binding TestCloudConnectionCommand}" CommandParameter="Sftp" Style="{StaticResource BtnQuiet}" Height="36" Padding="18,0" HorizontalAlignment="Left"/>
                            </StackPanel>

                            <!-- PROVIDER 6: FTP -->
                            <StackPanel Visibility="{Binding IsFtpProviderSelected, Converter={StaticResource BoolToVis}}">
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="FTP Host" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <TextBox Text="{Binding Config.Ftp.Host, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInputMono}" Tag="ftp.company.com" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Port" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <TextBox Text="{Binding Config.Ftp.Port, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInputMono}" Tag="21" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Username" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <TextBox Text="{Binding Config.Ftp.Username, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInput}" Tag="ftp-user" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Password" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <TextBox Text="{Binding Config.Ftp.Password, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInput}" Tag="FTP password" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Remote Directory" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                <TextBox Text="{Binding Config.Ftp.RemoteFolder, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInputMono}" Tag="/backups" Margin="0,4,0,18"/>

                                <Button Content="Test FTP connection" Command="{Binding TestCloudConnectionCommand}" CommandParameter="Ftp" Style="{StaticResource BtnQuiet}" Height="36" Padding="18,0" HorizontalAlignment="Left"/>
                            </StackPanel>

                            <!-- PROVIDER 7: WEBDAV -->
                            <StackPanel Visibility="{Binding IsWebDavProviderSelected, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="WebDAV Server URL" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                <TextBox Text="{Binding Config.WebDav.ServerUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInputMono}" Tag="https://webdav.nextcloud.company.com/remote.php/webdav" Margin="0,4,0,14"/>

                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Username" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <TextBox Text="{Binding Config.WebDav.Username, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInput}" Tag="webdav-user" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Password" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                        <TextBox Text="{Binding Config.WebDav.Password, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInput}" Tag="WebDAV password" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <Button Content="Test WebDAV connection" Command="{Binding TestCloudConnectionCommand}" CommandParameter="WebDav" Style="{StaticResource BtnQuiet}" Height="36" Padding="18,0" HorizontalAlignment="Left"/>
                            </StackPanel>

                            <!-- PROVIDER 8: CLOUD TOKENS -->
                            <StackPanel Visibility="{Binding IsTokensProviderSelected, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Dropbox Access Token" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                <TextBox Text="{Binding Config.Dropbox.AccessToken, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInputMono}" Tag="sl.u.AF..." Margin="0,4,0,14"/>

                                <TextBlock Text="Microsoft OneDrive Access Token" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                <TextBox Text="{Binding Config.OneDrive.AccessToken, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInputMono}" Tag="EwB..." Margin="0,4,0,14"/>

                                <TextBlock Text="Box Cloud Access Token" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                <TextBox Text="{Binding Config.Box.AccessToken, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInputMono}" Tag="Box developer or OAuth token" Margin="0,4,0,18"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Test Dropbox" Command="{Binding TestCloudConnectionCommand}" CommandParameter="Dropbox" Style="{StaticResource BtnQuiet}" Height="36" Padding="14,0" Margin="0,0,8,0"/>
                                    <Button Content="Test OneDrive" Command="{Binding TestCloudConnectionCommand}" CommandParameter="OneDrive" Style="{StaticResource BtnQuiet}" Height="36" Padding="14,0" Margin="0,0,8,0"/>
                                    <Button Content="Test Box" Command="{Binding TestCloudConnectionCommand}" CommandParameter="Box" Style="{StaticResource BtnQuiet}" Height="36" Padding="14,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Live Feedback Banner -->
                            <Border Background="{DynamicResource BrushSunken}" CornerRadius="8" Padding="14,10" Margin="0,18,0,0"
                                    Visibility="{Binding HasCloudTestFeedback, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding CloudTestFeedback}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeHelp}"
                                           Foreground="{Binding CloudTestIsSuccess, Converter={StaticResource StatusToBrushConverter}}"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===============================================================
                     SECTION 6: STORAGE & CACHE
                     =============================================================== -->
                <StackPanel Visibility="{Binding IsStorageSection, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource Card}" Padding="28" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Storage &amp; Working Partitions" FontWeight="Bold" FontSize="{StaticResource FontSizeH2}" Foreground="{DynamicResource BrushInk}"/>
                            <TextBlock Text="Configure temporary compression staging directories, retention policies and local repositories"
                                       FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,3,0,20"/>

                            <!-- Temp Directory Row with Browse -->
                            <TextBlock Text="Temporary staging partition" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                            <Grid Margin="0,4,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Config.Backup.TempFolder, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInputMono}" Tag="e.g. C:\UniBackup\temp"/>
                                <Button Grid.Column="2" Content="Browse..." Command="{Binding BrowseTempFolderCommand}" Style="{StaticResource BtnQuiet}" Height="36" Padding="18,0"/>
                            </Grid>

                            <!-- Disk Usage Progress Card -->
                            <Border Background="{DynamicResource BrushRaised}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,20">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <TextBlock Text="{Binding TempDiskUsageLabel}" FontWeight="Bold" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushInk}"/>
                                        <TextBlock HorizontalAlignment="Right" Text="{Binding TempDiskFreeText}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}"/>
                                    </Grid>
                                    <ProgressBar Grid.Row="1" Height="8" Margin="0,10,0,8" Value="{Binding TempDiskUsagePercent}" Maximum="100" Foreground="{DynamicResource BrushCobalt}" Background="{DynamicResource BrushSunken}"/>
                                    <TextBlock Grid.Row="2" Text="Ensure at least 20 GB free space on the staging drive for large SQL database dumps and compression" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkFaint}"/>
                                </Grid>
                            </Border>

                            <!-- Retention Parameters -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Log Retention (Days)" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                    <TextBox Text="{Binding Config.Backup.KeepLogsDays, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInputMono}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="History Retention (Days)" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                    <TextBox Text="{Binding Config.Backup.HistoryRetentionDays, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInputMono}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Max Log Size (MB)" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                    <TextBox Text="{Binding Config.Backup.MaxLogMb, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInputMono}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Button Content="Open logs folder in Explorer" Command="{Binding OpenLogsFolderCommand}" Style="{StaticResource BtnQuiet}" Height="34" Padding="16,0" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </StackPanel>



                <!-- ===============================================================
                     SECTION 7: ADVANCED
                     =============================================================== -->
                <StackPanel Visibility="{Binding IsAdvancedSection, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource Card}" Padding="28" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Advanced Engine &amp; Performance" FontWeight="Bold" FontSize="{StaticResource FontSizeH2}" Foreground="{DynamicResource BrushInk}"/>
                            <TextBlock Text="Fine-tune parallel execution streams, bandwidth limits, VSS snapshots, and configuration persistence"
                                       FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,3,0,20"/>

                            <!-- Concurrency & Bandwidth -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Concurrency Parallel Streams (1 - 16)" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                    <TextBox Text="{Binding Config.Backup.MaxDegreeOfParallelism, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInputMono}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Bandwidth Throttling (Kbps, 0 = Max)" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                    <TextBox Text="{Binding Config.Backup.BandwidthLimitKbps, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInputMono}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Compression Algorithm Level" FontWeight="SemiBold" FontSize="{StaticResource FontSizeFieldLabel}" Foreground="{DynamicResource BrushInkMuted}"/>
                                    <ComboBox ItemsSource="{Binding CompressionLevels}" SelectedItem="{Binding Config.Backup.CompressionLevel}" Style="{StaticResource FieldComboBox}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- VSS & Clean Toggles -->
                            <StackPanel Margin="0,0,0,24">
                                <CheckBox Content="Enable Volume Shadow Copy Service (VSS) by default for open file snapshots"
                                          IsChecked="{Binding Config.Backup.UseVssDefault, Mode=TwoWay}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <CheckBox Content="Automatically prune staging partition chunks after verified upload"
                                          IsChecked="{Binding Config.Backup.CleanTempAfterBackup, Mode=TwoWay}" FontWeight="SemiBold"/>
                            </StackPanel>

                            <Border Height="1" Background="{DynamicResource BrushLine}" Margin="0,0,0,24"/>

                            <!-- Configuration Export / Import / Factory Reset -->
                            <TextBlock Text="Configuration Management" FontWeight="Bold" FontSize="{StaticResource FontSizeRowTitle}" Foreground="{DynamicResource BrushInk}" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Export configuration..." Command="{Binding ExportConfigCommand}" Style="{StaticResource BtnQuiet}" Height="36" Padding="16,0" Margin="0,0,10,0"/>
                                <Button Content="Import configuration..." Command="{Binding ImportConfigCommand}" Style="{StaticResource BtnQuiet}" Height="36" Padding="16,0" Margin="0,0,10,0"/>
                                <Button Content="Reset to factory defaults" Command="{Binding ResetToFactoryDefaultsCommand}" Style="{StaticResource BtnQuiet}" Height="36" Padding="16,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- ===================================================================
             3. CONSISTENT BOTTOM ACTION BAR
             =================================================================== -->
        <Border Grid.Row="2" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,1,0,0" Padding="28,14">
            <Grid MaxWidth="1340">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Unsaved Changes State & Message -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Unsaved Changes Detected Badge -->
                    <Border Style="{StaticResource BadgePill}" Background="{DynamicResource BrushAmberSoft}" Margin="0,0,12,0" Padding="12,6"
                            Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource BrushAmber}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Unsaved changes detected" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBadge}" Foreground="{DynamicResource BrushAmber}"/>
                        </StackPanel>
                    </Border>

                    <!-- All Saved Badge -->
                    <Border Style="{StaticResource BadgePill}" Background="{DynamicResource BrushJadeSoft}" Margin="0,0,12,0" Padding="12,6"
                            Visibility="{Binding HasUnsavedChanges, Converter={StaticResource InverseBoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconCheck}" Fill="{DynamicResource BrushJade}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="All settings saved" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBadge}" Foreground="{DynamicResource BrushJade}"/>
                        </StackPanel>
                    </Border>

                    <!-- Save Feedback Message -->
                    <TextBlock Text="{Binding SaveStatusMessage}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeHelp}" VerticalAlignment="Center"
                               Visibility="{Binding HasSaveStatusMessage, Converter={StaticResource BoolToVis}}"
                               Foreground="{Binding SaveStatusIsSuccess, Converter={StaticResource StatusToBrushConverter}}"/>
                </StackPanel>

                <!-- Right: Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Reset section" Command="{Binding ResetSectionCommand}" Style="{StaticResource BtnQuiet}" Height="38" Padding="18,0" Margin="0,0,12,0"/>
                    <Button Content="Save settings" Command="{Binding SaveSettingsCommand}" Style="{StaticResource BtnPrimary}" Height="38" Padding="26,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
