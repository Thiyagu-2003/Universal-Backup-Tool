                                            <TextBlock Text="From PagerDuty Service → Integrations → Events API v2 (32 alphanumeric chars)" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding TestPagerDutyCommand}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconPaperPlane}" Fill="#059669" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Trigger Test PagerDuty Incident" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ============================================== -->
                            <!-- SUB-TAB 9: CUSTOM WEBHOOK (DEVOPS AUTOMATION)   -->
                            <!-- ============================================== -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedNotificationTab}" Value="Webhook">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <Border Style="{StaticResource ModernCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="26" Height="26" CornerRadius="6" Background="#EEF2FF" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource IconWebhook}" Fill="#4F46E5" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="GENERIC CUSTOM WEBHOOK (N8N / ZAPIER / MAKE / HOME ASSISTANT / SPLUNK)" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Content="Enable Webhooks" IsChecked="{Binding Config.Webhooks.Enabled}" FontWeight="Bold" Foreground="#4F46E5"/>
                                        </Grid>

                                        <Border Background="#F5F3FF" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                                            <TextBlock Text="Connect UniBackup with modern automation platforms: n8n workflows, Zapier zaps, Make scenarios, Home Assistant webhooks, Datadog logs, Splunk HEC, or custom internal REST microservices."
                                                       FontSize="12" Foreground="#4338CA" TextWrapping="Wrap"/>
                                        </Border>

                                        <StackPanel Margin="0,0,0,14">
                                            <TextBlock Text="Webhook Endpoint URL" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding Config.Webhooks.CustomWebhookUrl, UpdateSourceTrigger=PropertyChanged}" Height="36" VerticalContentAlignment="Center"/>
                                            <TextBlock Text="e.g. https://automation.domain.com/webhook/backup-alert or https://hooks.zapier.com/..." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="2*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <TextBlock Text="Custom Header Name (Optional)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding Config.Webhooks.CustomWebhookHeaderName, UpdateSourceTrigger=PropertyChanged}" Height="36" VerticalContentAlignment="Center"/>
                                                <TextBlock Text="e.g. Authorization or X-API-Key" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                <TextBlock Text="Custom Header Value / Token (Optional)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding Config.Webhooks.CustomWebhookHeaderValue, UpdateSourceTrigger=PropertyChanged}" Height="36" VerticalContentAlignment="Center"/>
                                                <TextBlock Text="e.g. Bearer secret_token_xyz" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding TestCustomWebhookCommand}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconPaperPlane}" Fill="#4F46E5" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Send Test Custom Webhook Payload" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <!-- ============================================== -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedNotificationTab}" Value="Matrix">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <!-- Trigger Matrix Card -->
                                <Border Style="{StaticResource ModernCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="GRANULAR NOTIFICATION TRIGGER MATRIX" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                                        <TextBlock Text="Filter alert notifications by backup type to prevent inbox and channel noise from high-frequency (e.g. 15-minute) transaction logs."
                                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,14"/>

                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="30"/>
                                                <RowDefinition Height="34"/>
                                                <RowDefinition Height="34"/>
                                                <RowDefinition Height="34"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Backup Type" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="On Success" FontWeight="Bold" FontSize="11.5" Foreground="#059669"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="On Warning" FontWeight="Bold" FontSize="11.5" Foreground="#D97706"/>
                                            <TextBlock Grid.Row="0" Grid.Column="3" Text="On Failure" FontWeight="Bold" FontSize="11.5" Foreground="#DC2626"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Full Backup" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding Config.NotificationMatrix.FullSuccess}" VerticalAlignment="Center"/>
                                            <CheckBox Grid.Row="1" Grid.Column="2" IsChecked="{Binding Config.NotificationMatrix.FullWarning}" VerticalAlignment="Center"/>
                                            <CheckBox Grid.Row="1" Grid.Column="3" IsChecked="{Binding Config.NotificationMatrix.FullFailure}" VerticalAlignment="Center"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Differential" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding Config.NotificationMatrix.DiffSuccess}" VerticalAlignment="Center"/>
                                            <CheckBox Grid.Row="2" Grid.Column="2" IsChecked="{Binding Config.NotificationMatrix.DiffWarning}" VerticalAlignment="Center"/>
                                            <CheckBox Grid.Row="2" Grid.Column="3" IsChecked="{Binding Config.NotificationMatrix.DiffFailure}" VerticalAlignment="Center"/>

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Transaction Log" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding Config.NotificationMatrix.LogSuccess}" VerticalAlignment="Center"/>
                                            <CheckBox Grid.Row="3" Grid.Column="2" IsChecked="{Binding Config.NotificationMatrix.LogWarning}" VerticalAlignment="Center"/>
                                            <CheckBox Grid.Row="3" Grid.Column="3" IsChecked="{Binding Config.NotificationMatrix.LogFailure}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Heartbeat Telemetry Card -->
                                <Border Style="{StaticResource ModernCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="26" Height="26" CornerRadius="6" Background="#FFE4E6" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource IconHeartbeat}" Fill="#E11D48" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="HEARTBEAT TELEMETRY (DEAD-MAN SWITCH)" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Content="Enable Heartbeat" IsChecked="{Binding Config.Heartbeat.Enabled}" FontWeight="Bold" Foreground="#E11D48"/>
                                        </Grid>

                                        <TextBlock Text="Integrate with Healthchecks.io, Uptime Kuma, or Dead Man's Snitch. Pings automatically upon run completion; alerts if your server dies or misses a scheduled window."
                                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,14"/>

                                        <StackPanel Margin="0,0,0,14">
                                            <TextBlock Text="Heartbeat Ping URL" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding Config.Heartbeat.Url, UpdateSourceTrigger=PropertyChanged}" Height="36" VerticalContentAlignment="Center"/>
                                            <TextBlock Text="e.g. https://hc-ping.com/your-uuid-token" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <CheckBox Content="Append /fail on backup failure" IsChecked="{Binding Config.Heartbeat.AppendFailPath}" FontWeight="SemiBold" Margin="0,0,0,16"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding TestHeartbeatCommand}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconPaperPlane}" Fill="#E11D48" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Send Test Ping" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Row 3: Bottom Action Bar (Save Notifications) -->
                        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Notification configurations apply immediately to all scheduled and manual backup jobs."
                                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Height="38" Padding="20,0" Command="{Binding SaveNotificationsCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconSave}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                                        <TextBlock Text="Save Notification Settings" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <!-- ============================================== -->
                <!-- 6. SETTINGS & ENGINE TAB                       -->
                <!-- ============================================== -->
                <ScrollViewer x:Name="SettingsTabContent" Style="{StaticResource AnimatedTabContent}" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,6,0,24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Row 0: Header with Config Path & Re-check button -->
                            <RowDefinition Height="Auto"/>
                            <!-- Row 1: Segmented Sub-Tab Switcher -->
                            <RowDefinition Height="Auto"/>
                            <!-- Row 2: Sub-Tab Content -->
                            <RowDefinition Height="*"/>
                            <!-- Row 3: Bottom Action Bar (Save, Validate, Diagnostics) -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Top Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Settings &amp; Engine" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Path Data="{StaticResource IconDocumentText}" Fill="{StaticResource TextMutedBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding ConfigFileLocation}" FontFamily="{StaticResource BrandFontMono}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" ToolTip="{Binding ConfigFileLocation}"/>
                                    <Button Style="{StaticResource SecondaryButton}" Height="24" Width="24" Padding="0" Margin="8,0,0,0" ToolTip="Copy configuration path" Command="{Binding CopyConfigPathCommand}">
                                        <Path Data="{StaticResource IconCopy}" Fill="{StaticResource PrimaryBrush}" Width="10" Height="10" Stretch="Uniform"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Height="36" Padding="16,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Command="{Binding RecheckAllCommand}" ToolTip="Re-read service, scheduler, storage, and cloud connection statuses">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource PrimaryBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0"/>
                                    <TextBlock Text="Re-check all"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Row 1: Segmented Sub-Tab Switcher (Colourful & Modern) -->
                        <Border Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,20" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="5">
                            <StackPanel Orientation="Horizontal">
                                <!-- 1. AWS / S3 Sub-Tab (Blue) -->
                                <RadioButton Content="AWS / S3" GroupName="SettingsSubTabs"
                                             Style="{StaticResource SettingsSubTabBlue}"
                                             Command="{Binding SelectSettingsTabCommand}" CommandParameter="AWS"/>

                                <!-- 2. Destinations Sub-Tab (Emerald) -->
                                <RadioButton Content="Destinations" GroupName="SettingsSubTabs"
                                             Style="{StaticResource SettingsSubTabEmerald}"
                                             Command="{Binding SelectSettingsTabCommand}" CommandParameter="Destinations"/>

                                <!-- 3. Schedule Sub-Tab (Teal) -->
                                <RadioButton Content="Schedule" GroupName="SettingsSubTabs"
                                             Style="{StaticResource SettingsSubTabTeal}"
                                             Command="{Binding SelectSettingsTabCommand}" CommandParameter="Schedule"/>

                                <!-- 5. Temp & Logs Sub-Tab (Amber) -->
                                <RadioButton Content="Temp &amp; Logs" GroupName="SettingsSubTabs"
                                             Style="{StaticResource SettingsSubTabAmber}"
                                             Command="{Binding SelectSettingsTabCommand}" CommandParameter="Storage"/>
                            </StackPanel>
                        </Border>

                        <!-- Row 2: Sub-Tab Content -->
                        <Grid Grid.Row="2">
                            <!-- ============================================== -->
                            <!-- SUB-TAB: SCHEDULE & SERVICE                    -->
                            <!-- ============================================== -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSettingsTab}" Value="Schedule">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedSettingsTab}" Value="Service">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <!-- Card 1: How Backups Run (Service vs Task Scheduler) -->
                                <Border Style="{StaticResource ModernCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Path Data="{StaticResource IconSettings}" Fill="{StaticResource PrimaryBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                                            <TextBlock Text="How backups run" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Text="Choose the background execution engine for automated backups on this machine." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,14"/>

                                        <!-- Two option cards side by side -->
                                        <UniformGrid Columns="2" Margin="0,0,0,14">
                                            <!-- Card 1: Windows Service Option -->
                                            <RadioButton Style="{StaticResource BrandOptionCard}" GroupName="EngineRunMode" IsChecked="{Binding RunByService}" Margin="0,0,8,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="8" Background="{StaticResource BrandTintTealSoft}" Margin="0,0,12,0" VerticalAlignment="Top">
                                                        <Path Data="{StaticResource IconServer}" Fill="{StaticResource BrandTintTealDeep}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Windows service" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                            <Border Background="#10B981" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="RECOMMENDED" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="Runs continuously as LocalSystem even when no user is signed in. Starts automatically with Windows." FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Grid>
                                            </RadioButton>

                                            <!-- Card 2: Task Scheduler Option -->
                                            <RadioButton Style="{StaticResource BrandOptionCard}" GroupName="EngineRunMode" IsChecked="{Binding RunByTask}" Margin="8,0,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="8" Background="{StaticResource BrandTintPurpleSoft}" Margin="0,0,12,0" VerticalAlignment="Top">
                                                        <Path Data="{StaticResource IconCalendarCheck}" Fill="{StaticResource BrandTintPurpleDeep}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="Task Scheduler" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="Runs on-demand via Windows Task Scheduler with zero background memory footprint. No password required." FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Grid>
                                            </RadioButton>
                                        </UniformGrid>

                                        <!-- Band 1: Windows Service Status Band (Shown when RunByService) -->
                                        <Border CornerRadius="10" Padding="16,14"
                                                Visibility="{Binding RunByService, Converter={StaticResource BoolToVis}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource BrandDangerSoft}"/>
                                                    <Setter Property="BorderBrush" Value="#FECACA"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding WindowsServiceRunning}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource BrandTintTealSoft}"/>
                                                            <Setter Property="BorderBrush" Value="#A7F3D0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="40" Height="40" CornerRadius="20" Margin="0,0,14,0" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#EF4444"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding WindowsServiceRunning}" Value="True">
                                                                        <Setter Property="Background" Value="#10B981"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Path Width="18" Height="18" Stretch="Uniform" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Setter Property="Data" Value="{StaticResource IconWarningCircle}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding WindowsServiceRunning}" Value="True">
                                                                            <Setter Property="Data" Value="{StaticResource IconCheckCircle}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                    </Border>

                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding WindowsServiceStatus}" FontWeight="Bold" FontSize="15">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#DC2626"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding WindowsServiceRunning}" Value="True">
                                                                            <Setter Property="Foreground" Value="#047857"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                            <TextBlock Text="UniBackup" FontFamily="{StaticResource BrandFontMono}" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            <TextBlock Text=" · " FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                                            <TextBlock Text="{Binding WindowsServiceDetail}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource SecondaryButton}" Height="34" Width="36" Padding="0" Margin="0,0,8,0"
                                                            ToolTip="Re-read service state" Command="{Binding RefreshServiceStatusCommand}">
                                                        <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource PrimaryBrush}" Width="12" Height="12" Stretch="Uniform"/>
                                                    </Button>
                                                    <Button Content="Install service" Style="{StaticResource PrimaryButton}" Height="34" Padding="16,0"
                                                            Command="{Binding InstallWindowsServiceCommand}"
                                                            Visibility="{Binding WindowsServiceNotInstalled, Converter={StaticResource BoolToVis}}"/>
                                                    <Button Style="{StaticResource SuccessButton}" Height="34" Padding="16,0" Margin="0,0,8,0"
                                                            Command="{Binding StartWindowsServiceCommand}"
                                                            Visibility="{Binding WindowsServiceStopped, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource IconPlay}" Fill="White" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0"/>
                                                            <TextBlock Text="Start"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource SecondaryButton}" Height="34" Padding="16,0" Margin="0,0,8,0"
                                                            Command="{Binding StopWindowsServiceCommand}"
                                                            Visibility="{Binding WindowsServiceRunning, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource IconStop}" Fill="{StaticResource TextPrimaryBrush}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0"/>
                                                            <TextBlock Text="Stop"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Content="Uninstall" Style="{StaticResource DangerButton}" Height="34" Padding="14,0"
                                                            Command="{Binding UninstallWindowsServiceCommand}"
                                                            Visibility="{Binding WindowsServiceInstalled, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Band 2: Task Scheduler Status Band (Shown when RunByTask) -->
                                        <Border CornerRadius="10" Padding="16,14"
                                                Visibility="{Binding RunByTask, Converter={StaticResource BoolToVis}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource BrandDangerSoft}"/>
                                                    <Setter Property="BorderBrush" Value="#FECACA"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TaskInstalled}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource BrandTintTealSoft}"/>
                                                            <Setter Property="BorderBrush" Value="#A7F3D0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="40" Height="40" CornerRadius="20" Margin="0,0,14,0" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#EF4444"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding TaskInstalled}" Value="True">
                                                                        <Setter Property="Background" Value="#10B981"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Path Width="18" Height="18" Stretch="Uniform" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Setter Property="Data" Value="{StaticResource IconWarningCircle}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding TaskInstalled}" Value="True">
                                                                            <Setter Property="Data" Value="{StaticResource IconCheckCircle}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                    </Border>

                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TaskState}" FontWeight="Bold" FontSize="15">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#DC2626"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding TaskInstalled}" Value="True">
                                                                            <Setter Property="Foreground" Value="#047857"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                            <TextBlock Text="UniBackup" FontFamily="{StaticResource BrandFontMono}" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            <TextBlock Text=" · " FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                                            <TextBlock Text="{Binding TaskDetail}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource SecondaryButton}" Height="34" Width="36" Padding="0" Margin="0,0,8,0"
                                                            ToolTip="Re-read task state" Command="{Binding RefreshServiceStatusCommand}">
                                                        <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource PrimaryBrush}" Width="12" Height="12" Stretch="Uniform"/>
                                                    </Button>
                                                    <Button Content="Install task" Style="{StaticResource PrimaryButton}" Height="34" Padding="16,0"
                                                            Command="{Binding InstallTaskCommand}"
                                                            Visibility="{Binding TaskNotInstalled, Converter={StaticResource BoolToVis}}"/>
                                                    <Button Style="{StaticResource SuccessButton}" Height="34" Padding="16,0" Margin="0,0,8,0"
                                                            Command="{Binding StartTaskCommand}"
                                                            Visibility="{Binding TaskInstalled, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource IconPlay}" Fill="White" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0"/>
                                                            <TextBlock Text="Start now"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Content="Remove" Style="{StaticResource DangerButton}" Height="34" Padding="14,0"
                                                            Command="{Binding RemoveTaskCommand}"
                                                            Visibility="{Binding TaskInstalled, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Card 2: Schedule Timings (Exact Reference Implementation) -->
                                <Border Style="{StaticResource ModernCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                            <Path Data="{StaticResource IconClock}" Fill="{StaticResource BrandTintAmberDeep}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                                            <TextBlock Text="Schedule Timings" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Amber Chip: Runs Daily -->
                                            <Border Style="{StaticResource BrandChipAmber}" Margin="0,0,14,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconClock}" Fill="{StaticResource BrandTintAmberDeep}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Runs daily" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrandTintAmberDeep}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Hour & Minute Pickers Well -->
                                            <Border Style="{StaticResource BrandWell}" Padding="8,4">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ComboBox ItemsSource="{Binding ScheduleHours}" SelectedItem="{Binding ScheduleHour12}" Width="66" Height="32"
                                                              Style="{StaticResource ModernTimeComboBox}"
                                                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontWeight="SemiBold"/>
                                                    <TextBlock Text=":" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <ComboBox ItemsSource="{Binding ScheduleMinutes}" SelectedItem="{Binding ScheduleMinute}" Width="66" Height="32"
                                                              Style="{StaticResource ModernTimeComboBox}"
                                                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontWeight="SemiBold">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding StringFormat={}{0:00}}"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Border>

                                            <!-- AM / PM Segmented Track (Clearly Highlighted) -->
                                            <Border Style="{StaticResource BrandSegmentTrack}" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton Content="AM" GroupName="ScheduleMeridiem" Style="{StaticResource MeridiemSegment}" IsChecked="{Binding ScheduleIsAm}"/>
                                                    <RadioButton Content="PM" GroupName="ScheduleMeridiem" Style="{StaticResource MeridiemSegment}" IsChecked="{Binding ScheduleIsPm}"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Next Run Hint -->
                                            <Border Background="{StaticResource BrandTintAmberSoft}" CornerRadius="6" Padding="10,6" Margin="14,0,0,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconClock}" Fill="{StaticResource BrandTintAmberDeep}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding NextRunHint}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrandTintAmberDeep}"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- Common times presets -->
                                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                            <TextBlock Text="Common times:" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <ItemsControl ItemsSource="{Binding SchedulePresets}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding}" Height="28" Padding="12,0" Margin="0,0,8,0" FontSize="11.5" Cursor="Hand"
                                                                Background="{StaticResource BrandTintAmberSoft}" Foreground="{StaticResource BrandTintAmberDeep}"
                                                                BorderBrush="Transparent"
                                                                Command="{Binding DataContext.UseSchedulePresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="btnBorder" Property="Background" Value="#FED7AA"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ============================================== -->
                            <!-- SUB-TAB 1: AWS / S3 CLOUD STORAGE              -->
                            <!-- ============================================== -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSettingsTab}" Value="AWS">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedSettingsTab}" Value="Connection">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <!-- S3 Connection Card (Fixed Fields matching Enterprise Standard) -->
                                <Border Style="{StaticResource ModernCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="S3 CONNECTION" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>

                                        <!-- Info Banner -->
                                        <Border Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="22" Height="22" CornerRadius="11" Background="#7C3AED" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <TextBlock Text="ⓘ" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Enterprise S3 infrastructure parameters are centrally locked. The S3 folder (key prefix) is set per job."
                                                           FontSize="12" Foreground="#6D28D9" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Two Column Form with S3 Settings -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Left Column -->
                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <!-- S3 Bucket Name -->
                                                <StackPanel Margin="0,0,0,12">
                                                    <TextBlock Text="S3 Bucket Name" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                    <TextBox Text="{Binding Config.Aws.BucketName, UpdateSourceTrigger=PropertyChanged}" Height="36" VerticalContentAlignment="Center"/>
                                                </StackPanel>

                                                <!-- Custom S3 Service URL (Cloudflare R2, Wasabi, MinIO, B2) -->
                                                <StackPanel Margin="0,0,0,12">
                                                    <TextBlock Text="S3 Service URL / Endpoint (Leave blank for official AWS S3)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                    <TextBox Text="{Binding Config.Aws.ServiceUrl, UpdateSourceTrigger=PropertyChanged}" Height="36" VerticalContentAlignment="Center"/>
                                                    <TextBlock Text="e.g. https://&lt;account_id&gt;.r2.cloudflarestorage.com or https://s3.wasabisys.com" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                                                </StackPanel>

                                                <!-- Storage Class -->
                                                <StackPanel Margin="0,0,0,12">
                                                    <TextBlock Text="Storage Class (STANDARD, STANDARD_IA, GLACIER)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                    <TextBox Text="{Binding Config.Aws.StorageClass, UpdateSourceTrigger=PropertyChanged}" Height="36" VerticalContentAlignment="Center"/>
                                                </StackPanel>

                                                <!-- Multipart Chunk Size (MB) -->
                                                <StackPanel>
                                                    <TextBlock Text="Multipart Chunk Size (MB)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                    <TextBox Text="{Binding Config.Aws.MultipartChunkMb, UpdateSourceTrigger=PropertyChanged}" Height="36" VerticalContentAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Right Column -->
                                            <StackPanel Grid.Column="1">
                                                <!-- AWS / Provider Region -->
                                                <StackPanel Margin="0,0,0,12">
                                                    <TextBlock Text="S3 Region (e.g. ap-south-1, us-east-1, auto)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                    <TextBox Text="{Binding Config.Aws.Region, UpdateSourceTrigger=PropertyChanged}" Height="36" VerticalContentAlignment="Center"/>
                                                </StackPanel>

                                                <!-- Force Path Style (MinIO / Ceph) -->
                                                <StackPanel Margin="0,0,0,12">
                                                    <TextBlock Text="Addressing Style" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                    <CheckBox Content="Force Path-Style S3 Addressing (Required for MinIO)" IsChecked="{Binding Config.Aws.ForcePathStyle}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                                </StackPanel>

                                                <!-- Retention Days (0 = forever) -->
                                                <StackPanel Margin="0,0,0,12">
                                                    <TextBlock Text="Retention Days (0 = forever)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                    <TextBox Text="{Binding Config.Aws.RetentionDays, UpdateSourceTrigger=PropertyChanged}" Height="36" VerticalContentAlignment="Center"/>
                                                </StackPanel>

                                                <!-- Destination Enablement Toggle -->
                                                <StackPanel VerticalAlignment="Bottom" Margin="0,10,0,0">
                                                    <CheckBox Content="Enable S3 as Backup Destination" IsChecked="{Binding Config.Aws.Enabled}" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- AWS Authentication Credentials Card -->
                                <Border Style="{StaticResource ModernCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="AWS Credentials (IAM User or Role)" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBlock Text="AWS Access Key ID (or leave blank for IAM Role)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding Config.Aws.AccessKeyId, UpdateSourceTrigger=PropertyChanged}" Height="36" VerticalContentAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="AWS Secret Access Key" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Height="36">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="38"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox x:Name="AwsSecretKeyVisibleInput" Grid.Column="0"
                                                                 Text="{Binding Config.Aws.SecretAccessKey, UpdateSourceTrigger=PropertyChanged}"
                                                                 BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="10,0"
                                                                 Visibility="{Binding IsAwsSecretVisible, Converter={StaticResource BoolToVis}}"/>
                                                        <PasswordBox x:Name="AwsSecretKeyInput" Grid.Column="0"
                                                                     BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="10,0"
                                                                     Visibility="{Binding IsAwsSecretVisible, Converter={StaticResource InverseBoolToVis}}"
                                                                     PasswordChanged="AwsSecretKeyInput_PasswordChanged"/>
                                                        <Button Grid.Column="1" Width="32" Height="32" Margin="0,0,3,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                Background="Transparent" BorderThickness="0" Cursor="Hand" Focusable="False"
                                                                Command="{Binding ToggleAwsSecretVisibilityCommand}" ToolTip="Show / Hide Secret Key">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="6">
                                                                                    <Path x:Name="EyeIcon" Data="{StaticResource IconEye}" Fill="{StaticResource TextSecondaryBrush}" Width="16" Height="16" Stretch="Uniform"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                                                                                    </Trigger>
                                                                                    <DataTrigger Binding="{Binding IsAwsSecretVisible}" Value="True">
                                                                                        <Setter TargetName="EyeIcon" Property="Data" Value="{StaticResource IconEyeOff}"/>
                                                                                        <Setter TargetName="EyeIcon" Property="Fill" Value="{StaticResource PrimaryBrush}"/>
                                                                                    </DataTrigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding TestS3ConnectionCommand}" ToolTip="Validate S3 connection, bucket access, and write permissions">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconCheck}" Fill="{StaticResource PrimaryBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Test S3 Connection" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Button>
                                            <TextBlock Text="Verifies bucket accessibility and IAM put/delete permissions." FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ============================================== -->
                            <!-- ============================================== -->
                            <!-- SUB-TAB 2: DESTINATIONS CATALOG & MANAGEMENT   -->
                            <!-- ============================================== -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSettingsTab}" Value="Destinations">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <!-- Universal Destination Banner -->
                                <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#059669" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconCheckCircle}" Fill="White" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="ALL DESTINATIONS 100% UNLOCKED &amp; FREE" FontWeight="Bold" FontSize="13" Foreground="#065F46"/>
                                            <TextBlock Text="Unlike commercial tools that gate Dropbox, Box, Google Drive, OneDrive, Azure Blob, and S3 behind expensive license editions, UniBackup Pro provides complete enterprise access to every storage destination with zero restrictions."
                                                       FontSize="11.5" Foreground="#047857" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- 1. Local or Network Folder (UNC / NAS) -->
                                <Border Style="{StaticResource ModernCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#FEF3C7" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconFolder}" Fill="#D97706" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Local or Network Folder (UNC / NAS)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <Border Background="#ECFDF5" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="FREE &amp; UNLOCKED" FontSize="10" FontWeight="Bold" Foreground="#059669"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="Store backup copies on local drives, external disks, or network UNC shares (\\server\share)." FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="2" Content="Enable" IsChecked="{Binding Config.Local.Enabled}" FontWeight="Bold" Foreground="#D97706" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <TextBlock Text="Target Directory / UNC Share Path" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding Config.Local.TargetPath, UpdateSourceTrigger=PropertyChanged}" Height="36" VerticalContentAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                <TextBlock Text="Retention Days" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding Config.Local.RetentionDays, UpdateSourceTrigger=PropertyChanged}" Height="36" VerticalContentAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding TestLocalCommand}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconCheck}" Fill="{StaticResource PrimaryBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Validate Folder Access" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 2. Microsoft Azure Blob Storage -->
                                <Border Style="{StaticResource ModernCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#EFF6FF" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconCloud}" Fill="#2563EB" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Microsoft Azure Blob Storage" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <Border Background="#ECFDF5" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="FREE &amp; UNLOCKED" FontSize="10" FontWeight="Bold" Foreground="#059669"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="Enterprise storage containers with Hot, Cool, or Cold Archive access tiers." FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="2" Content="Enable" IsChecked="{Binding Config.Azure.Enabled}" FontWeight="Bold" Foreground="#2563EB" VerticalAlignment="Center"/>
                                        </Grid>

                                        <StackPanel Margin="0,0,0,12">
                                            <TextBlock Text="Azure Storage Connection String" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding Config.Azure.ConnectionString, UpdateSourceTrigger=PropertyChanged}" Height="36" VerticalContentAlignment="Center"/>
                                            <TextBlock Text="DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <TextBlock Text="Container Name" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding Config.Azure.ContainerName, UpdateSourceTrigger=PropertyChanged}" Height="36" VerticalContentAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="5,0,5,0">
                                                <TextBlock Text="Access Tier (Hot / Cool / Cold)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding Config.Azure.AccessTier, UpdateSourceTrigger=PropertyChanged}" Height="36" VerticalContentAlignment="Center"/>
                                            </StackPanel>
