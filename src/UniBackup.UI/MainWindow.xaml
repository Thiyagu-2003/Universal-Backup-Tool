<Window x:Class="UniBackup.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:UniBackup.UI.Views"
        xmlns:controls="clr-namespace:UniBackup.UI.Controls"
        xmlns:vm="clr-namespace:UniBackup.UI.ViewModels"
        Title="UniBackup Pro — Universal Cloud Backup &amp; Recovery"
        Width="1280" Height="840"
        MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushCanvas}"
        SnapsToDevicePixels="True"
        SizeChanged="Window_SizeChanged">

    <!-- WindowChrome for seamless custom titlebar and native resize borders -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/> <!-- 1. Custom 38 px Title Bar -->
            <RowDefinition Height="*"/>  <!-- 2. Shell Layout (Rail + Content) -->
        </Grid.RowDefinitions>

        <!-- ===================================================================
             1. CUSTOM 38 PX TITLE BAR (§3.1)
             =================================================================== -->
        <Border Grid.Row="0" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,0,0,1" SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: 19 px Vector Logo + App Title + Subtitle -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <!-- 19 px Vector Logo -->
                    <Image Source="{StaticResource AppLogoDrawingImage}" Width="19" Height="19" VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <TextBlock Text="UniBackup Pro" FontWeight="SemiBold" FontSize="{StaticResource FontSizeRowTitle}" Foreground="{DynamicResource BrushInk}" VerticalAlignment="Center"/>
                    <TextBlock Text="—" Foreground="{DynamicResource BrushInkFaint}" Margin="8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Universal Cloud Backup &amp; Recovery" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right: Caption Buttons (46x38, hover Sunken, close hover Coral) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- Minimize Button -->
                    <Button Width="46" Height="38" Click="Minimize_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Focusable="False">
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border x:Name="bd" Background="{TemplateBinding Background}">
                                    <Path Data="M 0,0 L 10,0" Stroke="{DynamicResource BrushInk}" StrokeThickness="1.2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushSunken}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Maximize / Restore Button -->
                    <Button Width="46" Height="38" Click="Maximize_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Focusable="False">
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border x:Name="bd" Background="{TemplateBinding Background}">
                                    <Path Data="M 0,0 L 10,0 L 10,10 L 0,10 Z" Stroke="{DynamicResource BrushInk}" StrokeThickness="1.2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushSunken}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Close Button (Hover Coral with White Glyph) -->
                    <Button Width="46" Height="38" Click="Close_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Focusable="False">
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border x:Name="bd" Background="{TemplateBinding Background}">
                                    <Path x:Name="glyph" Data="{StaticResource IconClose}" Fill="{DynamicResource BrushInk}" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushCoral}"/>
                                        <Setter TargetName="glyph" Property="Fill" Value="#FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================================================================
             2. SHELL LAYOUT: 244 PX DARK NAV RAIL + WORKSPACE (§3.3, §3.4)
             =================================================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="244" x:Name="NavRailColumn"/> <!-- 244 px Navigation Rail -->
                <ColumnDefinition Width="*"/>                           <!-- Main Workspace -->
            </Grid.ColumnDefinitions>

            <!-- ================= NAVIGATION RAIL (DARK IN BOTH THEMES) ================= -->
            <Border Grid.Column="0" Background="{DynamicResource BrushRailBackground}" BorderBrush="{DynamicResource BrushRailHairline}" BorderThickness="0,0,1,0" SnapsToDevicePixels="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Top Brand & Host Pill -->
                        <RowDefinition Height="*"/>    <!-- Navigation Groups -->
                        <RowDefinition Height="Auto"/> <!-- Footer Free Space Card -->
                    </Grid.RowDefinitions>

                    <!-- Brand Header & Host Pill -->
                    <StackPanel Grid.Row="0" Margin="20,16,20,12">
                        <!-- Brand Stack -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Image Source="{StaticResource AppLogoDrawingImage}" Width="44" Height="44" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="UniBackup Pro" FontWeight="SemiBold" FontSize="15" Foreground="#FFFFFF"/>
                                <TextBlock Text="Universal Cloud Edition" FontSize="11" Foreground="{DynamicResource BrushRailText}" Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Host Pill: live dot + host name & IP (§3.3) -->
                        <Border Background="{DynamicResource BrushRailHostPill}" BorderBrush="{DynamicResource BrushRailHairline}" BorderThickness="1" CornerRadius="14" Padding="10,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <controls:StatusDot VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding HostDisplay}" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{DynamicResource BrushRailText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Navigation Groups (Protect · Recover and review · Configure) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" Padding="14,0">
                        <StackPanel>
                            <!-- GROUP 1: Protect -->
                            <TextBlock Text="Protect" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource BrushRailCaption}" Margin="10,6,10,4"/>

                            <!-- Overview -->
                            <RadioButton x:Name="NavOverviewRadio" Style="{StaticResource NavRailItem}" Checked="NavTab_Checked" Tag="Overview" Height="42" Margin="0,0,0,2">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="#332D5BFF" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconOverview}" Fill="{DynamicResource BrushCobalt}" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="Overview" FontWeight="Medium" FontSize="{StaticResource FontSizeBody}" Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center"/>
                                </Grid>
                            </RadioButton>

                            <!-- Backup Jobs -->
                            <RadioButton x:Name="NavBackupsRadio" IsChecked="True" Style="{StaticResource NavRailItem}" Checked="NavTab_Checked" Tag="Backups" Height="42" Margin="0,0,0,2">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="#332D5BFF" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconBackups}" Fill="{DynamicResource BrushCobalt}" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="Backup Jobs" FontWeight="Medium" FontSize="{StaticResource FontSizeBody}" Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center"/>

                                    <!-- Failing job count coral pill on right (§3.3) -->
                                    <Border Grid.Column="3" Visibility="{Binding HasStaleJobs, Converter={StaticResource BoolToVis}}" Style="{StaticResource BadgePill}" Background="{DynamicResource BrushCoral}" Height="18" Padding="6,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StaleJobsCount}" FontWeight="SemiBold" FontSize="10" Foreground="#FFFFFF"/>
                                    </Border>
                                </Grid>
                            </RadioButton>

                            <!-- Create Backup Job -->
                            <RadioButton x:Name="NavNewJobRadio" Style="{StaticResource NavRailItem}" Checked="NavTab_Checked" Tag="NewJob" Height="42" Margin="0,0,0,2">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="#332D5BFF" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconCreateJob}" Fill="{DynamicResource BrushCobalt}" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="Create Backup Job" FontWeight="Medium" FontSize="{StaticResource FontSizeBody}" Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center"/>
                                </Grid>
                            </RadioButton>

                            <!-- IIS Sites -->
                            <RadioButton x:Name="NavIisSitesRadio" Style="{StaticResource NavRailItem}" Checked="NavTab_Checked" Tag="IisSites" Height="42" Margin="0,0,0,8">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="#3300A0AE" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconIisSites}" Fill="{DynamicResource BrushTeal}" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="IIS Sites" FontWeight="Medium" FontSize="{StaticResource FontSizeBody}" Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center"/>
                                </Grid>
                            </RadioButton>

                            <!-- GROUP 2: Recover and review -->
                            <TextBlock Text="Recover and review" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource BrushRailCaption}" Margin="10,4,10,4"/>

                            <!-- Cloud Recovery -->
                            <RadioButton x:Name="NavRecoveryRadio" Style="{StaticResource NavRailItem}" Checked="NavTab_Checked" Tag="Recovery" Height="42" Margin="0,0,0,2">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="#337C4DFF" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconRecovery}" Fill="{DynamicResource BrushOrchid}" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="Cloud Recovery" FontWeight="Medium" FontSize="{StaticResource FontSizeBody}" Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center"/>
                                </Grid>
                            </RadioButton>

                            <!-- Analytics & History -->
                            <RadioButton x:Name="NavSummaryRadio" Style="{StaticResource NavRailItem}" Checked="NavTab_Checked" Tag="Summary" Height="42" Margin="0,0,0,2">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="#3300946A" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconSummary}" Fill="{DynamicResource BrushJade}" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="Analytics &amp; History" FontWeight="Medium" FontSize="{StaticResource FontSizeBody}" Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center"/>
                                </Grid>
                            </RadioButton>

                            <!-- Application Logs -->
                            <RadioButton x:Name="NavLogsRadio" Style="{StaticResource NavRailItem}" Checked="NavTab_Checked" Tag="Logs" Height="42" Margin="0,0,0,8">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="#332D5BFF" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconLogs}" Fill="{DynamicResource BrushCobalt}" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="Application Logs" FontWeight="Medium" FontSize="{StaticResource FontSizeBody}" Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center"/>
                                </Grid>
                            </RadioButton>

                            <!-- GROUP 3: Configure -->
                            <TextBlock Text="Configure" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource BrushRailCaption}" Margin="10,4,10,4"/>

                            <!-- Notifications -->
                            <RadioButton x:Name="NavNotificationsRadio" Style="{StaticResource NavRailItem}" Checked="NavTab_Checked" Tag="Notifications" Height="42" Margin="0,0,0,2">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="#33C97A00" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconNotifications}" Fill="{DynamicResource BrushSaffron}" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="Notifications" FontWeight="Medium" FontSize="{StaticResource FontSizeBody}" Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center"/>
                                </Grid>
                            </RadioButton>

                            <!-- Settings & Engine -->
                            <RadioButton x:Name="NavSettingsRadio" Style="{StaticResource NavRailItem}" Checked="NavTab_Checked" Tag="Settings" Height="42">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="#33808FA5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconSettings}" Fill="{DynamicResource BrushRailText}" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="Settings &amp; Engine" FontWeight="Medium" FontSize="{StaticResource FontSizeBody}" Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center"/>
                                </Grid>
                            </RadioButton>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Rail Footer Card: Temp Disk Free (§3.3) -->
                    <Border Grid.Row="2" Background="{DynamicResource BrushRailHostPill}" BorderBrush="{DynamicResource BrushRailHairline}" BorderThickness="0,1,0,0" Padding="16,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Temp disk free" FontSize="11" Foreground="{DynamicResource BrushRailCaption}"/>
                                <TextBlock Text="{Binding TempDiskFreeGbDisplay}" FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- 6 px Gradient Meter -->
                            <Border Height="6" CornerRadius="3" Background="#1B283A" Margin="0,0,0,6">
                                <Border Height="6" CornerRadius="3" HorizontalAlignment="Left" Width="120">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00A0AE" Offset="0.0"/>
                                            <GradientStop Color="#2ECC94" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Border>

                            <TextBlock Text="{Binding TempDiskDrive}" FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="{DynamicResource BrushRailCaption}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ================= WORKSPACE (TOP BAR + CONTENT TABS) ================= -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="62"/> <!-- Top Bar (§3.4) -->
                    <RowDefinition Height="*"/>  <!-- Active View Content -->
                </Grid.RowDefinitions>

                <!-- Top Bar (62 px, Panel) -->
                <Border Grid.Row="0" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,0,0,1" Padding="28,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>    <!-- Search Box -->
                            <ColumnDefinition Width="Auto"/> <!-- Action Buttons -->
                        </Grid.ColumnDefinitions>

                        <!-- Search Box (Enterprise 380 px width with Watermark & Clear Button) -->
                        <Border Width="380" Height="38" HorizontalAlignment="Left" CornerRadius="{StaticResource RadiusControl}" Background="{DynamicResource BrushCanvas}" BorderBrush="{DynamicResource BrushLineStrong}" BorderThickness="1">
                            <Grid>
                                <!-- Search Icon on Left -->
                                <Path Data="{StaticResource IconSearch}"
                                      Fill="{DynamicResource BrushInkFaint}"
                                      Width="19" Height="19"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Left"
                                      Margin="12,0,0,0"
                                      IsHitTestVisible="False"/>

                                <!-- Watermark Placeholder when empty -->
                                <TextBlock Text="Search backup jobs, logs, destinations..."
                                           Foreground="{DynamicResource BrushInkFaint}"
                                           FontSize="{StaticResource FontSizeBody}"
                                           VerticalAlignment="Center"
                                           Margin="36,0,32,0"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=MainSearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Text, ElementName=MainSearchBox}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Input TextBox -->
                                <TextBox x:Name="MainSearchBox"
                                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{DynamicResource BrushInk}"
                                         CaretBrush="{DynamicResource BrushCobalt}"
                                         FontSize="{StaticResource FontSizeBody}"
                                         VerticalContentAlignment="Center"
                                         Padding="36,0,32,0"/>

                                <!-- Clear Button (Appears when text is entered) -->
                                <Button x:Name="SearchClearButton"
                                        Click="SearchClear_Click"
                                        Width="26" Height="26"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="0,0,6,0"
                                        Cursor="Hand"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ToolTip="Clear search">
                                    <Button.Style>
                                        <Style TargetType="{x:Type Button}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type Button}">
                                                        <Border x:Name="bd" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource BrushSunken}">
                                                            <Path Data="{StaticResource IconClose}" Fill="{DynamicResource BrushInkMuted}" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushLineStrong}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=MainSearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Text, ElementName=MainSearchBox}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Top Bar Action Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Theme Toggle Icon Button -->
                            <Button Style="{StaticResource IconBtn}" Click="ToggleTheme_Click" Margin="0,0,10,0" ToolTip="Toggle light / dark theme">
                                <Path Data="{StaticResource IconTheme}" Fill="{DynamicResource BrushInkMuted}" Width="20" Height="20" Stretch="Uniform"/>
                            </Button>

                            <!-- Validate Health (Quiet) -->
                            <Button Content="Validate health" Click="ValidateHealth_Click" Style="{StaticResource BtnQuiet}" Margin="0,0,10,0" Height="36"/>

                            <!-- Run All Enabled (Jade) -->
                            <Button Content="Run all enabled" Command="{Binding RunAllCommand}" Style="{StaticResource BtnGo}" Margin="0,0,10,0" Height="36"/>

                            <!-- New Backup (Cobalt) -->
                            <Button Content="New backup" Click="NewBackup_Click" Style="{StaticResource BtnPrimary}" Height="36"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Active View Content Container -->
                <Grid Grid.Row="1">
                    <!-- 1. Overview Tab -->
                    <Grid x:Name="OverviewTabContent" Visibility="Collapsed">
                        <views:OverviewView/>
                    </Grid>

                    <!-- 2. Backup Jobs Tab (Default) -->
                    <Grid x:Name="BackupsTabContent" Visibility="Visible">
                        <views:JobsView/>
                    </Grid>

                    <!-- 3. Create Backup Job Tab -->
                    <Grid x:Name="NewJobTabContent" Visibility="Collapsed" DataContext="{Binding NewJob}">
                        <views:JobWizardView/>
                    </Grid>

                    <!-- 4. IIS Sites Tab -->
                    <Grid x:Name="IisSitesTabContent" Visibility="Collapsed">
                        <views:IisSitesView/>
                    </Grid>

                    <!-- 5. Cloud Recovery Tab -->
                    <Grid x:Name="RecoveryTabContent" Visibility="Collapsed">
                        <views:RecoveryView/>
                    </Grid>

                    <!-- 6. Analytics & History Tab -->
                    <Grid x:Name="SummaryTabContent" Visibility="Collapsed">
                        <views:AnalyticsView/>
                    </Grid>

                    <!-- 7. Application Logs Tab -->
                    <Grid x:Name="LogsTabContent" Visibility="Collapsed">
                        <views:LogsView x:Name="InnerLogsView"/>
                    </Grid>

                    <!-- 8. Notifications Tab -->
                    <Grid x:Name="NotificationsTabContent" Visibility="Collapsed">
                        <views:NotificationsView/>
                    </Grid>

                    <!-- 9. Settings & Engine Tab -->
                    <Grid x:Name="SettingsTabContent" Visibility="Collapsed">
                        <views:SettingsView/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- ===================================================================
             TOAST NOTIFICATION HOST (Bottom-Right Stack, §2.4, §6)
             =================================================================== -->
        <Border x:Name="ToastNotificationCard"
                Grid.Row="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,28,28"
                Width="380"
                Background="{DynamicResource BrushPanel}"
                BorderBrush="{DynamicResource BrushLine}"
                BorderThickness="1"
                CornerRadius="12"
                Effect="{StaticResource Sh3}"
                Visibility="Collapsed"
                SnapsToDevicePixels="True"
                ClipToBounds="True">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastTransform" Y="20"/>
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="2"/> <!-- 2 px Countdown Bar -->
                </Grid.RowDefinitions>

                <Border Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/> <!-- 32 px Icon Tile -->
                            <ColumnDefinition Width="*"/>    <!-- Text & Action -->
                            <ColumnDefinition Width="Auto"/> <!-- Close Button -->
                        </Grid.ColumnDefinitions>

                        <!-- 32 px Icon Tile -->
                        <Border x:Name="ToastIconBd" Width="32" Height="32" CornerRadius="8"
                                Background="{DynamicResource BrushJadeSoft}"
                                VerticalAlignment="Top" Margin="0,0,12,0">
                            <Path x:Name="ToastIconPath" Data="{StaticResource IconCheckCircle}"
                                  Fill="{DynamicResource BrushJade}"
                                  Width="16" Height="16"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="ToastTitleText" Text="Success" FontWeight="SemiBold" FontSize="{StaticResource FontSizeRowTitle}" Foreground="{DynamicResource BrushInk}"/>
                            <TextBlock x:Name="ToastMessageText" Text="Operation completed successfully." FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>

                            <!-- Optional Action Button (e.g. Undo) -->
                            <Button x:Name="ToastActionButton" Visibility="Collapsed" Style="{StaticResource BtnQuiet}" Height="28" Padding="10,0" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <!-- Dismiss Button -->
                        <Button Grid.Column="2" Click="DismissToast_Click" Style="{StaticResource IconBtn}" Width="28" Height="28" VerticalAlignment="Top">
                            <Path Data="{StaticResource IconClose}" Fill="{DynamicResource BrushInkMuted}" Width="10" Height="10" Stretch="Uniform"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- 2 px Countdown Bar (§2.4) -->
                <ProgressBar Grid.Row="1" Height="2" Minimum="0" Maximum="100" Value="100"
                             Foreground="{DynamicResource BrushCobalt}" Background="{DynamicResource BrushSunken}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
