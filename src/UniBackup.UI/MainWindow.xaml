                            <!-- ============================================== -->
                            <!-- SUB-TAB 4: TEMP & LOGS (STORAGE & MAINTENANCE) -->
                            <!-- ============================================== -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSettingsTab}" Value="Storage">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedSettingsTab}" Value="Temp">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <!-- Storage & Directory Paths Card -->
                                <Border Style="{StaticResource ModernCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Storage &amp; Working Directories" FontWeight="Bold" FontSize="15" Margin="0,0,0,12"/>

                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <TextBlock Text="Temporary Scratch / Staging Folder" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding Config.Backup.TempFolder, UpdateSourceTrigger=PropertyChanged}" Height="36" VerticalContentAlignment="Center"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Height="36" Padding="14,0" VerticalAlignment="Bottom" Margin="0,0,10,0"
                                                    Command="{Binding BrowseTempFolderCommand}" ToolTip="Browse partition or folder (automatically appends \UniBackup\temp)">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconFolderOpen}" Fill="{StaticResource PrimaryBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Browse Folder" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Button>
                                            <Border Grid.Column="2" Background="{StaticResource BrandTintBlueSoft}" CornerRadius="6" Padding="12,0" VerticalAlignment="Bottom" Height="36">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource IconServer}" Fill="{StaticResource PrimaryBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding TempFreeSpaceDisplay}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBlock Text="Application Log File Location" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding Config.Backup.LogPath, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Height="34" Padding="14,0" VerticalAlignment="Bottom" Command="{Binding OpenLogsFolderCommand}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconFolderOpen}" Fill="{StaticResource PrimaryBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Open Logs Folder"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <TextBlock Text="Keep Logs For (Days)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding Config.Backup.KeepLogsDays, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Maximum Single Log Size (MB)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding Config.Backup.MaxLogMb, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Server Diagnostics Card -->
                                <Border Style="{StaticResource ModernCard}" Margin="0,0,0,16" Visibility="{Binding HasDiagnostics, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="{StaticResource BrandTintPurpleSoft}" CornerRadius="6" Width="26" Height="26" Margin="0,0,10,0">
                                                    <Path Data="{StaticResource IconStethoscope}" Fill="{StaticResource BrandTintPurpleDeep}" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Server Health Diagnostics Report" FontWeight="Bold" FontSize="14.5" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Button HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Height="28" Padding="12,0" Command="{Binding RunValidateServerCommand}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource PrimaryBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Re-run Diagnostics" FontSize="11.5" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding DiagnosticItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="85"/>
                                                                <ColumnDefinition Width="220"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border x:Name="StatusBadge" Grid.Column="0" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                <TextBlock x:Name="StatusText" Text="{Binding Status}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Details}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="PASS">
                                                            <Setter TargetName="StatusBadge" Property="Background" Value="#DEF7EC"/>
                                                            <Setter TargetName="StatusText" Property="Foreground" Value="#03543F"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="OK">
                                                            <Setter TargetName="StatusBadge" Property="Background" Value="#DEF7EC"/>
                                                            <Setter TargetName="StatusText" Property="Foreground" Value="#03543F"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="WARN">
                                                            <Setter TargetName="StatusBadge" Property="Background" Value="#FEF08A"/>
                                                            <Setter TargetName="StatusText" Property="Foreground" Value="#854D0E"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="FAIL">
                                                            <Setter TargetName="StatusBadge" Property="Background" Value="#FDE8E8"/>
                                                            <Setter TargetName="StatusText" Property="Foreground" Value="#9B1C1C"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="ERROR">
                                                            <Setter TargetName="StatusBadge" Property="Background" Value="#FDE8E8"/>
                                                            <Setter TargetName="StatusText" Property="Foreground" Value="#9B1C1C"/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Row 3: Bottom Action Bar (Save Settings & Run Diagnostics) -->
                        <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,16,0,0">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource PrimaryButton}" Height="38" Padding="20,0" Margin="0,0,10,0" Command="{Binding SaveSettingsCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconSave}" Fill="White" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0"/>
                                            <TextBlock Text="Save All Settings" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource SecondaryButton}" Height="38" Padding="16,0" Command="{Binding RunValidateServerCommand}"
                                            ToolTip="Check temp disk, AWS S3, Google Drive, email configuration, and backup folders">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconCheckCircle}" Fill="{StaticResource BrandTintTealDeep}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                                            <TextBlock Text="Validate Server Health" Foreground="{StaticResource BrandTintTealDeep}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <TextBlock Text="UniBackup Enterprise v2.0 · Automated Engine" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <!-- ============================================== -->
                <!-- 7. NEW / EDIT BACKUP JOB SCREEN               -->
                <!-- ============================================== -->
                <ScrollViewer x:Name="NewJobTabContent" Style="{StaticResource AnimatedTabContent}" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" DataContext="{Binding NewJob}">
                    <StackPanel Margin="0,0,0,32">
                        <!-- Top Navigation & Actions Bar -->
                        <Border Style="{StaticResource ModernCard}" Margin="0,0,0,18" Padding="18,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource SecondaryButton}" Padding="14,8" Margin="0,0,16,0" Command="{Binding CancelCommand}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconBackups}" Fill="{StaticResource PrimaryBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                            <TextBlock Text="« Back to Backup Jobs" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>
                                    <Border Background="#0C4A6E" CornerRadius="10" Width="38" Height="38" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconPlus}" Fill="#38BDF8" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Create New Backup Job" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Full-Screen Stepped Wizard: Source → Schedule → Destinations → Encryption &amp; Options" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Width="90" Margin="0,0,10,0" Command="{Binding CancelCommand}"/>
                                    <Button Content="Save Job" Style="{StaticResource PrimaryButton}" Width="130" Command="{Binding SaveJobCommand}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Stepped Wizard Navigation Bar -->
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,18">
                            <UniformGrid Columns="4">
                                <Button Command="{Binding SetStepCommand}" CommandParameter="1" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Border CornerRadius="12" Width="24" Height="24" Margin="0,0,8,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#E2E8F0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsStep1}" Value="True">
                                                            <Setter Property="Background" Value="#0284C7"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="1" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#64748B"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsStep1}" Value="True">
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Text="1. Source" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding SetStepCommand}" CommandParameter="2" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Border CornerRadius="12" Width="24" Height="24" Margin="0,0,8,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#E2E8F0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsStep2}" Value="True">
                                                            <Setter Property="Background" Value="#0284C7"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="2" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#64748B"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsStep2}" Value="True">
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Text="2. Schedule" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding SetStepCommand}" CommandParameter="3" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Border CornerRadius="12" Width="24" Height="24" Margin="0,0,8,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#E2E8F0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsStep3}" Value="True">
                                                            <Setter Property="Background" Value="#0284C7"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="3" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#64748B"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsStep3}" Value="True">
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Text="3. Destinations" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding SetStepCommand}" CommandParameter="4" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Border CornerRadius="12" Width="24" Height="24" Margin="0,0,8,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#E2E8F0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsStep4}" Value="True">
                                                            <Setter Property="Background" Value="#0284C7"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="4" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#64748B"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsStep4}" Value="True">
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Text="4. Options" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                        </Border>

                        <!-- STEP 1: SOURCE -->
                        <StackPanel Visibility="{Binding IsStep1, Converter={StaticResource BoolToVis}}">
                            <Border Style="{StaticResource ModernCard}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Select Backup Source Type" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <RadioButton Content="Folder / File System / IIS" GroupName="NewJobSourceType" IsChecked="{Binding IsFolder}" Margin="0,0,24,0" FontWeight="SemiBold"/>
                                        <RadioButton Content="SQL Server Database Engine" GroupName="NewJobSourceType" IsChecked="{Binding IsSqlServer}" FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <TextBlock Text="Job Name (Identifier / Archive Base Name)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding JobName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                                </StackPanel>
                            </Border>

                            <!-- Folder / IIS Sub-Panel -->
                            <Border Style="{StaticResource ModernCard}" Visibility="{Binding IsFolder, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Source Folder Path on Disk" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding SourceFolder, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Grid.Column="1" Content="Browse..." Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="14,0" Command="{Binding BrowseSourceFolderCommand}"/>
                                    </Grid>

                                    <TextBlock Text="Subfolder Filter (Optional)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding Subfolder, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                                    <CheckBox Content="Use Volume Shadow Copy (VSS) for open / locked files" IsChecked="{Binding UseVss}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>

                            <!-- SQL Server Sub-Panel -->
                            <Border Style="{StaticResource ModernCard}" Visibility="{Binding IsSqlServer, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="SQL Server Instance (e.g. localhost, .\SQL2022)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding SqlServer, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Test Connection" Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" Padding="16,8" Command="{Binding TestSqlConnectionCommand}"/>
                                    </Grid>

                                    <TextBlock Text="{Binding SqlConnectionStatus}" FontSize="12" Foreground="#38BDF8" Margin="0,0,0,12"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <RadioButton Content="Windows Authentication" GroupName="NewJobSqlAuth" IsChecked="{Binding SqlUseWindowsAuth}" Margin="0,0,20,0" FontWeight="SemiBold"/>
                                        <RadioButton Content="SQL Server Authentication" GroupName="NewJobSqlAuth" IsChecked="{Binding SqlUseSqlAuth}" FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding SqlUseSqlAuth, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <TextBlock Text="SQL Username (e.g. sa)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding SqlUsername, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                <TextBlock Text="SQL Password" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding SqlPassword, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <CheckBox Content="Backup all user databases" IsChecked="{Binding SqlAllDatabases}" FontWeight="SemiBold" Margin="0,0,0,8"/>

                                    <TextBlock Text="Exclude Wildcards (comma-separated, e.g. *test*, report_*)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SqlExcludePatterns, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                                    <WrapPanel Margin="0,0,0,6">
                                        <CheckBox Content="Native Compression" IsChecked="{Binding SqlNativeCompression}" Margin="0,0,16,6" FontWeight="SemiBold"/>
                                        <CheckBox Content="CHECKSUM" IsChecked="{Binding SqlChecksum}" Margin="0,0,16,6" FontWeight="SemiBold"/>
                                        <CheckBox Content="RESTORE VERIFYONLY" IsChecked="{Binding SqlVerify}" Margin="0,0,16,6" FontWeight="SemiBold"/>
                                        <CheckBox Content="Run DBCC CHECKDB" IsChecked="{Binding SqlRunCheckDb}" Margin="0,0,16,6" FontWeight="SemiBold"/>
                                        <CheckBox Content="Direct-to-URL (S3 Only)" IsChecked="{Binding SqlDirectToUrl}" FontWeight="SemiBold"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- STEP 2: SCHEDULE -->
                        <StackPanel Visibility="{Binding IsStep2, Converter={StaticResource BoolToVis}}">
                            <Border Style="{StaticResource ModernCard}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Full Backup Cadence" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="Frequency" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding SelectedFrequency}" Height="34">
                                                <ComboBoxItem Content="Daily" Tag="daily"/>
                                                <ComboBoxItem Content="Weekly" Tag="weekly"/>
                                                <ComboBoxItem Content="Monthly" Tag="monthly"/>
                                                <ComboBoxItem Content="Manual Only" Tag="manual"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Full Run Time (HH:mm 24hr)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding ScheduledTime, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Active Days for Full Backup" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                    <WrapPanel Margin="0,0,0,14">
                                        <CheckBox Content="Mon" IsChecked="{Binding Monday}" Margin="0,0,12,0"/>
                                        <CheckBox Content="Tue" IsChecked="{Binding Tuesday}" Margin="0,0,12,0"/>
                                        <CheckBox Content="Wed" IsChecked="{Binding Wednesday}" Margin="0,0,12,0"/>
                                        <CheckBox Content="Thu" IsChecked="{Binding Thursday}" Margin="0,0,12,0"/>
                                        <CheckBox Content="Fri" IsChecked="{Binding Friday}" Margin="0,0,12,0"/>
                                        <CheckBox Content="Sat" IsChecked="{Binding Saturday}" Margin="0,0,12,0"/>
                                        <CheckBox Content="Sun" IsChecked="{Binding Sunday}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- SQL Server Differential & Log Schedules -->
                            <Border Style="{StaticResource ModernCard}" Visibility="{Binding IsSqlServer, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="High-Frequency Interval Backups (DIFF &amp; LOG)" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" Content="Enable Differential Backups every" IsChecked="{Binding DiffEnabled}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding DiffMinutes, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left" ToolTip="Minutes between differential runs (e.g. 240)"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" Content="Enable Transaction Log Backups every" IsChecked="{Binding LogEnabled}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding LogMinutes, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left" ToolTip="Minutes between transaction log runs (e.g. 15)"/>
                                    </Grid>

                                    <CheckBox Content="Constrain interval backups to daily business hours window" IsChecked="{Binding WindowEnabled}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding WindowEnabled, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox Text="{Binding WindowStart, UpdateSourceTrigger=PropertyChanged}" Width="65" Margin="0,0,14,0"/>
                                        <TextBlock Text="To:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox Text="{Binding WindowEnd, UpdateSourceTrigger=PropertyChanged}" Width="65"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- STEP 3: DESTINATIONS -->
                        <StackPanel Visibility="{Binding IsStep3, Converter={StaticResource BoolToVis}}">
                            <Border Style="{StaticResource ModernCard}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="S3 Compatible Cloud Providers" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                    <TextBlock Text="Direct streaming to any S3-compliant object store (Amazon S3, Cloudflare R2, Backblaze B2, Wasabi, MinIO, DigitalOcean Spaces, Oracle Cloud, Google Cloud)."
                                               FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                    <CheckBox Content="Amazon Web Services (AWS S3) / Cloudflare R2 / Wasabi / MinIO / S3-Compatible" IsChecked="{Binding EnableS3}" FontWeight="SemiBold" Margin="0,0,0,14"/>

                                    <Separator Margin="0,4,0,14" Background="{StaticResource BorderBrush}"/>

                                    <TextBlock Text="General &amp; Enterprise Storage Providers" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                    <TextBlock Text="All destination storage providers are 100% unlocked with zero license restrictions in UniBackup Pro."
                                               FontSize="11.5" Foreground="#059669" FontWeight="SemiBold" Margin="0,0,0,10"/>

                                    <UniformGrid Columns="2" Margin="0,0,0,14">
                                        <CheckBox Content="Google Drive" IsChecked="{Binding EnableGDrive}" FontWeight="SemiBold" Margin="0,0,10,8"/>
                                        <CheckBox Content="Microsoft Azure Blob Storage" IsChecked="{Binding EnableAzure}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <CheckBox Content="Dropbox" IsChecked="{Binding EnableDropbox}" FontWeight="SemiBold" Margin="0,0,10,8"/>
                                        <CheckBox Content="Microsoft OneDrive (Personal &amp; Business)" IsChecked="{Binding EnableOneDrive}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <CheckBox Content="Box Cloud Storage" IsChecked="{Binding EnableBox}" FontWeight="SemiBold" Margin="0,0,10,8"/>
                                        <CheckBox Content="WebDAV Server (Nextcloud / ownCloud)" IsChecked="{Binding EnableWebDav}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <CheckBox Content="FTP / FTPS Server (TLS/SSL)" IsChecked="{Binding EnableFtp}" FontWeight="SemiBold" Margin="0,0,10,8"/>
                                        <CheckBox Content="SFTP Server (SSH File Transfer)" IsChecked="{Binding EnableSftp}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <CheckBox Content="Local or Network Folder (UNC / NAS)" IsChecked="{Binding EnableLocal}" FontWeight="SemiBold" Margin="0,0,10,8"/>
                                    </UniformGrid>

                                    <TextBlock Text="Target Cloud Folder / Prefix Override (Optional)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding CloudFolder, UpdateSourceTrigger=PropertyChanged}" ToolTip="Leave blank to use host machine default"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- STEP 4: OPTIONS & ENCRYPTION -->
                        <StackPanel Visibility="{Binding IsStep4, Converter={StaticResource BoolToVis}}">
                            <Border Style="{StaticResource ModernCard}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Retention &amp; GFS Archival" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Standard Retention Days:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding RetentionDays, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left"/>
                                    </Grid>

                                    <CheckBox Content="Enable Grandfather-Father-Son (GFS) Long-Term Retention" IsChecked="{Binding GfsEnabled}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <WrapPanel Visibility="{Binding GfsEnabled, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                                        <TextBlock Text="Dailies:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox Text="{Binding GfsDailies, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="0,0,12,0"/>
                                        <TextBlock Text="Weeklies:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox Text="{Binding GfsWeeklies, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="0,0,12,0"/>
                                        <TextBlock Text="Monthlies:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox Text="{Binding GfsMonthlies, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ModernCard}">
                                <StackPanel>
                                    <TextBlock Text="AES-256-GCM Streaming Encryption &amp; Immutability" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                    <CheckBox Content="Encrypt backup archives with AES-256-GCM (.ubenc)" IsChecked="{Binding EncryptionEnabled}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <StackPanel Visibility="{Binding EncryptionEnabled, Converter={StaticResource BoolToVis}}" Margin="0,0,0,14">
                                        <TextBlock Text="Master Passphrase (PBKDF2-SHA256, keep safely for DR):" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding EncryptionPassphrase, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <CheckBox Content="Enable S3 Object Lock (WORM Immutability)" IsChecked="{Binding ObjectLockEnabled}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding ObjectLockEnabled, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Lock Retention Days:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox Text="{Binding ObjectLockDays, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Bottom Footer Actions Bar -->
                        <Border Style="{StaticResource ModernCard}" Margin="0,16,0,0" Padding="16,14">
                            <Grid>
                                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Width="90" HorizontalAlignment="Left" Command="{Binding CancelCommand}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="« Back" Style="{StaticResource SecondaryButton}" Width="95" Margin="0,0,10,0" Command="{Binding PreviousStepCommand}" IsEnabled="{Binding CanGoPrevious}"/>
                                    <Button Content="Next »" Style="{StaticResource PrimaryButton}" Width="110" Margin="0,0,10,0" Command="{Binding NextStepCommand}" Visibility="{Binding CanGoNext, Converter={StaticResource BoolToVis}}"/>
                                    <Button Content="Save Backup Job" Style="{StaticResource PrimaryButton}" Width="160" Command="{Binding SaveJobCommand}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ============================================== -->
        <!-- PROGRESS MODAL OVERLAY (Smooth Glass Effect)   -->
        <!-- ============================================== -->
        <Border Grid.ColumnSpan="2" Background="#900B132B" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <Border Background="White" CornerRadius="16" Width="440" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <!-- Spinning Loader Ring & Phase Header -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{StaticResource IconSpinner}" Stroke="{StaticResource PrimaryBrush}" StrokeThickness="3" Width="36" Height="36" Stretch="Uniform"
                              Style="{StaticResource RotatingSpinner}" Margin="0,0,14,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ProgressPhase}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding ProgressStatusMessage}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <!-- Animated Progress Bar -->
                    <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="8" Margin="0,0,0,10" Foreground="{StaticResource PrimaryGradient}"/>

                    <!-- Current File / Subtask details -->
                    <TextBlock Text="{Binding ProgressDetail}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- ============================================== -->
        <!-- MODERN FLOATING TOAST NOTIFICATION OVERLAY    -->
        <!-- ============================================== -->
        <Border x:Name="ToastNotificationCard" Grid.ColumnSpan="2"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,32,32" MaxWidth="440"
                CornerRadius="12"
                Background="#0F172A"
                BorderBrush="#334155"
                BorderThickness="1"
                Padding="16,14"
                Opacity="0"
                Visibility="Collapsed"
                IsHitTestVisible="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.5" Color="#020617"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastTransform" Y="30"/>
            </Border.RenderTransform>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status Icon Pill -->
                <Border x:Name="ToastIconBd" Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#064E3B" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Path x:Name="ToastIconPath" Data="{StaticResource IconCheckCircle}" Fill="#34D399" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Toast Content -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock x:Name="ToastTitleText" Text="Notification" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock x:Name="ToastMessageText" Text="Message details go here." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Close Button -->
                <Button Grid.Column="2" Width="26" Height="26" Padding="0" 
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Click="DismissToast_Click" ToolTip="Dismiss Notification">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="13">
                                <TextBlock Text="✕" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#1E293B"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
