<Window x:Class="UniBackup.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:UniBackup.UI.ViewModels"
        mc:Ignorable="d"
        Title="UniBackup Pro — Universal Cloud Backup &amp; Recovery (.NET)" 
        Height="840" Width="1240" MinHeight="700" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource MainFont}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================================== -->
        <!-- SIDEBAR NAVIGATION (Obsidian Dark Glass)       -->
        <!-- ============================================== -->
        <Border Grid.Column="0" Background="{StaticResource SidebarGradient}" BorderBrush="#1F2A4A" BorderThickness="0,0,1,0">
            <Grid Margin="16,20,16,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. App Brand & Server Identity -->
                <StackPanel Grid.Row="0" Margin="0,0,0,22">
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="10" Background="#162244" Padding="2" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/UniBackup;component/UniBackup.png" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="UniBackup Pro" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="Universal Cloud Edition" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>

                    <!-- Live Server Identity Pill -->
                    <Border Background="#131F3D" BorderBrush="#1E2E59" BorderThickness="1" CornerRadius="8" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Pulsing Emerald Live Indicator -->
                            <Ellipse Grid.Column="0" Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"
                                     Style="{StaticResource PulsingIndicator}"/>
                            <TextBlock Grid.Column="1" Text="{Binding ServerLabel}" FontSize="11" Foreground="#94A3B8" 
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding ServerLabel}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 2. Nav Menu Buttons with Dedicated Color Chips -->
                <StackPanel Grid.Row="1">
                    <!-- Backups Tab (Blue Chip) -->
                    <RadioButton x:Name="NavBackupsRadio" IsChecked="True" GroupName="NavTabs" Style="{StaticResource NavTabStyle}"
                                 Checked="NavTab_Checked" Tag="Backups">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="7" Background="#1E3A8A" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconBackups}" Fill="#60A5FA" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Backup Jobs" FontSize="13.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- Create Backup Job Tab (Sky Chip) -->
                    <RadioButton x:Name="NavNewJobRadio" GroupName="NavTabs" Style="{StaticResource NavTabStyle}"
                                 Checked="NavTab_Checked" Tag="NewJob">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="7" Background="#0C4A6E" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconPlus}" Fill="#38BDF8" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="＋ Create Backup Job" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- Summary & Analytics Tab (Purple Chip) -->
                    <RadioButton x:Name="NavSummaryRadio" GroupName="NavTabs" Style="{StaticResource NavTabStyle}"
                                 Checked="NavTab_Checked" Tag="Summary">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="7" Background="#3B0764" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconSummary}" Fill="#C084FC" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Analytics &amp; History" FontSize="13.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- Recovery Tab (Cyan Chip) -->
                    <RadioButton x:Name="NavRecoveryRadio" GroupName="NavTabs" Style="{StaticResource NavTabStyle}"
                                 Checked="NavTab_Checked" Tag="Recovery">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="7" Background="#0E7490" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconRecovery}" Fill="#67E8F9" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Cloud Recovery" FontSize="13.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- Logs Tab (Amber Chip) - Matching S3BackupTool Reference Design! -->
                    <RadioButton x:Name="NavLogsRadio" GroupName="NavTabs" Style="{StaticResource NavTabStyle}"
                                 Checked="NavTab_Checked" Tag="Logs">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="7" Background="#78350F" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconLogs}" Fill="#FBBF24" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Application Logs" FontSize="13.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- Notifications Tab (Rose/Pink Chip) -->
                    <RadioButton x:Name="NavNotificationsRadio" GroupName="NavTabs" Style="{StaticResource NavTabStyle}"
                                 Checked="NavTab_Checked" Tag="Notifications">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="7" Background="#881337" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconBell}" Fill="#FB7185" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Notifications" FontSize="13.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- Settings Tab (Slate Chip) -->
                    <RadioButton x:Name="NavSettingsRadio" GroupName="NavTabs" Style="{StaticResource NavTabStyle}"
                                 Checked="NavTab_Checked" Tag="Settings">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="7" Background="#334155" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconSettings}" Fill="#94A3B8" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Settings &amp; Engine" FontSize="13.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- 3. Footer System Card -->
                <StackPanel Grid.Row="2">
                    <Border Background="#131F3D" BorderBrush="#1E2E59" BorderThickness="1" CornerRadius="10" Padding="12">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Temp Disk Free" FontSize="11" Foreground="#94A3B8" FontWeight="SemiBold"/>
                                <Path Data="{StaticResource IconServer}" Fill="#38BDF8" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock Text="{Binding TempFreeSpaceDisplay}" FontWeight="Bold" FontSize="13" Foreground="#F8FAFC" Margin="0,0,0,4"/>
                            <TextBlock Text="Monitored real-time" FontSize="10" Foreground="#64748B"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================== -->
        <!-- MAIN CONTENT CANVAS                            -->
        <!-- ============================================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Toolbar Bar -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Input with Integrated Vector Icon & Watermark Hint -->
                    <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource IconSearch}" Fill="#94A3B8" Width="14" Height="14" Stretch="Uniform" Margin="12,0,8,0" VerticalAlignment="Center"/>
                            
                            <!-- Search TextBox with Overlay Placeholder Text -->
                            <Grid Grid.Column="1">
                                <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                         TextChanged="SearchBox_TextChanged" Background="Transparent" BorderThickness="0"
                                         VerticalContentAlignment="Center" FontSize="13" Padding="2,8"
                                         ToolTip="Search backup jobs by name or path"/>
                                <TextBlock Text="Search backup jobs by name or path..." 
                                           FontSize="12.5" Foreground="#94A3B8" VerticalAlignment="Center" Margin="4,0,0,0" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SearchQuery}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Action Buttons Toolbar -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- + New Backup Button -->
                        <Button Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Click="NewBackup_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconPlus}" Fill="White" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock Text="New Backup" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- ▷▷ Run All Button -->
                        <Button Style="{StaticResource SuccessButton}" Margin="0,0,10,0" Command="{Binding RunAllCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconRunAll}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock Text="Run All Enabled" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- 🩺 Validate Server Button -->
                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding RunValidateServerCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconValidate}" Fill="{StaticResource PrimaryBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock Text="Validate Health"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Dynamic Tab Content Views -->
            <Grid Grid.Row="1" Margin="24,20,24,20">

                <!-- ============================================== -->
                <!-- 1. BACKUPS TAB                                 -->
                <!-- ============================================== -->
                <ScrollViewer x:Name="BackupsTabContent" Style="{StaticResource AnimatedTabContent}" Visibility="Visible" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Stale Backups Warning Banner -->
                        <Border Background="#FFFBEB" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,18"
                                Visibility="{Binding HasStaleJobs, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="{StaticResource IconWarning}" Fill="#D97706" Width="20" Height="20" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Stale Backups Detected" FontWeight="Bold" FontSize="13" Foreground="#92400E"/>
                                    <TextBlock Text="One or more scheduled jobs have not run successfully recently. Check destinations or click 'Run All'." FontSize="12" Foreground="#B45309"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Empty State Illustration (when no jobs configured) -->
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="40"
                                Visibility="{Binding HasNoJobs, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Center" Margin="0,40,0,0" Width="460">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Background="#EEF2FF" CornerRadius="30" Width="60" Height="60" HorizontalAlignment="Center" Margin="0,0,0,16">
                                    <Path Data="{StaticResource IconCloud}" Fill="#4F46E5" Width="30" Height="30" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="No Backup Jobs Found" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="Create your first automated cloud backup to Amazon S3 or Google Drive with enterprise VSS protection." 
                                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,18"/>
                                <Button Content="＋ Create Backup Job" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Click="NewBackup_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Backup Cards List -->
                        <ItemsControl ItemsSource="{Binding Jobs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ModernCard}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Left Colored Accent Strip indicating Status -->
                                            <Border Grid.Column="0" Background="{Binding StatusColor}" Width="4" HorizontalAlignment="Left" CornerRadius="2"/>

                                            <!-- Main Job Information -->
                                            <StackPanel Grid.Column="1" Margin="14,0,18,0">
                                                <!-- Top Row: Name, Status Pill & Badges -->
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,10,0"/>

                                                        <!-- Kind Badge (SQL Server cyan / Folder blue) -->
                                                        <Border Background="#132742" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding KindBadge}" FontSize="10.5" Foreground="{Binding KindBadgeColor}" FontWeight="Bold"/>
                                                        </Border>

                                                        <!-- Schedule Badge (Purple) -->
                                                        <Border Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="0,0,6,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Path Data="{StaticResource IconClock}" Fill="#7C3AED" Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding ScheduleDisplay}" FontSize="11" Foreground="#6D28D9" FontWeight="SemiBold"/>
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- VSS Badge (Emerald) -->
                                                        <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="0,0,6,0"
                                                                Visibility="{Binding UseVss, Converter={StaticResource BoolToVis}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Path Data="{StaticResource IconShield}" Fill="#059669" Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="VSS" FontSize="11" Foreground="#047857" FontWeight="Bold"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- Status Badge Pill -->
                                                    <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="6" Padding="8,3">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="7" Height="7" Fill="{Binding StatusColor}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="Bold" Foreground="{Binding StatusColor}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>

                                                <!-- Path Row -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                    <Path Data="{StaticResource IconFolder}" Fill="{StaticResource TextMutedBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding EffectiveSourcePath}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Consolas, Segoe UI"/>
                                                </StackPanel>

                                                <!-- 3-Column Metrics Ribbon -->
                                                <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Last Run -->
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="LAST RUN" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                                            <TextBlock Text="{Binding LastRunDisplay}" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                        </StackPanel>

                                                        <!-- Archive Size -->
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="SIZE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                                            <TextBlock Text="{Binding ArchiveSizeDisplay}" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                        </StackPanel>

                                                        <!-- Duration -->
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="DURATION" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                                            <TextBlock Text="{Binding DurationDisplay}" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>

                                            <!-- Action Buttons -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Run Now Button -->
                                                <Button Style="{StaticResource SuccessButton}" Margin="0,0,8,0" Height="36" Padding="14,0"
                                                        Command="{Binding DataContext.RunJobCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" ToolTip="Run this backup immediately">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path Data="{StaticResource IconPlay}" Fill="White" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0"/>
                                                        <TextBlock Text="Run"/>
                                                    </StackPanel>
                                                </Button>

                                                <!-- Toggle Active Button -->
                                                <Button Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Height="36" Padding="12,0"
                                                        Command="{Binding DataContext.ToggleJobCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" ToolTip="Enable/Disable job automation">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path Data="{StaticResource IconToggle}" Fill="{StaticResource TextSecondaryBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                                        <TextBlock Text="Toggle"/>
                                                    </StackPanel>
                                                </Button>

                                                <!-- Delete Button -->
                                                <Button Style="{StaticResource DangerButton}" Height="36" Padding="12,0"
                                                        Command="{Binding DataContext.DeleteJobCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" ToolTip="Delete this backup job">
                                                    <Path Data="{StaticResource IconTrash}" Fill="White" Width="13" Height="13" Stretch="Uniform"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============================================== -->
                <!-- 2. SUMMARY & ANALYTICS TAB                     -->
                <!-- ============================================== -->
                <Grid x:Name="SummaryTabContent" Style="{StaticResource AnimatedTabContent}" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 4 Top KPI Stat Cards -->
                    <Grid Grid.Row="0" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: Total Runs (Indigo) -->
                        <Border Grid.Column="0" Style="{StaticResource ModernCard}" Margin="0,0,10,0" Padding="18">
                            <StackPanel>
                                <Border Height="3" Background="{StaticResource PrimaryGradient}" CornerRadius="2" Margin="0,-18,0,14"/>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="TOTAL RUNS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <Path Data="{StaticResource IconRunAll}" Fill="{StaticResource PrimaryBrush}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock Text="{Binding TotalRunsCount}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Lifetime job executions" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Succeeded (Emerald) -->
                        <Border Grid.Column="1" Style="{StaticResource ModernCard}" Margin="0,0,10,0" Padding="18">
                            <StackPanel>
                                <Border Height="3" Background="{StaticResource SuccessGradient}" CornerRadius="2" Margin="0,-18,0,14"/>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="SUCCEEDED" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                    <Path Data="{StaticResource IconCheck}" Fill="{StaticResource SuccessBrush}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock Text="{Binding SuccessfulRunsCount}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                <TextBlock Text="{Binding SuccessRateDisplay}" FontSize="11" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Failed / Warning (Coral) -->
                        <Border Grid.Column="2" Style="{StaticResource ModernCard}" Margin="0,0,10,0" Padding="18">
                            <StackPanel>
                                <Border Height="3" Background="{StaticResource DangerGradient}" CornerRadius="2" Margin="0,-18,0,14"/>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="FAILED / PARTIAL" FontSize="11" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
                                    <Path Data="{StaticResource IconWarning}" Fill="{StaticResource DangerBrush}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock Text="{Binding FailedRunsCount}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
                                <TextBlock Text="Requires investigation" FontSize="11" Foreground="{StaticResource DangerBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 4: Total Uploaded (Cyan) -->
                        <Border Grid.Column="3" Style="{StaticResource ModernCard}" Margin="0" Padding="18">
                            <StackPanel>
                                <Border Height="3" Background="{StaticResource CyanGradient}" CornerRadius="2" Margin="0,-18,0,14"/>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="TOTAL UPLOADED" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CyanBrush}"/>
                                    <Path Data="{StaticResource IconCloud}" Fill="{StaticResource CyanBrush}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock Text="{Binding TotalUploadedDisplay}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Compressed &amp; encrypted" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Run History Audit Log DataGrid -->
                    <Border Grid.Row="1" Style="{StaticResource ModernCard}" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Execution Audit Trail" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Chronological archive logs with durations, sizes, and cloud destination outcomes" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Command="{Binding ExportHistoryCsvCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconDownload}" Fill="{StaticResource TextSecondaryBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                        <TextBlock Text="Export CSV Report"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <DataGrid Grid.Row="1" ItemsSource="{Binding HistoryRecords}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="TIMESTAMP" Binding="{Binding Timestamp, StringFormat=\{0:yyyy-MM-dd HH:mm\}}" Width="140"/>
                                    <DataGridTextColumn Header="JOB NAME" Binding="{Binding JobName}" Width="160"/>
                                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="100"/>
                                    <DataGridTextColumn Header="SIZE (BYTES)" Binding="{Binding ArchiveSizeBytes}" Width="110"/>
                                    <DataGridTextColumn Header="DURATION" Binding="{Binding DurationSeconds, StringFormat=\{0:F1\}s}" Width="90"/>
                                    <DataGridTextColumn Header="ARCHIVE PACKAGE" Binding="{Binding ArchiveName}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ============================================== -->
                <!-- 3. CLOUD RECOVERY TAB                          -->
                <!-- ============================================== -->
                <Grid x:Name="RecoveryTabContent" Style="{StaticResource AnimatedTabContent}" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Sub-Tab Switcher -->
                    <Border Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,16" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="5">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="SQL Server Point-in-Time &amp; Drills" GroupName="RecoverySubTabs"
                                         Style="{StaticResource SettingsSubTabTeal}"
                                         IsChecked="True"
                                         Command="{Binding SelectRecoveryTabCommand}" CommandParameter="SqlServer"/>
                            <RadioButton Content="Cloud File Archives" GroupName="RecoverySubTabs"
                                         Style="{StaticResource SettingsSubTabBlue}"
                                         Command="{Binding SelectRecoveryTabCommand}" CommandParameter="CloudArchives"/>
                        </StackPanel>
                    </Border>

                    <!-- Sub-Tab Content -->
                    <Grid Grid.Row="1">
                        <!-- ============================================== -->
                        <!-- 1. SQL SERVER DISASTER RECOVERY & DRILLS       -->
                        <!-- ============================================== -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedRecoveryTab}" Value="SqlServer">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Banner -->
                            <Border Grid.Row="0" Style="{StaticResource ModernCard}" Margin="0,0,0,14" Padding="18">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="SQL Server Point-in-Time Recovery &amp; Automated Drills" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Assemble cloud backup chains (FULL + DIFF + LOG), recover to exact timestamps, decrypt AES-256-GCM, and execute automated sandbox drills verified with DBCC CHECKDB." FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Main Operations Grid -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Column: Point-in-Time Restore -->
                                <Border Grid.Column="0" Style="{StaticResource ModernCard}" Padding="18">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <TextBlock Text="Point-in-Time Database Restore" FontWeight="Bold" FontSize="15" Margin="0,0,0,12" Foreground="{StaticResource TextPrimaryBrush}"/>

                                            <!-- SQL Job Selection -->
                                            <TextBlock Text="Target Backup Job:" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,6"/>
                                            <ComboBox ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedSqlJob}" DisplayMemberPath="Name" Height="36" Margin="0,0,0,14"/>

                                            <!-- Database Name -->
                                            <TextBlock Text="Source Database Name:" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,6"/>
                                            <TextBox Text="{Binding SqlRestoreDatabaseName, UpdateSourceTrigger=PropertyChanged}" Height="34" Margin="0,0,0,14"/>

                                            <!-- Target Database Name -->
                                            <TextBlock Text="Restore As Database (Blank for Original):" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,6"/>
                                            <TextBox Text="{Binding SqlRestoreTargetDbName, UpdateSourceTrigger=PropertyChanged}" Height="34" Margin="0,0,0,14"/>

                                            <!-- Point-in-Time Scrubber -->
                                            <CheckBox Content="Point-in-Time Recovery (STOPAT)" IsChecked="{Binding SqlPointInTimeEnabled}" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,8"/>
                                            <Grid Margin="0,0,0,14" IsEnabled="{Binding SqlPointInTimeEnabled}">
                                                <TextBox Text="{Binding SqlPointInTime, StringFormat=\{0:yyyy-MM-dd HH:mm:ss\}, UpdateSourceTrigger=PropertyChanged}" Height="34"/>
                                            </Grid>

                                            <!-- Passphrase -->
                                            <TextBlock Text="AES-256-GCM Decryption Passphrase (if encrypted):" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,6"/>
                                            <TextBox Text="{Binding SqlRestorePassphrase, UpdateSourceTrigger=PropertyChanged}" Height="34" Margin="0,0,0,14"/>

                                            <!-- Replace Option -->
                                            <CheckBox Content="Replace / Overwrite Existing Database" IsChecked="{Binding SqlRestoreReplace}" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,18"/>

                                            <!-- Restore Action Button -->
                                            <Button Style="{StaticResource PrimaryButton}" Height="38" Command="{Binding ExecuteSqlCloudRestoreCommand}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconDownload}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Restore Database to SQL Server" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>

                                <!-- Right Column: Automated Restore Drills -->
                                <Border Grid.Column="2" Style="{StaticResource ModernCard}" Padding="18">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <TextBlock Text="Automated Sandbox Restore Drills" FontWeight="Bold" FontSize="15" Margin="0,0,0,12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Proactively proves database recoverability on a schedule or on-demand: restores the latest backup chain into sandbox 'ub_drill_&lt;db&gt;', executes DBCC CHECKDB integrity verification, records RTO wall time, and safely removes the sandbox." 
                                                       TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16"/>

                                            <!-- Live Drill Results Card -->
                                            <Border Background="#F1F5F9" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,8">
                                                        <TextBlock Text="LAST DRILL VERIFICATION" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                                        <Border HorizontalAlignment="Right" Background="#E2E8F0" CornerRadius="6" Padding="8,2">
                                                            <TextBlock Text="{Binding DrillRtoDisplay}" FontWeight="Bold" FontSize="11.5" Foreground="#334155"/>
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Text="{Binding DrillStatusDisplay}" FontWeight="Bold" FontSize="13.5" Foreground="{Binding DrillStatusColor}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Drill Action Button -->
                                            <Button Style="{StaticResource SecondaryButton}" Height="38" Margin="0,0,0,12" Command="{Binding ExecuteRestoreDrillCommand}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource PrimaryBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Run Sandbox Restore Drill (DBCC CHECKDB)" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Button>

                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,14"/>

                                            <TextBlock Text="Drill Safety Assurances:" FontWeight="Bold" FontSize="12.5" Margin="0,0,0,6"/>
                                            <TextBlock Text="• Isolated database prefix: ub_drill_*" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                            <TextBlock Text="• Zero production database impact" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                            <TextBlock Text="• Full physical &amp; logical DBCC CHECKDB verification" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                            <TextBlock Text="• Clean tear-down in finally block guarantees zero residue" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- ============================================== -->
                        <!-- 2. CLOUD FILE ARCHIVES (Existing)              -->
                        <!-- ============================================== -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedRecoveryTab}" Value="CloudArchives">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Header Information Banner -->
                            <Border Grid.Row="0" Style="{StaticResource ModernCard}" Margin="0,0,0,14" Padding="18">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Cloud Disaster Recovery Explorer" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Browse snapshots stored in AWS S3 or Google Drive. Extract files with full integrity and permission preservation." FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Command="{Binding RefreshRecoveryCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource PrimaryBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                            <TextBlock Text="Refresh Cloud Snapshots"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Cloud Archives DataGrid -->
                            <Border Grid.Row="1" Style="{StaticResource ModernCard}" Margin="0,0,0,14" Padding="12">
                                <DataGrid ItemsSource="{Binding CloudArchives}" SelectedItem="{Binding SelectedArchive}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="DESTINATION" Binding="{Binding Destination}" Width="100"/>
                                        <DataGridTextColumn Header="ARCHIVE PACKAGE" Binding="{Binding DisplayName}" Width="280"/>
                                        <DataGridTextColumn Header="CLOUD FOLDER" Binding="{Binding CloudFolder}" Width="220"/>
                                        <DataGridTextColumn Header="LAST MODIFIED" Binding="{Binding LastModified, StringFormat=\{0:yyyy-MM-dd HH:mm\}}" Width="150"/>
                                        <DataGridTextColumn Header="SIZE (BYTES)" Binding="{Binding SizeBytes}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <!-- Extraction Options & Action Card -->
                            <Border Grid.Row="2" Style="{StaticResource ModernCard}" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="Restore Destination &amp; Collision Handling" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding RestoreDestinationPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Click="BrowseRestoreDir_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconFolderOpen}" Fill="{StaticResource PrimaryBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                                <TextBlock Text="Browse Target..."/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Write Mode:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold" FontSize="13"/>
                                            <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding RestoreWriteMode}" Width="180" Height="34">
                                                <ComboBoxItem Content="Safe (Create New Folder)" Tag="safe" IsSelected="True"/>
                                                <ComboBoxItem Content="Overwrite All Files" Tag="overwrite"/>
                                                <ComboBoxItem Content="Missing Files Only" Tag="missing"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Command="{Binding ExecuteRestoreCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconDownload}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                                                <TextBlock Text="Restore Selected Archive" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ============================================== -->
                <!-- 4. APPLICATION LOGS TAB (Referenced Design!)   -->
                <!-- ============================================== -->
                <Grid x:Name="LogsTabContent" Style="{StaticResource AnimatedTabContent}" Visibility="Collapsed" DataContext="{Binding Logs}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Log File Browser -->
                    <Border Grid.Column="0" Style="{StaticResource ModernCard}" Padding="0" Margin="0,0,14,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Search Filter Header -->
                            <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0">
                                        <TextBox x:Name="FileFilterInput" Text="{Binding FileFilter, UpdateSourceTrigger=PropertyChanged}" 
                                                 Padding="26,6,8,6" FontSize="12" VerticalContentAlignment="Center" ToolTip="Filter log files by date or name"/>
                                        <Path Data="{StaticResource IconSearch}" Fill="#94A3B8" Width="12" Height="12" Stretch="Uniform"
                                              HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False"/>
                                        <TextBlock Text="Filter files..." FontSize="12" Foreground="#94A3B8"
                                                   VerticalAlignment="Center" Margin="28,0,0,0" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding FileFilter}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding FileFilter}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <Border Grid.Column="1" Background="{StaticResource BrandTintBlueSoft}" CornerRadius="10" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding VisibleFiles.Count}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrandTintBlueDeep}"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Toggles -->
                            <StackPanel Grid.Row="1" Margin="12,8,12,8">
                                <CheckBox Content="Only files with errors/warnings" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" IsChecked="{Binding ProblemsOnly}" Margin="0,0,0,4"/>
                                <CheckBox Content="Show legacy/archived logs" FontSize="11" Foreground="{StaticResource TextMutedBrush}" IsChecked="{Binding ShowArchivedLogs}"/>
                            </StackPanel>

                            <!-- Log Files List -->
                            <ListBox Grid.Row="2" ItemsSource="{Binding VisibleFiles}" SelectedItem="{Binding SelectedFile}"
                                     BorderThickness="0" Background="Transparent" Padding="4">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,9" Margin="0,0,0,5" CornerRadius="8" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Icon Chip -->
                                                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="7" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource BrandTintBlueSoft}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Kind}" Value="Service">
                                                                    <Setter Property="Background" Value="{StaticResource BrandTintPurpleSoft}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Kind}" Value="Archived">
                                                                    <Setter Property="Background" Value="#F1F5F9"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <Path Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <Setter Property="Data" Value="{StaticResource IconBackups}"/>
                                                                <Setter Property="Fill" Value="{StaticResource BrandTintBlueDeep}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="Service">
                                                                        <Setter Property="Data" Value="{StaticResource IconSettings}"/>
                                                                        <Setter Property="Fill" Value="{StaticResource BrandTintPurpleDeep}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="Archived">
                                                                        <Setter Property="Data" Value="{StaticResource IconDocumentText}"/>
                                                                        <Setter Property="Fill" Value="{StaticResource TextMutedBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                </Border>

                                                <!-- Title, Subtitle, Tags -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,6,0">
                                                    <TextBlock Text="{Binding DisplayTitle}" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <!-- Source Pill -->
                                                        <Border CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{StaticResource BrandTintBlueSoft}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="Service">
                                                                            <Setter Property="Background" Value="{StaticResource BrandTintPurpleSoft}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="Archived">
                                                                            <Setter Property="Background" Value="#F1F5F9"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding Source}" FontSize="9.5" FontWeight="SemiBold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource BrandTintBlueDeep}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Kind}" Value="Service">
                                                                                <Setter Property="Foreground" Value="{StaticResource BrandTintPurpleDeep}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Kind}" Value="Archived">
                                                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>

                                                        <TextBlock Text="{Binding Clock}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Badges & Size -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding Size}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" Margin="0,0,0,3"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <!-- Error Badge -->
                                                        <Border Background="{StaticResource BrandDangerSoft}" CornerRadius="4" Padding="5,1" Margin="0,0,4,0"
                                                                Visibility="{Binding HasErrors, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{Binding Errors, StringFormat=\{0\} err}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource BrandDangerDeep}"/>
                                                        </Border>

                                                        <!-- Warning Badge -->
                                                        <Border Background="{StaticResource BrandTintAmberSoft}" CornerRadius="4" Padding="5,1"
                                                                Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{Binding Warnings, StringFormat=\{0\} wrn}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource BrandTintAmberDeep}"/>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Right Column: Rich Log Viewer Pane (Reference Design) -->
                    <Border Grid.Column="1" Style="{StaticResource ModernCard}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Viewer Top Bar -->
                            <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,12">
                                <Grid>
                                    <!-- Title & Stats -->
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedFile.Name, FallbackValue='Select a log file'}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0">
                                            <Run Text="{Binding LineCount, Mode=OneWay}"/>
                                            <Run Text=" lines · "/>
                                            <Run Text="{Binding SelectedFile.Size, Mode=OneWay}"/>
                                            <Run Text=" · last written "/>
                                            <Run Text="{Binding SelectedFile.Clock, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Action Buttons -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Style="{StaticResource CrispToolButton}" Margin="0,0,8,0" Command="{Binding CopyAllCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconCopy}" Fill="{StaticResource PrimaryBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                                <TextBlock Text="Copy all"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Style="{StaticResource CrispToolButton}" Margin="0,0,8,0" Command="{Binding OpenInNotepadCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconDocumentText}" Fill="{StaticResource PrimaryBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                                <TextBlock Text="Open in Notepad"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Style="{StaticResource CrispToolButton}" Command="{Binding OpenFolderCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconFolder}" Fill="{StaticResource BrandTintAmberDeep}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                                <TextBlock Text="Logs folder"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Filter & Problem Navigation Row (Reference Design) -->
                            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,8">
                                <Grid>
                                    <!-- Left: Dynamic Level Filter Chips with Counts -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <!-- All chip -->
                                        <RadioButton IsChecked="{Binding ShowAll, Mode=OneWay}" GroupName="LvlGroup" 
                                                     Style="{StaticResource FilterChipStyle}" Margin="0,0,6,0" 
                                                     Command="{Binding SetLevelFilterCommand}" CommandParameter="ALL">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconLayers}" Fill="{StaticResource PrimaryBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="All" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>

                                        <!-- Errors chip with count -->
                                        <RadioButton GroupName="LvlGroup" IsChecked="{Binding ShowErrors, Mode=OneWay}"
                                                     Style="{StaticResource FilterChipStyle}" Margin="0,0,6,0" 
                                                     Command="{Binding SetLevelFilterCommand}" CommandParameter="ERR">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconCloseCircle}" Fill="#DC2626" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Errors" VerticalAlignment="Center"/>
                                                <Border Background="#FEE2E2" CornerRadius="8" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ErrorCount}" FontSize="10" FontWeight="Bold" Foreground="#DC2626"/>
                                                </Border>
                                            </StackPanel>
                                        </RadioButton>

                                        <!-- Warnings chip with count -->
                                        <RadioButton GroupName="LvlGroup" IsChecked="{Binding ShowWarnings, Mode=OneWay}"
                                                     Style="{StaticResource FilterChipStyle}" Margin="0,0,6,0" 
                                                     Command="{Binding SetLevelFilterCommand}" CommandParameter="WRN">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconWarningCircle}" Fill="#B45309" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Warnings" VerticalAlignment="Center"/>
                                                <Border Background="#FEF3C7" CornerRadius="8" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding WarningCount}" FontSize="10" FontWeight="Bold" Foreground="#B45309"/>
                                                </Border>
                                            </StackPanel>
                                        </RadioButton>

                                        <!-- Info chip with count -->
                                        <RadioButton GroupName="LvlGroup" IsChecked="{Binding ShowInfo, Mode=OneWay}"
                                                     Style="{StaticResource FilterChipStyle}" 
                                                     Command="{Binding SetLevelFilterCommand}" CommandParameter="INF">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconInfoCircle}" Fill="#0D9488" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Info" VerticalAlignment="Center"/>
                                                <Border Background="#E6FFFA" CornerRadius="8" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding InfoCount}" FontSize="10" FontWeight="Bold" Foreground="#0D9488"/>
                                                </Border>
                                            </StackPanel>
                                        </RadioButton>
                                    </StackPanel>

                                    <!-- Right: Problem Walking (Previous / Next with crisp buttons & highlight jump) -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <!-- Problems Count Label -->
                                        <TextBlock Text="{Binding ProblemLabel}" FontSize="12" FontWeight="SemiBold" 
                                                   Foreground="#475569" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                        <!-- Previous Button -->
                                        <Button Style="{StaticResource CrispProblemPrevButton}" 
                                                Margin="0,0,6,0" Command="{Binding PreviousProblemCommand}"
                                                ToolTip="Jump to previous error/warning line">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconChevronLeft}" Fill="#64748B" Width="9" Height="9" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Previous" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Next Button (Active Golden Accent Border as in Image 2!) -->
                                        <Button Style="{StaticResource CrispProblemNextButton}" 
                                                Command="{Binding NextProblemCommand}"
                                                ToolTip="Jump to next error/warning line">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Next" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <Path Data="{StaticResource IconChevronRight}" Fill="#B45309" Width="9" Height="9" Stretch="Uniform" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Find In This Log Bar -->
                            <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="280"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0">
                                        <TextBox x:Name="SearchInLogInput" Text="{Binding SearchInLog, UpdateSourceTrigger=PropertyChanged}" 
                                                 Height="32" Padding="28,4,8,4" FontSize="12" VerticalContentAlignment="Center" ToolTip="Type keyword to search in active log"/>
                                        <Path Data="{StaticResource IconSearch}" Fill="#94A3B8" Width="12" Height="12" Stretch="Uniform"
                                              HorizontalAlignment="Left" VerticalAlignment="Center" Margin="9,0,0,0" IsHitTestVisible="False"/>
                                        <TextBlock Text="Find in this log..." FontSize="12" Foreground="#94A3B8"
                                                   VerticalAlignment="Center" Margin="30,0,0,0" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SearchInLog}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SearchInLog}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <Button Grid.Column="1" Style="{StaticResource CrispToolButton}" 
                                            Height="32" Margin="6,0,0,0" Command="{Binding FindNextCommand}" ToolTip="Find next occurrence">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconSearch}" Fill="{StaticResource PrimaryBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0"/>
                                            <TextBlock Text="Find"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Column="3" Style="{StaticResource CrispToolButton}" Height="32" 
                                            Command="{Binding RefreshLogsCommand}" ToolTip="Reload active log from disk">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource PrimaryBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0"/>
                                            <TextBlock Text="Refresh"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Log Viewer Lines List -->
                            <ListBox x:Name="LogViewerList" Grid.Row="3" ItemsSource="{Binding VisibleLines}"
                                     BorderThickness="0" Background="#FFFFFF" Padding="6,4"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.ScrollUnit="Pixel"
                                     ScrollViewer.CanContentScroll="True"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto" 
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="4,2" Margin="0,1" BorderThickness="1" BorderBrush="Transparent">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                                            <Setter Property="Background" Value="#FEF2F2"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                            <Setter Property="Background" Value="#FFFBEB"/>
                                                        </DataTrigger>
                                                        
                                                        <!-- Highlighted Problem Line (Warm Golden Selection as in Image 2!) -->
                                                        <DataTrigger Binding="{Binding Highlighted}" Value="True">
                                                            <Setter Property="Background" Value="#FEF9C3"/>
                                                            <Setter Property="BorderBrush" Value="#F59E0B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="38"/>
                                                    <ColumnDefinition Width="76"/>
                                                    <ColumnDefinition Width="42"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- 1. Line Number (Tabular Monospace, High-Contrast) -->
                                                <TextBlock Grid.Column="0" Text="{Binding Number}" 
                                                           FontFamily="{StaticResource BrandFontMono}" 
                                                           FontSize="11" Foreground="#475569" 
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" 
                                                           Margin="0,0,8,0"/>

                                                <!-- 2. Crisp, Dark, Tabular Timestamp (Slate 900 - Highly Clear & Visible!) -->
                                                <TextBlock Grid.Column="1" Text="{Binding Time}" 
                                                           FontFamily="{StaticResource BrandFontMono}" 
                                                           FontSize="12" FontWeight="SemiBold" 
                                                           Foreground="#0F172A" VerticalAlignment="Center" 
                                                           Margin="0,0,8,0"
                                                           Visibility="{Binding HasTime, Converter={StaticResource BoolToVis}}"/>

                                                <!-- Subtle Stack Trace Indent Indicator -->
                                                <TextBlock Grid.Column="1" Text="↳" 
                                                           FontFamily="{StaticResource BrandFontMono}" 
                                                           FontSize="12" FontWeight="Bold" Foreground="#94A3B8"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasTime}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                    <Setter Property="Foreground" Value="#F87171"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- 3. Level Pill (Only when HasLevel is True - No phantom empty boxes!) -->
                                                <Border Grid.Column="2" CornerRadius="4" Height="19" MinWidth="34" VerticalAlignment="Center" Margin="0,0,8,0"
                                                        Visibility="{Binding HasLevel, Converter={StaticResource BoolToVis}}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#E6FFFA"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Level}" Value="INF">
                                                                    <Setter Property="Background" Value="#E6FFFA"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Level}" Value="WRN">
                                                                    <Setter Property="Background" Value="#FEF3C7"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Level}" Value="ERR">
                                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Level}" FontFamily="{StaticResource BrandFontMono}" FontSize="9.5" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#0D9488"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Level}" Value="INF">
                                                                        <Setter Property="Foreground" Value="#0D9488"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Level}" Value="WRN">
                                                                        <Setter Property="Foreground" Value="#B45309"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Level}" Value="ERR">
                                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <!-- 4. Log Message Text with Syntax Coloring -->
                                                <TextBlock Grid.Column="3" Text="{Binding Message}" 
                                                           FontFamily="{StaticResource BrandFontMono}" 
                                                           FontSize="12" VerticalAlignment="Center" 
                                                           TextWrapping="NoWrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#0F172A"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                    <Setter Property="Foreground" Value="#991B1B"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                                    <Setter Property="Foreground" Value="#B45309"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                                                    <Setter Property="Foreground" Value="#047857"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Highlighted}" Value="True">
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                    <Setter Property="Foreground" Value="#0F172A"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Status Footer Bar -->
                            <Border Grid.Row="4" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,6">
                                <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ============================================== -->
                <!-- 5. NOTIFICATIONS & INCIDENT ALERTS TAB         -->
                <!-- ============================================== -->
                <ScrollViewer x:Name="NotificationsTabContent" Style="{StaticResource AnimatedTabContent}" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,6,0,24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Row 0: Header with Description & Server badge -->
                            <RowDefinition Height="Auto"/>
                            <!-- Row 1: Segmented Sub-Tab Switcher (Email, Slack, Discord, Telegram, Teams, Matrix) -->
                            <RowDefinition Height="Auto"/>
                            <!-- Row 2: Sub-Tab Content -->
                            <RowDefinition Height="*"/>
                            <!-- Row 3: Bottom Action Bar (Save Notifications) -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                    <Border Width="26" Height="26" CornerRadius="6" Background="#881337" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconBell}" Fill="#FB7185" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Notifications &amp; Incident Alerts" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <TextBlock Text="Configure multi-channel notifications for automated backup success, warnings, failure alerts, and heartbeat telemetry."
                                           FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <Border Grid.Column="1" Background="#F1F5F9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ServerLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Row 1: Segmented Sub-Tab Switcher -->
                        <Border Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,20" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="5">
                            <WrapPanel Orientation="Horizontal" MaxWidth="1100">
                                <!-- 1. Email (Purple) -->
                                <RadioButton Content="Email (SMTP)" GroupName="NotifSubTabs"
                                             Style="{StaticResource NotifSubTabEmail}"
                                             Command="{Binding SelectNotificationTabCommand}" CommandParameter="Email"/>

                                <!-- 2. Slack (Emerald) -->
                                <RadioButton Content="Slack" GroupName="NotifSubTabs"
                                             Style="{StaticResource NotifSubTabSlack}"
                                             Command="{Binding SelectNotificationTabCommand}" CommandParameter="Slack"/>

                                <!-- 3. Discord (Blurple) -->
                                <RadioButton Content="Discord" GroupName="NotifSubTabs"
                                             Style="{StaticResource NotifSubTabDiscord}"
                                             Command="{Binding SelectNotificationTabCommand}" CommandParameter="Discord"/>

                                <!-- 4. Telegram (Sky Blue) -->
                                <RadioButton Content="Telegram" GroupName="NotifSubTabs"
                                             Style="{StaticResource NotifSubTabTelegram}"
                                             Command="{Binding SelectNotificationTabCommand}" CommandParameter="Telegram"/>

                                <!-- 5. Microsoft Teams (Violet) -->
                                <RadioButton Content="Teams" GroupName="NotifSubTabs"
                                             Style="{StaticResource NotifSubTabTeams}"
                                             Command="{Binding SelectNotificationTabCommand}" CommandParameter="Teams"/>

                                <!-- 6. Pushover (Amber Orange) -->
                                <RadioButton Content="Pushover" GroupName="NotifSubTabs"
                                             Style="{StaticResource NotifSubTabPushover}"
                                             Command="{Binding SelectNotificationTabCommand}" CommandParameter="Pushover"/>

                                <!-- 7. ntfy.sh (Sky Blue) -->
                                <RadioButton Content="ntfy.sh" GroupName="NotifSubTabs"
                                             Style="{StaticResource NotifSubTabNtfy}"
                                             Command="{Binding SelectNotificationTabCommand}" CommandParameter="Ntfy"/>

                                <!-- 8. PagerDuty (Forest Green) -->
                                <RadioButton Content="PagerDuty" GroupName="NotifSubTabs"
                                             Style="{StaticResource NotifSubTabPagerDuty}"
                                             Command="{Binding SelectNotificationTabCommand}" CommandParameter="PagerDuty"/>

                                <!-- 9. Custom Webhook (Indigo) -->
                                <RadioButton Content="Webhook" GroupName="NotifSubTabs"
                                             Style="{StaticResource NotifSubTabWebhook}"
                                             Command="{Binding SelectNotificationTabCommand}" CommandParameter="Webhook"/>

                                <!-- 10. Trigger Matrix & Heartbeat (Rose) -->
                                <RadioButton Content="Rules &amp; Heartbeat" GroupName="NotifSubTabs"
                                             Style="{StaticResource NotifSubTabRules}"
                                             Command="{Binding SelectNotificationTabCommand}" CommandParameter="Matrix"/>
                            </WrapPanel>
                        </Border>

                        <!-- Row 2: Sub-Tab Content -->
                        <Grid Grid.Row="2" Margin="0,0,0,20">
                            <!-- ============================================== -->
                            <!-- SUB-TAB 1: EMAIL (SMTP & OAuth)                -->
                            <!-- ============================================== -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedNotificationTab}" Value="Email">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <!-- Email Configuration Card -->
                                <Border Style="{StaticResource ModernCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="26" Height="26" CornerRadius="6" Background="#F5F3FF" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource IconMail}" Fill="#7C3AED" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="EMAIL DISPATCH CONFIGURATION" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Content="Enable Email Alerts" IsChecked="{Binding Config.Email.Enabled}" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                        </Grid>

                                        <!-- Email Provider Radio buttons -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                            <RadioButton Content="Custom SMTP" GroupName="EmailProviderChoice" IsChecked="True" FontWeight="SemiBold" Margin="0,0,24,0"/>
                                            <RadioButton Content="Gmail (OAuth)" GroupName="EmailProviderChoice" FontWeight="SemiBold" Margin="0,0,24,0" IsEnabled="False"/>
                                            <RadioButton Content="Microsoft 365 (OAuth)" GroupName="EmailProviderChoice" FontWeight="SemiBold" IsEnabled="False"/>
                                        </StackPanel>

                                        <!-- SMTP Host & Port -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3*"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBlock Text="SMTP Host" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding Config.Email.SmtpHost, UpdateSourceTrigger=PropertyChanged}" Height="36" VerticalContentAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Port" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding Config.Email.SmtpPort, UpdateSourceTrigger=PropertyChanged}" Height="36" VerticalContentAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Username -->
                                        <StackPanel Margin="0,0,0,12">
                                            <TextBlock Text="Username (authentication sender account)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding Config.Email.Username, UpdateSourceTrigger=PropertyChanged}" Height="36" VerticalContentAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Password with Eye Toggle -->
                                        <StackPanel Margin="0,0,0,12">
                                            <TextBlock Text="Password (login credentials — encrypted securely when saved)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Height="36">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="38"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="SmtpPasswordVisibleInput" Grid.Column="0"
                                                             Text="{Binding Config.Email.Password, UpdateSourceTrigger=PropertyChanged}"
                                                             BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="10,0"
                                                             Visibility="{Binding IsSmtpPasswordVisible, Converter={StaticResource BoolToVis}}"/>
                                                    <PasswordBox x:Name="SmtpPasswordInput" Grid.Column="0"
                                                                 BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="10,0"
                                                                 Visibility="{Binding IsSmtpPasswordVisible, Converter={StaticResource InverseBoolToVis}}"
                                                                 PasswordChanged="SmtpPasswordInput_PasswordChanged"/>
                                                    <Button Grid.Column="1" Width="32" Height="32" Margin="0,0,3,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Background="Transparent" BorderThickness="0" Cursor="Hand" Focusable="False"
                                                            Command="{Binding ToggleSmtpPasswordVisibilityCommand}" ToolTip="Show / Hide Password">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="6">
                                                                                <Path x:Name="EyeIcon" Data="{StaticResource IconEye}" Fill="{StaticResource TextSecondaryBrush}" Width="16" Height="16" Stretch="Uniform"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                                                                                </Trigger>
                                                                                <DataTrigger Binding="{Binding IsSmtpPasswordVisible}" Value="True">
                                                                                    <Setter TargetName="EyeIcon" Property="Data" Value="{StaticResource IconEyeOff}"/>
                                                                                    <Setter TargetName="EyeIcon" Property="Fill" Value="{StaticResource PrimaryBrush}"/>
                                                                                </DataTrigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </StackPanel>

                                        <!-- Use TLS -->
                                        <CheckBox Content="Use TLS (STARTTLS)" IsChecked="{Binding Config.Email.UseTls}" FontWeight="SemiBold" Margin="0,0,0,16"/>

                                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,16"/>

                                        <!-- From Address -->
                                        <StackPanel Margin="0,0,0,14">
                                            <TextBlock Text="From Address (sender display email)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding Config.Email.FromAddress, UpdateSourceTrigger=PropertyChanged}" Height="36" VerticalContentAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Recipients (comma separated) -->
                                        <StackPanel Margin="0,0,0,16">
                                            <TextBlock Text="Recipients (comma or semicolon separated)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding EmailRecipientsText, UpdateSourceTrigger=PropertyChanged}" Height="36" VerticalContentAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Triggers -->
                                        <StackPanel Margin="0,0,0,16">
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" Content="Send email on success" IsChecked="{Binding Config.Email.NotifyOnSuccess}" FontWeight="SemiBold"/>
                                                <CheckBox Grid.Column="1" Content="Send email on failure" IsChecked="{Binding Config.Email.NotifyOnFailure}" FontWeight="SemiBold"/>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
