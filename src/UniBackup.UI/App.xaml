<Application x:Class="UniBackup.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:UniBackup.UI.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Tokens must be merged first -->
                <ResourceDictionary Source="pack://application:,,,/UniBackup;component/Themes/Tokens.xaml"/>
                <!-- Active Theme (Light by default, switched dynamically) -->
                <ResourceDictionary Source="pack://application:,,,/UniBackup;component/Themes/Light.xaml"/>
                <!-- Reusable Controls & Component Styles -->
                <ResourceDictionary Source="pack://application:,,,/UniBackup;component/Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
            <conv:BytesToStringConverter x:Key="BytesToStringConverter"/>
            <conv:RelativeTimeConverter x:Key="RelativeTimeConverter"/>
            <conv:DurationConverter x:Key="DurationConverter"/>
            <conv:StatusToBrushConverter x:Key="StatusToBrushConverter"/>
            <conv:StatusToGlyphConverter x:Key="StatusToGlyphConverter"/>
            <conv:KindToBrushConverter x:Key="KindToBrushConverter"/>
            <conv:RatioToWidthConverter x:Key="RatioToWidthConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
