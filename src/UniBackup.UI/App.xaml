            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedNotificationTab}" Value="Webhook">
                    <Setter Property="IsChecked" Value="True"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

