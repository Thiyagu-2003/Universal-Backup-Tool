            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedNotificationTab}" Value="PagerDuty">
                    <Setter Property="IsChecked" Value="True"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

