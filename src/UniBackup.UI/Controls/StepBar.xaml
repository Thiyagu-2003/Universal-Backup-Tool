<UserControl x:Class="UniBackup.UI.Controls.StepBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Background="{DynamicResource BrushPanel}"
            BorderBrush="{DynamicResource BrushLine}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusCard}"
            SnapsToDevicePixels="True">
        <UniformGrid Columns="4" Rows="1">
            <!-- Step 1: Source -->
            <Button x:Name="Step1Button" Click="Step_Click" Tag="1"
                    Background="Transparent" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource BrushLine}"
                    Padding="16,14" Cursor="Hand" FocusVisualStyle="{StaticResource UniBackupFocusVisual}">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- 26 px Circle -->
                                <Border x:Name="circle" Width="26" Height="26" CornerRadius="13"
                                        Background="{DynamicResource BrushSunken}" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <Grid>
                                        <TextBlock x:Name="stepNum" Text="1" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBadge}"
                                                   Foreground="{DynamicResource BrushInkMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Path x:Name="checkIcon" Data="{StaticResource IconCheck}" Fill="#FFFFFF" Width="12" Height="12"
                                              Stretch="Uniform" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="title" Text="Source" FontWeight="SemiBold" FontSize="{StaticResource FontSizeRowTitle}"
                                               Foreground="{DynamicResource BrushInkMuted}"/>
                                    <TextBlock Text="What to back up" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkFaint}" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Step 2: Schedule -->
            <Button x:Name="Step2Button" Click="Step_Click" Tag="2"
                    Background="Transparent" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource BrushLine}"
                    Padding="16,14" Cursor="Hand" FocusVisualStyle="{StaticResource UniBackupFocusVisual}">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="circle" Width="26" Height="26" CornerRadius="13"
                                        Background="{DynamicResource BrushSunken}" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <Grid>
                                        <TextBlock x:Name="stepNum" Text="2" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBadge}"
                                                   Foreground="{DynamicResource BrushInkMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Path x:Name="checkIcon" Data="{StaticResource IconCheck}" Fill="#FFFFFF" Width="12" Height="12"
                                              Stretch="Uniform" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="title" Text="Schedule" FontWeight="SemiBold" FontSize="{StaticResource FontSizeRowTitle}"
                                               Foreground="{DynamicResource BrushInkMuted}"/>
                                    <TextBlock Text="When to run" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkFaint}" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Step 3: Destinations -->
            <Button x:Name="Step3Button" Click="Step_Click" Tag="3"
                    Background="Transparent" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource BrushLine}"
                    Padding="16,14" Cursor="Hand" FocusVisualStyle="{StaticResource UniBackupFocusVisual}">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="circle" Width="26" Height="26" CornerRadius="13"
                                        Background="{DynamicResource BrushSunken}" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <Grid>
                                        <TextBlock x:Name="stepNum" Text="3" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBadge}"
                                                   Foreground="{DynamicResource BrushInkMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Path x:Name="checkIcon" Data="{StaticResource IconCheck}" Fill="#FFFFFF" Width="12" Height="12"
                                              Stretch="Uniform" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="title" Text="Destinations" FontWeight="SemiBold" FontSize="{StaticResource FontSizeRowTitle}"
                                               Foreground="{DynamicResource BrushInkMuted}"/>
                                    <TextBlock Text="Where to store" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkFaint}" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Step 4: Options -->
            <Button x:Name="Step4Button" Click="Step_Click" Tag="4"
                    Background="Transparent" BorderThickness="0"
                    Padding="16,14" Cursor="Hand" FocusVisualStyle="{StaticResource UniBackupFocusVisual}">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="circle" Width="26" Height="26" CornerRadius="13"
                                        Background="{DynamicResource BrushSunken}" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <Grid>
                                        <TextBlock x:Name="stepNum" Text="4" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBadge}"
                                                   Foreground="{DynamicResource BrushInkMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Path x:Name="checkIcon" Data="{StaticResource IconCheck}" Fill="#FFFFFF" Width="12" Height="12"
                                              Stretch="Uniform" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="title" Text="Options" FontWeight="SemiBold" FontSize="{StaticResource FontSizeRowTitle}"
                                               Foreground="{DynamicResource BrushInkMuted}"/>
                                    <TextBlock Text="Retention &amp; encryption" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkFaint}" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </UniformGrid>
    </Border>
</UserControl>
