<UserControl x:Class="UniBackup.UI.Controls.StatusDot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="16" Height="16" x:Name="Root">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <!-- Pulsing Ring -->
        <Border x:Name="PulseRing" Width="8" Height="8" CornerRadius="4"
                BorderBrush="{Binding DotBrush, ElementName=Root}"
                BorderThickness="1.5"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="PulseScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
        </Border>

        <!-- Solid Center Dot (8x8) -->
        <Border Width="8" Height="8" CornerRadius="4"
                Background="{Binding DotBrush, ElementName=Root}"
                HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</UserControl>
