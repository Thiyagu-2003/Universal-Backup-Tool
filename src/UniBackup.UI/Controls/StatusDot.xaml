<UserControl x:Class="UniBackup.UI.Controls.StatusDot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="20" Height="20" x:Name="Root"
             SnapsToDevicePixels="True">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <!-- Pulsing Ring (Geometric Circle 13 px) -->
        <Ellipse x:Name="PulseRing" Width="13" Height="13" Stretch="Uniform"
                 Stroke="{Binding DotBrush, ElementName=Root}"
                 StrokeThickness="1.5"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="PulseScale" ScaleX="1" ScaleY="1"/>
            </Ellipse.RenderTransform>
        </Ellipse>

        <!-- Solid Center Dot (Geometric Circle 13 px) -->
        <Ellipse Width="13" Height="13" Stretch="Uniform"
                 Fill="{Binding DotBrush, ElementName=Root}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</UserControl>
