<UserControl x:Class="UniBackup.UI.Controls.KpiCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Style="{StaticResource Card}" MinHeight="104" SnapsToDevicePixels="True" ClipToBounds="True">
        <Grid>
            <!-- Background Sparkline bleeding into bottom-right corner at 65% opacity -->
            <Canvas HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="140" Height="50" IsHitTestVisible="False" Opacity="0.55">
                <Polyline x:Name="SparklinePolyline"
                          Stroke="{Binding TileBrush, ElementName=Root}"
                          StrokeThickness="2"
                          StrokeLineJoin="Round"/>
            </Canvas>

            <Grid Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 40 px Coloured Icon Tile (22 px Icon) -->
                <Border Width="40" Height="40"
                        CornerRadius="10"
                        Background="{Binding TileBrush, ElementName=Root}"
                        VerticalAlignment="Top"
                        Margin="0,2,14,0">
                    <Path Data="{Binding Icon, ElementName=Root}"
                          Fill="#FFFFFF"
                          Width="22" Height="22"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Border>

                <!-- Value, Title, and Subtitle -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title, ElementName=Root}"
                               FontWeight="SemiBold"
                               FontSize="{StaticResource FontSizeFieldLabel}"
                               Foreground="{DynamicResource BrushInkMuted}"/>

                    <!-- 28 / 600 KPI Value -->
                    <TextBlock x:Name="ValueTextBlock"
                               Text="{Binding Value, ElementName=Root}"
                               FontWeight="SemiBold"
                               FontSize="{StaticResource FontSizeKpi}"
                               Foreground="{DynamicResource BrushInk}"
                               Margin="0,2,0,0"/>

                    <TextBlock Text="{Binding SubText, ElementName=Root}"
                               FontSize="{StaticResource FontSizeHelp}"
                               Foreground="{DynamicResource BrushInkFaint}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
