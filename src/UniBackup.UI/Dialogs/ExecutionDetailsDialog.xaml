<Window x:Class="UniBackup.UI.Dialogs.ExecutionDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:UniBackup.UI.ViewModels"
        Title="Backup Execution Details"
        Width="780" Height="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SnapsToDevicePixels="True"
        KeyDown="Window_KeyDown">

    <Border Background="Transparent" Padding="20">
        <Border x:Name="DialogCard"
                Background="{DynamicResource BrushPanel}"
                BorderBrush="{DynamicResource BrushLine}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusDialog}"
                Effect="{StaticResource Sh3}"
                ClipToBounds="True"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="DialogScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="*"/>    <!-- Content -->
                    <RowDefinition Height="Auto"/> <!-- Footer -->
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,0,0,1" Padding="24,18" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon Tile -->
                        <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource BrushCobaltSoft}" VerticalAlignment="Center" Margin="0,0,14,0">
                            <Path Data="{StaticResource IconClock}" Fill="{DynamicResource BrushCobalt}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding JobName}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSectionHeader}" Foreground="{DynamicResource BrushInk}"/>
                            <TextBlock Text="{Binding TimestampDisplay, StringFormat='{}Executed on {0}'}" FontSize="{StaticResource FontSizeHelp}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Status Badge -->
                        <Border Grid.Column="2" Style="{StaticResource BadgePill}" Background="{Binding StatusSoftBrush}" VerticalAlignment="Center" Padding="10,4" Margin="0,0,14,0">
                            <TextBlock Text="{Binding StatusDisplay}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeStatus}" Foreground="{Binding StatusBrush}"/>
                        </Border>

                        <!-- Close Button -->
                        <Button Grid.Column="3" Click="Close_Click" Style="{StaticResource IconBtn}" Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconDismiss}" Fill="{DynamicResource BrushInkMuted}" Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Content Body -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20">
                    <StackPanel>

                        <!-- Key Metrics Grid -->
                        <Border BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="10" Background="{DynamicResource BrushRaised}" Padding="18,14" Margin="0,0,0,18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Metric 1: Backup Type -->
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="Backup Type" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkMuted}"/>
                                    <TextBlock Text="{Binding BackupTypeDisplay}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeRowTitle}" Foreground="{DynamicResource BrushInk}" Margin="0,3,0,0"/>
                                </StackPanel>

                                <!-- Metric 2: Archive Size -->
                                <StackPanel Grid.Row="0" Grid.Column="1">
                                    <TextBlock Text="Total Size" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkMuted}"/>
                                    <TextBlock Text="{Binding SizeDisplay}" FontFamily="{StaticResource FontFamilyMono}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeRowTitle}" Foreground="{DynamicResource BrushInk}" Margin="0,3,0,0"/>
                                </StackPanel>

                                <!-- Metric 3: Duration -->
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="Execution Duration" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkMuted}"/>
                                    <TextBlock Text="{Binding DurationDisplay}" FontFamily="{StaticResource FontFamilyMono}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeRowTitle}" Foreground="{DynamicResource BrushInk}" Margin="0,3,0,0"/>
                                </StackPanel>

                                <!-- Metric 4: Trigger -->
                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <TextBlock Text="Trigger Source" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkMuted}"/>
                                    <TextBlock Text="{Binding Trigger}" FontWeight="Medium" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushInk}" Margin="0,3,0,0"/>
                                </StackPanel>

                                <!-- Metric 5: Archive File -->
                                <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2">
                                    <TextBlock Text="Archive Name" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkMuted}"/>
                                    <TextBlock Text="{Binding ArchiveName}" FontFamily="{StaticResource FontFamilyMono}" FontSize="{StaticResource FontSizeMono}" Foreground="{DynamicResource BrushInkMuted}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Error Message Alert Box (if present) -->
                        <Border Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}" Background="{DynamicResource BrushCoralSoft}" BorderBrush="{DynamicResource BrushCoral}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="Execution Error / Diagnostic Details" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushCoral}"/>
                                <TextBox Text="{Binding ErrorMessage, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" FontFamily="{StaticResource FontFamilyMono}" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInk}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Source Folder / Resource Details -->
                        <TextBlock Text="Source Configuration" FontWeight="SemiBold" FontSize="{StaticResource FontSizeRowTitle}" Foreground="{DynamicResource BrushInk}" Margin="0,0,0,8"/>
                        <Border BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Source Folder / Target: " FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}"/>
                                <TextBlock Grid.Column="1" Text="{Binding SourceFolder}" FontFamily="{StaticResource FontFamilyMono}" FontSize="{StaticResource FontSizeMono}" Foreground="{DynamicResource BrushInk}" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Border>

                        <!-- Destination Upload Breakdown -->
                        <TextBlock Text="Cloud Storage Destinations" FontWeight="SemiBold" FontSize="{StaticResource FontSizeRowTitle}" Foreground="{DynamicResource BrushInk}" Margin="0,0,0,8"/>
                        <DataGrid ItemsSource="{Binding Destinations}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" Background="Transparent" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" Margin="0,0,0,18" RowHeight="32">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="120"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                <DataGridTextColumn Header="Uploaded Bytes" Binding="{Binding BytesUploaded, Converter={StaticResource BytesToStringConverter}}" Width="120"/>
                                <DataGridTextColumn Header="Duration" Binding="{Binding DurationSeconds, Converter={StaticResource DurationConverter}}" Width="100"/>
                                <DataGridTextColumn Header="Remote Location" Binding="{Binding TargetLocation}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- SQL Databases (if applicable) -->
                        <TextBlock Text="SQL Server Databases" FontWeight="SemiBold" FontSize="{StaticResource FontSizeRowTitle}" Foreground="{DynamicResource BrushInk}" Margin="0,0,0,8"/>
                        <DataGrid ItemsSource="{Binding SqlDatabases}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" Background="Transparent" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" Margin="0,0,0,12" RowHeight="32">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Database" Binding="{Binding Database}" Width="160"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding BackupType}" Width="100"/>
                                <DataGridTextColumn Header="Size" Binding="{Binding SizeBytes, Converter={StaticResource BytesToStringConverter}}" Width="100"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                    </StackPanel>
                </ScrollViewer>

                <!-- Footer -->
                <Border Grid.Row="2" BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,1,0,0" Padding="24,14" Background="{DynamicResource BrushRaised}">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Run ID: " FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkFaint}"/>
                            <TextBlock Text="{Binding RunId}" FontFamily="{StaticResource FontFamilyMono}" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushInkMuted}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="View in Application Logs" Click="OpenLogs_Click" Style="{StaticResource BtnQuiet}" Height="34" Margin="0,0,10,0"/>
                            <Button Content="Close" Click="Close_Click" Style="{StaticResource BtnPrimary}" Height="34" Padding="18,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Border>
</Window>
