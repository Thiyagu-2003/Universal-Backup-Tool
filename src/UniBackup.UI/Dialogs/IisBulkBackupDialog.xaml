<Window x:Class="UniBackup.UI.Dialogs.IisBulkBackupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:UniBackup.UI.ViewModels"
        Title="Bulk Backup IIS Websites"
        Width="920" Height="650"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SnapsToDevicePixels="True"
        KeyDown="Window_KeyDown">

    <!-- Transparent container giving margin for drop shadow -->
    <Border Background="Transparent" Padding="20">
        <!-- Dialog Container -->
        <Border x:Name="DialogCard"
                Background="{DynamicResource BrushPanel}"
                BorderBrush="{DynamicResource BrushLine}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusDialog}"
                Effect="{StaticResource Sh3}"
                ClipToBounds="True"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="DialogCardScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="Auto"/> <!-- Summary / Status Banner -->
                    <RowDefinition Height="*"/>    <!-- Items List -->
                    <RowDefinition Height="Auto"/> <!-- Footer -->
                </Grid.RowDefinitions>

                <!-- 1. Header (Draggable) -->
                <Border Grid.Row="0" BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,0,0,1" Padding="24,18" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon Tile -->
                        <Border Width="40" Height="40" CornerRadius="10"
                                Background="{DynamicResource BrushTealSoft}"
                                VerticalAlignment="Center" Margin="0,0,14,0">
                            <Path Data="{StaticResource IconCloudArrowUp}"
                                  Fill="{DynamicResource BrushTeal}"
                                  Width="20" Height="20"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Bulk Backup IIS Websites"
                                       FontWeight="SemiBold"
                                       FontSize="{StaticResource FontSizeSectionHeader}"
                                       Foreground="{DynamicResource BrushInk}"/>
                            <TextBlock Text="Package selected web applications and upload to configured storage destinations"
                                       FontSize="{StaticResource FontSizeHelp}"
                                       Foreground="{DynamicResource BrushInkMuted}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Close Button -->
                        <Button Grid.Column="2" Click="Close_Click" Style="{StaticResource IconBtn}" VerticalAlignment="Center"
                                IsEnabled="{Binding CanCancel}">
                            <Path Data="{StaticResource IconClose}" Fill="{DynamicResource BrushInkMuted}" Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- 2. Status / Progress Banner -->
                <Border Grid.Row="1" Background="{DynamicResource BrushRaised}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,0,0,1" Padding="24,14">
                    <StackPanel>
                        <!-- Confirmation phase summary -->
                        <StackPanel Visibility="{Binding IsConfirmationPhase, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding ConfirmationSummaryText}"
                                       FontWeight="Medium"
                                       FontSize="{StaticResource FontSizeBody}"
                                       Foreground="{DynamicResource BrushInk}"/>
                            <!-- Ineligible Warning -->
                            <Border Margin="0,8,0,0"
                                    Background="{DynamicResource BrushSaffronSoft}"
                                    BorderBrush="{DynamicResource BrushSaffron}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,8"
                                    Visibility="{Binding HasIneligibleSites, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconWarningCircle}" Fill="{DynamicResource BrushSaffron}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding IneligibleWarningText}" Foreground="{DynamicResource BrushInk}" FontWeight="Medium" FontSize="{StaticResource FontSizeSecondary}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Execution phase progress -->
                        <StackPanel Visibility="{Binding IsExecutionPhase, Converter={StaticResource BoolToVis}}">
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="{Binding CurrentOperationMessage}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushInk}"/>
                                <TextBlock HorizontalAlignment="Right"
                                           Text="{Binding OverallProgressPercent, StringFormat='{}{0:N0}%'}"
                                           FontWeight="SemiBold"
                                           FontFamily="{StaticResource FontFamilyMono}"
                                           Foreground="{DynamicResource BrushTeal}"/>
                            </Grid>
                            <ProgressBar Value="{Binding OverallProgressPercent}" Maximum="100" Height="8" Foreground="{DynamicResource BrushTeal}" Background="{DynamicResource BrushSunken}" BorderThickness="0"/>
                        </StackPanel>

                        <!-- Completed phase metrics -->
                        <StackPanel Visibility="{Binding IsCompletedPhase, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding CurrentOperationMessage}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushInk}" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <!-- Succeeded Badge -->
                                <Border Style="{StaticResource BadgePill}" Background="{DynamicResource BrushJadeSoft}" Margin="0,0,12,0" Padding="14,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconCheck}" Fill="{DynamicResource BrushJade}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding SuccessCount, StringFormat='{}{0} Succeeded'}" FontWeight="SemiBold" Foreground="{DynamicResource BrushJade}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Skipped Badge -->
                                <Border Style="{StaticResource BadgePill}" Background="{DynamicResource BrushSaffronSoft}" Margin="0,0,12,0" Padding="14,6"
                                        Visibility="{Binding HasSkippedSites, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconWarningCircle}" Fill="{DynamicResource BrushSaffron}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding SkippedCount, StringFormat='{}{0} Skipped'}" FontWeight="SemiBold" Foreground="{DynamicResource BrushSaffron}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Failed Badge -->
                                <Border Style="{StaticResource BadgePill}" Background="{DynamicResource BrushCoralSoft}" Padding="14,6"
                                        Visibility="{Binding HasFailedSites, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconClose}" Fill="{DynamicResource BrushCoral}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding FailedCount, StringFormat='{}{0} Failed'}" FontWeight="SemiBold" Foreground="{DynamicResource BrushCoral}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 3. Items List -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,16">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:IisBulkBackupItemVm}">
                                <Border Margin="0,0,0,8"
                                        Background="{DynamicResource BrushPanel}"
                                        BorderBrush="{DynamicResource BrushLine}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusCard}"
                                        Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="140"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Site Name and Path/Message -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushInk}"/>
                                            <TextBlock Text="{Binding Path}" FontFamily="{StaticResource FontFamilyMono}" FontSize="{StaticResource FontSizeMono}" Foreground="{DynamicResource BrushInkMuted}" Margin="0,2,0,2"/>

                                            <!-- Failure or Skip Error Message -->
                                            <TextBlock Text="{Binding ErrorMessage}"
                                                       FontSize="{StaticResource FontSizeHelp}"
                                                       Foreground="{DynamicResource BrushCoral}"
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding HasErrorMessage, Converter={StaticResource BoolToVis}}"/>

                                            <!-- Success Details -->
                                            <TextBlock Text="{Binding Details}"
                                                       FontSize="{StaticResource FontSizeHelp}"
                                                       Foreground="{DynamicResource BrushJade}"
                                                       Visibility="{Binding HasDetails, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>

                                        <!-- Size / Phase -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding SizeDisplay}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushInk}" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding Phase}" FontSize="{StaticResource FontSizeSecondary}" Foreground="{DynamicResource BrushInkMuted}" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Status Badge -->
                                        <Border Grid.Column="2" Style="{StaticResource BadgePill}" Background="{Binding StatusBadgeSoftBrush}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status}" FontWeight="Medium" FontSize="{StaticResource FontSizeStatus}" Foreground="{Binding StatusBadgeBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 4. Footer -->
                <Border Grid.Row="3" BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,1,0,0" Padding="24,16" Background="{DynamicResource BrushRaised}">
                    <Grid>
                        <!-- Confirmation Phase Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    Visibility="{Binding IsConfirmationPhase, Converter={StaticResource BoolToVis}}">
                            <Button Content="Cancel" Click="Close_Click" Style="{StaticResource BtnQuiet}" Margin="0,0,12,0" Width="100"/>
                            <Button Content="Start Backup" Command="{Binding StartBackupCommand}" IsEnabled="{Binding CanStart}" Style="{StaticResource BtnPrimary}" Width="140"/>
                        </StackPanel>

                        <!-- Execution Phase Cancel -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    Visibility="{Binding IsExecutionPhase, Converter={StaticResource BoolToVis}}">
                            <Button Content="Cancel Backup" Command="{Binding CancelOrCloseCommand}" Style="{StaticResource BtnQuiet}" Width="130"/>
                        </StackPanel>

                        <!-- Completed Phase Close -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    Visibility="{Binding IsCompletedPhase, Converter={StaticResource BoolToVis}}">
                            <Button Content="Done" Click="Close_Click" Style="{StaticResource BtnPrimary}" Width="120"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Border>
</Window>
