    <!-- ===================================================================
         APP LOGO VECTOR DRAWING (Rounded-square gradient tile + shield + disk stack)
         #3C6BFF → #2D5BFF → #00A0AE, 135 deg
         =================================================================== -->
    <DrawingImage x:Key="AppLogoDrawingImage">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Tile Background (48x48) with CornerRadius 11 -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#3C6BFF" Offset="0.0"/>
                            <GradientStop Color="#2D5BFF" Offset="0.5"/>
                            <GradientStop Color="#00A0AE" Offset="1.0"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,48,48" RadiusX="11" RadiusY="11"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- Shield Outline (White, 2px stroke) -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFFFFF" Thickness="2.2" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 24,9 C 29,11.5 35,11.5 37,13 C 37,24 31,33 24,38.5 C 17,33 11,24 11,13 C 13,11.5 19,11.5 24,9 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- 3-layer Disk Stack inside Shield -->
                <!-- Top Disk: Ellipse -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFFFFF" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 18,18.5 A 6,2.2 0 1 0 30,18.5 A 6,2.2 0 1 0 18,18.5 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- Middle Disk Rim -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFFFFF" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 18,23 C 18,25 30,25 30,23"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- Bottom Disk Rim -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFFFFF" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 18,27.5 C 18,29.5 30,29.5 30,27.5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- Vertical Sides of Disk Stack -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFFFFF" Thickness="1.6" StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 18,18.5 L 18,27.5 M 30,18.5 L 30,27.5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

