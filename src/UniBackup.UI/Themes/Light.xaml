<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Identity & State Palette (Light) -->
    <Color x:Key="ColorCobalt">#2D5BFF</Color>
    <Color x:Key="ColorCobaltHover">#1E45D6</Color>
    <Color x:Key="ColorCobaltSoft">#E8EDFF</Color>

    <Color x:Key="ColorTeal">#00A0AE</Color>
    <Color x:Key="ColorTealSoft">#DFF4F6</Color>

    <Color x:Key="ColorOrchid">#7C4DFF</Color>
    <Color x:Key="ColorOrchidSoft">#EEE9FF</Color>

    <Color x:Key="ColorJade">#00946A</Color>
    <Color x:Key="ColorJadeSoft">#DFF3EC</Color>

    <Color x:Key="ColorSaffron">#C97A00</Color>
    <Color x:Key="ColorSaffronSoft">#FCF0DC</Color>

    <Color x:Key="ColorCoral">#E0293F</Color>
    <Color x:Key="ColorCoralSoft">#FDE7EA</Color>

    <Color x:Key="ColorSky">#0A7FD4</Color>

    <!-- Surfaces (Light) -->
    <Color x:Key="ColorCanvas">#F1F4F9</Color>
    <Color x:Key="ColorPanel">#FFFFFF</Color>
    <Color x:Key="ColorRaised">#F7F9FC</Color>
    <Color x:Key="ColorSunken">#EAEFF6</Color>
    <Color x:Key="ColorLine">#E0E7F0</Color>
    <Color x:Key="ColorLineStrong">#C7D2E0</Color>
    <Color x:Key="ColorInk">#0B1420</Color>
    <Color x:Key="ColorInkMuted">#4A5A70</Color>
    <Color x:Key="ColorInkFaint">#808FA5</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BrushCobalt" Color="{StaticResource ColorCobalt}"/>
    <SolidColorBrush x:Key="BrushCobaltHover" Color="{StaticResource ColorCobaltHover}"/>
    <SolidColorBrush x:Key="BrushCobaltSoft" Color="{StaticResource ColorCobaltSoft}"/>

    <SolidColorBrush x:Key="BrushTeal" Color="{StaticResource ColorTeal}"/>
    <SolidColorBrush x:Key="BrushTealSoft" Color="{StaticResource ColorTealSoft}"/>

    <SolidColorBrush x:Key="BrushOrchid" Color="{StaticResource ColorOrchid}"/>
    <SolidColorBrush x:Key="BrushOrchidSoft" Color="{StaticResource ColorOrchidSoft}"/>

    <SolidColorBrush x:Key="BrushJade" Color="{StaticResource ColorJade}"/>
    <SolidColorBrush x:Key="BrushJadeSoft" Color="{StaticResource ColorJadeSoft}"/>

    <SolidColorBrush x:Key="BrushSaffron" Color="{StaticResource ColorSaffron}"/>
    <SolidColorBrush x:Key="BrushSaffronSoft" Color="{StaticResource ColorSaffronSoft}"/>

    <SolidColorBrush x:Key="BrushCoral" Color="{StaticResource ColorCoral}"/>
    <SolidColorBrush x:Key="BrushCoralSoft" Color="{StaticResource ColorCoralSoft}"/>

    <SolidColorBrush x:Key="BrushSky" Color="{StaticResource ColorSky}"/>

    <!-- Surface Brushes -->
    <SolidColorBrush x:Key="BrushCanvas" Color="{StaticResource ColorCanvas}"/>
    <SolidColorBrush x:Key="BrushPanel" Color="{StaticResource ColorPanel}"/>
    <SolidColorBrush x:Key="BrushRaised" Color="{StaticResource ColorRaised}"/>
    <SolidColorBrush x:Key="BrushSunken" Color="{StaticResource ColorSunken}"/>
    <SolidColorBrush x:Key="BrushLine" Color="{StaticResource ColorLine}"/>
    <SolidColorBrush x:Key="BrushLineStrong" Color="{StaticResource ColorLineStrong}"/>
    <SolidColorBrush x:Key="BrushInk" Color="{StaticResource ColorInk}"/>
    <SolidColorBrush x:Key="BrushInkMuted" Color="{StaticResource ColorInkMuted}"/>
    <SolidColorBrush x:Key="BrushInkFaint" Color="{StaticResource ColorInkFaint}"/>

    <!-- Rail Palette (Stays dark in both themes) -->
    <LinearGradientBrush x:Key="BrushRailBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0D1726" Offset="0.0"/>
        <GradientStop Color="#16304F" Offset="1.0"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BrushRailText" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="BrushRailTextActive" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushRailHairline" Color="#1E2C40"/>
    <SolidColorBrush x:Key="BrushRailHover" Color="#182A45"/>
    <SolidColorBrush x:Key="BrushRailCaption" Color="#94A3B8"/>
    <SolidColorBrush x:Key="BrushRailHostPill" Color="#122035"/>

    <!-- Backward Compatibility Aliases -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource ColorCobalt}"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource ColorCobaltHover}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource ColorJade}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource ColorSaffron}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource ColorCoral}"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource ColorCanvas}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource ColorPanel}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource ColorLine}"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource ColorSunken}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource ColorInk}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource ColorInkMuted}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource ColorInkFaint}"/>
    <SolidColorBrush x:Key="SidebarTextBrush" Color="#AEBCD0"/>
    <SolidColorBrush x:Key="SidebarTextActiveBrush" Color="#FFFFFF"/>

    <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3C6BFF" Offset="0.0"/>
        <GradientStop Color="#2D5BFF" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SuccessGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#00946A" Offset="0.0"/>
        <GradientStop Color="#2ECC94" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="WarningGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#C97A00" Offset="0.0"/>
        <GradientStop Color="#F0AE3C" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DangerGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E0293F" Offset="0.0"/>
        <GradientStop Color="#FF6274" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0D1726" Offset="0.0"/>
        <GradientStop Color="#16304F" Offset="1.0"/>
    </LinearGradientBrush>

</ResourceDictionary>
